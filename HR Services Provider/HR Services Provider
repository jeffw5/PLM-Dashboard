        function toggleTreeFolder(element, nodeId) {
            const childrenContainer = element.nextElementSibling;
            const chevron = element.querySelector('.chevron-icon');
            if (childrenContainer) {
                childrenContainer.classList.toggle('open');
                if (childrenContainer.classList.contains('open')) {
                    chevron.style.transform = 'rotate(90deg)';
                } else {
                    chevron.style.transform = 'rotate(0deg)';
                }
            }
            if (nodeId) selectNode(nodeId);
        }

        function selectNode(id) {
            selectedNodeId = id;
            renderGraph();

            let selectedItem = null;
            function searchData(item) {
                if (item.id === id) return item;
                if (item.children) {
                    for (let c of item.children) {
                        let res = searchData(c);
                        if (res) return res;
                    }
                }
                return null;
            }

            selectedItem = searchData(domainData) || layoutNodes.find(n => n.id === id);

            if (selectedItem) {
                document.getElementById('ctx-bounded-context').textContent = selectedItem.name;
                
                const termsBox = document.getElementById('ctx-terms');
                if (selectedItem.terms && selectedItem.terms.length > 0) {
                    termsBox.innerHTML = selectedItem.terms.map(t => `<span class="badge">${t}</span>`).join('');
                } else {
                    termsBox.innerHTML = `<span class="badge">HR Services Enterprise Architecture</span>`;
                }

                const procBox = document.getElementById('ctx-processes');
                if (selectedItem.processes && selectedItem.processes.length > 0) {
                    procBox.textContent = selectedItem.processes.join(" • ");
                } else {
                    procBox.textContent = "Gross-to-Net Wage Computation, Multi-State Tax Impounding, Carrier EDI 834, EPLI Legal Review & Form 5500 Consolidation";
                }
            }
        }

        function updateDetailLevel(val) {
            const labels = ["Domains (L1)", "Contexts (L2)", "Services (L3)", "Processes"];
            document.getElementById('slider-value-label').textContent = labels[val - 1];
            renderGraph();
        }

        function switchView(view) {
            document.getElementById('btn-graph-view').classList.toggle('active', view === 'graph');
            document.getElementById('btn-tree-view').classList.toggle('active', view === 'tree');
            
            document.getElementById('view-graph').style.display = view === 'graph' ? 'block' : 'none';
            document.getElementById('view-tree').style.display = view === 'tree' ? 'block' : 'none';
        }

        document.getElementById('domain-type-filter').addEventListener('change', () => {
            renderGraph();
        });

        function setupSearch() {
            document.getElementById('search-input').addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                if (!query) return;

                const match = layoutNodes.find(n => n.name.toLowerCase().includes(query));
                if (match) {
                    selectNode(match.id);
                }
            });
        }

        function zoom(factor) {
            currentZoom *= factor;
            document.getElementById('nodes-layer').setAttribute('transform', `scale(${currentZoom})`);
            document.getElementById('links-layer').setAttribute('transform', `scale(${currentZoom})`);
        }

        function resetZoom() {
            currentZoom = 1;
            document.getElementById('nodes-layer').setAttribute('transform', `scale(1)`);
            document.getElementById('links-layer').setAttribute('transform', `scale(1)`);
        }
    </script>
</body>
</html>