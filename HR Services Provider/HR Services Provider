        // SVG Graph Rendering
        function renderGraph() {
            const svg = document.getElementById('graph-svg');
            const linksLayer = document.getElementById('links-layer');
            const nodesLayer = document.getElementById('nodes-layer');

            linksLayer.innerHTML = '';
            nodesLayer.innerHTML = '';

            const currentDetailLevel = parseInt(document.getElementById('detail-slider').value);
            const filterType = document.getElementById('domain-type-filter').value;

            const visibleNodes = layoutNodes.filter(n => {
                const matchesLevel = n.level <= currentDetailLevel;
                if (filterType === 'all') return matchesLevel;
                const rootDomain = getRootDomain(n);
                return matchesLevel && rootDomain && rootDomain.type === filterType;
            });

            const visibleIds = new Set(visibleNodes.map(n => n.id));

            // Render Links
            visibleNodes.forEach(node => {
                if (node.parent && visibleIds.has(node.parent)) {
                    const parentNode = layoutNodes.find(n => n.id === node.parent);
                    if (parentNode) {
                        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                        line.setAttribute('x1', parentNode.x);
                        line.setAttribute('y1', parentNode.y);
                        line.setAttribute('x2', node.x);
                        line.setAttribute('y2', node.y);
                        line.setAttribute('class', `link-line ${selectedNodeId === node.id || selectedNodeId === parentNode.id ? 'active' : ''}`);
                        linksLayer.appendChild(line);
                    }
                }
            });

            // Render Nodes
            visibleNodes.forEach(node => {
                const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                g.setAttribute('class', 'node-group');
                g.setAttribute('transform', `translate(${node.x}, ${node.y})`);
                g.onclick = () => selectNode(node.id);

                if (node.level === 1) {
                    const glow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                    glow.setAttribute('r', node.r + 12);
                    glow.setAttribute('fill', node.color);
                    glow.setAttribute('opacity', '0.15');
                    g.appendChild(glow);

                    const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
                    const pts = getOctagonPoints(0, 0, node.r);
                    polygon.setAttribute('points', pts);
                    polygon.setAttribute('fill', node.color);
                    polygon.setAttribute('stroke', '#ffffff');
                    polygon.setAttribute('stroke-width', '2.5');
                    polygon.setAttribute('class', 'node-core');
                    g.appendChild(polygon);
                } else {
                    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                    circle.setAttribute('r', node.r);
                    circle.setAttribute('fill', node.color);
                    circle.setAttribute('stroke', '#ffffff');
                    circle.setAttribute('stroke-width', '2');
                    circle.setAttribute('class', 'node-core');
                    g.appendChild(circle);
                }

                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('y', node.r + 14);
                text.setAttribute('class', 'node-label');
                text.textContent = node.name;
                g.appendChild(text);

                nodesLayer.appendChild(g);
            });
        }

        function getOctagonPoints(x, y, r) {
            const points = [];
            for (let i = 0; i < 8; i++) {
                const angle = (i * Math.PI / 4) + (Math.PI / 8);
                const px = x + r * Math.cos(angle);
                const py = y + r * Math.sin(angle);
                points.push(`${px},${py}`);
            }
            return points.join(' ');
        }

        function getRootDomain(node) {
            let current = node;
            while (current && current.parent) {
                current = layoutNodes.find(n => n.id === current.parent);
            }
            return current;
        }

        function createTreeHTML(data) {
            if (!data.children || data.children.length === 0) {
                return `<li class="tree-item">
                    <div class="tree-node" onclick="selectNode('${data.id || ''}')">
                        <i data-lucide="file-text" style="width:14px; color: var(--text-muted);"></i>
                        <span>${data.name}</span>
                    </div>
                </li>`;
            }

            return `<li class="tree-item">
                <div class="tree-node" onclick="toggleTreeFolder(this, '${data.id || ''}')">
                    <i data-lucide="chevron-right" class="chevron-icon" style="width:14px;"></i>
                    <i data-lucide="folder" style="width:14px; color: var(--primary)"></i>
                    <span>${data.name}</span>
                </div>
                <ul class="tree-children">
                    ${data.children.map(child => createTreeHTML(child)).join('')}
                </ul>
            </li>`;
        }

