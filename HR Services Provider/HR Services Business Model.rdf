hr:DigitalSelfServiceExperienceSubDomain a hr:SubDomain ;
    rdfs:label "Digital Self-Service & Platform Experience Bounded Context" ;
    hr:providesService hr:EmployeeSelfServicePortalService ,
                       hr:ClientAdminPortalReportingService ,
                       hr:SingleSignOnIdentityManagementService ,
                       hr:MobileWorkforceAppService .

hr:EmployeeSelfServicePortalService a hr:DomainService ;
    rdfs:label "Employee Self-Service Portal Service" ;
    hr:executedByProcess hr:ProcPortalProfileSelfUpdate , hr:ProcPayStubDocumentAccessLog ;
    hr:mapsToOntologyConcept hr:ConceptSelfServiceProfileSchema , hr:ConceptDigitalPayStubArchive .

hr:ClientAdminPortalReportingService a hr:DomainService ;
    rdfs:label "Client Admin Portal & Reporting Service" ;
    hr:executedByProcess hr:ProcClientDashboardReportGen , hr:ProcAdminRoleBasedAccessControl ;
    hr:mapsToOntologyConcept hr:ConceptClientReportingDashboard , hr:ConceptRoleBasedAccessModel .

hr:SingleSignOnIdentityManagementService a hr:DomainService ;
    rdfs:label "Single Sign-On & Identity Management Service" ;
    hr:executedByProcess hr:ProcSSOFederationSetup , hr:ProcMultiFactorAuthEnforcement ;
    hr:mapsToOntologyConcept hr:ConceptSSOFederationProtocol , hr:ConceptMFAPolicyRule .

hr:MobileWorkforceAppService a hr:DomainService ;
    rdfs:label "Mobile Workforce Application Service" ;
    hr:executedByProcess hr:ProcMobilePushNotificationDispatch , hr:ProcGeofencedClockInValidation ;
    hr:mapsToOntologyConcept hr:ConceptMobileAppNotificationSchema , hr:ConceptGeofenceBoundaryModel .

# --- Sub-Domain: Data Integration & Workforce Analytics Context (L2) ---
hr:DataIntegrationAnalyticsSubDomain a hr:SubDomain ;
    rdfs:label "Data Integration & Workforce Analytics Bounded Context" ;
    hr:providesService hr:HRISDataIntegrationConnectorService ,
                       hr:WorkforceAnalyticsReportingService ,
                       hr:DataPrivacySecurityGovernanceService .

hr:HRISDataIntegrationConnectorService a hr:DomainService ;
    rdfs:label "HRIS Data Integration & API Connector Service" ;
    hr:executedByProcess hr:ProcAPIConnectorSyncMonitoring , hr:ProcThirdPartyHRISFileMapping ;
    hr:mapsToOntologyConcept hr:ConceptAPIConnectorRegistry , hr:ConceptHRISFieldMappingSchema .

hr:WorkforceAnalyticsReportingService a hr:DomainService ;
