    hr:executedByProcess hr:ProcWorkforceKPIDashboardBuild , hr:ProcTurnoverPredictiveModeling ;
    hr:mapsToOntologyConcept hr:ConceptWorkforceKPILibrary , hr:ConceptTurnoverPredictionModel .

hr:DataPrivacySecurityGovernanceService a hr:DomainService ;
