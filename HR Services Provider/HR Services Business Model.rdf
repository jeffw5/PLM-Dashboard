# =================================================================
# SHACL SHAPES — MACHINE-CHECKABLE PRIVACY RULES
# =================================================================

hr:ValueIndicatorShape a sh:NodeShape ;
    sh:targetClass hr:ValueIndicator ;
    rdfs:comment "Every indicator must declare what it evidences, how it is collected, its granularity, its privacy flags, and at least one safeguard." ;
    sh:property [ sh:path hr:isIndicatorOf ; sh:minCount 1 ] ,
                [ sh:path hr:collectedByService ; sh:minCount 1 ; sh:class hr:DomainService ] ,
                [ sh:path hr:hasCollectionMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hr:DataCollectionMode ] ,
                [ sh:path hr:reportingGranularity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hr:ReportingGranularity ] ,
                [ sh:path hr:isIndividuallyAttributable ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path hr:usableInEmploymentDecisions ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path hr:governedBySafeguard ; sh:minCount 1 ; sh:class hr:PrivacySafeguard ] .

hr:AggregateThresholdShape a sh:NodeShape ;
    sh:targetClass hr:ValueIndicator ;
    rdfs:comment "Group-level indicators must set a minimum group size of at least 5 and be governed by the aggregation threshold safeguard." ;
    sh:sparql [
        sh:message "Aggregate-group indicator lacks k >= 5 or the aggregation threshold safeguard." ;
        sh:prefixes hr:HRServicesEnterpriseModel ;
        sh:select """
            SELECT $this WHERE {
                $this hr:reportingGranularity hr:GranularityAggregateGroup .
                FILTER ( NOT EXISTS { $this hr:minimumGroupSize ?k . FILTER (?k >= 5) }
                      || NOT EXISTS { $this hr:governedBySafeguard hr:SafeguardAggregationThreshold } )
            }""" ] .

hr:AnonymousNotAttributableShape a sh:NodeShape ;
    sh:targetClass hr:ValueIndicator ;
    sh:sparql [
        sh:message "Anonymous-survey indicator must not be individually attributable or usable in employment decisions." ;
        sh:prefixes hr:HRServicesEnterpriseModel ;
        sh:select """
            SELECT $this WHERE {
                $this hr:hasCollectionMode hr:ModeAnonymousSurvey .
                { $this hr:isIndividuallyAttributable true } UNION { $this hr:usableInEmploymentDecisions true }
            }""" ] .

hr:EmploymentDecisionShape a sh:NodeShape ;
    sh:targetClass hr:ValueIndicator ;
    rdfs:comment "An indicator usable in employment decisions must be conduct- or record-based, transparent to the employee, human-reviewed and retention-limited; survey and voluntary data never qualify." ;
    sh:sparql [
        sh:message "Decision-grade indicator is missing a required safeguard or uses a prohibited collection mode." ;
        sh:prefixes hr:HRServicesEnterpriseModel ;
        sh:select """
            SELECT $this WHERE {
                $this hr:usableInEmploymentDecisions true .
                FILTER ( NOT EXISTS { $this hr:governedBySafeguard hr:SafeguardHumanReview }
                      || NOT EXISTS { $this hr:governedBySafeguard hr:SafeguardTransparencyNotice }
                      || NOT EXISTS { $this hr:governedBySafeguard hr:SafeguardRetentionLimit }
                      || EXISTS { $this hr:hasCollectionMode hr:ModeAnonymousSurvey }
                      || EXISTS { $this hr:hasCollectionMode hr:ModeVoluntarySelfReport } )
            }""" ] .

hr:GuidingPrincipleShape a sh:NodeShape ;
    sh:targetClass hr:GuidingPrinciple ;
    rdfs:comment "Every value or objective must be promoted by at least one service and evidenced by at least one indicator." ;
    sh:property [ sh:path hr:evidencedByIndicator ; sh:minCount 1 ; sh:class hr:ValueIndicator ] ,
                [ sh:path [ sh:inversePath hr:promotesPrinciple ] ; sh:minCount 1 ] .

hr:HRServicesEnterpriseModel sh:declare
    [ sh:prefix "hr" ; sh:namespace "http://example.org/hrservices/ddd#"^^xsd:anyURI ] .

# =================================================================
# COMPETENCY QUESTIONS (sample SPARQL)
# =================================================================
# CQ1  Which indicators may be used in employment decisions, and which
#      safeguards govern them?
#   SELECT ?ind ?sg WHERE { ?ind hr:usableInEmploymentDecisions true ;
#                                 hr:governedBySafeguard ?sg . }
#
# CQ2  For each value/objective, which services promote it and how is it
#      measured?
#   SELECT ?p ?svc ?ind ?mode WHERE { ?svc hr:promotesPrinciple ?p .
#       ?p hr:evidencedByIndicator ?ind . ?ind hr:hasCollectionMode ?mode . }
#
# CQ3  Which practices are prohibited, by which safeguard, under which law?
#   SELECT ?practice ?sg ?reg WHERE { ?sg hr:prohibitsPractice ?practice .
#       OPTIONAL { ?sg hr:derivedFromRegulation ?reg } }
#
# CQ4  Which operational areas carry the values-stewardship service line?
#   SELECT DISTINCT ?op WHERE { hr:ServiceLineValuesStewardship hr:realizedBySubDomain ?sd .
#       ?sd hr:providesService ?svc . ?svc hr:executedByProcess ?proc .
#       ?proc hr:supportedByOperation ?op . }
