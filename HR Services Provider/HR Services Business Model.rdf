@prefix hr:       <http://example.org/hrservices/ddd#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# =================================================================
# ONTOLOGY & CLASS DEFINITIONS
# =================================================================

hr:HRServicesEnterpriseModel a owl:Ontology ;
    rdfs:label "HR Services & PEO Enterprise Business Model Ontology" ;
    rdfs:comment "A Domain-Driven Design ontology defining L1-L3 service topologies, business processes, and operational mappings for an HR/PEO provider." .

# --- DDD Core Classes ---
hr:Domain a owl:Class ;
    rdfs:label "Business Domain (L1)" .

hr:SubDomain a owl:Class ;
    rdfs:subClassOf hr:Domain ;
    rdfs:label "Sub-Domain / Bounded Context (L2)" .

hr:DomainService a owl:Class ;
    rdfs:label "Domain Service (L3)" .

hr:BusinessProcess a owl:Class ;
    rdfs:label "Underlying Business Process" .

hr:OperationalArea a owl:Class ;
    rdfs:label "Functional Operational Area" .

hr:OntologyConcept a owl:Class ;
    rdfs:label "Domain-Specific Ontology Concept" .

# --- DDD Object Properties ---
hr:hasSubDomain a owl:ObjectProperty ;
    rdfs:domain hr:Domain ;
    rdfs:range hr:SubDomain .

hr:providesService a owl:ObjectProperty ;
    rdfs:domain hr:SubDomain ;
    rdfs:range hr:DomainService .

hr:executedByProcess a owl:ObjectProperty ;
    rdfs:domain hr:DomainService ;
    rdfs:range hr:BusinessProcess .

hr:supportedByOperation a owl:ObjectProperty ;
    rdfs:domain hr:BusinessProcess ;
    rdfs:range hr:OperationalArea .

hr:mapsToOntologyConcept a owl:ObjectProperty ;
    rdfs:domain hr:DomainService ;
    rdfs:range hr:OntologyConcept .


# --- Inverse DDD Object Properties (added for full bidirectional traversal) ---
hr:isSubDomainOf a owl:ObjectProperty ;
    owl:inverseOf hr:hasSubDomain ;
    rdfs:domain hr:SubDomain ;
    rdfs:range hr:Domain ;
    rdfs:label "Is Sub-Domain Of" .

hr:isProvidedBySubDomain a owl:ObjectProperty ;
    owl:inverseOf hr:providesService ;
    rdfs:domain hr:DomainService ;
    rdfs:range hr:SubDomain ;
    rdfs:label "Is Provided By Sub-Domain" .

hr:realizesService a owl:ObjectProperty ;
    owl:inverseOf hr:executedByProcess ;
    rdfs:domain hr:BusinessProcess ;
    rdfs:range hr:DomainService ;
    rdfs:label "Realizes Domain Service" .

hr:supportsProcess a owl:ObjectProperty ;
    owl:inverseOf hr:supportedByOperation ;
    rdfs:domain hr:OperationalArea ;
    rdfs:range hr:BusinessProcess ;
    rdfs:label "Supports Business Process" .

hr:isConceptOfService a owl:ObjectProperty ;
    owl:inverseOf hr:mapsToOntologyConcept ;
    rdfs:domain hr:OntologyConcept ;
    rdfs:range hr:DomainService ;
    rdfs:label "Is Ontology Concept Of Service" .

# =================================================================
# FUNCTIONAL & CORPORATE OPERATIONAL AREAS
# =================================================================

hr:OpPayrollTaxAccounting a hr:OperationalArea ;
    rdfs:label "Payroll Tax Accounting & Treasury Operations" ;
    rdfs:comment "Multi-jurisdiction tax impounding, disbursement, and general ledger reconciliation." .

hr:OpBenefitsUnderwriting a hr:OperationalArea ;
    rdfs:label "Benefits Plan Underwriting & Carrier Relations" ;
    rdfs:comment "Carrier EDI feeds, master trust management, and stop-loss underwriting." .

hr:OpLegalCompliance a hr:OperationalArea ;
    rdfs:label "Employment Legal, Regulatory & Compliance Operations" ;
    rdfs:comment "EPLI defense coordination, CPEO compliance, and labor standards adherence." .

hr:OpRiskSafety a hr:OperationalArea ;
    rdfs:label "Risk Management & Worksite Safety Operations" ;
    rdfs:comment "Workers' compensation claims triage, safety audits, and OSHA reporting." .

hr:OpTalentAdvisory a hr:OperationalArea ;
    rdfs:label "Talent Acquisition & Organizational Consulting Operations" ;
    rdfs:comment "Recruiting pipeline delivery, HR advisory, and compensation benchmarking." .

hr:OpHRTechnologyCyber a hr:OperationalArea ;
    rdfs:label "HR Technology Platform & Cybersecurity Operations" ;
    rdfs:comment "Single Sign-On (SSO), data connectors, and self-service portal infrastructure." .


hr:OpBusinessDevelopmentSales a hr:OperationalArea ;
    rdfs:label "Sales, Contracting & Client Implementation Operations" ;
    rdfs:comment "Prospect qualification, master service agreement contracting, and new-client implementation/onboarding delivery." .

hr:OpClientFinanceBilling a hr:OperationalArea ;
    rdfs:label "Client Invoicing, Billing & Accounts Receivable Operations" ;
    rdfs:comment "Service fee invoicing, accounts receivable collection, and client-facing financial reporting, distinct from worksite-employee payroll treasury." .

