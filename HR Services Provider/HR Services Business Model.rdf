hr:RegNYElectronicMonitoringNotice a hr:RegulatoryInstrument ;
    rdfs:label "New York Civil Rights Law §52-c — Electronic Monitoring Notice" .

hr:RegCTElectronicMonitoringNotice a hr:RegulatoryInstrument ;
    rdfs:label "Connecticut Gen. Stat. §31-48d — Electronic Monitoring Notice" .

hr:RegNLRASection7 a hr:RegulatoryInstrument ;
    rdfs:label "National Labor Relations Act §7 — Protected Concerted Activity" .

hr:RegGDPRArticle88 a hr:RegulatoryInstrument ;
    rdfs:label "EU GDPR Article 88 — Processing in the Context of Employment (for non-U.S. worksite employees)" .

