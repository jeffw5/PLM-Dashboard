###############################################################################
#  ontology-domain-customer-questions - KE Domains
#  179 customer questions beyond the sales decision questions, each linked
#  to a persona, job, job-map step, service and business process, and classified
#  under SKL (ontology-core-classification v0.2.0).
#
#  Governance spline: one registry of governance references (regulations, legal
#  concerns, standards, policies). Terms point to references; phrases point to
#  terms; questions point to phrases, terms and references. A citation is edited
#  in one place only.
#  Also holds proposed concept defaults for terms that have none yet.
#  DRAFT 2026-11-11 for SME, Legal and Privacy review. Proposed defaults take
#  effect only when the owning Domain Governance Team approves them by KGCL.
###############################################################################
@prefix pj:        <https://enablingvalue.com/ontology/persona-jobs#> .
@prefix isp-class: <https://enablingvalue.com/ontology/isp-class#> .
@prefix isp-pay:   <https://enablingvalue.com/ontology/isp-pay#> .
@prefix isp-ben:   <https://enablingvalue.com/ontology/isp-ben#> .
@prefix isp-comp:  <https://enablingvalue.com/ontology/isp-comp#> .
@prefix isp-tal:   <https://enablingvalue.com/ontology/isp-tal#> .
@prefix isp-wfd:   <https://enablingvalue.com/ontology/isp-wfd#> .
@prefix isp-val:   <https://enablingvalue.com/ontology/isp-val#> .
@prefix isp-crm:   <https://enablingvalue.com/ontology/isp-crm#> .
@prefix isp-tech:  <https://enablingvalue.com/ontology/isp-tech#> .
@prefix pes:       <https://enablingvalue.com/ontology/peo-es#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .

<https://enablingvalue.com/ontology/ontology-domain-customer-questions>
    a owl:Ontology ;
    owl:versionInfo "0.2.0" ;
    owl:imports <https://enablingvalue.com/ontology/ontology-core-classification> ,
                <https://enablingvalue.com/ontology/ontology-domain-persona-jobs> ;
    dcterms:title "ontology-domain-customer-questions"@en ;
    dcterms:created "2026-11-11"^^xsd:date .

#################################################################
#  Schema
#################################################################
pj:CustomerQuestion a owl:Class ; rdfs:subClassOf isp-class:ClassifiedItem ; rdfs:label "Customer question"@en ;
    skos:definition "A question a customer, worker, prospect or third party raises with service staff, or that staff raise while serving them. Classified by the answer and the case record it produces."@en .
pj:BusinessProcess a owl:Class ; rdfs:label "Business process"@en .
pj:GovernanceReference a owl:Class ; rdfs:label "Governance reference"@en ;
    skos:definition "A regulation, legal concern, standard or policy that bears on how a classified term may be disclosed or used. Held once; everything else points to it."@en .
pj:RegulationRef a owl:Class ; rdfs:subClassOf pj:GovernanceReference ; rdfs:label "Regulation reference"@en .
pj:LegalConcernRef a owl:Class ; rdfs:subClassOf pj:GovernanceReference ; rdfs:label "Legal concern reference"@en .
pj:StandardRef a owl:Class ; rdfs:subClassOf pj:GovernanceReference ; rdfs:label "Standard reference"@en .
pj:PolicyRef a owl:Class ; rdfs:subClassOf pj:GovernanceReference ; rdfs:label "Policy reference"@en .
pj:Phrase a owl:Class ; rdfs:label "Phrase"@en ;
    skos:definition "A phrase pattern that, found in a question, resolves to a classified term."@en .
pj:raisedBy a owl:ObjectProperty ; rdfs:label "raised by"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:Persona .
pj:handledBy a owl:ObjectProperty ; rdfs:label "handled by"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:Persona .
pj:audience a owl:ObjectProperty ; rdfs:label "audience"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range skos:Concept .
pj:concernsJob a owl:ObjectProperty ; rdfs:label "concerns job"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:Job .
pj:atJobMapStep a owl:ObjectProperty ; rdfs:label "at job-map step"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range skos:Concept .
pj:relatesToOutcome a owl:ObjectProperty ; rdfs:label "relates to outcome"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:DesiredOutcome .
pj:concernsService a owl:ObjectProperty ; rdfs:label "concerns service"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range skos:Concept .
pj:concernsProcess a owl:ObjectProperty ; rdfs:label "concerns process"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:BusinessProcess .
pj:executedByProcess a owl:ObjectProperty ; rdfs:label "executed by process"@en ; rdfs:range pj:BusinessProcess .
pj:touchesTerm a owl:ObjectProperty ; rdfs:label "touches term"@en ; rdfs:domain pj:CustomerQuestion ;
    skos:definition "A classified term whose values the answer or the case record contains. Counts toward the question's sensitivity."@en .
pj:mentionsPhrase a owl:ObjectProperty ; rdfs:label "mentions phrase"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:Phrase .
pj:mentionsTerm a owl:ObjectProperty ; rdfs:label "mentions term"@en ; rdfs:domain pj:CustomerQuestion ;
    skos:definition "A term the question names but the answer and the case record do not contain. Does not count toward sensitivity; a reviewer confirms it."@en .
pj:mapsToTerm a owl:ObjectProperty ; rdfs:label "maps to term"@en ; rdfs:domain pj:Phrase .
pj:governedBy a owl:ObjectProperty ; rdfs:label "governed by"@en ; rdfs:range pj:GovernanceReference ;
    skos:definition "A classified term is governed by a reference."@en .
pj:appliesGovernance a owl:ObjectProperty ; rdfs:label "applies governance"@en ; rdfs:domain pj:CustomerQuestion ; rdfs:range pj:GovernanceReference ;
    skos:definition "Every governance reference that applies to the answer: from the terms touched, the handling flags and the SKL rules."@en .
pj:phrasePattern a owl:DatatypeProperty ; rdfs:label "phrase pattern"@en ; rdfs:domain pj:Phrase .
pj:appliesWhen a owl:DatatypeProperty ; rdfs:label "applies when"@en ; rdfs:domain pj:GovernanceReference .
pj:proposedOwner a owl:DatatypeProperty ; rdfs:label "proposed owner"@en ; rdfs:domain pj:GovernanceReference .
pj:confirmation a owl:DatatypeProperty ; rdfs:label "Legal or Privacy confirmation"@en ; rdfs:domain pj:GovernanceReference .
pj:questionKind a owl:DatatypeProperty ; rdfs:label "question kind"@en .
pj:aboutScope a owl:DatatypeProperty ; rdfs:label "about"@en .
pj:dataFlow a owl:DatatypeProperty ; rdfs:label "data flow"@en .
pj:privacyClass a owl:DatatypeProperty ; rdfs:label "privacy class"@en .
pj:confidentialityClass a owl:DatatypeProperty ; rdfs:label "confidentiality class"@en .
pj:defaultDisclosure a owl:DatatypeProperty ; rdfs:label "default disclosure"@en .
pj:disclosureOutcome a owl:DatatypeProperty ; rdfs:label "disclosure outcome"@en .
pj:personHandling a owl:DatatypeProperty ; rdfs:label "person handling"@en .
pj:agentHandling a owl:DatatypeProperty ; rdfs:label "agent handling"@en .
pj:evidenceToRecord a owl:DatatypeProperty ; rdfs:label "evidence to record"@en .
pj:trustTrace a owl:DatatypeProperty ; rdfs:label "trust trace"@en .
pj:handlingNote a owl:DatatypeProperty ; rdfs:label "handling note"@en .
pj:purposeCheck a owl:DatatypeProperty ; rdfs:label "purpose check"@en .
pj:proposalStatus a owl:AnnotationProperty ; rdfs:label "proposal status"@en .

#  Audiences missing from isp-class:AudienceScheme (proposed additions, by KGCL)
pj:aud-Prospect a skos:Concept ; skos:prefLabel "Prospect"@en ;
    skos:editorialNote "Proposed addition to isp-class:AudienceScheme."@en .
pj:aud-ThirdParty a skos:Concept ; skos:prefLabel "Third party (family member, lender, agency, attorney, applicant)"@en ;
    skos:editorialNote "Proposed addition to isp-class:AudienceScheme."@en .
pj:persona-TP a pj:Persona ; skos:notation "TP" ; rdfs:label "Third party"@en ;
    skos:definition "Someone outside the client relationship who asks for a worker's or a client's information."@en .

#################################################################
