pj:CQ-001 a pj:CustomerQuestion ; skos:notation "CQ-001" ;
    rdfs:label "Why is my net pay lower this period than last period?"@en ;
    pj:questionKind "Explanation"@en ;
    pj:raisedBy pj:persona-P6 ; pj:handledBy pj:persona-CS ; pj:audience isp-class:Aud_WorkerSelf ;
    pj:concernsService pj:svc-GrossToNetPayrollService ; pj:atJobMapStep pj:step-MON ;
    pj:concernsProcess pj:proc-ProcGrossToNetCalculation ;
    pj:concernsJob pj:J01 ;
    pj:relatesToOutcome pj:O008 ;
    pj:touchesTerm isp-pay:grossPay , isp-pay:payRate ;
    pj:mentionsPhrase pj:phr-gross-1 ;
    pj:appliesGovernance pj:gov-r-022 , pj:gov-r-023 , pj:gov-r-024 , pj:gov-r-025 , pj:gov-r-032 , pj:gov-p-006 , pj:gov-p-008 ;
    pj:aboutScope "The asker's own records"@en ; pj:dataFlow "Answer discloses data"@en ;
    pj:privacyClass "Personal data"@en ; pj:confidentialityClass "Worker confidential"@en ;
    pj:defaultDisclosure "Allow the worker's own records, after identity verification."@en ; pj:disclosureOutcome "Allow with conditions"@en ;
    pj:personHandling "Confirm who is asking and why, then answer within the limits in Default disclosure."@en ; pj:agentHandling "AI may answer a permitted asker. Redact identifiers otherwise. Resolve each phrase through the lexicon; an unmapped phrase is Held at C3."@en ;
    pj:evidenceToRecord "question ID and text; phrases resolved to terms; classification record (level, regime, purpose); governance IDs applied; decision and who responded (person or agent); identity check result"@en ;
    pj:trustTrace "“net pay” → gross pay for a period; (implied) → pay rate | C3 set by gross pay for a period, pay rate | governed by GOV-R-022, GOV-R-023, GOV-R-024, GOV-R-025, GOV-R-032, GOV-P-006, GOV-P-008 | Worker (self): Allow with conditions"@en ;
