    isp-class:defaultSubject isp-class:Subject_Client ;
    isp-class:defaultPurpose isp-class:Purpose_Advisory , isp-class:Purpose_Payroll , isp-class:Purpose_Benefits , isp-class:Purpose_Compliance ;
    pj:proposalStatus "Proposed 2026-11-11; pending Domain Governance Team approval" .
isp-tech:securityControlDescription rdfs:label "security control description"@en ;
    isp-class:defaultSensitivity isp-class:C2 ;
    isp-class:defaultSubject isp-class:Subject_Insperity ;
    isp-class:defaultPurpose isp-class:Purpose_Advisory , isp-class:Purpose_Compliance ;
    pj:proposalStatus "Proposed 2026-11-11; pending Domain Governance Team approval" .
isp-tech:securityIncident rdfs:label "security incident record"@en ;
    isp-class:defaultSensitivity isp-class:C4 ;
    isp-class:defaultSubject isp-class:Subject_Insperity , isp-class:Subject_Worker ;
    isp-class:defaultPurpose isp-class:Purpose_Compliance ;
    pj:proposalStatus "Proposed 2026-11-11; pending Domain Governance Team approval" .
isp-tech:preciseGeolocation rdfs:label "precise geolocation"@en ;
    isp-class:defaultSensitivity isp-class:C3 ;
    isp-class:defaultSubject isp-class:Subject_Worker ;
    isp-class:defaultRegime isp-class:Reg_CCPA ;
    isp-class:defaultPurpose isp-class:Purpose_Payroll , isp-class:Purpose_Compliance ;
    pj:proposalStatus "Proposed 2026-11-11; pending Domain Governance Team approval" .

