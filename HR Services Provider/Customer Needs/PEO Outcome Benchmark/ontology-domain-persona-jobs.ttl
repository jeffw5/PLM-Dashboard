###############################################################################
#  ontology-domain-persona-jobs - KE Domains
#  Personas, the jobs they hire a PEO to get done, the job steps, desired
#  outcomes and the decision questions, from two studies:
#    1. Sales journey study (prospect side): Client Admin and HR Specialist,
#       job-specific steps (Discover ... Onboard), 42 desired outcomes each,
#       and the Decision Question Baseline (one decision and four questions
#       per step of each persona's core job; 48 questions).
#    2. PEO Outcome Benchmark (client side, ODI): seven client personas,
#       26 jobs on the universal eight-step job map, 224 outcome statements
#       that the benchmark survey rates for importance and satisfaction.
#  Generated 2026-11-10 from the published KE Workbench (Buyer Personas,
#  Decision Question Baseline) and PEO Outcome Benchmark artifacts.
#  Question wording, tiers and targets are proposals for SME/steward review.
###############################################################################
@prefix pj:      <https://enablingvalue.com/ontology/persona-jobs#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://enablingvalue.com/ontology/ontology-domain-persona-jobs>
    a owl:Ontology ;
    dcterms:title "ontology-domain-persona-jobs"@en ;
    dcterms:description "Personas, jobs, job steps, desired outcomes and decision questions for PEO buyers and clients."@en ;
    owl:versionInfo "0.1.0" ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator "Jeffrey Wallk" .

#################################################################
#  Schema
#################################################################
pj:Persona a owl:Class ; rdfs:label "Persona"@en ;
    skos:definition "A role whose jobs, needs and questions the PEO designs services around."@en .
pj:PersonaInstance a owl:Class ; rdfs:label "Persona instance"@en ;
    skos:definition "A fictitious, named example of a persona used for scenarios and prototyping."@en .
pj:JobStudy a owl:Class ; rdfs:label "Job study"@en .
pj:Job a owl:Class ; rdfs:label "Job"@en ;
    skos:definition "A job to be done: a goal a persona is trying to accomplish, independent of any solution."@en .
pj:JobStep a owl:Class ; rdfs:label "Job step"@en .
pj:DesiredOutcome a owl:Class ; rdfs:label "Desired outcome"@en ;
    skos:definition "A measurable statement of how a persona judges success at a job step (direction, object of control, context)."@en .
pj:Decision a owl:Class ; rdfs:label "Decision"@en ;
    skos:definition "The choice a persona makes at a job step."@en .
pj:DecisionQuestion a owl:Class ; rdfs:label "Decision question"@en ;
    skos:definition "A question that must be answered well for the persona to make a decision; the unit of control for the advisor baseline."@en .

pj:performsJob a owl:ObjectProperty ; rdfs:label "performs job"@en ; rdfs:domain pj:Persona ; rdfs:range pj:Job .
pj:executesJob a owl:ObjectProperty ; rdfs:subPropertyOf pj:performsJob ; rdfs:label "executes job"@en ;
    skos:definition "The persona carries out the job (Outcome Benchmark 'executor')."@en .
pj:participatesInJob a owl:ObjectProperty ; rdfs:label "participates in job"@en ; rdfs:domain pj:Persona ; rdfs:range pj:Job ;
    skos:definition "The persona takes part in or is affected by the job without owning it."@en .
pj:instanceOf a owl:ObjectProperty ; rdfs:label "instance of persona"@en ; rdfs:domain pj:PersonaInstance ; rdfs:range pj:Persona .
pj:hasJobStudy a owl:ObjectProperty ; rdfs:label "has job study"@en ; rdfs:domain pj:Persona ; rdfs:range pj:JobStudy .
pj:includesJob a owl:ObjectProperty ; rdfs:label "includes job"@en ; rdfs:domain pj:JobStudy ; rdfs:range pj:Job .
pj:hasStep a owl:ObjectProperty ; rdfs:label "has step"@en ; rdfs:domain pj:Job ; rdfs:range pj:JobStep .
pj:onJobMapStep a owl:ObjectProperty ; rdfs:label "on job-map step"@en ; rdfs:domain pj:JobStep ; rdfs:range skos:Concept .
pj:inStage a owl:ObjectProperty ; rdfs:label "in journey stage"@en ; rdfs:domain pj:JobStep ; rdfs:range skos:Concept .
pj:hasDesiredOutcome a owl:ObjectProperty ; rdfs:label "has desired outcome"@en ; rdfs:domain pj:JobStep ; rdfs:range pj:DesiredOutcome .
pj:hasDecision a owl:ObjectProperty ; rdfs:label "has decision"@en ; rdfs:domain pj:JobStep ; rdfs:range pj:Decision .
pj:hasQuestion a owl:ObjectProperty ; rdfs:label "has question"@en ; rdfs:domain pj:Decision ; rdfs:range pj:DecisionQuestion .
pj:askedBy a owl:ObjectProperty ; rdfs:label "asked by"@en ; rdfs:domain pj:DecisionQuestion ; rdfs:range pj:Persona .
pj:decisionServes a owl:ObjectProperty ; rdfs:label "serves outcome"@en ; rdfs:domain pj:Decision ; rdfs:range pj:DesiredOutcome .
pj:questionType a owl:ObjectProperty ; rdfs:label "question type"@en ; rdfs:range skos:Concept .
pj:riskTier a owl:ObjectProperty ; rdfs:label "risk tier"@en ; rdfs:range skos:Concept .
pj:jobKind a owl:ObjectProperty ; rdfs:label "job kind"@en ; rdfs:range skos:Concept .
pj:inDomain a owl:ObjectProperty ; rdfs:label "in business domain"@en ; rdfs:range skos:Concept .
pj:supportedBy a owl:ObjectProperty ; rdfs:label "supported by service"@en ; rdfs:range skos:Concept .
pj:theme a owl:ObjectProperty ; rdfs:label "service-line theme"@en ; rdfs:range skos:Concept .
pj:outcomeMetricType a owl:ObjectProperty ; rdfs:label "outcome metric type"@en ; rdfs:range skos:Concept .

pj:statement a owl:DatatypeProperty ; rdfs:label "statement"@en .
pj:direction a owl:DatatypeProperty ; rdfs:label "direction (Minimize or Maximize)"@en .
pj:unit a owl:DatatypeProperty ; rdfs:label "metric unit"@en .
pj:target a owl:DatatypeProperty ; rdfs:label "target"@en .
pj:baseline a owl:DatatypeProperty ; rdfs:label "baseline (absent when not yet measured)"@en .
pj:metricCard a owl:DatatypeProperty ; rdfs:label "metric card"@en .
pj:measurementSource a owl:DatatypeProperty ; rdfs:label "measurement source"@en .
pj:advisorService a owl:DatatypeProperty ; rdfs:label "advisor service"@en .
pj:expectedAnswerShape a owl:DatatypeProperty ; rdfs:label "expected answer shape"@en .
pj:goal a owl:DatatypeProperty ; rdfs:label "goal"@en .
pj:emotionalJob a owl:DatatypeProperty ; rdfs:label "emotional job"@en .
pj:context a owl:DatatypeProperty ; rdfs:label "context"@en .
pj:buyingRole a owl:DatatypeProperty ; rdfs:label "buying role"@en .
pj:typicalTitles a owl:DatatypeProperty ; rdfs:label "typical titles"@en .
pj:scope a owl:DatatypeProperty ; rdfs:label "scope"@en .
pj:lineageData a owl:DatatypeProperty ; rdfs:label "lineage: data"@en .
pj:lineageContent a owl:DatatypeProperty ; rdfs:label "lineage: content"@en .
pj:lineageKnowledge a owl:DatatypeProperty ; rdfs:label "lineage: knowledge"@en .
pj:lineageMappings a owl:DatatypeProperty ; rdfs:label "lineage: mappings"@en .
pj:lineageTransforms a owl:DatatypeProperty ; rdfs:label "lineage: transformations"@en .
pj:lineageResponse a owl:DatatypeProperty ; rdfs:label "lineage: advisor response"@en .

#################################################################
#  Controlled vocabularies
#################################################################
pj:JobMapScheme a skos:ConceptScheme ; skos:prefLabel "Universal job map"@en .
pj:step-DEF a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Define"@en ;
    skos:definition "Determine objectives and plan the approach"@en .
pj:step-LOC a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Locate"@en ;
    skos:definition "Gather the inputs and information needed"@en .
pj:step-PRE a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Prepare"@en ;
    skos:definition "Set up the environment and inputs"@en .
pj:step-CON a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Confirm"@en ;
    skos:definition "Verify readiness before acting"@en .
pj:step-EXE a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Execute"@en ;
    skos:definition "Carry out the core task"@en .
pj:step-MON a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Monitor"@en ;
    skos:definition "Check that the task is going as intended"@en .
pj:step-MOD a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Modify"@en ;
    skos:definition "Make adjustments and corrections"@en .
pj:step-CONC a skos:Concept ; skos:inScheme pj:JobMapScheme ; skos:topConceptOf pj:JobMapScheme ;
    skos:prefLabel "Conclude"@en ;
    skos:definition "Finish, close out and prepare for next time"@en .

pj:step-DEF skos:notation "1" .
pj:step-LOC skos:notation "2" .
pj:step-PRE skos:notation "3" .
pj:step-CON skos:notation "4" .
pj:step-EXE skos:notation "5" .
pj:step-MON skos:notation "6" .
pj:step-MOD skos:notation "7" .
pj:step-CONC skos:notation "8" .

pj:SalesStageScheme a skos:ConceptScheme ; skos:prefLabel "Sales journey stages"@en .
pj:stage-Discover a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Discover"@en .
pj:stage-Qualify a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Qualify"@en .
pj:stage-Evaluate a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Evaluate"@en .
pj:stage-Propose a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Propose"@en .
pj:stage-Decide a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Decide"@en .
pj:stage-Onboard a skos:Concept ; skos:inScheme pj:SalesStageScheme ; skos:topConceptOf pj:SalesStageScheme ;
    skos:prefLabel "Onboard"@en .

pj:QuestionTypeScheme a skos:ConceptScheme ; skos:prefLabel "Decision question types"@en .
pj:qt-FACT a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Factual"@en .
pj:qt-ELIG a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Eligibility"@en .
pj:qt-COMP a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Comparative"@en .
pj:qt-SCEN a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Scenario"@en .
pj:qt-RISK a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Risk / exposure"@en .
pj:qt-PROC a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Procedural"@en .
pj:qt-ALLOC a skos:Concept ; skos:inScheme pj:QuestionTypeScheme ; skos:topConceptOf pj:QuestionTypeScheme ;
    skos:prefLabel "Responsibility allocation"@en .

pj:qt-FACT skos:notation "FACT" .
pj:qt-ELIG skos:notation "ELIG" .
pj:qt-COMP skos:notation "COMP" .
pj:qt-SCEN skos:notation "SCEN" .
pj:qt-RISK skos:notation "RISK" .
pj:qt-PROC skos:notation "PROC" .
pj:qt-ALLOC skos:notation "ALLOC" .

pj:RiskTierScheme a skos:ConceptScheme ; skos:prefLabel "Decision question risk tiers"@en .
pj:tier-H a skos:Concept ; skos:inScheme pj:RiskTierScheme ; skos:topConceptOf pj:RiskTierScheme ;
    skos:prefLabel "High"@en ;
    skos:definition "Changes the decision or creates legal or financial exposure if answered wrongly; stricter grounding and breaker thresholds."@en .
pj:tier-M a skos:Concept ; skos:inScheme pj:RiskTierScheme ; skos:topConceptOf pj:RiskTierScheme ;
    skos:prefLabel "Medium"@en .
pj:tier-L a skos:Concept ; skos:inScheme pj:RiskTierScheme ; skos:topConceptOf pj:RiskTierScheme ;
    skos:prefLabel "Low"@en .

pj:JobKindScheme a skos:ConceptScheme ; skos:prefLabel "Job kinds"@en .
pj:kind-ConsumptionChainJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Consumption chain job"@en .
pj:kind-CoreFunctionalJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Core functional job"@en .
pj:kind-RelatedEmotionalRiskJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Related emotional/risk job"@en .
pj:kind-RelatedFinancialJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Related financial job"@en .
pj:kind-RelatedFunctionalJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Related functional job"@en .
pj:kind-RelatedSocialJob a skos:Concept ; skos:inScheme pj:JobKindScheme ; skos:topConceptOf pj:JobKindScheme ;
    skos:prefLabel "Related social job"@en .

pj:BusinessDomainScheme a skos:ConceptScheme ; skos:prefLabel "HR Services & PEO business domains"@en .
pj:dom-WorkforceAdminDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Workforce Administration & Payroll"@en .
pj:dom-BenefitsRetirementDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Employee Benefits & Retirement Sponsorship"@en .
pj:dom-ComplianceRiskDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Government Compliance & Employer Risk Management"@en .
pj:dom-TalentManagementDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Talent Management & Organizational Development"@en .
pj:dom-WorkforceDevelopmentDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Workforce Development, Coaching & Performance Measurement"@en .
pj:dom-ValuesCultureStewardshipDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Organizational Values, Culture & Ethics Stewardship"@en .
pj:dom-HRTechnologyPlatformDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "HR Technology Platform & Employee Experience"@en .
pj:dom-ClientRelationshipDomain a skos:Concept ; skos:inScheme pj:BusinessDomainScheme ; skos:topConceptOf pj:BusinessDomainScheme ;
    skos:prefLabel "Client Relationship & Business Development"@en .

pj:ThemeScheme a skos:ConceptScheme ; skos:prefLabel "Service-line themes"@en .
pj:theme-Payroll a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Payroll"@en ;
    skos:definition "Paying people correctly and on time, meeting payroll tax obligations, and tracking time and leave."@en .
pj:theme-Benefits a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Benefits"@en ;
    skos:definition "Health, welfare and retirement plans: offering them, enrolling people, and keeping plans compliant."@en .
pj:theme-HR-Compliance a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "HR Compliance"@en ;
    skos:definition "Employment law, employee relations risk, workers' compensation and worksite safety."@en .
pj:theme-Talent-Management a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Talent Management"@en ;
    skos:definition "Hiring, onboarding, pay decisions, performance management and succession."@en .
pj:theme-Training a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Training"@en ;
    skos:definition "Skills-gap analysis and delivery of e-learning and instructor-led training."@en .
pj:theme-Coaching a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Coaching"@en ;
    skos:definition "Confidential manager coaching and peer mentoring."@en .
pj:theme-Monitoring a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Monitoring"@en ;
    skos:definition "Continuous check-ins and progress tracking against goals."@en .
pj:theme-Measurement a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Measurement"@en ;
    skos:definition "Workforce analytics, scorecards and evidence that development works."@en .
pj:theme-Values-Stewardship a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "Values Stewardship"@en ;
    skos:definition "Promoting, monitoring and measuring culture and values without violating employee privacy."@en .
pj:theme-PEO-Relationship a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "PEO Relationship"@en ;
    skos:definition "Choosing, moving onto, getting help from and renewing the HR outsourcing partner. Added for the benchmark."@en .
pj:theme-HR-Technology---Data a skos:Concept ; skos:inScheme pj:ThemeScheme ; skos:topConceptOf pj:ThemeScheme ;
    skos:prefLabel "HR Technology & Data"@en ;
    skos:definition "Self-service, administrator tools, identity, integration and data security. Added for the benchmark."@en .

pj:OutcomeMetricScheme a skos:ConceptScheme ; skos:prefLabel "Outcome metric types"@en .
pj:metric-Cost---exposure a skos:Concept ; skos:inScheme pj:OutcomeMetricScheme ; skos:topConceptOf pj:OutcomeMetricScheme ;
    skos:prefLabel "Cost & exposure"@en .
pj:metric-Effort a skos:Concept ; skos:inScheme pj:OutcomeMetricScheme ; skos:topConceptOf pj:OutcomeMetricScheme ;
    skos:prefLabel "Effort"@en .
pj:metric-Output a skos:Concept ; skos:inScheme pj:OutcomeMetricScheme ; skos:topConceptOf pj:OutcomeMetricScheme ;
    skos:prefLabel "Output"@en .
pj:metric-Speed a skos:Concept ; skos:inScheme pj:OutcomeMetricScheme ; skos:topConceptOf pj:OutcomeMetricScheme ;
    skos:prefLabel "Speed"@en .
pj:metric-Stability a skos:Concept ; skos:inScheme pj:OutcomeMetricScheme ; skos:topConceptOf pj:OutcomeMetricScheme ;
    skos:prefLabel "Stability"@en .

pj:ServiceScheme a skos:ConceptScheme ; skos:prefLabel "PEO domain services (Outcome Benchmark)"@en .
pj:svc-GrossToNetPayrollService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Gross-to-Net Payroll Calculation Service"@en ;
    skos:notation "GrossToNetPayrollService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Payroll Processing & Multi-State Tax"@en .
pj:svc-MultiStateTaxFilingService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Multi-Jurisdiction Payroll Tax Filing Service"@en ;
    skos:notation "MultiStateTaxFilingService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Payroll Processing & Multi-State Tax"@en .
