#  Decision questions - HR Specialist
pj:HR-J1.1 pj:hasDecision pj:DEC-HR-J1-1 .
pj:DEC-HR-J1-1 a pj:Decision ; rdfs:label "Which risk areas do we prioritize in the evaluation?"@en ;
    pj:decisionServes pj:DO-HR-J1-1-1, pj:DO-HR-J1-1-2, pj:DO-HR-J1-1-3 ;
    pj:lineageData "Worksites and headcount by state; current HR policies"@en ;
    pj:lineageContent "Compliance map standards (47) and requirements (26); topic taxonomy (30 topics)"@en ;
    pj:lineageKnowledge "peo-es:Standard, peo-es:Requirement, peo-topics"@en ;
    pj:lineageMappings "Worksite → jurisdiction chain (MAP-JUR-01)"@en ;
    pj:lineageTransforms "Applicability check (headcount thresholds); EXT-008 rule binding"@en ;
    pj:lineageResponse "Risk items by topic, each with rule citation and verification status"@en ;
    pj:hasQuestion pj:DQ-HR-1-01, pj:DQ-HR-1-02, pj:DQ-HR-1-03, pj:DQ-HR-1-04 .
pj:DQ-HR-1-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-1-01" ;
    rdfs:label "Where do we carry compliance risk today, by topic and state?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Risk items by topic and jurisdiction with citations"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-1-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-1-02" ;
    rdfs:label "Which of those obligations would the PEO take on, share or leave with us?"@en ;
    pj:questionType pj:qt-ALLOC ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Per obligation: owner after the move"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-1-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-1-03" ;
    rdfs:label "Which rule changes in our states take effect in the next 12 months?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Changes with effective dates and status"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-1-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-1-04" ;
    rdfs:label "What penalties or exposure apply to each risk item?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Penalty ranges with citations"@en ; pj:askedBy pj:persona-HR .
pj:HR-J1.2 pj:hasDecision pj:DEC-HR-J1-2 .
pj:DEC-HR-J1-2 a pj:Decision ; rdfs:label "Order a gap assessment · Subscribe to state updates · Hand off to the Client Admin"@en ;
    pj:decisionServes pj:DO-HR-J1-2-1, pj:DO-HR-J1-2-2, pj:DO-HR-J1-2-3 ;
    pj:lineageData "Employee work locations incl. remote; GOV-007 identity registry"@en ;
    pj:lineageContent "Regulatory feed items (e.g. Colorado change, Candidate); state checklists"@en ;
    pj:lineageKnowledge "isp-core:Jurisdiction, TAL-005 and state rules"@en ;
    pj:lineageMappings "Remote employee address → jurisdiction (MAP-JUR-02, gap)"@en ;
    pj:lineageTransforms "GOV-007 resolution; EXT-008 binding; applicability thresholds"@en ;
    pj:lineageResponse "Jurisdiction per employee group; coverage verdict per state; gaps named"@en ;
    pj:hasQuestion pj:DQ-HR-2-01, pj:DQ-HR-2-02, pj:DQ-HR-2-03, pj:DQ-HR-2-04 .
pj:DQ-HR-2-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-2-01" ;
    rdfs:label "Which states and localities do our employees work in, including remote staff, and which jurisdiction governs each?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Employee group → jurisdiction table"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-2-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-2-02" ;
    rdfs:label "Does the PEO cover every one of those jurisdictions today?"@en ;
    pj:questionType pj:qt-ELIG ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Covered yes/no per jurisdiction with source"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-2-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-2-03" ;
    rdfs:label "Which state rules change our obligations at our headcount?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Rules with thresholds and citations"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-2-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-2-04" ;
    rdfs:label "Which coverage gaps would remain our responsibility?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Gaps with owner and remedy"@en ; pj:askedBy pj:persona-HR .
pj:HR-J1.3 pj:hasDecision pj:DEC-HR-J1-3 .
pj:DEC-HR-J1-3 a pj:Decision ; rdfs:label "Which plan line-up do we propose to employees?"@en ;
    pj:decisionServes pj:DO-HR-J1-3-1, pj:DO-HR-J1-3-2, pj:DO-HR-J1-3-3 ;
    pj:lineageData "Current plan elections; census; carrier networks"@en ;
    pj:lineageContent "Plan comparison v14 (2 claims Candidate); carrier summaries of benefits"@en ;
    pj:lineageKnowledge "isp-sal:BenefitPlan, hr:ConceptLargeGroupPoolTier"@en ;
    pj:lineageMappings "Carrier plan fields → isp-sal:BenefitPlan (MAP-BEN-02)"@en ;
    pj:lineageTransforms "Per-paycheck contribution calc; network match; EXT-005 validity"@en ;
    pj:lineageResponse "Plan-by-plan comparison; per-employee cost change; Candidate items labelled"@en ;
    pj:hasQuestion pj:DQ-HR-3-01, pj:DQ-HR-3-02, pj:DQ-HR-3-03, pj:DQ-HR-3-04 .
pj:DQ-HR-3-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-3-01" ;
    rdfs:label "How do the PEO plans compare with ours on premiums, deductibles and employee contributions?"@en ;
    pj:questionType pj:qt-COMP ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Plan-by-plan table with citations"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-3-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-3-02" ;
    rdfs:label "How does each employee’s per-paycheck cost change?"@en ;
    pj:questionType pj:qt-SCEN ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Per employee or tier: before, after, difference"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-3-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-3-03" ;
    rdfs:label "Are employees’ current doctors and facilities in network?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Share in network, list of disruptions"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-3-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-3-04" ;
    rdfs:label "Which elections are limited by waiting periods or carrier rules?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Limits with rule and dates"@en ; pj:askedBy pj:persona-HR .
pj:HR-J1.4 pj:hasDecision pj:DEC-HR-J1-4 .
pj:DEC-HR-J1-4 a pj:Decision ; rdfs:label "Adopt PEO policy or keep a local addendum, policy by policy"@en ;
    pj:decisionServes pj:DO-HR-J1-4-1, pj:DO-HR-J1-4-2, pj:DO-HR-J1-4-3 ;
    pj:lineageData "Prospect handbook (often scanned PDF)"@en ;
    pj:lineageContent "PEO policy library; state addenda"@en ;
    pj:lineageKnowledge "isp-core:Policy, peo-topics"@en ;
    pj:lineageMappings "Handbook sections → isp-core:Policy (OCR + MAP-POL-01)"@en ;
    pj:lineageTransforms "OCR; EXT-002 confidence floor; conflict detection rules"@en ;
    pj:lineageResponse "Mapped, unmapped and conflicting policies, each with source page"@en ;
    pj:hasQuestion pj:DQ-HR-4-01, pj:DQ-HR-4-02, pj:DQ-HR-4-03, pj:DQ-HR-4-04 .
pj:DQ-HR-4-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-4-01" ;
    rdfs:label "Which of our handbook policies map to PEO policies, and which have no match?"@en ;
    pj:questionType pj:qt-FACT ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Mapping table with confidence"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-4-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-4-02" ;
    rdfs:label "Where do our policies conflict with PEO policy or state law?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Conflicts with both texts cited"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-4-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-4-03" ;
    rdfs:label "Which local policies can we keep as addenda?"@en ;
    pj:questionType pj:qt-ELIG ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Allowed addenda with conditions"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-4-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-4-04" ;
    rdfs:label "Which employee notices and acknowledgements do the changes require?"@en ;
    pj:questionType pj:qt-PROC ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Notices with deadlines and jurisdictions"@en ; pj:askedBy pj:persona-HR .
pj:HR-J1.5 pj:hasDecision pj:DEC-HR-J1-5 .
pj:DEC-HR-J1-5 a pj:Decision ; rdfs:label "Attach the risk brief and recommend · Recommend with conditions · Recommend against"@en ;
    pj:decisionServes pj:DO-HR-J1-5-1, pj:DO-HR-J1-5-2, pj:DO-HR-J1-5-3 ;
    pj:lineageData "Gap assessment results; decision records"@en ;
    pj:lineageContent "Risk brief template; compliance map"@en ;
    pj:lineageKnowledge "isp-dec:RiskItem, peo-es:Requirement"@en ;
    pj:lineageMappings "Gap findings → isp-dec:RiskItem (MAP-RSK-01)"@en ;
    pj:lineageTransforms "Penalty quantification; EXT-013; EXT-014"@en ;
    pj:lineageResponse "Risk removed and added, quantified, open items labelled"@en ;
    pj:hasQuestion pj:DQ-HR-5-01, pj:DQ-HR-5-02, pj:DQ-HR-5-03, pj:DQ-HR-5-04 .
pj:DQ-HR-5-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-5-01" ;
    rdfs:label "What risk does the move remove, in penalties avoided or exposure reduced?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Quantified risk items with citations"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-5-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-5-02" ;
    rdfs:label "What new risks or dependencies does it introduce?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "New risks with owner and mitigation"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-5-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-5-03" ;
    rdfs:label "Which risk items are still unassessed or waiting for a rule owner?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Open items with owner and due date"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-5-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-5-04" ;
    rdfs:label "How does the recommendation change if we grow or enter a new state?"@en ;
    pj:questionType pj:qt-SCEN ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Changes by scenario"@en ; pj:askedBy pj:persona-HR .
pj:HR-J1.6 pj:hasDecision pj:DEC-HR-J1-6 .
pj:DEC-HR-J1-6 a pj:Decision ; rdfs:label "Confirm the enrollment calendar · Extend enrollment · Verify carrier lead times"@en ;
    pj:decisionServes pj:DO-HR-J1-6-1, pj:DO-HR-J1-6-2, pj:DO-HR-J1-6-3 ;
    pj:lineageData "Enrollment system; carrier EDI 834 calendar; leave and PTO balances"@en ;
    pj:lineageContent "Enrollment playbook; carrier lead-time table (not yet in graph)"@en ;
    pj:lineageKnowledge "isp-core:EnrollmentWindow, isp-core:Coverage"@en ;
    pj:lineageMappings "Carrier calendars → isp-core:EnrollmentWindow (MAP-EDI-01, to build)"@en ;
    pj:lineageTransforms "834 schedule calc; balance conversion; leave rule checks"@en ;
    pj:lineageResponse "Window that guarantees continuity; employees needing special handling"@en ;
    pj:hasQuestion pj:DQ-HR-6-01, pj:DQ-HR-6-02, pj:DQ-HR-6-03, pj:DQ-HR-6-04 .
pj:DQ-HR-6-01 a pj:DecisionQuestion ; skos:notation "DQ-HR-6-01" ;
    rdfs:label "Which enrollment window guarantees no coverage gap, given carrier file lead times?"@en ;
    pj:questionType pj:qt-SCEN ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Window dates with carrier deadlines"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-6-02 a pj:DecisionQuestion ; skos:notation "DQ-HR-6-02" ;
    rdfs:label "How are leave and PTO balances, I-9s and personnel files carried over?"@en ;
    pj:questionType pj:qt-PROC ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Per record type: method, owner, date"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-6-03 a pj:DecisionQuestion ; skos:notation "DQ-HR-6-03" ;
    rdfs:label "Which employees need special handling (on leave, COBRA, hired during the transition)?"@en ;
    pj:questionType pj:qt-RISK ; pj:riskTier pj:tier-H ;
    pj:expectedAnswerShape "Employee groups with actions"@en ; pj:askedBy pj:persona-HR .
pj:DQ-HR-6-04 a pj:DecisionQuestion ; skos:notation "DQ-HR-6-04" ;
    rdfs:label "What goes to employees, in which languages, and when?"@en ;
    pj:questionType pj:qt-PROC ; pj:riskTier pj:tier-M ;
    pj:expectedAnswerShape "Communication calendar"@en ; pj:askedBy pj:persona-HR .

#################################################################
#  Study 2 - PEO Outcome Benchmark (client side)
#################################################################
pj:JS-BENCH a pj:JobStudy ; skos:notation "JS-BENCH" ; rdfs:label "PEO Outcome Benchmark"@en ;
    pj:scope "Client personas at 5-150 employee companies; jobs they hire an HR partner to get done, on the universal eight-step job map. Outcomes are the survey items rated for importance and satisfaction."@en ;
    pj:includesJob pj:J01, pj:J02, pj:J03, pj:J04, pj:J05, pj:J06, pj:J07, pj:J08, pj:J09, pj:J10, pj:J11, pj:J12, pj:J13, pj:J14, pj:J15, pj:J16, pj:J17, pj:J18, pj:J19, pj:J20, pj:J21, pj:J22, pj:C1, pj:C2, pj:C3, pj:C4 .

pj:persona-P1 a pj:Persona ; skos:notation "P1" ;
    rdfs:label "Business Owner / CEO"@en ; skos:altLabel "Owner"@en ;
    pj:typicalTitles "Founder, CEO, President, Managing Partner"@en ;
    pj:context "Runs a 5–150 employee company; often the final HR decision-maker; HR is a distraction from growing the business."@en ;
    pj:buyingRole "Economic buyer — signs the agreement and owns the cost/value decision"@en ;
    pj:goal "Grow the business without becoming an expert in employment law, insurance and payroll tax."@en ;
    pj:emotionalJob "Feel confident the company is not exposed to a lawsuit or penalty it doesn't know about"@en ,
        "Feel able to compete with larger employers for talent"@en ,
        "Be seen by employees as an employer that takes care of its people"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P2 a pj:Persona ; skos:notation "P2" ;
    rdfs:label "Finance Leader"@en ; skos:altLabel "Finance"@en ;
    pj:typicalTitles "CFO, Controller, Office / Finance Manager who runs payroll"@en ;
    pj:context "Owns payroll funding, tax deposits, GL posting and the HR provider invoice; frequently also the payroll processor in smaller firms."@en ;
    pj:buyingRole "Evaluator and gatekeeper on total cost; often the day-to-day payroll user"@en ;
    pj:goal "Keep employer costs predictable and the books accurate with minimal manual reconciliation."@en ;
    pj:emotionalJob "Avoid the embarrassment of a missed or wrong payroll"@en ,
        "Feel in control of every dollar of employer cost"@en ,
        "Be seen by the owner as a trusted steward of company money"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P3 a pj:Persona ; skos:notation "P3" ;
    rdfs:label "HR Leader"@en ; skos:altLabel "HR"@en ;
    pj:typicalTitles "HR Manager, HR Generalist, People Operations lead (often a team of one)"@en ;
    pj:context "Covers every HR discipline at once — benefits, compliance, hiring, employee relations — with little specialist support."@en ;
    pj:buyingRole "Primary evaluator and daily user; champions or blocks the provider"@en ;
    pj:goal "Run reliable HR operations and spend more time on people strategy than on paperwork."@en ;
    pj:emotionalJob "Feel confident in giving advice on issues outside their expertise"@en ,
        "Avoid being blamed for a compliance miss"@en ,
        "Be seen as a strategic partner rather than an administrator"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P4 a pj:Persona ; skos:notation "P4" ;
    rdfs:label "Operations & Safety Leader"@en ; skos:altLabel "Ops/Safety"@en ;
    pj:typicalTitles "Operations Manager, Safety Manager, Site Superintendent"@en ;
    pj:context "Responsible for field or industrial worksites (construction, manufacturing, logistics, trades) where injury risk and workers' comp cost are material."@en ;
    pj:buyingRole "Influencer on risk and safety services; user of injury and safety workflows"@en ;
    pj:goal "Keep crews safe and productive and keep insurance cost under control."@en ;
    pj:emotionalJob "Feel that no one will be seriously hurt on their watch"@en ,
        "Be seen by crews as someone who has their back after an injury"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P5 a pj:Persona ; skos:notation "P5" ;
    rdfs:label "People Manager"@en ; skos:altLabel "Manager"@en ;
    pj:typicalTitles "Supervisor, Team Lead, Department Manager"@en ;
    pj:context "Approves time, hires, coaches and evaluates a team; usually promoted for technical skill with little leadership training."@en ;
    pj:buyingRole "User and influencer; their experience drives employee adoption"@en ;
    pj:goal "Build a capable, engaged team and handle people issues well."@en ;
    pj:emotionalJob "Feel competent handling difficult people conversations"@en ,
        "Be seen by their team as fair and supportive"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P6 a pj:Persona ; skos:notation "P6" ;
    rdfs:label "Worksite Employee"@en ; skos:altLabel "Employee"@en ;
    pj:typicalTitles "Any employee of the client company"@en ;
    pj:context "Experiences the PEO through pay, benefits, self-service and HR answers; never chose the provider."@en ;
    pj:buyingRole "End user; satisfaction affects client retention and renewal"@en ;
    pj:goal "Get paid correctly, understand and use benefits, and get HR tasks done without friction."@en ;
    pj:emotionalJob "Feel financially secure and protected by good benefits"@en ,
        "Feel respected and that personal data is handled with care"@en ;
    pj:hasJobStudy pj:JS-BENCH .
pj:persona-P7 a pj:Persona ; skos:notation "P7" ;
    rdfs:label "IT & Systems Administrator"@en ; skos:altLabel "IT"@en ;
    pj:typicalTitles "IT Manager, Systems Administrator, outsourced MSP"@en ;
    pj:context "Connects HR and payroll data to accounting, scheduling and identity systems; responsible for access and security."@en ;
    pj:buyingRole "Technical evaluator; can veto on security or integration grounds"@en ;
    pj:goal "Keep employee data flowing between systems accurately and securely with little maintenance."@en ;
    pj:emotionalJob "Avoid being responsible for a data breach involving employee records"@en ;
    pj:hasJobStudy pj:JS-BENCH .

#  Proposed alignment between the two persona sets (for steward review)
pj:persona-CA skos:closeMatch pj:persona-P1 , pj:persona-P2 .
pj:persona-HR skos:closeMatch pj:persona-P3 .

pj:persona-P2 pj:executesJob pj:J01 .
pj:persona-P3 pj:participatesInJob pj:J01 .
pj:persona-P1 pj:participatesInJob pj:J01 .
pj:J01 a pj:Job ; skos:notation "J01" ; rdfs:label "Pay employees accurately and on time"@en ;
    pj:statement "Pay employees accurately and on time"@en ; pj:jobKind pj:kind-CoreFunctionalJob ;
    pj:inDomain pj:dom-WorkforceAdminDomain ;
    pj:supportedBy pj:svc-DirectDepositOffCycleService, pj:svc-EmployeeSelfServicePortalService, pj:svc-GrossToNetPayrollService, pj:svc-LaborAllocationCostingService, pj:svc-TimesheetApprovalStagingService, pj:svc-WageGarnishmentService ;
    pj:hasStep pj:J01-DEF, pj:J01-LOC, pj:J01-PRE, pj:J01-CON, pj:J01-EXE, pj:J01-MON, pj:J01-MOD, pj:J01-CONC .
pj:J01-DEF a pj:JobStep ; skos:notation "J01-DEF" ;
    rdfs:label "Define: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-DEF ;
    pj:hasDesiredOutcome pj:O001 .
pj:O001 a pj:DesiredOutcome ; skos:notation "O001" ;
    pj:statement "Minimize the time required to determine which pay rules apply to each employee, e.g., overtime, shift differentials, bonuses"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-GrossToNetPayrollService .
pj:J01-LOC a pj:JobStep ; skos:notation "J01-LOC" ;
    rdfs:label "Locate: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-LOC ;
    pj:hasDesiredOutcome pj:O002 .
pj:O002 a pj:DesiredOutcome ; skos:notation "O002" ;
    pj:statement "Minimize the time required to gather all hours, earnings changes and deductions for a pay period"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-TimesheetApprovalStagingService .
pj:J01-PRE a pj:JobStep ; skos:notation "J01-PRE" ;
    rdfs:label "Prepare: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-PRE ;
    pj:hasDesiredOutcome pj:O003 .
pj:O003 a pj:DesiredOutcome ; skos:notation "O003" ;
    pj:statement "Minimize the likelihood that a pay change, e.g., a raise, new hire or termination, is missed before payroll is run"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Stability ;
    pj:supportedBy pj:svc-GrossToNetPayrollService .
pj:J01-CON a pj:JobStep ; skos:notation "J01-CON" ;
    rdfs:label "Confirm: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-CON ;
    pj:hasDesiredOutcome pj:O004, pj:O005 .
pj:O004 a pj:DesiredOutcome ; skos:notation "O004" ;
    pj:statement "Minimize the time required to confirm that pay calculations are correct before funds are released"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-GrossToNetPayrollService .
pj:O005 a pj:DesiredOutcome ; skos:notation "O005" ;
    pj:statement "Minimize the likelihood of miscalculating overtime under federal and state rules"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Stability ;
    pj:supportedBy pj:svc-GrossToNetPayrollService .
pj:J01-EXE a pj:JobStep ; skos:notation "J01-EXE" ;
    rdfs:label "Execute: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-EXE ;
    pj:hasDesiredOutcome pj:O006, pj:O007 .
pj:O006 a pj:DesiredOutcome ; skos:notation "O006" ;
    pj:statement "Minimize the likelihood that an employee is paid late, e.g., due to a missed funding deadline or bank cutoff"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Stability ;
    pj:supportedBy pj:svc-DirectDepositOffCycleService .
pj:O007 a pj:DesiredOutcome ; skos:notation "O007" ;
    pj:statement "Minimize the likelihood of withholding a garnishment incorrectly or in the wrong priority order"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Stability ;
    pj:supportedBy pj:svc-WageGarnishmentService .
pj:J01-MON a pj:JobStep ; skos:notation "J01-MON" ;
    rdfs:label "Monitor: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-MON ;
    pj:hasDesiredOutcome pj:O008 .
pj:O008 a pj:DesiredOutcome ; skos:notation "O008" ;
    pj:statement "Minimize the number of pay-related questions employees raise after each payroll"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Output ;
    pj:supportedBy pj:svc-GrossToNetPayrollService, pj:svc-EmployeeSelfServicePortalService .
pj:J01-MOD a pj:JobStep ; skos:notation "J01-MOD" ;
    rdfs:label "Modify: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-MOD ;
    pj:hasDesiredOutcome pj:O009 .
pj:O009 a pj:DesiredOutcome ; skos:notation "O009" ;
    pj:statement "Minimize the time required to issue a correct off-cycle payment when an error or termination requires one"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-DirectDepositOffCycleService .
pj:J01-CONC a pj:JobStep ; skos:notation "J01-CONC" ;
    rdfs:label "Conclude: Pay employees accurately and on time"@en ; pj:onJobMapStep pj:step-CONC ;
    pj:hasDesiredOutcome pj:O010 .
pj:O010 a pj:DesiredOutcome ; skos:notation "O010" ;
    pj:statement "Minimize the time required to reconcile payroll to the bank account and general ledger after each run"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-LaborAllocationCostingService .

pj:persona-P2 pj:executesJob pj:J02 .
pj:persona-P1 pj:participatesInJob pj:J02 .
pj:J02 a pj:Job ; skos:notation "J02" ; rdfs:label "Meet payroll tax obligations in every jurisdiction where employees work"@en ;
    pj:statement "Meet payroll tax obligations in every jurisdiction where employees work"@en ; pj:jobKind pj:kind-CoreFunctionalJob ;
    pj:inDomain pj:dom-WorkforceAdminDomain, pj:dom-ComplianceRiskDomain ;
    pj:supportedBy pj:svc-CPEOComplianceMonitoringService, pj:svc-MultiStateTaxFilingService, pj:svc-YearEndTaxDocService ;
    pj:hasStep pj:J02-DEF, pj:J02-PRE, pj:J02-EXE, pj:J02-MON, pj:J02-MOD, pj:J02-CONC .
pj:J02-DEF a pj:JobStep ; skos:notation "J02-DEF" ;
    rdfs:label "Define: Meet payroll tax obligations in every jurisdiction where employees work"@en ; pj:onJobMapStep pj:step-DEF ;
    pj:hasDesiredOutcome pj:O011 .
pj:O011 a pj:DesiredOutcome ; skos:notation "O011" ;
    pj:statement "Minimize the time required to determine tax registration and withholding requirements when an employee starts working in a new state or locality"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Speed ;
    pj:supportedBy pj:svc-MultiStateTaxFilingService .
pj:J02-PRE a pj:JobStep ; skos:notation "J02-PRE" ;
    rdfs:label "Prepare: Meet payroll tax obligations in every jurisdiction where employees work"@en ; pj:onJobMapStep pj:step-PRE ;
    pj:hasDesiredOutcome pj:O012 .
pj:O012 a pj:DesiredOutcome ; skos:notation "O012" ;
    pj:statement "Minimize the likelihood of setting up a state or local tax account incorrectly"@en ;
    pj:direction "Minimize" ;
    pj:theme pj:theme-Payroll ; pj:outcomeMetricType pj:metric-Stability ;
    pj:supportedBy pj:svc-MultiStateTaxFilingService .
