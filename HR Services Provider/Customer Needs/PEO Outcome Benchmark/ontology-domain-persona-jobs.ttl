pj:svc-TimesheetApprovalStagingService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Timesheet Approval & Payroll Staging Service"@en ;
    skos:notation "TimesheetApprovalStagingService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Time, Attendance & Leave Management"@en .
pj:svc-CustomPTOAccrualService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Custom PTO Accrual & Balance Ledger Service"@en ;
    skos:notation "CustomPTOAccrualService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Time, Attendance & Leave Management"@en .
pj:svc-StatutoryLeaveFMLAService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Statutory Leave & FMLA Administration Service"@en ;
    skos:notation "StatutoryLeaveFMLAService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Time, Attendance & Leave Management"@en .
pj:svc-LaborAllocationCostingService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Labor Allocation & Job Costing Service"@en ;
    skos:notation "LaborAllocationCostingService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Time, Attendance & Leave Management"@en .
pj:svc-PEOMasterHealthPlanService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "PEO Master Health Plan Administration Service"@en ;
    skos:notation "PEOMasterHealthPlanService" ; pj:inDomain pj:dom-BenefitsRetirementDomain ; pj:theme pj:theme-Benefits ;
    rdfs:comment "Subdomain: Group Health & Welfare Plan Sponsorship"@en .
pj:svc-OpenEnrollmentLifeEventService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Open Enrollment & Life Event Election Service"@en ;
    skos:notation "OpenEnrollmentLifeEventService" ; pj:inDomain pj:dom-BenefitsRetirementDomain ; pj:theme pj:theme-Benefits ;
