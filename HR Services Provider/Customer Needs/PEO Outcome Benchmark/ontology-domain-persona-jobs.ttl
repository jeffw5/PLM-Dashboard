pj:persona-HR a pj:Persona ; skos:notation "HR" ;
    rdfs:label "HR Specialist"@en ;
    skos:definition "isp-sal:HRSpecialist rdfs:subClassOf PersonaType. A buyer-side persona who owns compliance, benefits and policy for a PEO prospect."@en ;
    pj:context "HR Specialist (HR generalist or HR lead at the prospect). Owns compliance, benefits and policy, and has to live with the change. Their jobs across the sales pipeline:DiscoverFind where we carry compliance risk todayQualifyCheck coverage for every state we hire inEvaluateCompare benefit plans employees will seeProposeMap our handbook to PEO policyDecideShow leadership the risk we removeOnboardRe-enroll employees with no coverage gap"@en ;
    pj:hasJobStudy pj:JS-HR .
pj:JordanEllis a pj:PersonaInstance ; rdfs:label "Jordan Ellis"@en ; pj:instanceOf pj:persona-HR ;
    rdfs:comment "Fictitious scenario persona. HR Specialist — a one-person HR team at a 96-person engineering firm hiring across Colorado, California, Texas and fully remote, who carries the compliance risk today and has to live with whatever the PEO changes for employees."@en ;
    pj:context "HR Lead at Summit Ridge Engineering: 96 employees, civil and structural engineering. Prospect in the advisor’s first HR Specialist scenario."@en ;
    skos:notation "isp-sal:persona/hr-specialist/summit-ridge-001" .
pj:JS-HR a pj:JobStudy ; skos:notation "JS-HR" ; rdfs:label "HR Specialist job study: keeping people compliant and covered through a PEO move (prospect side)"@en ;
    pj:scope "HR generalists or HR leads at prospects with 5–150 employees; jobs performed from the first risk question to the first PEO benefits month."@en ;
    pj:includesJob pj:HR-J1, pj:HR-J2, pj:HR-J3 .

pj:HR-J1 a pj:Job ; skos:notation "HR-J1" ; rdfs:label "Make sure the move to a PEO leaves us compliant and our people covered"@en ;
    pj:statement "Confirm, before and through the switch, that every compliance obligation is met and no employee loses coverage."@en ; pj:jobKind pj:kind-CoreFunctionalJob ;
    pj:hasStep pj:HR-J1.1, pj:HR-J1.2, pj:HR-J1.3, pj:HR-J1.4, pj:HR-J1.5, pj:HR-J1.6 .
pj:persona-HR pj:performsJob pj:HR-J1 .
pj:HR-J1.1 a pj:JobStep ; skos:notation "HR-J1.1" ; rdfs:label "Find where we carry compliance risk today"@en ;
    pj:inStage pj:stage-Discover ; pj:advisorService "Risk discovery brief (HR template)"@en ;
    pj:hasDesiredOutcome pj:DO-HR-J1-1-1, pj:DO-HR-J1-1-2, pj:DO-HR-J1-1-3 .
pj:DO-HR-J1-1-1 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-1-1" ;
    pj:statement "Minimize the time it takes to see where we carry compliance risk"@en ;
    pj:direction "Minimize" ;
    pj:unit "minutes to useful answer"@en ; pj:target "15"^^xsd:decimal ; pj:baseline "12"^^xsd:decimal ;
    pj:metricCard "time-to-useful-answer v1.0" ; pj:measurementSource "Advisor telemetry"@en .
pj:DO-HR-J1-1-2 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-1-2" ;
    pj:statement "Maximize the share of risk items that cite a rule or regulator"@en ;
    pj:direction "Maximize" ;
    pj:unit "% cited"@en ; pj:target "100"^^xsd:decimal ;
    pj:metricCard "risk-citation v1.0" ; pj:measurementSource "Brief audit (EXT-013)"@en .
pj:DO-HR-J1-1-3 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-1-3" ;
    pj:statement "Minimize the likelihood of missing a risk area (I-9, leave, postings, wage and hour)"@en ;
    pj:direction "Minimize" ;
    pj:unit "areas missed and found later"@en ; pj:target "0"^^xsd:decimal ;
    pj:metricCard "risk-completeness v1.0" ; pj:measurementSource "Gap assessment"@en .
pj:HR-J1.2 a pj:JobStep ; skos:notation "HR-J1.2" ; rdfs:label "Check coverage for every state we hire in"@en ;
    pj:inStage pj:stage-Qualify ; pj:advisorService "State coverage check (SSOT rules by jurisdiction)"@en ;
    pj:hasDesiredOutcome pj:DO-HR-J1-2-1, pj:DO-HR-J1-2-2, pj:DO-HR-J1-2-3 .
pj:DO-HR-J1-2-1 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-2-1" ;
    pj:statement "Maximize the share of hiring states assessed"@en ;
    pj:direction "Maximize" ;
    pj:unit "% of states"@en ; pj:target "100"^^xsd:decimal ; pj:baseline "88"^^xsd:decimal ;
    pj:metricCard "coverage-assessed v1.0" ; pj:measurementSource "Advisor telemetry"@en .
pj:DO-HR-J1-2-2 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-2-2" ;
    pj:statement "Minimize the time it takes to resolve a remote employee’s jurisdiction"@en ;
    pj:direction "Minimize" ;
    pj:unit "days"@en ; pj:target "2"^^xsd:decimal ;
    pj:metricCard "remote-jurisdiction v1.0" ; pj:measurementSource "GOV-007 registry"@en .
pj:DO-HR-J1-2-3 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-2-3" ;
    pj:statement "Minimize the time it takes to learn of a rule change in a hiring state"@en ;
    pj:direction "Minimize" ;
    pj:unit "days"@en ; pj:target "7"^^xsd:decimal ;
    pj:metricCard "reg-latency v1.0" ; pj:measurementSource "Regulatory feed + alerts"@en .
pj:HR-J1.3 a pj:JobStep ; skos:notation "HR-J1.3" ; rdfs:label "Compare benefit plans employees will see"@en ;
    pj:inStage pj:stage-Evaluate ; pj:advisorService "Plan comparison brief (v14)"@en ;
    pj:hasDesiredOutcome pj:DO-HR-J1-3-1, pj:DO-HR-J1-3-2, pj:DO-HR-J1-3-3 .
pj:DO-HR-J1-3-1 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-3-1" ;
    pj:statement "Minimize the time it takes to compare current plans with PEO plans"@en ;
    pj:direction "Minimize" ;
    pj:unit "minutes"@en ; pj:target "20"^^xsd:decimal ; pj:baseline "34"^^xsd:decimal ;
    pj:metricCard "plan-compare-time v1.0" ; pj:measurementSource "Advisor telemetry"@en .
pj:DO-HR-J1-3-2 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-3-2" ;
    pj:statement "Maximize the share of employees whose per-paycheck cost change is shown"@en ;
