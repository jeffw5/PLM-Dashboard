pj:svc-TimeCapturePunchService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Time Capture & Punch Ingestion Service"@en ;
    skos:notation "TimeCapturePunchService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
