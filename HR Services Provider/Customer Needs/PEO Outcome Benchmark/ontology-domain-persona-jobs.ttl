    pj:unit "% of employees"@en ; pj:target "100"^^xsd:decimal ;
    pj:metricCard "paycheck-impact v1.0" ; pj:measurementSource "Brief audit"@en .
pj:DO-HR-J1-3-3 a pj:DesiredOutcome ; skos:notation "DO-HR-J1-3-3" ;
    pj:statement "Minimize the share of employees whose current doctors fall out of network"@en ;
