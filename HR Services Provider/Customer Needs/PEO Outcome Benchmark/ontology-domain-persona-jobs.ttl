    skos:notation "DirectDepositOffCycleService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
    rdfs:comment "Subdomain: Payroll Processing & Multi-State Tax"@en .
pj:svc-YearEndTaxDocService a skos:Concept ; skos:inScheme pj:ServiceScheme ; skos:prefLabel "Year-End Tax Document (W-2 / 1099) Service"@en ;
    skos:notation "YearEndTaxDocService" ; pj:inDomain pj:dom-WorkforceAdminDomain ; pj:theme pj:theme-Payroll ;
