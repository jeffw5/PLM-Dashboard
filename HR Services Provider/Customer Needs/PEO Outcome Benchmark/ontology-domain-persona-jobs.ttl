#################################################################
#  Study 1 - Sales journey (prospect side)
#################################################################
pj:persona-CA a pj:Persona ; skos:notation "CA" ;
    rdfs:label "Client Admin"@en ;
    skos:definition "isp-sal:ClientAdmin rdfs:subClassOf PersonaType. A buyer-side persona who owns cost, contract and payroll cut-over for a PEO prospect."@en ;
    pj:context "Client Admin (owner, controller or office manager at a prospect with 5–150 employees). Owns cost, payroll cut-over and the contract. Her jobs across the sales pipeline:DiscoverUnderstand what a PEO takes off my plateQualifyConfirm we fit (size, industry, states)EvaluateCompare total cost against our current stackProposeSee the co-employment split before signingDecideGet sign-off from owners and financeOnboardMove payroll without a missed paycheck"@en ;
    pj:hasJobStudy pj:JS-CA .
pj:MarisolReyes a pj:PersonaInstance ; rdfs:label "Marisol Reyes"@en ; pj:instanceOf pj:persona-CA ;
    rdfs:comment "Fictitious scenario persona. Client Admin — the controller who owns cost, the contract and payroll cut-over at a 121-person logistics company, deciding whether a PEO is cheaper and safer than running payroll in-house, buying benefits through a broker and carrying a standalone workers’ comp policy."@en ;
    pj:context "Controller and office manager at Harbor Point Logistics: 121 employees, freight brokerage and warehousing. Prospect in the advisor’s first Client Admin scenario."@en ;
    skos:notation "isp-sal:persona/client-admin/harbor-point-001" .
pj:JS-CA a pj:JobStudy ; skos:notation "JS-CA" ; rdfs:label "Client Admin job study: buying and adopting a PEO (prospect side)"@en ;
    pj:scope "Prospect companies with 5–150 employees evaluating a PEO; jobs the Client Admin performs from first enquiry to first PEO payroll."@en ;
    pj:includesJob pj:CA-J1, pj:CA-J2, pj:CA-J3 .

pj:CA-J1 a pj:Job ; skos:notation "CA-J1" ; rdfs:label "Decide whether a PEO is the right way to run HR for our company"@en ;
    pj:statement "Decide, with evidence the owners will accept, whether moving HR, payroll and benefits to a PEO lowers our cost and risk."@en ; pj:jobKind pj:kind-CoreFunctionalJob ;
    pj:hasStep pj:CA-J1.1, pj:CA-J1.2, pj:CA-J1.3, pj:CA-J1.4, pj:CA-J1.5, pj:CA-J1.6 .
pj:persona-CA pj:performsJob pj:CA-J1 .
pj:CA-J1.1 a pj:JobStep ; skos:notation "CA-J1.1" ; rdfs:label "Understand what a PEO takes off my plate"@en ;
