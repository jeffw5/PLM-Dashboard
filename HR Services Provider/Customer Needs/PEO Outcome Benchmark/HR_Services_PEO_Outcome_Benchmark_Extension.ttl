# --- SHACL: every desired outcome is well-formed and traceable ---
hr:DesiredOutcomeShape a sh:NodeShape ;
    sh:targetClass hr:DesiredOutcome ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^(Minimize|Increase) the " ;
                  sh:message "Outcome statements start with a direction (Minimize/Increase) and a metric." ] ;
    sh:property [ sh:path hr:isOutcomeOfJob ; sh:class hr:JobToBeDone ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hr:atJobStep ; sh:class hr:JobStep ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hr:addressedByService ; sh:class hr:DomainService ; sh:minCount 1 ;
                  sh:message "Every outcome must trace to at least one domain service." ] ;
    sh:property [ sh:path hr:benchmarkTheme ; sh:class hr:ServiceLine ; sh:minCount 1 ; sh:maxCount 1 ] .

hr:JobToBeDoneShape a sh:NodeShape ;
    sh:targetClass hr:JobToBeDone ;
    sh:property [ sh:path hr:executedByPersona ; sh:class hr:ClientPersona ; sh:minCount 1 ] ;
    sh:property [ sh:path hr:hasDesiredOutcome ; sh:minCount 5 ] .
