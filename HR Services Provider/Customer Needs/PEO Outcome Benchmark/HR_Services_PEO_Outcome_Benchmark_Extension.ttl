@prefix hr:   <http://example.org/hrservices/ddd#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# #################################################################
#   EXTENSION v3.0 — OUTCOME-DRIVEN BENCHMARK (CUSTOMER JOBS LAYER)
#
#   Adds the client's side of the PEO business model: who the client
#   personas are, the jobs they are trying to get done, the universal
#   job-map steps, and the desired outcomes (customer success metrics)
#   that the benchmark survey will rate for importance and satisfaction.
#   Every desired outcome is linked to the hr:DomainService(s) that
#   address it, and to a benchmark theme (hr:ServiceLine).
#
#   Additive only: nothing in v1 or v2.0 is changed.
# #################################################################

hr:OutcomeBenchmarkExtension a owl:Ontology ;
    rdfs:label "PEO Outcome-Driven Benchmark Extension" ;
    owl:imports hr:HRServicesEnterpriseModel ;
    owl:versionInfo "3.0" .

# --- Classes ---
hr:ClientPersona a owl:Class ;
    rdfs:label "Client Persona (Job Executor)" ;
    rdfs:comment "A role at or within a client company that executes, or takes part in, a job the PEO helps get done." .

hr:JobToBeDone a owl:Class ;
    rdfs:label "Job To Be Done" ;
    rdfs:comment "A solution-agnostic goal a client persona is trying to accomplish." .

hr:CoreFunctionalJob a owl:Class ;
    rdfs:subClassOf hr:JobToBeDone ;
    rdfs:label "Core Functional Job" .

hr:ConsumptionChainJob a owl:Class ;
    rdfs:subClassOf hr:JobToBeDone ;
    rdfs:label "Consumption Chain Job" ;
    rdfs:comment "A job the client must do to acquire, adopt, use and renew the PEO relationship itself." .

hr:JobStep a owl:Class ;
    rdfs:label "Universal Job-Map Step" .

hr:DesiredOutcome a owl:Class ;
    rdfs:label "Desired Outcome" ;
    rdfs:comment "A measurable customer success metric: direction + metric + object of control + contextual clarifier." .

hr:OutcomeMetricType a owl:Class ;
    rdfs:label "Outcome Metric Type" .

# --- Object properties (with inverses) ---
hr:executedByPersona a owl:ObjectProperty ; rdfs:domain hr:JobToBeDone ; rdfs:range hr:ClientPersona ; rdfs:label "Executed By Persona" .
hr:executesJob a owl:ObjectProperty ; owl:inverseOf hr:executedByPersona ; rdfs:label "Executes Job" .
hr:involvesPersona a owl:ObjectProperty ; rdfs:domain hr:JobToBeDone ; rdfs:range hr:ClientPersona ; rdfs:label "Involves Persona (Participant)" .
hr:participatesInJob a owl:ObjectProperty ; owl:inverseOf hr:involvesPersona ; rdfs:label "Participates In Job" .
hr:jobInDomain a owl:ObjectProperty ; rdfs:domain hr:JobToBeDone ; rdfs:range hr:Domain ; rdfs:label "Job In Domain" .
hr:hasDesiredOutcome a owl:ObjectProperty ; rdfs:domain hr:JobToBeDone ; rdfs:range hr:DesiredOutcome ; rdfs:label "Has Desired Outcome" .
hr:isOutcomeOfJob a owl:ObjectProperty ; owl:inverseOf hr:hasDesiredOutcome ; rdfs:label "Is Outcome Of Job" .
hr:atJobStep a owl:ObjectProperty ; rdfs:domain hr:DesiredOutcome ; rdfs:range hr:JobStep ; rdfs:label "At Job-Map Step" .
hr:addressedByService a owl:ObjectProperty ; rdfs:domain hr:DesiredOutcome ; rdfs:range hr:DomainService ; rdfs:label "Addressed By Domain Service" .
hr:addressesOutcome a owl:ObjectProperty ; owl:inverseOf hr:addressedByService ; rdfs:label "Addresses Desired Outcome" .
hr:benchmarkTheme a owl:ObjectProperty ; rdfs:domain hr:DesiredOutcome ; rdfs:range hr:ServiceLine ; rdfs:label "Benchmark Theme" .
hr:hasMetricType a owl:ObjectProperty ; rdfs:domain hr:DesiredOutcome ; rdfs:range hr:OutcomeMetricType ; rdfs:label "Has Metric Type" .

# --- Datatype properties ---
hr:outcomeCode a owl:DatatypeProperty ; rdfs:domain hr:DesiredOutcome ; rdfs:range xsd:string ; rdfs:label "Outcome Code" .
hr:stepOrder a owl:DatatypeProperty ; rdfs:domain hr:JobStep ; rdfs:range xsd:integer ; rdfs:label "Step Order" .
hr:personaGoal a owl:DatatypeProperty ; rdfs:domain hr:ClientPersona ; rdfs:range xsd:string ; rdfs:label "Persona Goal" .
hr:buyingRole a owl:DatatypeProperty ; rdfs:domain hr:ClientPersona ; rdfs:range xsd:string ; rdfs:label "Buying Role" .
hr:emotionalJob a owl:DatatypeProperty ; rdfs:domain hr:ClientPersona ; rdfs:range xsd:string ; rdfs:label "Emotional / Social Job" .

# --- Benchmark themes not covered by the v2.0 service-line layer ---
hr:ServiceLinePEORelationship a hr:ServiceLine ;
    rdfs:label "PEO Relationship" ;
    rdfs:comment "Added for the benchmark: buying, onboarding, support and renewal of the PEO relationship." ;
    hr:realizedBySubDomain hr:SalesClientOnboardingSubDomain , hr:ClientSuccessAccountMgmtSubDomain .

hr:ServiceLineHRTechnologyData a hr:ServiceLine ;
    rdfs:label "HR Technology & Data" ;
    rdfs:comment "Added for the benchmark: self-service, administration, identity, integration and data security." ;
    hr:realizedBySubDomain hr:DigitalSelfServiceExperienceSubDomain ;
    hr:realizedByService hr:HRISDataIntegrationConnectorService , hr:ClientAdminPortalReportingService ,
                         hr:SingleSignOnIdentityManagementService , hr:DataPrivacySecurityGovernanceService .

# --- Metric types ---
hr:MetricSpeed a hr:OutcomeMetricType ; rdfs:label "Speed" .
hr:MetricStability a hr:OutcomeMetricType ; rdfs:label "Stability" .
hr:MetricCostexposure a hr:OutcomeMetricType ; rdfs:label "Cost & exposure" .
hr:MetricEffort a hr:OutcomeMetricType ; rdfs:label "Effort" .
hr:MetricOutput a hr:OutcomeMetricType ; rdfs:label "Output" .

# --- Universal job-map steps ---
hr:StepDefine a hr:JobStep ; rdfs:label "Define" ; rdfs:comment "Determine objectives and plan the approach" ; hr:stepOrder 1 .
hr:StepLocate a hr:JobStep ; rdfs:label "Locate" ; rdfs:comment "Gather the inputs and information needed" ; hr:stepOrder 2 .
hr:StepPrepare a hr:JobStep ; rdfs:label "Prepare" ; rdfs:comment "Set up the environment and inputs" ; hr:stepOrder 3 .
hr:StepConfirm a hr:JobStep ; rdfs:label "Confirm" ; rdfs:comment "Verify readiness before acting" ; hr:stepOrder 4 .
hr:StepExecute a hr:JobStep ; rdfs:label "Execute" ; rdfs:comment "Carry out the core task" ; hr:stepOrder 5 .
hr:StepMonitor a hr:JobStep ; rdfs:label "Monitor" ; rdfs:comment "Check that the task is going as intended" ; hr:stepOrder 6 .
hr:StepModify a hr:JobStep ; rdfs:label "Modify" ; rdfs:comment "Make adjustments and corrections" ; hr:stepOrder 7 .
hr:StepConclude a hr:JobStep ; rdfs:label "Conclude" ; rdfs:comment "Finish, close out and prepare for next time" ; hr:stepOrder 8 .

# --- Client personas ---
hr:PersonaOwner a hr:ClientPersona ;
    rdfs:label "Business Owner / CEO" ;
    rdfs:comment "Runs a 5–150 employee company; often the final HR decision-maker; HR is a distraction from growing the business." ;
    hr:personaGoal "Grow the business without becoming an expert in employment law, insurance and payroll tax." ;
    hr:buyingRole "Economic buyer — signs the agreement and owns the cost/value decision" ;
    hr:emotionalJob "Feel confident the company is not exposed to a lawsuit or penalty it doesn't know about" , "Feel able to compete with larger employers for talent" , "Be seen by employees as an employer that takes care of its people" .

hr:PersonaFinance a hr:ClientPersona ;
    rdfs:label "Finance Leader" ;
    rdfs:comment "Owns payroll funding, tax deposits, GL posting and the HR provider invoice; frequently also the payroll processor in smaller firms." ;
    hr:personaGoal "Keep employer costs predictable and the books accurate with minimal manual reconciliation." ;
    hr:buyingRole "Evaluator and gatekeeper on total cost; often the day-to-day payroll user" ;
    hr:emotionalJob "Avoid the embarrassment of a missed or wrong payroll" , "Feel in control of every dollar of employer cost" , "Be seen by the owner as a trusted steward of company money" .

hr:PersonaHR a hr:ClientPersona ;
    rdfs:label "HR Leader" ;
    rdfs:comment "Covers every HR discipline at once — benefits, compliance, hiring, employee relations — with little specialist support." ;
    hr:personaGoal "Run reliable HR operations and spend more time on people strategy than on paperwork." ;
    hr:buyingRole "Primary evaluator and daily user; champions or blocks the provider" ;
    hr:emotionalJob "Feel confident in giving advice on issues outside their expertise" , "Avoid being blamed for a compliance miss" , "Be seen as a strategic partner rather than an administrator" .

hr:PersonaOpsSafety a hr:ClientPersona ;
    rdfs:label "Operations & Safety Leader" ;
    rdfs:comment "Responsible for field or industrial worksites (construction, manufacturing, logistics, trades) where injury risk and workers' comp cost are material." ;
    hr:personaGoal "Keep crews safe and productive and keep insurance cost under control." ;
    hr:buyingRole "Influencer on risk and safety services; user of injury and safety workflows" ;
    hr:emotionalJob "Feel that no one will be seriously hurt on their watch" , "Be seen by crews as someone who has their back after an injury" .

hr:PersonaManager a hr:ClientPersona ;
    rdfs:label "People Manager" ;
    rdfs:comment "Approves time, hires, coaches and evaluates a team; usually promoted for technical skill with little leadership training." ;
    hr:personaGoal "Build a capable, engaged team and handle people issues well." ;
    hr:buyingRole "User and influencer; their experience drives employee adoption" ;
    hr:emotionalJob "Feel competent handling difficult people conversations" , "Be seen by their team as fair and supportive" .

hr:PersonaEmployee a hr:ClientPersona ;
    rdfs:label "Worksite Employee" ;
    rdfs:comment "Experiences the PEO through pay, benefits, self-service and HR answers; never chose the provider." ;
    hr:personaGoal "Get paid correctly, understand and use benefits, and get HR tasks done without friction." ;
    hr:buyingRole "End user; satisfaction affects client retention and renewal" ;
    hr:emotionalJob "Feel financially secure and protected by good benefits" , "Feel respected and that personal data is handled with care" .

hr:PersonaIT a hr:ClientPersona ;
    rdfs:label "IT & Systems Administrator" ;
    rdfs:comment "Connects HR and payroll data to accounting, scheduling and identity systems; responsible for access and security." ;
    hr:personaGoal "Keep employee data flowing between systems accurately and securely with little maintenance." ;
    hr:buyingRole "Technical evaluator; can veto on security or integration grounds" ;
    hr:emotionalJob "Avoid being responsible for a data breach involving employee records" .

# --- Jobs to be done ---
hr:JobJ01 a hr:CoreFunctionalJob ;
    rdfs:label "Pay employees accurately and on time" ;
    hr:executedByPersona hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaHR , hr:PersonaOwner ;
    hr:jobInDomain hr:WorkforceAdminDomain ;
    hr:hasDesiredOutcome hr:OutcomeO001 , hr:OutcomeO002 , hr:OutcomeO003 , hr:OutcomeO004 , hr:OutcomeO005 , hr:OutcomeO006 , hr:OutcomeO007 , hr:OutcomeO008 , hr:OutcomeO009 , hr:OutcomeO010 .

hr:JobJ02 a hr:CoreFunctionalJob ;
    rdfs:label "Meet payroll tax obligations in every jurisdiction where employees work" ;
    hr:executedByPersona hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaOwner ;
    hr:jobInDomain hr:WorkforceAdminDomain , hr:ComplianceRiskDomain ;
    hr:hasDesiredOutcome hr:OutcomeO011 , hr:OutcomeO012 , hr:OutcomeO013 , hr:OutcomeO014 , hr:OutcomeO015 , hr:OutcomeO016 , hr:OutcomeO017 , hr:OutcomeO018 , hr:OutcomeO019 .

hr:JobJ03 a hr:CoreFunctionalJob ;
    rdfs:label "Track time worked and manage time off" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaManager , hr:PersonaOpsSafety ;
    hr:involvesPersona hr:PersonaEmployee , hr:PersonaFinance ;
    hr:jobInDomain hr:WorkforceAdminDomain ;
    hr:hasDesiredOutcome hr:OutcomeO020 , hr:OutcomeO021 , hr:OutcomeO022 , hr:OutcomeO023 , hr:OutcomeO024 , hr:OutcomeO025 , hr:OutcomeO026 , hr:OutcomeO027 , hr:OutcomeO028 .

hr:JobJ04 a hr:CoreFunctionalJob ;
    rdfs:label "Understand and allocate labor cost by department, job or project" ;
    hr:executedByPersona hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaOwner , hr:PersonaOpsSafety ;
    hr:jobInDomain hr:WorkforceAdminDomain ;
    hr:hasDesiredOutcome hr:OutcomeO029 , hr:OutcomeO030 , hr:OutcomeO031 , hr:OutcomeO032 , hr:OutcomeO033 , hr:OutcomeO034 , hr:OutcomeO035 .

hr:JobJ05 a hr:CoreFunctionalJob ;
    rdfs:label "Offer a competitive and affordable benefits package" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaHR ;
    hr:involvesPersona hr:PersonaFinance ;
    hr:jobInDomain hr:BenefitsRetirementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO036 , hr:OutcomeO037 , hr:OutcomeO038 , hr:OutcomeO039 , hr:OutcomeO040 , hr:OutcomeO041 , hr:OutcomeO042 , hr:OutcomeO043 , hr:OutcomeO044 .

hr:JobJ06 a hr:CoreFunctionalJob ;
    rdfs:label "Administer benefit enrollment and changes" ;
    hr:executedByPersona hr:PersonaHR ;
    hr:involvesPersona hr:PersonaFinance , hr:PersonaEmployee ;
    hr:jobInDomain hr:BenefitsRetirementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO045 , hr:OutcomeO046 , hr:OutcomeO047 , hr:OutcomeO048 , hr:OutcomeO049 , hr:OutcomeO050 , hr:OutcomeO051 , hr:OutcomeO052 , hr:OutcomeO053 .

hr:JobJ07 a hr:CoreFunctionalJob ;
    rdfs:label "Provide a retirement savings plan" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaHR , hr:PersonaEmployee ;
    hr:jobInDomain hr:BenefitsRetirementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO054 , hr:OutcomeO055 , hr:OutcomeO056 , hr:OutcomeO057 , hr:OutcomeO058 , hr:OutcomeO059 , hr:OutcomeO060 , hr:OutcomeO061 , hr:OutcomeO062 .

hr:JobJ08 a hr:CoreFunctionalJob ;
    rdfs:label "Choose and use my benefits" ;
    hr:executedByPersona hr:PersonaEmployee ;
    hr:jobInDomain hr:BenefitsRetirementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO063 , hr:OutcomeO064 , hr:OutcomeO065 , hr:OutcomeO066 , hr:OutcomeO067 , hr:OutcomeO068 , hr:OutcomeO069 , hr:OutcomeO070 .

hr:JobJ09 a hr:CoreFunctionalJob ;
    rdfs:label "Keep the company compliant with employment laws" ;
    hr:executedByPersona hr:PersonaHR ;
    hr:involvesPersona hr:PersonaOwner ;
    hr:jobInDomain hr:ComplianceRiskDomain ;
    hr:hasDesiredOutcome hr:OutcomeO071 , hr:OutcomeO072 , hr:OutcomeO073 , hr:OutcomeO074 , hr:OutcomeO075 , hr:OutcomeO076 , hr:OutcomeO077 , hr:OutcomeO078 , hr:OutcomeO079 , hr:OutcomeO080 .

hr:JobJ10 a hr:CoreFunctionalJob ;
    rdfs:label "Resolve employee relations issues and separations without legal exposure" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaOwner ;
    hr:involvesPersona hr:PersonaManager ;
    hr:jobInDomain hr:ComplianceRiskDomain , hr:ValuesCultureStewardshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO081 , hr:OutcomeO082 , hr:OutcomeO083 , hr:OutcomeO084 , hr:OutcomeO085 , hr:OutcomeO086 , hr:OutcomeO087 , hr:OutcomeO088 , hr:OutcomeO089 .

hr:JobJ11 a hr:CoreFunctionalJob ;
    rdfs:label "Keep the workplace safe and manage injuries" ;
    hr:executedByPersona hr:PersonaOpsSafety ;
    hr:involvesPersona hr:PersonaHR , hr:PersonaFinance , hr:PersonaEmployee ;
    hr:jobInDomain hr:ComplianceRiskDomain ;
    hr:hasDesiredOutcome hr:OutcomeO090 , hr:OutcomeO091 , hr:OutcomeO092 , hr:OutcomeO093 , hr:OutcomeO094 , hr:OutcomeO095 , hr:OutcomeO096 , hr:OutcomeO097 , hr:OutcomeO098 , hr:OutcomeO099 .

hr:JobJ12 a hr:CoreFunctionalJob ;
    rdfs:label "Hire the right people" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaManager ;
    hr:involvesPersona hr:PersonaOwner , hr:PersonaOpsSafety ;
    hr:jobInDomain hr:TalentManagementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO100 , hr:OutcomeO101 , hr:OutcomeO102 , hr:OutcomeO103 , hr:OutcomeO104 , hr:OutcomeO105 , hr:OutcomeO106 , hr:OutcomeO107 , hr:OutcomeO108 .

hr:JobJ13 a hr:CoreFunctionalJob ;
    rdfs:label "Get new hires productive quickly" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaManager ;
    hr:involvesPersona hr:PersonaEmployee , hr:PersonaIT ;
    hr:jobInDomain hr:TalentManagementDomain , hr:ValuesCultureStewardshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO109 , hr:OutcomeO110 , hr:OutcomeO111 , hr:OutcomeO112 , hr:OutcomeO113 , hr:OutcomeO114 , hr:OutcomeO115 , hr:OutcomeO116 .

hr:JobJ14 a hr:CoreFunctionalJob ;
    rdfs:label "Set pay that is competitive, fair and affordable" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaHR ;
    hr:involvesPersona hr:PersonaFinance , hr:PersonaManager ;
    hr:jobInDomain hr:TalentManagementDomain ;
    hr:hasDesiredOutcome hr:OutcomeO117 , hr:OutcomeO118 , hr:OutcomeO119 , hr:OutcomeO120 , hr:OutcomeO121 , hr:OutcomeO122 , hr:OutcomeO123 , hr:OutcomeO124 .

hr:JobJ15 a hr:CoreFunctionalJob ;
    rdfs:label "Manage and improve team performance" ;
    hr:executedByPersona hr:PersonaManager ;
    hr:involvesPersona hr:PersonaHR , hr:PersonaEmployee ;
    hr:jobInDomain hr:TalentManagementDomain , hr:WorkforceDevelopmentDomain , hr:ValuesCultureStewardshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO125 , hr:OutcomeO126 , hr:OutcomeO127 , hr:OutcomeO128 , hr:OutcomeO129 , hr:OutcomeO130 , hr:OutcomeO131 , hr:OutcomeO132 , hr:OutcomeO133 .

hr:JobJ16 a hr:CoreFunctionalJob ;
    rdfs:label "Develop employees and retain the best ones" ;
    hr:executedByPersona hr:PersonaHR ;
    hr:involvesPersona hr:PersonaOwner , hr:PersonaManager , hr:PersonaEmployee ;
    hr:jobInDomain hr:TalentManagementDomain , hr:WorkforceDevelopmentDomain ;
    hr:hasDesiredOutcome hr:OutcomeO134 , hr:OutcomeO135 , hr:OutcomeO136 , hr:OutcomeO137 , hr:OutcomeO138 , hr:OutcomeO139 , hr:OutcomeO140 , hr:OutcomeO141 , hr:OutcomeO142 .

hr:JobJ17 a hr:CoreFunctionalJob ;
    rdfs:label "Become an effective people leader" ;
    hr:executedByPersona hr:PersonaManager ;
    hr:jobInDomain hr:WorkforceDevelopmentDomain ;
    hr:hasDesiredOutcome hr:OutcomeO143 , hr:OutcomeO144 , hr:OutcomeO145 , hr:OutcomeO146 , hr:OutcomeO147 , hr:OutcomeO148 , hr:OutcomeO149 , hr:OutcomeO150 .

hr:JobJ18 a hr:CoreFunctionalJob ;
    rdfs:label "Build and sustain a healthy, values-driven culture" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaHR ;
    hr:involvesPersona hr:PersonaManager , hr:PersonaEmployee ;
    hr:jobInDomain hr:ValuesCultureStewardshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO151 , hr:OutcomeO152 , hr:OutcomeO153 , hr:OutcomeO154 , hr:OutcomeO155 , hr:OutcomeO156 , hr:OutcomeO157 , hr:OutcomeO158 , hr:OutcomeO159 , hr:OutcomeO160 .

hr:JobJ19 a hr:CoreFunctionalJob ;
    rdfs:label "Measure the workforce while protecting employee privacy" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaIT ;
    hr:involvesPersona hr:PersonaOwner ;
    hr:jobInDomain hr:ValuesCultureStewardshipDomain , hr:HRTechnologyPlatformDomain ;
    hr:hasDesiredOutcome hr:OutcomeO161 , hr:OutcomeO162 , hr:OutcomeO163 , hr:OutcomeO164 , hr:OutcomeO165 , hr:OutcomeO166 , hr:OutcomeO167 , hr:OutcomeO168 , hr:OutcomeO169 .

hr:JobJ20 a hr:CoreFunctionalJob ;
    rdfs:label "Use workforce data to make business decisions" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaHR ;
    hr:jobInDomain hr:HRTechnologyPlatformDomain , hr:WorkforceDevelopmentDomain ;
    hr:hasDesiredOutcome hr:OutcomeO170 , hr:OutcomeO171 , hr:OutcomeO172 , hr:OutcomeO173 , hr:OutcomeO174 , hr:OutcomeO175 , hr:OutcomeO176 , hr:OutcomeO177 .

hr:JobJ21 a hr:CoreFunctionalJob ;
    rdfs:label "Connect employee data to other business systems securely" ;
    hr:executedByPersona hr:PersonaIT ;
    hr:involvesPersona hr:PersonaFinance , hr:PersonaHR ;
    hr:jobInDomain hr:HRTechnologyPlatformDomain ;
    hr:hasDesiredOutcome hr:OutcomeO178 , hr:OutcomeO179 , hr:OutcomeO180 , hr:OutcomeO181 , hr:OutcomeO182 , hr:OutcomeO183 , hr:OutcomeO184 , hr:OutcomeO185 , hr:OutcomeO186 .

hr:JobJ22 a hr:CoreFunctionalJob ;
    rdfs:label "Get HR answers and complete HR tasks myself" ;
    hr:executedByPersona hr:PersonaEmployee ;
    hr:jobInDomain hr:HRTechnologyPlatformDomain ;
    hr:hasDesiredOutcome hr:OutcomeO187 , hr:OutcomeO188 , hr:OutcomeO189 , hr:OutcomeO190 , hr:OutcomeO191 , hr:OutcomeO192 , hr:OutcomeO193 , hr:OutcomeO194 .

hr:JobC1 a hr:ConsumptionChainJob ;
    rdfs:label "Evaluate and choose an HR outsourcing partner" ;
    hr:executedByPersona hr:PersonaOwner , hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaHR , hr:PersonaIT ;
    hr:jobInDomain hr:ClientRelationshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO195 , hr:OutcomeO196 , hr:OutcomeO197 , hr:OutcomeO198 , hr:OutcomeO199 , hr:OutcomeO200 , hr:OutcomeO201 , hr:OutcomeO202 .

hr:JobC2 a hr:ConsumptionChainJob ;
    rdfs:label "Move the company onto a new HR provider" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaFinance ;
    hr:involvesPersona hr:PersonaIT , hr:PersonaOwner ;
    hr:jobInDomain hr:ClientRelationshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO203 , hr:OutcomeO204 , hr:OutcomeO205 , hr:OutcomeO206 , hr:OutcomeO207 , hr:OutcomeO208 , hr:OutcomeO209 , hr:OutcomeO210 .

hr:JobC3 a hr:ConsumptionChainJob ;
    rdfs:label "Get help when an HR issue arises" ;
    hr:executedByPersona hr:PersonaHR , hr:PersonaOwner ;
    hr:involvesPersona hr:PersonaManager , hr:PersonaFinance ;
    hr:jobInDomain hr:ClientRelationshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO211 , hr:OutcomeO212 , hr:OutcomeO213 , hr:OutcomeO214 , hr:OutcomeO215 , hr:OutcomeO216 , hr:OutcomeO217 .

hr:JobC4 a hr:ConsumptionChainJob ;
    rdfs:label "Manage the cost and value of the HR outsourcing relationship" ;
    hr:executedByPersona hr:PersonaFinance , hr:PersonaOwner ;
    hr:involvesPersona hr:PersonaHR ;
    hr:jobInDomain hr:ClientRelationshipDomain ;
    hr:hasDesiredOutcome hr:OutcomeO218 , hr:OutcomeO219 , hr:OutcomeO220 , hr:OutcomeO221 , hr:OutcomeO222 , hr:OutcomeO223 , hr:OutcomeO224 .

# --- Desired outcomes ---
hr:OutcomeO001 a hr:DesiredOutcome ;
    rdfs:label "Minimize the time required to determine which pay rules apply to each employee, e.g., overtime, shift differentials, bonuses" ;
    hr:outcomeCode "O001" ;
    hr:isOutcomeOfJob hr:JobJ01 ;
    hr:atJobStep hr:StepDefine ;
    hr:addressedByService hr:GrossToNetPayrollService ;
    hr:benchmarkTheme hr:ServiceLinePayroll ;
    hr:hasMetricType hr:MetricSpeed .

hr:OutcomeO002 a hr:DesiredOutcome ;
    rdfs:label "Minimize the time required to gather all hours, earnings changes and deductions for a pay period" ;
    hr:outcomeCode "O002" ;
    hr:isOutcomeOfJob hr:JobJ01 ;
    hr:atJobStep hr:StepLocate ;
    hr:addressedByService hr:TimesheetApprovalStagingService ;
    hr:benchmarkTheme hr:ServiceLinePayroll ;
    hr:hasMetricType hr:MetricSpeed .

hr:OutcomeO003 a hr:DesiredOutcome ;
    rdfs:label "Minimize the likelihood that a pay change, e.g., a raise, new hire or termination, is missed before payroll is run" ;
    hr:outcomeCode "O003" ;
    hr:isOutcomeOfJob hr:JobJ01 ;
    hr:atJobStep hr:StepPrepare ;
    hr:addressedByService hr:GrossToNetPayrollService ;
    hr:benchmarkTheme hr:ServiceLinePayroll ;
    hr:hasMetricType hr:MetricStability .

hr:OutcomeO004 a hr:DesiredOutcome ;
    rdfs:label "Minimize the time required to confirm that pay calculations are correct before funds are released" ;
    hr:outcomeCode "O004" ;
    hr:isOutcomeOfJob hr:JobJ01 ;
    hr:atJobStep hr:StepConfirm ;
    hr:addressedByService hr:GrossToNetPayrollService ;
    hr:benchmarkTheme hr:ServiceLinePayroll ;
    hr:hasMetricType hr:MetricSpeed .

hr:OutcomeO005 a hr:DesiredOutcome ;
    rdfs:label "Minimize the likelihood of miscalculating overtime under federal and state rules" ;
    hr:outcomeCode "O005" ;
    hr:isOutcomeOfJob hr:JobJ01 ;
    hr:atJobStep hr:StepConfirm ;
    hr:addressedByService hr:GrossToNetPayrollService ;
    hr:benchmarkTheme hr:ServiceLinePayroll ;
    hr:hasMetricType hr:MetricStability .

hr:OutcomeO006 a hr:DesiredOutcome ;
