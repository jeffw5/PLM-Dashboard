    ke:designation "ISO 12620-1:2022" ; ke:edition 1 ; dcterms:issued "2022"^^xsd:gYear ;
    ke:status ke:Status_ToBeRevised ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/TC 37/SC 3" ; ke:contentType "Requirements (term metadata)" ;
