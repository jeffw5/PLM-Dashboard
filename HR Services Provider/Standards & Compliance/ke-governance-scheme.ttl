### Graph data ----------------------------------------------------------------
ke:ISO39075 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_GraphData ;
    skos:notation "ISO/IEC 39075" ;
    skos:prefLabel "ISO/IEC 39075 — Database language GQL"@en ;
    ke:designation "ISO/IEC 39075:2024" ; ke:edition 1 ; dcterms:issued "2024"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/IEC JTC 1/SC 32/WG 3" ; ke:contentType "Database language" ;
    dcterms:description "The first ISO database language since SQL: defines, queries and updates labeled property graphs. Published April 2024; a technical corrigendum was scheduled for December 2025."@en ;
    ke:relevance "Standard query language if the persistent graph is a property-graph database rather than an RDF store."@en .
ke:ISO9075_16 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_GraphData ;
    skos:notation "ISO/IEC 9075-16" ;
    skos:prefLabel "ISO/IEC 9075-16 — SQL/PGQ (property graph queries)"@en ;
    ke:designation "ISO/IEC 9075-16:2023" ; ke:edition 1 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/IEC JTC 1/SC 32/WG 3" ; ke:contentType "Database language" ;
    dcterms:description "Lets SQL tables be declared as a property graph (nodes and edges with labels and properties) and queried with graph patterns — a standard virtual graph over relational data. Corrigendum 1 in 2026."@en ;
    ke:relevance "Expose payroll/HRIS tables as a virtual compliance graph without copying worker data."@en ;
    dcterms:isReplacedBy ke:ISO9075_16_ed2 ;
    ke:isoPage <https://www.iso.org/standard/79473.html> .
ke:ISO9075_16_ed2 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_GraphData ;
    skos:notation "ISO/IEC CD 9075-16" ; skos:prefLabel "SQL/PGQ edition 2 — draft"@en ;
    ke:designation "ISO/IEC CD 9075-16" ; ke:edition 2 ;
    ke:status ke:Status_Draft ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/IEC JTC 1/SC 32/WG 3" ; ke:contentType "Database language" ;
    dcterms:description "Second edition; committee-draft comments closed 2026-01-30."@en ;
    ke:relevance "Watch item for the virtual-graph layer."@en ;
    dcterms:replaces ke:ISO9075_16 ;
    ke:isoPage <https://www.iso.org/standard/87342.html> .
ke:ISO13250 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_GraphData ;
    skos:notation "ISO/IEC 13250" ; skos:prefLabel "ISO/IEC 13250 — Topic Maps"@en ;
    ke:committee "ISO/IEC JTC 1/SC 34" ; ke:contentType "Data model + syntaxes" ;
    dcterms:description "Topics, associations and occurrences with merging rules; Part 2 (data model, 2006) is current. Largely superseded in practice by RDF and property graphs."@en ;
    ke:relevance "Low; only for migrating legacy topic-map knowledge bases."@en .

### Quality, AI and privacy ---------------------------------------------------
ke:ISO5259 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Quality ;
    skos:notation "ISO/IEC 5259" ;
    skos:prefLabel "ISO/IEC 5259 — Data quality for analytics and machine learning"@en ;
    ke:committee "ISO/IEC JTC 1/SC 42" ; ke:contentType "Framework + measures + process" ;
    ke:newSince2022 "true"^^xsd:boolean ;
    dcterms:description "Five-part series: overview and terminology, quality measures, quality management requirements, a quality process framework, and a governance framework (parts 1–4 published 2024; part 5 2025)."@en ;
    ke:relevance "Quality measures (completeness, accuracy, currency) for the reference graph when it feeds analytics or an AI assistant."@en ;
    dcterms:hasPart ke:ISO5259_1 ; skos:narrower ke:ISO5259_1 .
ke:ISO5259_1 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO5259 ;
    skos:notation "ISO/IEC 5259-1" ; skos:prefLabel "Part 1: Overview, terminology and examples"@en ;
    ke:designation "ISO/IEC 5259-1:2024" ; ke:edition 1 ; dcterms:issued "2024"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 42" ; ke:contentType "Framework" ;
    dcterms:isPartOf ke:ISO5259 ;
    dcterms:description "Framework for assessing and improving data quality across the data lifecycle."@en ;
    ke:relevance "Entry point to the series."@en ;
    ke:isoPage <https://www.iso.org/standard/81088.html> .
ke:ISO42001 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Quality ;
    skos:notation "ISO/IEC 42001" ; skos:prefLabel "ISO/IEC 42001 — AI management system"@en ;
    ke:designation "ISO/IEC 42001:2023" ; ke:edition 1 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 42" ; ke:contentType "Management system requirements" ;
    dcterms:description "Requirements for an organization's AI management system."@en ;
    ke:relevance "Governs AI services built on the graph (HR assistant, compliance Q&A) and fits with the knowledge management system under ISO 30401."@en .
ke:ISO42005 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Quality ;
    skos:notation "ISO/IEC 42005" ; skos:prefLabel "ISO/IEC 42005 — AI system impact assessment"@en ;
    ke:designation "ISO/IEC 42005:2025" ; ke:edition 1 ; dcterms:issued "2025"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 42" ; ke:contentType "Guidance" ;
    dcterms:description "Guidance for assessing how an AI system may affect individuals, groups and society across its lifecycle."@en ;
    ke:relevance "Directly relevant where the graph drives AI in hiring or HR decisions (Illinois HB 3773, NYC Local Law 144)."@en ;
    rdfs:seeAlso pes:Requirement ;
    ke:isoPage <https://www.iso.org/standard/42005> .
ke:ISO27701 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Quality ;
    skos:notation "ISO/IEC 27701" ; skos:prefLabel "ISO/IEC 27701 — Privacy information management systems"@en ;
    ke:designation "ISO/IEC 27701:2025" ; ke:edition 2 ; dcterms:issued "2025"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 27" ; ke:contentType "Management system requirements" ;
    dcterms:description "Requirements and guidance for a privacy information management system; the 2025 edition is standalone rather than an extension of ISO/IEC 27001."@en ;
    ke:relevance "Worker PII in the instance graph (and biometric data under BIPA) must sit inside a privacy management system."@en ;
    ke:isoPage <https://www.iso.org/standard/27701> .

### HR domain and records -----------------------------------------------------
ke:ISO30400 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_HR ;
    skos:notation "ISO 30400" ; skos:prefLabel "ISO 30400 — Human resource management: Vocabulary"@en ;
    ke:designation "ISO 30400:2022" ; ke:edition 2 ; dcterms:issued "2022"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/TC 260" ; ke:contentType "Vocabulary" ;
    dcterms:description "Terms used in the ISO human resource management standards."@en ;
    ke:relevance "Authoritative source vocabulary for HR terms; map peo-topics and class labels to it."@en ;
    ke:isoPage <https://www.iso.org/standard/78044.html> .
ke:ISO30414 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_HR ;
    skos:notation "ISO 30414" ; skos:prefLabel "ISO 30414 — Human capital reporting and disclosure"@en ;
    ke:designation "ISO 30414:2025" ; ke:edition 2 ; dcterms:issued "2025"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/TC 260" ; ke:contentType "Requirements (reporting)" ;
    dcterms:description "Requirements for internal and external human capital reporting in eleven areas, including compliance, workforce costs, health and safety, and turnover."@en ;
    ke:relevance "Defines client-facing HR metrics a PEO can compute from the graph, including compliance metrics."@en ;
    ke:isoPage <https://www.iso.org/standard/30414> .
ke:ISO30300 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_HR ;
    skos:notation "ISO 30300" ; skos:prefLabel "ISO 30300 — Records management: Core concepts and vocabulary"@en ;
    ke:designation "ISO 30300:2020" ; ke:edition 2 ; dcterms:issued "2020"^^xsd:gYear ;
    ke:status ke:Status_ToBeRevised ; ke:committee "ISO/TC 46/SC 11" ; ke:contentType "Vocabulary" ;
    dcterms:description "Core records-management terms: records, metadata for records, appraisal, disposition."@en ;
    ke:relevance "Retention and disposition of payroll, I-9 and leave records; versioned history of the graph itself."@en ;
    ke:isoPage <https://www.iso.org/standard/74291.html> .

### Other (from the original mind map) ----------------------------------------
ke:ISO21127 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Other ;
    skos:notation "ISO 21127" ; skos:prefLabel "ISO 21127 — Reference ontology for cultural heritage (CIDOC CRM)"@en ;
    ke:designation "ISO 21127:2023" ; ke:edition 3 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/TC 46/SC 4" ; ke:contentType "Reference ontology" ;
    dcterms:description "Event-centric reference ontology for cultural heritage documentation."@en ;
    ke:relevance "Not HR-specific; a worked example of an ISO-standardized domain ontology."@en ;
    ke:isoPage <https://www.iso.org/standard/85100.html> .
ke:ISO80000_1 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Other ;
    skos:notation "ISO 80000-1" ; skos:prefLabel "ISO 80000-1 — Quantities and units: General"@en ;
    ke:designation "ISO 80000-1:2022" ; ke:edition 2 ; dcterms:issued "2022"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/TC 12" ; ke:contentType "Vocabulary + rules" ;
    dcterms:description "Quantities, units and how to write them."@en ;
    ke:relevance "Applied: every pes:WageRate records its unit explicitly (USD/h, USD/wk)."@en ;
    rdfs:seeAlso pes:WageRate ;
    ke:isoPage <https://www.iso.org/standard/76921.html> .

#################################################################
#  W3C companion specifications (not ISO)
#################################################################
ke:CompanionSpecs a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "W3C companion specifications"@en ;
    skos:scopeNote "Not ISO standards, but the working languages that implement several lifecycle stages."@en ;
    skos:narrower ke:W3C_SKOS , ke:W3C_OWL2 , ke:W3C_SHACL , ke:W3C_SPARQL , ke:W3C_R2RML , ke:W3C_PROV .
ke:W3C_SKOS a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "SKOS"@en ; ke:designation "W3C Recommendation (2009)" ;
    dcterms:description "Simple Knowledge Organization System: RDF vocabulary for taxonomies and thesauri."@en .
ke:W3C_OWL2 a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "OWL 2"@en ; ke:designation "W3C Recommendation (2012, 2nd ed.)" ;
    dcterms:description "Web Ontology Language for ontologies with formal semantics."@en .
ke:W3C_SHACL a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "SHACL"@en ; ke:designation "W3C Recommendation (2017)" ;
    dcterms:description "Shapes Constraint Language for validating RDF graphs."@en .
ke:W3C_SPARQL a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "SPARQL 1.1"@en ; ke:designation "W3C Recommendation (2013)" ;
    dcterms:description "Query and update language for RDF graphs."@en .
ke:W3C_R2RML a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "R2RML"@en ; ke:designation "W3C Recommendation (2012)" ;
    dcterms:description "Mapping language from relational databases to RDF, the basis of virtual RDF graphs."@en .
ke:W3C_PROV a skos:Concept , ke:Specification ; skos:inScheme ke:Scheme ; skos:broader ke:CompanionSpecs ;
    skos:prefLabel "PROV-O"@en ; ke:designation "W3C Recommendation (2013)" ;
    dcterms:description "Provenance ontology: who produced a fact, from what, and when."@en .

#################################################################
#  ISO 19763 (MFI) — objectives and HR-services applications
#################################################################
ke:MFI a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "ISO 19763 (MFI)"@en ; skos:related ke:ISO19763 ;
    skos:narrower ke:MFIObjectives , ke:MFIHRApplications .
ke:MFIObjectives a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFI ;
    skos:prefLabel "MFI Objectives"@en ; skos:narrower ke:StandardizeMetamodelStructure , ke:EnsureInteroperability .
ke:StandardizeMetamodelStructure a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIObjectives ;
    skos:prefLabel "Standardize Structure of Metamodels"@en .
ke:EnsureInteroperability a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIObjectives ;
    skos:prefLabel "Ensure Interoperability"@en .
ke:MFIHRApplications a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFI ;
    skos:prefLabel "MFI Applications for HR Services"@en ;
    skos:narrower ke:App_RulesSSOT , ke:App_ClientDataExchange , ke:App_PayrollBenefitsModels , ke:App_ComplianceReporting .
ke:App_RulesSSOT a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIHRApplications ;
    skos:prefLabel "Single source of truth for compliance rules"@en ; rdfs:seeAlso pes:Requirement , pes:EmploymentStandard .
ke:App_ClientDataExchange a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIHRApplications ;
    skos:prefLabel "Client and worksite data exchange"@en ; rdfs:seeAlso pes:Worksite , pes:ClientEmployer .
ke:App_PayrollBenefitsModels a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIHRApplications ;
    skos:prefLabel "Payroll and benefits model registration"@en ; rdfs:seeAlso pes:WageRate .
ke:App_ComplianceReporting a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:MFIHRApplications ;
    skos:prefLabel "Co-employment responsibility reporting"@en ; rdfs:seeAlso pes:ResponsibilityAllocation .

#################################################################
#  Pointer to the domain ontology
#################################################################
ke:EmploymentStandardsOntology a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Employment Standards Ontology for PEOs"@en ;
    skos:scopeNote "Formalized as peo-es.ttl with reference data in peo-standards.ttl, topics in peo-topics.ttl, examples in peo-examples.ttl and quality gates in peo-shapes.ttl. Replaces the Service Interoperability Ontology for Telecom."@en ;
    rdfs:seeAlso <https://enablingvalue.com/ontology/peo-es> .

#################################################################
#  Upper / top-level ontologies (from the mind map)
#################################################################
ke:UpperOntologies a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Upper/Top-Level Ontologies (ISO/IEC 21838)"@en ;
    skos:scopeNote "The PEO ontology aligns its core classes to BFO (ISO/IEC 21838-2)."@en ;
    skos:related ke:ISO21838 ;
    skos:narrower ke:UpperOntologyBenefits , ke:UpperOntologyHRImplementation .
ke:UpperOntologyBenefits a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologies ;
    skos:prefLabel "Importance and Applications"@en ;
    skos:narrower ke:Standardization , ke:Interoperability , ke:SemanticIntegration , ke:EnhancedQuerying , ke:Consistency , ke:Extensibility .
ke:Standardization     a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Standardization"@en .
ke:Interoperability    a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Interoperability"@en .
ke:SemanticIntegration a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Semantic Integration"@en .
ke:EnhancedQuerying    a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Enhanced Querying"@en .
ke:Consistency         a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Consistency"@en .
ke:Extensibility       a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyBenefits ; skos:prefLabel "Extensibility"@en .
ke:UpperOntologyHRImplementation a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologies ;
    skos:prefLabel "Example Implementation in HR Services"@en ;
    skos:scopeNote "Ordered steps, as applied to the PEO ontology."@en ;
    skos:narrower ke:Step1 , ke:Step2 , ke:Step3 , ke:Step4 , ke:Step5 , ke:Step6 , ke:Step7 .
ke:Step1 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "1" ;
    skos:prefLabel "Identification of Core Concepts"@en ; ke:projectExample "Standard, requirement, jurisdiction, employer, worksite, agreement."@en .
ke:Step2 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "2" ;
    skos:prefLabel "Mapping Domain-Specific Concepts"@en ; ke:projectExample "Each core class placed under a BFO category."@en .
ke:Step3 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "3" ;
    skos:prefLabel "Establishing Relationships"@en ; ke:projectExample "appliesIn, withinJurisdiction, establishedBy, allocatedTo, preemptedBy."@en .
ke:Step4 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "4" ;
    skos:prefLabel "Integrating Multiple KOS"@en ; ke:projectExample "OWL ontology + SKOS topic taxonomy joined by pes:coversTopic."@en .
ke:Step5 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "5" ;
    skos:prefLabel "Enhancing Data Retrieval"@en ; ke:projectExample "Query: all in-force standards that apply to a worksite at the client's headcount."@en .
ke:Step6 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "6" ;
    skos:prefLabel "Semantic Integration and Interoperability"@en ; ke:projectExample "Virtual graph over HRIS worksite and headcount tables."@en .
ke:Step7 a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:UpperOntologyHRImplementation ; skos:notation "7" ;
    skos:prefLabel "Supporting Evolving Knowledge"@en ; ke:projectExample "Dated wage-rate records; legal status values; lastVerified governance attribute."@en .
