### Top-level ontologies ------------------------------------------------------
ke:ISO21838 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Ontology ;
    skos:notation "ISO/IEC 21838" ;
    skos:prefLabel "ISO/IEC 21838 — Top-level ontologies (TLO)"@en ;
    ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Requirements + top-level ontologies" ;
    dcterms:description "Part 1 sets requirements for top-level ontologies; later parts standardize BFO, DOLCE, TUpper and (in draft) UFO."@en ;
    ke:relevance "The PEO ontology's upper layer is Part 2 (BFO)."@en ;
    skos:related ke:UpperOntologies ;
    dcterms:hasPart ke:ISO21838_1 , ke:ISO21838_2 , ke:ISO21838_3 , ke:ISO21838_4 , ke:ISO21838_5 ;
    skos:narrower ke:ISO21838_1 , ke:ISO21838_2 , ke:ISO21838_3 , ke:ISO21838_4 , ke:ISO21838_5 .
ke:ISO21838_1 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO21838 ;
    skos:notation "ISO/IEC 21838-1" ; skos:prefLabel "Part 1: Requirements"@en ;
    ke:designation "ISO/IEC 21838-1:2021" ; ke:edition 1 ; dcterms:issued "2021"^^xsd:gYear ;
    ke:status ke:Status_UnderReview ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Requirements" ;
    dcterms:isPartOf ke:ISO21838 ;
    dcterms:description "What a top-level ontology must provide to act as a hub for domain ontologies."@en ;
    ke:relevance "Yardstick for choosing BFO."@en ;
    ke:isoPage <https://www.iso.org/standard/71954.html> .
ke:ISO21838_2 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO21838 ;
    skos:notation "ISO/IEC 21838-2" ; skos:prefLabel "Part 2: Basic Formal Ontology (BFO)"@en ;
