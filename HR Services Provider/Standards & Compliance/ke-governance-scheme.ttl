###############################################################################
#  Knowledge Engineering & Semantic Governance scheme (SKOS) — v0.3.0
#  For knowledge engineering teams at an HR services provider (PEO).
#
#  Covers: the knowledge artifact types (vocabulary → taxonomy → thesaurus →
#  ontology → knowledge graph), a 10-stage semantic governance lifecycle,
#  persistent vs virtual graph deployment, and the ISO standards (plus W3C
#  companion specifications) that guide each stage.
#
#  Finding (checked 2026-09-30): no single ISO standard covers the full
#  lifecycle. ISO/IEC 5392:2024 (KE reference architecture) is the closest
#  umbrella; the stages are guided by terminology (TC 37), thesaurus (TC 46),
#  top-level ontology and metadata-registry (JTC 1/SC 32), database language
#  (SC 32 WG3: GQL, SQL/PGQ), AI and data quality (SC 42), privacy (SC 27)
#  and HR / knowledge management (TC 260) standards.
#
#  Replaces the telecom-specific concepts of v0.2.0.
###############################################################################
@prefix ke:      <https://enablingvalue.com/ontology/ke-scheme#> .
@prefix pes:     <https://enablingvalue.com/ontology/peo-es#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ke:Scheme a skos:ConceptScheme ;
    skos:prefLabel "Knowledge Engineering and Semantic Governance"@en ;
    dcterms:source "MindMap (KE).svg" ;
    owl:versionInfo "0.3.0" ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    skos:hasTopConcept ke:OntologyBasedRepresentation , ke:KnowledgeArtifactTypes , ke:GovernanceLifecycle ,
                       ke:GraphDeploymentModels , ke:DomainModeling , ke:ISOStandardsForKE , ke:CompanionSpecs ,
                       ke:MFI , ke:EmploymentStandardsOntology , ke:UpperOntologies .

#################################################################
#  Metadata vocabulary for standards and lifecycle links
#################################################################
ke:Standard a owl:Class ; rdfs:label "Standard"@en ;
    skos:definition "A single published or draft standards document with its own designation and edition."@en .
ke:StandardSeries a owl:Class ; rdfs:label "Standard Series"@en ;
    skos:definition "A multipart standard whose parts are published as separate documents under a shared number."@en .
ke:Specification a owl:Class ; rdfs:label "Companion specification"@en ;
    skos:definition "A non-ISO technical specification (e.g. a W3C Recommendation) that implements a lifecycle stage."@en .

ke:designation     a owl:DatatypeProperty ; rdfs:label "designation"@en .
ke:edition         a owl:DatatypeProperty ; rdfs:label "edition"@en ; rdfs:range xsd:integer .
ke:committee       a owl:DatatypeProperty ; rdfs:label "committee"@en .
ke:contentType     a owl:DatatypeProperty ; rdfs:label "content type"@en .
ke:relevance       a owl:DatatypeProperty ; rdfs:label "use at a PEO"@en ;
    skos:definition "How the standard applies to knowledge engineering for HR services / employment compliance."@en .
ke:newSince2022    a owl:DatatypeProperty ; rdfs:label "new since 2022"@en ; rdfs:range xsd:boolean ;
    skos:definition "True if this edition was published, or is in development, in 2022 or later."@en .
ke:status          a owl:ObjectProperty ; rdfs:label "status"@en ; rdfs:range ke:LifecycleStatus .
ke:isoPage         a owl:ObjectProperty ; rdfs:label "iso.org page"@en .
ke:guidedBy        a owl:ObjectProperty ; rdfs:label "guided by"@en ;
    skos:definition "A standard or specification that gives requirements or guidance for this stage, artifact or deployment model."@en .
ke:projectExample  a owl:DatatypeProperty ; rdfs:label "in this project"@en ;
    skos:definition "Where this concept shows up in the PEO Employment Standards Ontology files."@en .
dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:issued a owl:AnnotationProperty .
dcterms:replaces a owl:ObjectProperty .
dcterms:isReplacedBy a owl:ObjectProperty ; owl:inverseOf dcterms:replaces .
dcterms:hasPart a owl:ObjectProperty .
dcterms:isPartOf a owl:ObjectProperty ; owl:inverseOf dcterms:hasPart .

ke:LifecycleStatus a owl:Class ; rdfs:label "Lifecycle Status"@en .
ke:StatusScheme a skos:ConceptScheme ; skos:prefLabel "Standard lifecycle status"@en .
ke:Status_Current a ke:LifecycleStatus , skos:Concept ; skos:inScheme ke:StatusScheme ;
    skos:prefLabel "Published — current"@en ; skos:notation "60.60 / 90.93" .
ke:Status_UnderReview a ke:LifecycleStatus , skos:Concept ; skos:inScheme ke:StatusScheme ;
    skos:prefLabel "Published — under systematic review"@en ; skos:notation "90.20" .
ke:Status_ToBeRevised a ke:LifecycleStatus , skos:Concept ; skos:inScheme ke:StatusScheme ;
    skos:prefLabel "Published — to be revised"@en ; skos:notation "90.92" .
ke:Status_Draft a ke:LifecycleStatus , skos:Concept ; skos:inScheme ke:StatusScheme ;
    skos:prefLabel "Under development"@en ; skos:notation "00–50" .
ke:Status_Withdrawn a ke:LifecycleStatus , skos:Concept ; skos:inScheme ke:StatusScheme ;
    skos:prefLabel "Withdrawn"@en ; skos:notation "95.99" .

#################################################################
#  Ontology-Based Representation (from the mind map)
#################################################################
ke:OntologyBasedRepresentation a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Ontology-Based Representation"@en ;
    skos:narrower ke:IntegrationAndSharingOfKnowledge , ke:IntelligentReasoning .
ke:IntegrationAndSharingOfKnowledge a skos:Concept ; skos:inScheme ke:Scheme ;
    skos:prefLabel "Integration and Sharing of Knowledge"@en ; skos:broader ke:OntologyBasedRepresentation .
ke:IntelligentReasoning a skos:Concept ; skos:inScheme ke:Scheme ;
    skos:prefLabel "Intelligent Reasoning"@en ; skos:broader ke:OntologyBasedRepresentation ;
    skos:narrower ke:ConceptClassification , ke:SemanticDescription , ke:LogicReasoning .
ke:ConceptClassification a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:IntelligentReasoning ;
    skos:prefLabel "Concept Classification"@en ;
    ke:projectExample "A reasoner classifies each law as pes:FederalStandard, pes:StateStandard or pes:LocalStandard from where it applies."@en .
ke:SemanticDescription a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:IntelligentReasoning ;
    skos:prefLabel "Semantic Description"@en .
ke:LogicReasoning a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:IntelligentReasoning ;
    skos:prefLabel "Logic Reasoning"@en ;
    ke:projectExample "Property chains infer pes:subjectTo: a Chicago worksite is subject to Chicago, Cook County, Illinois and federal standards."@en .

#################################################################
#  Knowledge artifact types
#################################################################
ke:KnowledgeArtifactTypes a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Knowledge Artifact Types"@en ;
    skos:scopeNote "Ordered by increasing semantic commitment. Each builds on the one before; governance applies to all of them."@en ;
    skos:narrower ke:Art_Vocabulary , ke:Art_Taxonomy , ke:Art_Thesaurus , ke:Art_Ontology , ke:Art_KnowledgeGraph , ke:Art_Shapes .
ke:Art_Vocabulary a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "1" ;
    skos:prefLabel "Controlled vocabulary / term base"@en ;
    skos:definition "Agreed terms with definitions, preferred and alternative labels."@en ;
    ke:guidedBy ke:ISO704 , ke:ISO1087 , ke:ISO12620_1 , ke:ISO30042 , ke:ISO26162_1 , ke:ISO30400 ;
    ke:projectExample "Labels, altLabels and definitions throughout; HR terms cross-checked with ISO 30400."@en .
ke:Art_Taxonomy a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "2" ;
    skos:prefLabel "Taxonomy"@en ;
    skos:definition "Terms arranged in broader/narrower hierarchies for classification and navigation."@en ;
    ke:guidedBy ke:ISO25964_1 , ke:W3C_SKOS ;
    ke:projectExample "peo-topics.ttl — compliance topic taxonomy."@en .
ke:Art_Thesaurus a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "3" ;
    skos:prefLabel "Thesaurus and mappings"@en ;
    skos:definition "A taxonomy plus associative relations, scope notes, and mappings to other vocabularies."@en ;
    ke:guidedBy ke:ISO25964_1 , ke:ISO25964_2 , ke:W3C_SKOS ;
    ke:projectExample "skos:related links (AI in employment ↔ anti-discrimination); mappings to ISO 30400 terms are the next step."@en .
ke:Art_Ontology a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "4" ;
    skos:prefLabel "Ontology"@en ;
    skos:definition "Classes, properties and logical axioms, aligned to a top-level ontology, that a reasoner can use."@en ;
    ke:guidedBy ke:ISO21838_1 , ke:ISO21838_2 , ke:ISO5392 , ke:W3C_OWL2 ;
    ke:projectExample "peo-es.ttl — OWL 2 DL, aligned to BFO."@en .
ke:Art_KnowledgeGraph a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "5" ;
    skos:prefLabel "Knowledge graph (instance data)"@en ;
    skos:definition "Facts about real things, typed by the ontology and classified by the taxonomy, stored or virtualized as a graph."@en ;
    ke:guidedBy ke:ISO39075 , ke:ISO9075_16 , ke:W3C_SPARQL , ke:W3C_R2RML , ke:ISO5259 ;
    ke:projectExample "peo-standards.ttl (reference data) and peo-examples.ttl (client data)."@en .
ke:Art_Shapes a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:KnowledgeArtifactTypes ; skos:notation "6" ;
    skos:prefLabel "Constraint shapes"@en ;
    skos:definition "Closed-world data quality rules checked before each release."@en ;
    ke:guidedBy ke:W3C_SHACL , ke:ISO5259 ;
    ke:projectExample "peo-shapes.ttl."@en .

#################################################################
#  Semantic governance lifecycle (10 stages)
#################################################################
ke:GovernanceLifecycle a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Semantic Governance Lifecycle"@en ;
    skos:definition "The stages a vocabulary, taxonomy, ontology or knowledge graph passes through from scoping to retirement, with the standards that guide each."@en ;
    skos:scopeNote "No single ISO standard covers this whole lifecycle (checked 2026-09-30). ISO/IEC 5392:2024 gives the overall KE reference architecture; the stage-level guidance comes from the standards linked to each stage."@en ;
    skos:narrower ke:Stage01_Scope , ke:Stage02_Acquire , ke:Stage03_Terminology , ke:Stage04_Organize , ke:Stage05_Formalize ,
                  ke:Stage06_Validate , ke:Stage07_Register , ke:Stage08_Deploy , ke:Stage09_Operate , ke:Stage10_Change .
ke:Stage01_Scope a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "1" ;
    skos:prefLabel "Scope and competency questions"@en ;
    skos:definition "Agree what the knowledge must answer, for whom, and who owns it."@en ;
    ke:guidedBy ke:ISO5392 , ke:ISO30401 , ke:ISO42001 ;
    ke:projectExample "Which standards apply to a client worksite given its location and headcount? Who carries each requirement under the client service agreement?"@en .
ke:Stage02_Acquire a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "2" ;
    skos:prefLabel "Acquire knowledge and provenance"@en ;
    skos:definition "Collect authoritative sources and expert input, recording where each fact came from."@en ;
    ke:guidedBy ke:ISO5392 , ke:ISO30401 , ke:W3C_PROV ;
    ke:projectExample "Statutes, agency pages and counsel review; pes:verifiedAgainst records the source URL."@en .
ke:Stage03_Terminology a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "3" ;
    skos:prefLabel "Define terms"@en ;
    skos:definition "Choose preferred terms, write intensional definitions, and record term metadata."@en ;
    ke:guidedBy ke:ISO704 , ke:ISO1087 , ke:ISO12620_1 , ke:ISO30042 , ke:ISO26162_1 , ke:ISO30400 .
ke:Stage04_Organize a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "4" ;
    skos:prefLabel "Organize concepts"@en ;
    skos:definition "Build hierarchies and associative relations, and map to external vocabularies."@en ;
    ke:guidedBy ke:ISO25964_1 , ke:ISO25964_2 , ke:W3C_SKOS .
ke:Stage05_Formalize a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "5" ;
    skos:prefLabel "Formalize the ontology"@en ;
    skos:definition "Express classes, relations and axioms and align them to a top-level ontology."@en ;
    ke:guidedBy ke:ISO21838_1 , ke:ISO21838_2 , ke:ISO21838_5 , ke:ISO5392 , ke:W3C_OWL2 .
ke:Stage06_Validate a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "6" ;
    skos:prefLabel "Validate"@en ;
    skos:definition "Check logical consistency with a reasoner, data quality with shapes, and content with subject-matter and legal reviewers."@en ;
    ke:guidedBy ke:ISO5259 , ke:W3C_SHACL ;
    ke:projectExample "peo-shapes.ttl blocks releases on violations and lists unverified records as warnings."@en .
ke:Stage07_Register a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "7" ;
    skos:prefLabel "Register and publish"@en ;
    skos:definition "Record each artifact, version and registration status in a metadata registry so others can find and trust it."@en ;
    ke:guidedBy ke:ISO11179_3 , ke:ISO11179_32 , ke:ISO11179_35 , ke:ISO19763_1 , ke:ISO19763_3 .
ke:Stage08_Deploy a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "8" ;
    skos:prefLabel "Deploy as persistent or virtual graphs"@en ;
    skos:definition "Load the graph into a store, or expose existing databases as a graph without copying them."@en ;
    ke:guidedBy ke:ISO39075 , ke:ISO9075_16 , ke:W3C_SPARQL , ke:W3C_R2RML ;
    skos:related ke:GraphDeploymentModels .
ke:Stage09_Operate a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "9" ;
    skos:prefLabel "Operate, protect and measure"@en ;
    skos:definition "Control access to worker data, assess AI uses of the graph, monitor quality, and report."@en ;
    ke:guidedBy ke:ISO27701 , ke:ISO42001 , ke:ISO42005 , ke:ISO5259 , ke:ISO30414 ;
    ke:projectExample "An HR assistant that answers leave questions from the graph needs an AI impact assessment and PII controls."@en .
ke:Stage10_Change a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GovernanceLifecycle ; skos:notation "10" ;
    skos:prefLabel "Change, version and retire"@en ;
    skos:definition "Track legal changes, issue new versions, deprecate rather than delete, and retain history."@en ;
    ke:guidedBy ke:ISO30300 , ke:ISO11179_3 , ke:ISO30401 ;
    ke:projectExample "The 2024 FLSA overtime rule is kept with status Rescinded; each wage rate is a dated record, not an overwrite."@en .

#################################################################
#  Graph deployment models
#################################################################
ke:GraphDeploymentModels a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Graph Deployment Models"@en ;
    skos:narrower ke:PersistentGraph , ke:VirtualGraph , ke:HybridGraph .
ke:PersistentGraph a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GraphDeploymentModels ;
    skos:prefLabel "Persistent (materialized) graph"@en ;
    skos:definition "Graph data copied into and stored by a graph database."@en ;
    skos:narrower ke:RDFStore , ke:PropertyGraphStore .
ke:RDFStore a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:PersistentGraph ;
    skos:prefLabel "RDF triple store"@en ;
    skos:definition "Stores RDF triples, supports OWL reasoning and SPARQL queries."@en ;
    ke:guidedBy ke:W3C_SPARQL , ke:W3C_OWL2 , ke:W3C_SHACL .
ke:PropertyGraphStore a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:PersistentGraph ;
    skos:prefLabel "Labeled property graph database"@en ;
    skos:definition "Stores nodes and edges with labels and key–value properties, queried with GQL."@en ;
    ke:guidedBy ke:ISO39075 .
ke:VirtualGraph a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GraphDeploymentModels ;
    skos:prefLabel "Virtual graph"@en ;
    skos:definition "A graph view over data that stays in its source systems (payroll, HRIS, benefits), translated at query time."@en ;
    skos:narrower ke:OBDA , ke:SQLPGQView .
ke:OBDA a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:VirtualGraph ;
    skos:prefLabel "Ontology-based data access (R2RML)"@en ;
    skos:definition "Mappings from relational tables to ontology terms let SPARQL queries run over SQL databases."@en ;
    ke:guidedBy ke:W3C_R2RML , ke:W3C_SPARQL .
ke:SQLPGQView a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:VirtualGraph ;
    skos:prefLabel "SQL/PGQ property graph view"@en ;
    skos:definition "A property graph defined over existing SQL tables with CREATE PROPERTY GRAPH and queried with GRAPH_TABLE."@en ;
    ke:guidedBy ke:ISO9075_16 ;
    skos:example "CREATE PROPERTY GRAPH peo_compliance VERTEX TABLES (worksite KEY (site_id) LABEL Worksite, jurisdiction KEY (jur_id) LABEL Jurisdiction) EDGE TABLES (site_location KEY (site_id) SOURCE KEY (site_id) REFERENCES worksite (site_id) DESTINATION KEY (jur_id) REFERENCES jurisdiction (jur_id) LABEL locatedIn)" .
ke:HybridGraph a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:GraphDeploymentModels ;
    skos:prefLabel "Hybrid"@en ;
    skos:definition "Persist the slow-changing reference graph; virtualize the fast-changing operational data."@en ;
    ke:projectExample "Persist peo-es, peo-topics and peo-standards (laws change a few times a year); expose client, worksite and headcount data from the HRIS as a virtual graph so it is never stale or duplicated."@en .

#################################################################
#  Domain modeling levels (from the mind map)
#################################################################
ke:DomainModeling a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "Domain Modeling"@en ;
    skos:narrower ke:Domain , ke:PrimaryClass , ke:SecondaryClass , ke:Instances .
ke:Domain a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:DomainModeling ;
    skos:prefLabel "Domain"@en ; skos:example "Employment-standards compliance for PEO co-employment"@en .
ke:PrimaryClass a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:DomainModeling ;
    skos:prefLabel "Primary Class"@en ;
    skos:example "pes:EmploymentStandard, pes:Requirement, pes:Jurisdiction, pes:Employer, pes:ClientServiceAgreement" .
ke:SecondaryClass a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:DomainModeling ;
    skos:prefLabel "Secondary Class"@en ;
    skos:example "pes:Ordinance, pes:MunicipalJurisdiction, pes:ProfessionalEmployerOrganization, pes:ResponsibilityAllocation" .
ke:Instances a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:DomainModeling ;
    skos:prefLabel "Instances"@en ; skos:example "See peo-standards.ttl and peo-examples.ttl"@en .

#################################################################
#  ISO standards — grouped by role
#################################################################
ke:ISOStandardsForKE a skos:Concept ; skos:inScheme ke:Scheme ; skos:topConceptOf ke:Scheme ;
    skos:prefLabel "ISO Standards for Knowledge Engineering"@en ;
    skos:narrower ke:Grp_Architecture , ke:Grp_Terminology , ke:Grp_Thesauri , ke:Grp_Ontology , ke:Grp_Registries ,
                  ke:Grp_GraphData , ke:Grp_Quality , ke:Grp_HR , ke:Grp_Other .
ke:Grp_Architecture a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "KE architecture and knowledge management"@en ; skos:narrower ke:ISO5392 , ke:ISO30401 , ke:ISO30401_ed2 .
ke:Grp_Terminology a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Terminology (vocabularies)"@en ; skos:narrower ke:ISO704 , ke:ISO1087 , ke:ISO12620_1 , ke:ISO30042 , ke:ISO26162_1 .
ke:Grp_Thesauri a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Thesauri and taxonomies"@en ; skos:narrower ke:ISO25964 , ke:ISO5964 .
ke:Grp_Ontology a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Top-level ontologies"@en ; skos:narrower ke:ISO21838 .
ke:Grp_Registries a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Metadata and model registries"@en ; skos:narrower ke:ISO11179 , ke:ISO19763 .
ke:Grp_GraphData a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Graph data (persistent and virtual)"@en ; skos:narrower ke:ISO39075 , ke:ISO9075_16 , ke:ISO9075_16_ed2 , ke:ISO13250 .
ke:Grp_Quality a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Data quality, AI and privacy governance"@en ; skos:narrower ke:ISO5259 , ke:ISO42001 , ke:ISO42005 , ke:ISO27701 .
ke:Grp_HR a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "HR domain and records"@en ; skos:narrower ke:ISO30400 , ke:ISO30414 , ke:ISO30300 .
ke:Grp_Other a skos:Concept ; skos:inScheme ke:Scheme ; skos:broader ke:ISOStandardsForKE ;
    skos:prefLabel "Other standards from the mind map"@en ; skos:narrower ke:ISO21127 , ke:ISO80000_1 .

### KE architecture ---------------------------------------------------------
ke:ISO5392 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Architecture ;
    skos:notation "ISO/IEC 5392" ;
    skos:prefLabel "ISO/IEC 5392 — Reference architecture of knowledge engineering"@en ;
    dcterms:title "Information technology — Artificial intelligence — Reference architecture of knowledge engineering"@en ;
    ke:designation "ISO/IEC 5392:2024" ; ke:edition 1 ; dcterms:issued "2024"^^xsd:gYear ;
    ke:status ke:Status_UnderReview ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/IEC JTC 1/SC 42" ; ke:contentType "Reference architecture + terminology" ;
    dcterms:description "Defines a reference architecture for knowledge engineering in AI: the roles, activities, layers and components involved and how they connect, with standard KE terminology. Published March 2024."@en ;
    ke:relevance "The closest thing to an umbrella standard for a KE team: use it to define team roles and the activities in each lifecycle stage."@en ;
    ke:isoPage <https://www.iso.org/standard/81228.html> .

ke:ISO30401 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Architecture ;
    skos:notation "ISO 30401" ;
    skos:prefLabel "ISO 30401 — Knowledge management systems: Requirements"@en ;
    ke:designation "ISO 30401:2018" ; ke:edition 1 ; dcterms:issued "2018"^^xsd:gYear ;
    ke:status ke:Status_ToBeRevised ;
    ke:committee "ISO/TC 260" ; ke:contentType "Management system requirements" ;
    dcterms:description "Requirements for establishing, running and improving a knowledge management system; amended in 2022 and 2024."@en ;
    ke:relevance "Frames the KE team's governance as a certifiable management system (policy, roles, review, improvement)."@en ;
    dcterms:isReplacedBy ke:ISO30401_ed2 .
ke:ISO30401_ed2 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Architecture ;
    skos:notation "ISO/DIS 30401" ;
    skos:prefLabel "ISO/DIS 30401 — Knowledge management systems (edition 2)"@en ;
    ke:designation "ISO/DIS 30401" ; ke:edition 2 ;
    ke:status ke:Status_Draft ; ke:newSince2022 "true"^^xsd:boolean ;
    ke:committee "ISO/TC 260" ; ke:contentType "Management system requirements" ;
    dcterms:description "Second edition; enquiry vote closed 2026-09-18. Will replace ISO 30401:2018 and its two amendments."@en ;
    ke:relevance "Watch item: plan to align the KE team's management system to edition 2."@en ;
    dcterms:replaces ke:ISO30401 ;
    ke:isoPage <https://www.iso.org/standard/89436.html> .

### Terminology -------------------------------------------------------------
ke:ISO704 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Terminology ;
    skos:notation "ISO 704" ;
    skos:prefLabel "ISO 704 — Terminology work: Principles and methods"@en ;
    ke:designation "ISO 704:2022" ; ke:edition 4 ; dcterms:issued "2022"^^xsd:gYear ;
