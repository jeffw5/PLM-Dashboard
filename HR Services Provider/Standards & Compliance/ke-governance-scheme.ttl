    dcterms:isPartOf ke:ISO21838 ;
    dcterms:description "BFO-2020 terms, relations and axiomatizations in OWL 2 and Common Logic."@en ;
    ke:relevance "Used: laws, requirements, agreements ⊑ generically dependent continuant; jurisdictions, worksites ⊑ site; organizations ⊑ material entity; workers ⊑ object."@en ;
    rdfs:seeAlso pes:EmploymentStandard , pes:Jurisdiction , pes:Organization ;
    ke:isoPage <https://www.iso.org/standard/74572.html> .
ke:ISO21838_3 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO21838 ;
    skos:notation "ISO/IEC 21838-3" ; skos:prefLabel "Part 3: DOLCE"@en ;
    ke:designation "ISO/IEC 21838-3:2023" ; dcterms:issued "2023"^^xsd:gYear ;
