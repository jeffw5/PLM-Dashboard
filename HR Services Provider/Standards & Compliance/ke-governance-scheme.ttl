ke:ISO26162_1 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Terminology ;
    skos:notation "ISO 26162-1" ;
    skos:prefLabel "ISO 26162-1 — Terminology databases: Design"@en ;
    ke:designation "ISO 26162-1:2019" ; dcterms:issued "2019"^^xsd:gYear ;
    ke:status ke:Status_Current ;
    ke:committee "ISO/TC 37/SC 3" ; ke:contentType "Guidance (database design)" ;
    dcterms:description "Principles for designing terminology databases."@en ;
    ke:relevance "Design reference if the term base is kept outside the graph."@en .

### Thesauri ----------------------------------------------------------------
ke:ISO25964 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Thesauri ;
    skos:notation "ISO 25964" ;
    skos:prefLabel "ISO 25964 — Thesauri and interoperability with other vocabularies"@en ;
    ke:committee "ISO/TC 46/SC 9" ; ke:contentType "Guidance + data model" ;
    dcterms:description "The international reference for building thesauri and mapping them to other vocabularies."@en ;
    ke:relevance "Governs peo-topics.ttl and its mappings to ISO 30400 and to vendor HRIS code lists."@en ;
    dcterms:replaces ke:ISO5964 ;
    dcterms:hasPart ke:ISO25964_1 , ke:ISO25964_2 , ke:ISO25964_1_ed2 ; skos:narrower ke:ISO25964_1 , ke:ISO25964_2 , ke:ISO25964_1_ed2 .
