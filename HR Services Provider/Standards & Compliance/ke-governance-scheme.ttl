    dcterms:isPartOf ke:ISO21838 ;
    dcterms:description "Descriptive Ontology for Linguistic and Cognitive Engineering."@en ;
    ke:relevance "Alternative upper layer; not used."@en .
ke:ISO21838_4 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO21838 ;
    skos:notation "ISO/IEC 21838-4" ; skos:prefLabel "Part 4: TUpper"@en ;
    ke:designation "ISO/IEC 21838-4:2023" ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Top-level ontology" ;
    dcterms:isPartOf ke:ISO21838 ;
    dcterms:description "TUpper, a modular top-level ontology."@en ;
    ke:relevance "Alternative upper layer; not used."@en .
ke:ISO21838_5 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO21838 ;
    skos:notation "ISO/IEC DIS 21838-5" ; skos:prefLabel "Part 5: Unified Foundational Ontology (UFO) — draft"@en ;
    ke:designation "ISO/IEC DIS 21838-5" ; ke:edition 1 ;
    ke:status ke:Status_Draft ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Top-level ontology" ;
    dcterms:isPartOf ke:ISO21838 ;
    dcterms:description "Standardizes the Unified Foundational Ontology; DIS vote closed 2026-09-01."@en ;
    ke:relevance "UFO has strong support for roles, relators and social commitments — a good fit for co-employment and contracts. Worth evaluating against BFO for the agreement model."@en ;
    ke:isoPage <https://www.iso.org/standard/89915.html> .

### Registries ----------------------------------------------------------------
ke:ISO11179 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Registries ;
    skos:notation "ISO/IEC 11179" ;
    skos:prefLabel "ISO/IEC 11179 — Metadata registries (MDR)"@en ;
    ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Metamodels" ;
    dcterms:description "Metamodels for registering data elements, concept systems and models, with registration status, stewardship and versioning. The fourth edition (2023) restructured the series."@en ;
    ke:relevance "Backbone of semantic governance: who owns each term, class and code list, its registration status, and its versions."@en ;
    dcterms:hasPart ke:ISO11179_3 , ke:ISO11179_32 , ke:ISO11179_35 ; skos:narrower ke:ISO11179_3 , ke:ISO11179_32 , ke:ISO11179_35 .
ke:ISO11179_3 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO11179 ;
    skos:notation "ISO/IEC 11179-3" ; skos:prefLabel "Part 3: Metamodel for registry common facilities"@en ;
    ke:designation "ISO/IEC 11179-3:2023" ; ke:edition 4 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Metamodel" ;
    dcterms:isPartOf ke:ISO11179 ;
    dcterms:description "Core registry model: identification, designation, definition, registration, classification and mapping between registered items. Amendment 1 (2026) enhances item mapping."@en ;
