    ke:status ke:Status_Current ;
    ke:committee "ISO/TC 37/SC 1" ; ke:contentType "Vocabulary" ;
    dcterms:description "Basic terms of terminology work: concept, characteristic, definition, designation, concept system. Replaced ISO 1087-1:2000."@en ;
    ke:relevance "Shared vocabulary for the KE team and legal/HR reviewers."@en ;
    ke:isoPage <https://www.iso.org/standard/62330.html> .
ke:ISO12620_1 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Terminology ;
    skos:notation "ISO 12620-1" ;
    skos:prefLabel "ISO 12620-1 — Data category specifications"@en ;
