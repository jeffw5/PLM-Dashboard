    skos:notation "ISO/IEC 19763-1" ; skos:prefLabel "Part 1: Framework"@en ;
    ke:designation "ISO/IEC 19763-1:2023" ; ke:edition 3 ; dcterms:issued "2023"^^xsd:gYear ;
