    ke:designation "ISO/IEC 11179-32:2023" ; ke:edition 1 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Metamodel" ;
    dcterms:isPartOf ke:ISO11179 ;
    dcterms:description "Registers concept systems — taxonomies, thesauri, ontologies — with their concepts, relations and assertions."@en ;
    ke:relevance "Register peo-topics and peo-es as concept systems in the enterprise metadata registry."@en ;
    ke:isoPage <https://www.iso.org/standard/78926.html> .
ke:ISO11179_35 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO11179 ;
    skos:notation "ISO/IEC 11179-35" ; skos:prefLabel "Part 35: Metamodel for model registration"@en ;
    ke:designation "ISO/IEC 11179-35:2023" ; ke:edition 1 ; dcterms:issued "2023"^^xsd:gYear ;
    ke:status ke:Status_Current ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Metamodel" ;
    dcterms:isPartOf ke:ISO11179 ;
    dcterms:description "Registers data, process and service models and mappings between them."@en ;
    ke:relevance "Register the HRIS/payroll schemas and their R2RML or SQL/PGQ mappings to the ontology."@en ;
    ke:isoPage <https://www.iso.org/standard/81727.html> .
ke:ISO19763 a skos:Concept , ke:StandardSeries ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Registries ;
    skos:notation "ISO/IEC 19763" ;
    skos:prefLabel "ISO/IEC 19763 — Metamodel framework for interoperability (MFI)"@en ;
    ke:committee "ISO/IEC JTC 1/SC 32" ; ke:contentType "Metamodels" ;
