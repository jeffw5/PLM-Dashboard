    skos:notation "ISO 25964-1" ; skos:prefLabel "Part 1: Thesauri for information retrieval"@en ;
    ke:designation "ISO 25964-1:2011" ; ke:edition 1 ; dcterms:issued "2011"^^xsd:gYear ;
    ke:status ke:Status_ToBeRevised ; ke:committee "ISO/TC 46/SC 9" ; ke:contentType "Guidance + data model" ;
    dcterms:isPartOf ke:ISO25964 ; dcterms:replaces ke:ISO5964 ; dcterms:isReplacedBy ke:ISO25964_1_ed2 ;
    dcterms:description "Constructing and maintaining monolingual and multilingual thesauri, with an exchange data model."@en ;
    ke:relevance "Rules for broader/narrower/related relations and scope notes in the topic taxonomy."@en ;
    ke:isoPage <https://www.iso.org/standard/53657.html> .
ke:ISO25964_1_ed2 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO25964 ;
    skos:notation "ISO/FDIS 25964-1" ; skos:prefLabel "Part 1, edition 2 (draft)"@en ;
    ke:designation "ISO/FDIS 25964-1" ; ke:edition 2 ;
    ke:status ke:Status_Draft ; ke:newSince2022 "true"^^xsd:boolean ; ke:committee "ISO/TC 46/SC 9" ; ke:contentType "Guidance + data model" ;
    dcterms:isPartOf ke:ISO25964 ; dcterms:replaces ke:ISO25964_1 ;
    dcterms:description "Second edition at FDIS ballot since August 2026."@en ;
    ke:relevance "Watch item: review the updated data model before the next taxonomy release."@en ;
    ke:isoPage <https://www.iso.org/standard/86713.html> .
ke:ISO25964_2 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:ISO25964 ;
    skos:notation "ISO 25964-2" ; skos:prefLabel "Part 2: Interoperability with other vocabularies"@en ;
    ke:designation "ISO 25964-2:2013" ; ke:edition 1 ; dcterms:issued "2013"^^xsd:gYear ;
    ke:status ke:Status_ToBeRevised ; ke:committee "ISO/TC 46/SC 9" ; ke:contentType "Guidance (mapping)" ;
    dcterms:isPartOf ke:ISO25964 ; dcterms:replaces ke:ISO5964 ;
    dcterms:description "Compares thesauri with taxonomies, ontologies, classification schemes and other vocabularies, and gives guidance on mapping between them."@en ;
    ke:relevance "Guides crosswalks from the topic taxonomy to ISO 30400 terms, O*NET/SOC occupations and payroll earning codes."@en ;
    ke:isoPage <https://www.iso.org/standard/53658.html> .
ke:ISO5964 a skos:Concept , ke:Standard ; skos:inScheme ke:Scheme ; skos:broader ke:Grp_Thesauri ;
    skos:notation "ISO 5964" ; skos:prefLabel "ISO 5964 — Multilingual thesauri (withdrawn)"@en ;
    ke:designation "ISO 5964:1985" ; dcterms:issued "1985"^^xsd:gYear ;
