#################################################################
#  Requirements (deontic norms)
#################################################################
esd:Req_PayMinimumWage a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Pay at least the applicable minimum wage"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:MinimumWage ;
    pes:establishedBy esd:FLSA , esd:IL_MWL , esd:COOK_MWO , esd:CHI_MWO , esd:TX_MWA , esd:CA_MinWage , esd:NY_MinWage ;
    skos:note "Where several rates apply, the highest governs."@en .
esd:Req_PayOvertime a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Pay overtime to non-exempt workers"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:Overtime ; pes:establishedBy esd:FLSA , esd:IL_MWL .
esd:Req_ProvidePaidLeave a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Provide accrued paid sick or any-purpose leave"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:PaidSickLeave ;
    pes:establishedBy esd:IL_PLAWA , esd:COOK_PLO , esd:CHI_PLO , esd:CA_PSL , esd:NY_PSL , esd:NYC_ESSTA .
esd:Req_ProvidePrenatalLeave a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Provide paid prenatal leave"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:PrenatalLeave ; pes:establishedBy esd:NY_PrenatalLeave , esd:NYC_ESSTA .
esd:Req_FamilyMedicalLeave a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Grant job-protected family and medical leave"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:FamilyMedicalLeave ; pes:establishedBy esd:FMLA , esd:CFRA .
esd:Req_NoDiscrimination a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Do not discriminate on a protected characteristic"@en ; pes:deonticModality pes:Prohibition ;
    pes:coversTopic topic:AntiDiscrimination ;
    pes:establishedBy esd:TitleVII , esd:ADA , esd:ADEA , esd:IHRA , esd:TCHRA , esd:FEHA , esd:NYSHRL .
esd:Req_Accommodate a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Provide reasonable accommodation"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:Accommodation ; pes:establishedBy esd:ADA , esd:PWFA , esd:FEHA .
esd:Req_EqualPay a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Do not pay unequally by sex for equal work"@en ; pes:deonticModality pes:Prohibition ;
    pes:coversTopic topic:PayTransparency ; pes:establishedBy esd:EPA .
esd:Req_PostPayRange a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Post the pay range in job advertisements"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:PayTransparency ;
    pes:establishedBy esd:IL_EPA_Transparency , esd:CA_PayTransparency , esd:NYC_PayTransparency .
esd:Req_NoticeOfAIUse a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Notify candidates and employees when AI is used in employment decisions"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:AIInEmployment ; pes:establishedBy esd:IL_AI_HB3773 , esd:NYC_LL144 .
esd:Req_BiasAudit a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Obtain an annual independent bias audit of automated hiring tools"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:AIInEmployment ; pes:establishedBy esd:NYC_LL144 .
esd:Req_NoDiscriminatoryAI a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Do not use AI that has a discriminatory effect"@en ; pes:deonticModality pes:Prohibition ;
    pes:coversTopic topic:AIInEmployment , topic:AntiDiscrimination ; pes:establishedBy esd:IL_AI_HB3773 .
esd:Req_BiometricConsent a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Obtain written consent before collecting biometrics"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:BiometricPrivacy ; pes:establishedBy esd:BIPA .
esd:Req_VerifyEligibility a owl:NamedIndividual , pes:Requirement ;
    rdfs:label "Verify identity and work authorization on Form I-9"@en ; pes:deonticModality pes:Obligation ;
    pes:coversTopic topic:WorkforceEligibility ; pes:establishedBy esd:IRCA .
esd:Req_WithholdTaxes a owl:NamedIndividual , pes:Requirement ;
