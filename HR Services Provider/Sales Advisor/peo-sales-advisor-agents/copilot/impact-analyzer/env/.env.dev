# Environment variables for the dev environment. Values written by provision are filled in automatically.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Generated during provision
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=

# OAuth client registration for the Keel Gateway (Teams Developer Portal > OAuth client registration, Entra ID)
MCP_DA_AUTH_ID=

# Public URL of the Keel Gateway MCP endpoint (Streamable HTTP)
KEEL_GATEWAY_MCP_URL=https://keel-gateway.example.com/mcp
