# Copy to .env next to infra/docker-compose.yml
FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com
FOUNDRY_MODEL=<standard model deployment>
FOUNDRY_REASONING_MODEL=<reasoning model deployment for tier-1 agents>
KEEL_SERVICE_TOKEN=<shared secret between gateway and agents host>
KEEL_ADMIN_TOKEN=<owner token for breaker reset, kill switch and local approvals>
KEEL_ENTRA_TENANT_ID=<Entra tenant ID>
KEEL_ENTRA_AUDIENCE=<Application ID URI or client ID of the gateway app registration>
KEEL_AUDIT_KEY=<HMAC key for the audit chain, from Key Vault>

# Microservice base URLs; leave unset to use the gateway's labelled stubs
