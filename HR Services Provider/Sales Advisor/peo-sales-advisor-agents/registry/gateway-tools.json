      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Action being requested, e.g. read, serve_to_persona, publish, send"
          },
          "resource_uri": {
            "type": "string",
            "description": "URI of the resource or record"
          },
          "context": {
            "type": "object",
            "description": "Context bundle values: who, persona, tenant, jurisdiction, purpose"
          }
        },
        "required": [
          "action",
          "resource_uri"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
