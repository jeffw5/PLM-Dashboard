# =================================================================
# EXTENSION: CAPABILITY LAYER (added by TVE Group business model update)
# Adds a cross-cutting Capability class that sits between Service and
# Domain: services ENABLE capabilities, and capabilities in turn SUPPORT
# every domain whose service(s) enable them. This produces an explicit,
# queryable capability map layered over the existing DDD service model.
# =================================================================

# --- New Class ---
ddd:Capability a owl:Class ;
    rdfs:label "Business Capability" ;
    rdfs:comment "A cross-cutting business capability enabled by one or more domain services, independent of any single domain's internal structure." .

# --- New Object Properties ---
ddd:enablesCapability a owl:ObjectProperty ;
    rdfs:domain ddd:Service ;
    rdfs:range ddd:Capability ;
    rdfs:label "enables capability" ;
    rdfs:comment "Relates a domain service to the cross-cutting business capability(ies) it enables." .

ddd:capabilitySupportsDomain a owl:ObjectProperty ;
    rdfs:domain ddd:Capability ;
    rdfs:range ddd:Domain ;
    rdfs:label "capability supports domain" ;
    rdfs:comment "Relates a capability back to every domain that depends on it, derived by traversing enablesCapability through each domain's services." .

# -----------------------------------------------------------------
# Capability Instances
# -----------------------------------------------------------------
aero:CapEngineeringDesign a ddd:Capability ;
    rdfs:label "Engineering & Design Capability" ;
    rdfs:comment "Ability to conceive, model, and simulate airworthy aircraft designs." .

aero:CapRegulatoryCompliance a ddd:Capability ;
    rdfs:label "Regulatory Compliance & Certification Capability" ;
    rdfs:comment "Ability to secure and maintain type certification and airworthiness across the fleet lifecycle." .

aero:CapManufacturingExecution a ddd:Capability ;
    rdfs:label "Manufacturing Execution Capability" ;
    rdfs:comment "Ability to fabricate components and integrate them into a finished aircraft." .

aero:CapQualityAssurance a ddd:Capability ;
    rdfs:label "Quality Assurance Capability" ;
    rdfs:comment "Ability to verify conformance, safety, and reliability across design, build, and support." .

aero:CapSupplierSourcing a ddd:Capability ;
    rdfs:label "Supplier & Sourcing Management Capability" ;
    rdfs:comment "Ability to select, qualify, and manage the supplier base and strategic sourcing." .

aero:CapLogisticsInventory a ddd:Capability ;
    rdfs:label "Logistics & Inventory Capability" ;
    rdfs:comment "Ability to move parts and materials reliably across the global supply network." .

aero:CapCustomerRelationship a ddd:Capability ;
    rdfs:label "Customer Relationship Capability" ;
    rdfs:comment "Ability to build and sustain long-term relationships with operators and buyers." .

aero:CapRevenueFinancing a ddd:Capability ;
    rdfs:label "Revenue & Financing Capability" ;
    rdfs:comment "Ability to structure, price, and finance aircraft transactions." .

aero:CapAftermarketServiceDelivery a ddd:Capability ;
    rdfs:label "Aftermarket Service Delivery Capability" ;
    rdfs:comment "Ability to keep customer fleets flying through planned, unplanned, and overhaul support." .

aero:CapFinancialPlanningControl a ddd:Capability ;
    rdfs:label "Financial Planning & Control Capability" ;
    rdfs:comment "Ability to forecast, account for, and appraise the financial performance of the enterprise." .

aero:CapStrategicPortfolio a ddd:Capability ;
    rdfs:label "Strategic Portfolio Management Capability" ;
    rdfs:comment "Ability to set enterprise direction: market position, brand, and M&A strategy." .

# -----------------------------------------------------------------
# Service -> Capability relations (enablesCapability)
# -----------------------------------------------------------------
aero:AircraftDesignService ddd:enablesCapability aero:CapEngineeringDesign .
aero:CertificationService ddd:enablesCapability aero:CapRegulatoryCompliance .
aero:MROServiceInst ddd:enablesCapability aero:CapRegulatoryCompliance .
aero:ProcurementService ddd:enablesCapability aero:CapRegulatoryCompliance .
aero:ComponentFabricationService ddd:enablesCapability aero:CapManufacturingExecution .
aero:MajorAssemblyService ddd:enablesCapability aero:CapManufacturingExecution .
aero:FinalAssemblyService ddd:enablesCapability aero:CapManufacturingExecution .
aero:FinalAssemblyService ddd:enablesCapability aero:CapQualityAssurance .
aero:CertificationService ddd:enablesCapability aero:CapQualityAssurance .
aero:MROServiceInst ddd:enablesCapability aero:CapQualityAssurance .
aero:SRMService ddd:enablesCapability aero:CapSupplierSourcing .
aero:ProcurementService ddd:enablesCapability aero:CapSupplierSourcing .
aero:GlobalLogisticsService ddd:enablesCapability aero:CapLogisticsInventory .
aero:ProcurementService ddd:enablesCapability aero:CapLogisticsInventory .
aero:CRMService ddd:enablesCapability aero:CapCustomerRelationship .
aero:PlannedSupportServiceInst ddd:enablesCapability aero:CapCustomerRelationship .
aero:SalesFinancingService ddd:enablesCapability aero:CapRevenueFinancing .
aero:FPAAnalysisService ddd:enablesCapability aero:CapRevenueFinancing .
aero:PlannedSupportServiceInst ddd:enablesCapability aero:CapAftermarketServiceDelivery .
aero:MROServiceInst ddd:enablesCapability aero:CapAftermarketServiceDelivery .
aero:OnDemandSupportServiceInst ddd:enablesCapability aero:CapAftermarketServiceDelivery .
aero:FPAAnalysisService ddd:enablesCapability aero:CapFinancialPlanningControl .
aero:StrategicPlanningService ddd:enablesCapability aero:CapStrategicPortfolio .
aero:CRMService ddd:enablesCapability aero:CapStrategicPortfolio .

# -----------------------------------------------------------------
# Capability -> Domain relations (capabilitySupportsDomain)
# Derived: a capability supports every domain that owns a service
# enabling it (Domain -> hasService -> Service -> enablesCapability -> Capability).
# -----------------------------------------------------------------
aero:CapEngineeringDesign ddd:capabilitySupportsDomain aero:ProductEngineeringDomain .
aero:CapRegulatoryCompliance ddd:capabilitySupportsDomain aero:ProductEngineeringDomain .
aero:CapRegulatoryCompliance ddd:capabilitySupportsDomain aero:CustomerSupportDomain .
aero:CapRegulatoryCompliance ddd:capabilitySupportsDomain aero:SupplyChainDomain .
aero:CapManufacturingExecution ddd:capabilitySupportsDomain aero:AircraftManufacturingDomain .
aero:CapQualityAssurance ddd:capabilitySupportsDomain aero:AircraftManufacturingDomain .
aero:CapQualityAssurance ddd:capabilitySupportsDomain aero:ProductEngineeringDomain .
aero:CapQualityAssurance ddd:capabilitySupportsDomain aero:CustomerSupportDomain .
aero:CapSupplierSourcing ddd:capabilitySupportsDomain aero:SupplyChainDomain .
aero:CapLogisticsInventory ddd:capabilitySupportsDomain aero:SupplyChainDomain .
aero:CapCustomerRelationship ddd:capabilitySupportsDomain aero:SalesAndMarketingDomain .
aero:CapCustomerRelationship ddd:capabilitySupportsDomain aero:CustomerSupportDomain .
aero:CapRevenueFinancing ddd:capabilitySupportsDomain aero:SalesAndMarketingDomain .
aero:CapRevenueFinancing ddd:capabilitySupportsDomain aero:CorporateStrategyDomain .
aero:CapAftermarketServiceDelivery ddd:capabilitySupportsDomain aero:CustomerSupportDomain .
aero:CapFinancialPlanningControl ddd:capabilitySupportsDomain aero:CorporateStrategyDomain .
aero:CapStrategicPortfolio ddd:capabilitySupportsDomain aero:CorporateStrategyDomain .
aero:CapStrategicPortfolio ddd:capabilitySupportsDomain aero:SalesAndMarketingDomain .
