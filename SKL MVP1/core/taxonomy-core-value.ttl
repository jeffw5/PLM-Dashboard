# Taxonomy: Value taxonomy
# File: taxonomy-core-value.ttl   Version 0.1.0   Status: Draft
# Conforms to Semantic Governance v1.8 (Sections 3.2, 3.7, 3.8, 3.9; Appendix E Step 3).
# One skos:ConceptScheme per file; load through RDF Studio's taxonomy import.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix tax: <https://www.insperity.com/taxonomy/core/> .
@prefix voc: <https://www.insperity.com/vocabulary/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tax:ValueTaxonomy a skos:ConceptScheme ;
    dcterms:title "Value taxonomy"@en ;
    skos:prefLabel "Value taxonomy"@en ;
    dcterms:description "Classification of value, the benefit or worth that stakeholders receive from offerings, capabilities, and process outcomes, and of the structures used to describe how it is delivered."@en ;
    dcterms:subject core:Value ;
    skos:scopeNote "Value is evaluated with measures. Realization status, horizon, and certainty values are in the value vocabulary."@en ;
    dcterms:source "Business Architecture Guild value stream mapping; ISO 30414 human capital reporting; ISO 26000 social responsibility."@en ;
    dcterms:publisher "Architecture"@en ;
    dcterms:creator "Knowledge Engineering"@en ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus voc:lifecycle-status-draft ;
    skos:hasTopConcept tax:EconomicValue ,
        tax:RiskReductionValue ,
        tax:StakeholderValue ,
        tax:SocietalValue ,
        tax:InformationValue ,
        tax:ValueStream ,
        tax:ValueProposition .

tax:EconomicValue a skos:Concept ;
    skos:prefLabel "Economic value"@en ;
    skos:altLabel "Financial value"@en , "Monetary value"@en ;
    skos:definition "A value expressed as a financial gain, saving, or avoided cost."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:RevenueGrowth , tax:CostReduction , tax:CostAvoidance , tax:ProductivityGain , tax:CapitalEfficiency ;
    skos:inScheme tax:ValueTaxonomy .

tax:RevenueGrowth a skos:Concept ;
    skos:prefLabel "Revenue growth"@en ;
    skos:altLabel "Revenue increase"@en ;
    skos:definition "An economic value from increased sales, retention, or pricing."@en ;
    skos:broader tax:EconomicValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:CostReduction a skos:Concept ;
    skos:prefLabel "Cost reduction"@en ;
    skos:altLabel "Cost savings"@en ;
    skos:definition "An economic value from lowering current spending."@en ;
    skos:broader tax:EconomicValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:CostAvoidance a skos:Concept ;
    skos:prefLabel "Cost avoidance"@en ;
    skos:altLabel "Avoided cost"@en ;
    skos:definition "An economic value from preventing spending that would otherwise occur."@en ;
    skos:broader tax:EconomicValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:ProductivityGain a skos:Concept ;
    skos:prefLabel "Productivity gain"@en ;
    skos:altLabel "Efficiency gain"@en , "Time savings"@en ;
    skos:definition "An economic value from producing more output with the same resources."@en ;
    skos:broader tax:EconomicValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:CapitalEfficiency a skos:Concept ;
    skos:prefLabel "Capital efficiency"@en ;
    skos:definition "An economic value from using less capital or working capital for the same outcome."@en ;
    skos:broader tax:EconomicValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:RiskReductionValue a skos:Concept ;
    skos:prefLabel "Risk reduction value"@en ;
    skos:altLabel "Protection value"@en , "Risk mitigation value"@en ;
    skos:definition "A value from lowering the likelihood or impact of adverse events."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:ComplianceAssurance , tax:LossAvoidance , tax:Resilience ;
    skos:inScheme tax:ValueTaxonomy .

tax:ComplianceAssurance a skos:Concept ;
    skos:prefLabel "Compliance assurance"@en ;
    skos:altLabel "Regulatory assurance"@en ;
    skos:definition "A risk reduction value from meeting legal, regulatory, and contractual obligations."@en ;
    skos:broader tax:RiskReductionValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:LossAvoidance a skos:Concept ;
    skos:prefLabel "Loss avoidance"@en ;
    skos:altLabel "Penalty avoidance"@en ;
    skos:definition "A risk reduction value from preventing fraud, errors, penalties, or incidents."@en ;
    skos:broader tax:RiskReductionValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:Resilience a skos:Concept ;
    skos:prefLabel "Resilience"@en ;
    skos:altLabel "Business continuity"@en ;
    skos:definition "A risk reduction value from the ability to continue and recover when disruption occurs."@en ;
    skos:broader tax:RiskReductionValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:StakeholderValue a skos:Concept ;
    skos:prefLabel "Stakeholder value"@en ;
    skos:altLabel "Experience value"@en ;
    skos:definition "A value experienced by a particular group of stakeholders."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:ClientValue , tax:EmployeeValue , tax:PartnerValue , tax:ShareholderValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:ClientValue a skos:Concept ;
    skos:prefLabel "Client value"@en ;
    skos:altLabel "Customer value"@en ;
    skos:definition "A stakeholder value experienced by client organizations."@en ;
    skos:broader tax:StakeholderValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:EmployeeValue a skos:Concept ;
    skos:prefLabel "Employee value"@en ;
    skos:altLabel "Worker value"@en , "Employee experience"@en ;
    skos:definition "A stakeholder value experienced by workers, such as security, wellbeing, and growth."@en ;
    skos:broader tax:StakeholderValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:PartnerValue a skos:Concept ;
    skos:prefLabel "Partner value"@en ;
    skos:definition "A stakeholder value experienced by suppliers, carriers, and partners."@en ;
    skos:broader tax:StakeholderValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:ShareholderValue a skos:Concept ;
    skos:prefLabel "Shareholder value"@en ;
    skos:altLabel "Owner value"@en ;
    skos:definition "A stakeholder value experienced by owners and investors."@en ;
    skos:broader tax:StakeholderValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:SocietalValue a skos:Concept ;
    skos:prefLabel "Societal value"@en ;
    skos:altLabel "Social value"@en , "Public value"@en ;
    skos:definition "A value that benefits communities or the wider public beyond direct stakeholders."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:CommunityValue , tax:EnvironmentalValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:CommunityValue a skos:Concept ;
    skos:prefLabel "Community value"@en ;
    skos:altLabel "Community benefit"@en ;
    skos:definition "A societal value that benefits the communities where the organization and its clients operate."@en ;
    skos:broader tax:SocietalValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:EnvironmentalValue a skos:Concept ;
    skos:prefLabel "Environmental value"@en ;
    skos:altLabel "Sustainability value"@en , "Planet value"@en ;
    skos:definition "A societal value from reducing harm to or improving the natural environment."@en ;
    skos:broader tax:SocietalValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:InformationValue a skos:Concept ;
    skos:prefLabel "Information value"@en ;
    skos:altLabel "Decision value"@en , "Knowledge value"@en ;
    skos:definition "A value from better knowledge, decisions, and trust."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:DecisionQuality , tax:TrustAndTransparency , tax:ReuseValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:DecisionQuality a skos:Concept ;
    skos:prefLabel "Decision quality"@en ;
    skos:altLabel "Better decisions"@en ;
    skos:definition "An information value from making decisions that are faster, more consistent, and better informed."@en ;
    skos:broader tax:InformationValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:TrustAndTransparency a skos:Concept ;
    skos:prefLabel "Trust and transparency"@en ;
    skos:altLabel "Trust"@en , "Transparency"@en ;
    skos:definition "An information value from answers and records that can be traced, explained, and verified."@en ;
    skos:broader tax:InformationValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:ReuseValue a skos:Concept ;
    skos:prefLabel "Reuse value"@en ;
    skos:altLabel "Single source of truth value"@en ;
    skos:definition "An information value from defining knowledge once and reusing it across services and domains."@en ;
    skos:broader tax:InformationValue ;
    skos:inScheme tax:ValueTaxonomy .

tax:ValueStream a skos:Concept ;
    skos:prefLabel "Value stream"@en ;
    skos:altLabel "Value chain"@en ;
    skos:definition "A value-related structure that is an end-to-end sequence of stages delivering an outcome to a stakeholder."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:CustomerValueStream , tax:InternalValueStream ;
    skos:relatedMatch tax:OperationalProcess ;
    skos:inScheme tax:ValueTaxonomy .

tax:CustomerValueStream a skos:Concept ;
    skos:prefLabel "Customer value stream"@en ;
    skos:altLabel "Operational value stream"@en , "Prospect to client value stream"@en ;
    skos:definition "A value stream that delivers an outcome to an external client or worker."@en ;
    skos:broader tax:ValueStream ;
    skos:inScheme tax:ValueTaxonomy .

tax:InternalValueStream a skos:Concept ;
    skos:prefLabel "Internal value stream"@en ;
    skos:altLabel "Development value stream"@en , "Enabling value stream"@en ;
    skos:definition "A value stream that delivers an outcome to an internal stakeholder."@en ;
    skos:broader tax:ValueStream ;
    skos:inScheme tax:ValueTaxonomy .

tax:ValueProposition a skos:Concept ;
    skos:prefLabel "Value proposition"@en ;
    skos:altLabel "Offer value statement"@en ;
    skos:definition "A value-related statement of the benefits an offering or capability delivers to a stakeholder and why it is preferable to alternatives."@en ;
    skos:topConceptOf tax:ValueTaxonomy ;
    skos:narrower tax:ClientValueProposition , tax:EmployeeValueProposition ;
    skos:inScheme tax:ValueTaxonomy .

tax:ClientValueProposition a skos:Concept ;
    skos:prefLabel "Client value proposition"@en ;
    skos:altLabel "Customer value proposition"@en ;
    skos:definition "A value proposition addressed to clients."@en ;
    skos:broader tax:ValueProposition ;
    skos:inScheme tax:ValueTaxonomy .

tax:EmployeeValueProposition a skos:Concept ;
    skos:prefLabel "Employee value proposition"@en ;
    skos:altLabel "Employer brand promise"@en ;
    skos:definition "A value proposition addressed to current and prospective workers."@en ;
    skos:broader tax:ValueProposition ;
    skos:inScheme tax:ValueTaxonomy .
