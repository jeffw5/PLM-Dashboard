# Vocabulary: Location vocabulary
# File: vocabulary-core-location.ttl   Version 0.1.0   Status: Draft
# Conforms to Semantic Governance v1.8 (Sections 3.2, 3.7, 3.8, 3.9; Appendix E Step 3).
# One skos:ConceptScheme per file; load through RDF Studio's taxonomy import.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix tax: <https://www.insperity.com/taxonomy/core/> .
@prefix voc: <https://www.insperity.com/vocabulary/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

voc:location-vocabulary a skos:ConceptScheme ;
    dcterms:title "Location vocabulary"@en ;
    skos:prefLabel "Location vocabulary"@en ;
    dcterms:description "Controlled values for the United States jurisdictions where worksite clients operate, work arrangements, and address types."@en ;
    dcterms:subject core:Location ;
    skos:scopeNote "Jurisdictions carry ISO 3166 codes in skos:notation. The federal and state jurisdictions are siblings under one value set, because skos:broader is used only for classification; the legal containment of a state within the United States is modeled in the ontology with located in."@en ;
    dcterms:source "ISO 3166-1 and ISO 3166-2 codes; LKIF-Core jurisdiction."@en ;
    dcterms:publisher "Architecture"@en ;
    dcterms:creator "Knowledge Engineering"@en ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus voc:lifecycle-status-draft ;
    skos:hasTopConcept voc:jurisdiction ,
        voc:work-arrangement ,
        voc:address-type .

voc:country-code a rdfs:Datatype ;
    rdfs:label "Country code"@en ;
    skos:definition "A datatype for two-letter country codes defined by ISO 3166-1."@en ;
    rdfs:isDefinedBy voc:location-vocabulary .

voc:country-subdivision-code a rdfs:Datatype ;
    rdfs:label "Country subdivision code"@en ;
    skos:definition "A datatype for country subdivision codes defined by ISO 3166-2."@en ;
    rdfs:isDefinedBy voc:location-vocabulary .

voc:jurisdiction a skos:Concept ;
    skos:prefLabel "United States jurisdiction"@en ;
    skos:definition "A controlled value set for the federal, state, and District of Columbia jurisdictions whose laws apply to worksite clients."@en ;
    skos:topConceptOf voc:location-vocabulary ;
    skos:narrower voc:jurisdiction-united-states-federal , voc:jurisdiction-alabama , voc:jurisdiction-alaska , voc:jurisdiction-arizona , voc:jurisdiction-arkansas , voc:jurisdiction-california , voc:jurisdiction-colorado , voc:jurisdiction-connecticut , voc:jurisdiction-delaware , voc:jurisdiction-district-of-columbia , voc:jurisdiction-florida , voc:jurisdiction-georgia , voc:jurisdiction-hawaii , voc:jurisdiction-idaho , voc:jurisdiction-illinois , voc:jurisdiction-indiana , voc:jurisdiction-iowa , voc:jurisdiction-kansas , voc:jurisdiction-kentucky , voc:jurisdiction-louisiana , voc:jurisdiction-maine , voc:jurisdiction-maryland , voc:jurisdiction-massachusetts , voc:jurisdiction-michigan , voc:jurisdiction-minnesota , voc:jurisdiction-mississippi , voc:jurisdiction-missouri , voc:jurisdiction-montana , voc:jurisdiction-nebraska , voc:jurisdiction-nevada , voc:jurisdiction-new-hampshire , voc:jurisdiction-new-jersey , voc:jurisdiction-new-mexico , voc:jurisdiction-new-york , voc:jurisdiction-north-carolina , voc:jurisdiction-north-dakota , voc:jurisdiction-ohio , voc:jurisdiction-oklahoma , voc:jurisdiction-oregon , voc:jurisdiction-pennsylvania , voc:jurisdiction-rhode-island , voc:jurisdiction-south-carolina , voc:jurisdiction-south-dakota , voc:jurisdiction-tennessee , voc:jurisdiction-texas , voc:jurisdiction-utah , voc:jurisdiction-vermont , voc:jurisdiction-virginia , voc:jurisdiction-washington , voc:jurisdiction-west-virginia , voc:jurisdiction-wisconsin , voc:jurisdiction-wyoming ;
    skos:inScheme voc:location-vocabulary .

voc:jurisdiction-united-states-federal a skos:Concept ;
    skos:prefLabel "United States federal jurisdiction"@en ;
    skos:altLabel "Federal"@en , "United States"@en , "US"@en ;
    skos:notation "US"^^voc:country-code ;
    skos:definition "A national jurisdiction in which United States federal law and federal agencies apply."@en ;
    skos:broader voc:jurisdiction ;
    skos:broadMatch tax:NationalJurisdiction ;
    skos:inScheme voc:location-vocabulary .

voc:jurisdiction-alabama a skos:Concept ;
    skos:prefLabel "Alabama"@en ;
    skos:altLabel "AL"@en ;
    skos:notation "US-AL"^^voc:country-subdivision-code ;
    skos:definition "A state jurisdiction comprising the state of Alabama and the state and local laws, regulations, and agencies that apply there."@en ;
    skos:broader voc:jurisdiction ;
    skos:broadMatch tax:StateJurisdiction ;
    skos:inScheme voc:location-vocabulary .

