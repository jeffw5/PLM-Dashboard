# Core vocabularies and taxonomies, one named graph per artifact (Semantic Governance v1.8 Section 3.3).
# For loading a graph store such as GraphDB. RDF Studio needs the individual .ttl files instead.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix tax: <https://www.insperity.com/taxonomy/core/> .
@prefix voc: <https://www.insperity.com/vocabulary/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix persona: <https://www.insperity.com/vocabulary/persona/> .

<https://www.insperity.com/graph/taxonomy-core-asset> {
    tax:AssetTaxonomy a skos:ConceptScheme ;
        dcterms:title "Asset taxonomy"@en ;
        skos:prefLabel "Asset taxonomy"@en ;
        dcterms:description "Classification of the things of value that process steps consume, produce, use, or maintain, from buildings and equipment to documents, records, datasets, and software."@en ;
        dcterms:subject core:Asset ;
        skos:scopeNote "Covers kinds of asset only. Asset status, ownership, and criticality values are in the asset vocabulary. Products offered to clients are in the product taxonomy; parties are in the party taxonomy."@en ;
        dcterms:source "BFO material entity and generically dependent continuant (ISO/IEC 21838-2); Information Artifact Ontology; Data Catalog Vocabulary for digital asset descriptions."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:PhysicalAsset ,
            tax:InformationAsset ,
            tax:SoftwareAsset ,
            tax:FinancialAsset ,
            tax:IntangibleAsset .

    tax:PhysicalAsset a skos:Concept ;
        skos:prefLabel "Physical asset"@en ;
        skos:altLabel "Tangible asset"@en , "Material asset"@en ;
        skos:definition "An asset that has material existence and can be located, handled, or occupied."@en ;
        skos:scopeNote "Aligned to the BFO material entity category."@en ;
        skos:example "A worksite building; a laptop."@en ;
        skos:topConceptOf tax:AssetTaxonomy ;
        skos:narrower tax:Facility , tax:Equipment , tax:Vehicle , tax:Inventory ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Facility a skos:Concept ;
        skos:prefLabel "Facility"@en ;
        skos:altLabel "Premises"@en , "Building"@en ;
        skos:definition "A physical asset that is a building, room, or fixed installation used to house people, equipment, or operations."@en ;
        skos:example "Headquarters building; regional service center."@en ;
        skos:broader tax:PhysicalAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Equipment a skos:Concept ;
        skos:prefLabel "Equipment"@en ;
        skos:altLabel "Tool"@en ;
        skos:definition "A physical asset that is a durable device or apparatus used to perform work."@en ;
        skos:broader tax:PhysicalAsset ;
        skos:narrower tax:ComputingEquipment , tax:CommunicationEquipment , tax:OperationalEquipment ;
        skos:inScheme tax:AssetTaxonomy .

    tax:ComputingEquipment a skos:Concept ;
        skos:prefLabel "Computing equipment"@en ;
        skos:altLabel "Hardware"@en , "Computing device"@en ;
        skos:definition "An equipment that processes, stores, or displays digital information."@en ;
        skos:example "Laptop; server; tablet."@en ;
        skos:broader tax:Equipment ;
        skos:inScheme tax:AssetTaxonomy .

    tax:CommunicationEquipment a skos:Concept ;
        skos:prefLabel "Communication equipment"@en ;
        skos:definition "An equipment that transmits or receives voice or data."@en ;
        skos:example "Telephone handset; network router."@en ;
        skos:broader tax:Equipment ;
        skos:inScheme tax:AssetTaxonomy .

    tax:OperationalEquipment a skos:Concept ;
        skos:prefLabel "Operational equipment"@en ;
        skos:altLabel "Machinery"@en ;
        skos:definition "An equipment that is used directly in producing goods or delivering physical services."@en ;
        skos:broader tax:Equipment ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Vehicle a skos:Concept ;
        skos:prefLabel "Vehicle"@en ;
        skos:altLabel "Fleet asset"@en ;
        skos:definition "A physical asset that is a means of transporting people or goods."@en ;
        skos:broader tax:PhysicalAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Inventory a skos:Concept ;
        skos:prefLabel "Inventory"@en ;
        skos:altLabel "Stock"@en , "Supplies"@en ;
        skos:definition "A physical asset that is a stock of materials or goods held for use, sale, or distribution."@en ;
        skos:broader tax:PhysicalAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:InformationAsset a skos:Concept ;
        skos:prefLabel "Information asset"@en ;
        skos:altLabel "Information artifact"@en , "Information entity"@en ;
        skos:definition "An asset that consists of information that can be copied across physical or digital carriers without losing its identity."@en ;
        skos:scopeNote "Aligned to the BFO generically dependent continuant category and the Information Artifact Ontology. Software is classified separately as a software asset."@en ;
        skos:example "A pay statement; a timesheet; a policy document."@en ;
        skos:topConceptOf tax:AssetTaxonomy ;
        skos:narrower tax:Document , tax:Record , tax:Dataset , tax:Identifier , tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Document a skos:Concept ;
        skos:prefLabel "Document"@en ;
        skos:definition "An information asset that is a bounded, human-readable unit of content with a title and author."@en ;
        skos:example "Plan document; enrollment guide."@en ;
        skos:broader tax:InformationAsset ;
        skos:narrower tax:AgreementDocument , tax:PolicyDocument , tax:Form , tax:Notice , tax:Report , tax:KnowledgeArticle ;
        skos:inScheme tax:AssetTaxonomy .

    tax:AgreementDocument a skos:Concept ;
        skos:prefLabel "Agreement document"@en ;
        skos:altLabel "Contract document"@en , "Contract"@en ;
        skos:definition "A document that records the terms agreed between two or more parties."@en ;
        skos:broader tax:Document ;
        skos:relatedMatch tax:ContractualInstrument ;
        skos:inScheme tax:AssetTaxonomy .

    tax:PolicyDocument a skos:Concept ;
        skos:prefLabel "Policy document"@en ;
        skos:definition "A document that states a policy, standard, or procedure in human-readable form."@en ;
        skos:broader tax:Document ;
        skos:relatedMatch tax:OrganizationalPolicy ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Form a skos:Concept ;
        skos:prefLabel "Form"@en ;
        skos:definition "A document that has structured fields for collecting information from a person or system."@en ;
        skos:example "Enrollment form; tax withholding form."@en ;
        skos:broader tax:Document ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Notice a skos:Concept ;
        skos:prefLabel "Notice"@en ;
        skos:altLabel "Notification letter"@en ;
        skos:definition "A document that formally informs a party of a fact, right, obligation, or change."@en ;
        skos:example "Benefits continuation notice."@en ;
        skos:broader tax:Document ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Report a skos:Concept ;
        skos:prefLabel "Report"@en ;
        skos:definition "A document that presents organized facts, analysis, or measures for a stated purpose and period."@en ;
        skos:broader tax:Document ;
        skos:relatedMatch tax:Observation ;
        skos:inScheme tax:AssetTaxonomy .

    tax:KnowledgeArticle a skos:Concept ;
        skos:prefLabel "Knowledge article"@en ;
        skos:altLabel "Frequently asked question"@en , "FAQ"@en , "Help article"@en ;
        skos:definition "A document that answers a specific question or explains a topic for reuse in support and self-service."@en ;
        skos:broader tax:Document ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Record a skos:Concept ;
        skos:prefLabel "Record"@en ;
        skos:altLabel "Business record"@en ;
        skos:definition "An information asset that is evidence of an activity, transaction, or state, kept for reference or compliance."@en ;
        skos:scopeNote "Records are subject to retention policies."@en ;
        skos:broader tax:InformationAsset ;
        skos:narrower tax:TransactionRecord , tax:PartyRecord , tax:AuditRecord , tax:ChangeRecord ;
        skos:inScheme tax:AssetTaxonomy .

    tax:TransactionRecord a skos:Concept ;
        skos:prefLabel "Transaction record"@en ;
        skos:definition "A record that captures the details of a single business transaction."@en ;
        skos:example "Payment record; payroll register entry."@en ;
        skos:broader tax:Record ;
        skos:inScheme tax:AssetTaxonomy .

    tax:PartyRecord a skos:Concept ;
        skos:prefLabel "Party record"@en ;
        skos:altLabel "Master record"@en , "Personnel record"@en , "Client record"@en ;
        skos:definition "A record that holds identifying and descriptive information about a party."@en ;
        skos:broader tax:Record ;
        skos:inScheme tax:AssetTaxonomy .

    tax:AuditRecord a skos:Concept ;
        skos:prefLabel "Audit record"@en ;
        skos:altLabel "Audit log entry"@en , "Audit trail entry"@en ;
        skos:definition "A record that documents who performed an action, when, and with what result, for later review."@en ;
        skos:broader tax:Record ;
        skos:relatedMatch tax:AuditTrail ;
        skos:inScheme tax:AssetTaxonomy .

    tax:ChangeRecord a skos:Concept ;
        skos:prefLabel "Change record"@en ;
        skos:definition "A record that documents an approved change to a knowledge artifact, its reason, and its approver."@en ;
        skos:broader tax:Record ;
        skos:relatedMatch tax:ChangeControl ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Dataset a skos:Concept ;
        skos:prefLabel "Dataset"@en ;
        skos:altLabel "Data set"@en , "Data asset"@en ;
        skos:definition "An information asset that is a collection of related data published or curated as a unit."@en ;
        skos:broader tax:InformationAsset ;
        skos:relatedMatch tax:DataProduct ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Identifier a skos:Concept ;
        skos:prefLabel "Identifier"@en ;
        skos:definition "An information asset that is a symbol or code assigned to uniquely designate an entity within a context."@en ;
        skos:example "Employee number; client number."@en ;
        skos:broader tax:InformationAsset ;
        skos:relatedMatch voc:party-identifier-type ;
        skos:inScheme tax:AssetTaxonomy .

    tax:KnowledgeArtifact a skos:Concept ;
        skos:prefLabel "Knowledge artifact"@en ;
        skos:altLabel "Semantic asset"@en , "Knowledge asset"@en ;
        skos:definition "An information asset that encodes governed meaning, structure, or logic for use by people, applications, and artificial intelligence agents."@en ;
        skos:broader tax:InformationAsset ;
        skos:narrower tax:Ontology , tax:Vocabulary , tax:Taxonomy , tax:MappingSpecification , tax:ValidationShape , tax:RuleSpecification , tax:PromptTemplate ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Ontology a skos:Concept ;
        skos:prefLabel "Ontology"@en ;
        skos:definition "A knowledge artifact that formally defines classes, relations, and axioms for a domain using a logic-based language."@en ;
        skos:example "Core ontology; payroll ontology."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Vocabulary a skos:Concept ;
        skos:prefLabel "Vocabulary"@en ;
        skos:altLabel "Controlled vocabulary"@en ;
        skos:definition "A knowledge artifact that defines the preferred, alternate, and hidden labels and definitions of a set of terms."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Taxonomy a skos:Concept ;
        skos:prefLabel "Taxonomy"@en ;
        skos:altLabel "Classification scheme"@en , "Concept scheme"@en ;
        skos:definition "A knowledge artifact that arranges concepts into a classification hierarchy."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:MappingSpecification a skos:Concept ;
        skos:prefLabel "Mapping specification"@en ;
        skos:altLabel "Mapping"@en , "Crosswalk"@en ;
        skos:definition "A knowledge artifact that defines how elements of a source schema or vocabulary correspond to ontology terms."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:ValidationShape a skos:Concept ;
        skos:prefLabel "Validation shape"@en ;
        skos:altLabel "Shape"@en , "Shapes Constraint Language shape"@en , "SHACL shape"@en ;
        skos:definition "A knowledge artifact that defines the constraints data must satisfy, expressed in a shapes language."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:RuleSpecification a skos:Concept ;
        skos:prefLabel "Rule specification"@en ;
        skos:definition "A knowledge artifact that declaratively defines a business rule, constraint, logic component, or calculation in the single source of truth."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:relatedMatch tax:BusinessRule ;
        skos:inScheme tax:AssetTaxonomy .

    tax:PromptTemplate a skos:Concept ;
        skos:prefLabel "Prompt template"@en ;
        skos:definition "A knowledge artifact that defines the versioned instructions, tone, and answer format given to a language model for a persona or task."@en ;
        skos:broader tax:KnowledgeArtifact ;
        skos:inScheme tax:AssetTaxonomy .

    tax:SoftwareAsset a skos:Concept ;
        skos:prefLabel "Software asset"@en ;
        skos:altLabel "Software"@en , "Digital system"@en ;
        skos:definition "An asset that is a set of executable instructions or a trained model that performs computation."@en ;
        skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en ;
        skos:topConceptOf tax:AssetTaxonomy ;
        skos:narrower tax:Application , tax:SoftwareComponent , tax:ApplicationProgrammingInterface , tax:MachineLearningModel , tax:DataStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Application a skos:Concept ;
        skos:prefLabel "Application"@en ;
        skos:altLabel "Software application"@en , "System of record"@en ;
        skos:definition "A software asset that provides functions to users through an interface."@en ;
        skos:example "Payroll application; client portal."@en ;
        skos:broader tax:SoftwareAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:SoftwareComponent a skos:Concept ;
        skos:prefLabel "Software component"@en ;
        skos:altLabel "Microservice"@en , "Library"@en ;
        skos:definition "A software asset that is a deployable unit of code providing a defined function to other software."@en ;
        skos:broader tax:SoftwareAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:ApplicationProgrammingInterface a skos:Concept ;
        skos:prefLabel "Application programming interface"@en ;
        skos:altLabel "API"@en , "Interface"@en ;
        skos:definition "A software asset that is a defined contract through which software components call one another."@en ;
        skos:broader tax:SoftwareAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:MachineLearningModel a skos:Concept ;
        skos:prefLabel "Machine learning model"@en ;
        skos:altLabel "Model"@en , "Language model"@en , "Large language model"@en , "LLM"@en ;
        skos:definition "A software asset that is a trained statistical model producing predictions or generated content from inputs."@en ;
        skos:broader tax:SoftwareAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:DataStore a skos:Concept ;
        skos:prefLabel "Data store"@en ;
        skos:altLabel "Database"@en , "Repository"@en ;
        skos:definition "A software asset that persists and serves data."@en ;
        skos:broader tax:SoftwareAsset ;
        skos:narrower tax:GraphStore , tax:RelationalDatabase , tax:VectorStore , tax:DocumentStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:GraphStore a skos:Concept ;
        skos:prefLabel "Graph store"@en ;
        skos:altLabel "Triple store"@en , "Knowledge graph store"@en ;
        skos:definition "A data store that stores and queries data as a graph of nodes and edges."@en ;
        skos:broader tax:DataStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:RelationalDatabase a skos:Concept ;
        skos:prefLabel "Relational database"@en ;
        skos:definition "A data store that stores data in tables related by keys and queried with a structured query language."@en ;
        skos:broader tax:DataStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:VectorStore a skos:Concept ;
        skos:prefLabel "Vector store"@en ;
        skos:altLabel "Vector database"@en ;
        skos:definition "A data store that stores embeddings and supports similarity search."@en ;
        skos:broader tax:DataStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:DocumentStore a skos:Concept ;
        skos:prefLabel "Document store"@en ;
        skos:definition "A data store that stores semi-structured documents."@en ;
        skos:broader tax:DataStore ;
        skos:inScheme tax:AssetTaxonomy .

    tax:FinancialAsset a skos:Concept ;
        skos:prefLabel "Financial asset"@en ;
        skos:definition "An asset that is a monetary claim or contractual right to receive cash or another financial asset."@en ;
        skos:example "Cash; accounts receivable."@en ;
        skos:topConceptOf tax:AssetTaxonomy ;
        skos:narrower tax:CashAndCashEquivalent , tax:Receivable , tax:Investment , tax:PrepaidAmount ;
        skos:inScheme tax:AssetTaxonomy .

    tax:CashAndCashEquivalent a skos:Concept ;
        skos:prefLabel "Cash and cash equivalent"@en ;
        skos:altLabel "Cash"@en ;
        skos:definition "A financial asset that is currency or a highly liquid investment readily convertible to a known amount of cash."@en ;
        skos:broader tax:FinancialAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Receivable a skos:Concept ;
        skos:prefLabel "Receivable"@en ;
        skos:altLabel "Accounts receivable"@en ;
        skos:definition "A financial asset that is an amount owed to the organization by another party."@en ;
        skos:broader tax:FinancialAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Investment a skos:Concept ;
        skos:prefLabel "Investment"@en ;
        skos:altLabel "Investment holding"@en ;
        skos:definition "A financial asset that is held to generate income or appreciation."@en ;
        skos:broader tax:FinancialAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:PrepaidAmount a skos:Concept ;
        skos:prefLabel "Prepaid amount"@en ;
        skos:altLabel "Prepaid expense"@en ;
        skos:definition "A financial asset that is a payment made in advance for goods or services not yet received."@en ;
        skos:broader tax:FinancialAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:IntangibleAsset a skos:Concept ;
        skos:prefLabel "Intangible asset"@en ;
        skos:altLabel "Non-physical asset"@en ;
        skos:definition "An asset that has no physical substance but provides future value through rights, knowledge, or reputation."@en ;
        skos:topConceptOf tax:AssetTaxonomy ;
        skos:narrower tax:IntellectualProperty , tax:LicenseRight , tax:Brand , tax:RelationshipAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:IntellectualProperty a skos:Concept ;
        skos:prefLabel "Intellectual property"@en ;
        skos:definition "An intangible asset that is a legally protected creation of the mind."@en ;
        skos:example "Trademark; patent; copyright."@en ;
        skos:broader tax:IntangibleAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:LicenseRight a skos:Concept ;
        skos:prefLabel "License right"@en ;
        skos:altLabel "License"@en , "Software license"@en ;
        skos:definition "An intangible asset that is a granted permission to use property owned by another party under stated terms."@en ;
        skos:broader tax:IntangibleAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:Brand a skos:Concept ;
        skos:prefLabel "Brand"@en ;
        skos:altLabel "Trademark identity"@en ;
        skos:definition "An intangible asset that is the name, identity, and reputation by which an organization or offering is recognized."@en ;
        skos:broader tax:IntangibleAsset ;
        skos:inScheme tax:AssetTaxonomy .

    tax:RelationshipAsset a skos:Concept ;
        skos:prefLabel "Relationship asset"@en ;
        skos:altLabel "Client relationships"@en , "Customer relationships"@en ;
        skos:definition "An intangible asset that is the established, valuable connection between the organization and a group of parties."@en ;
        skos:broader tax:IntangibleAsset ;
        skos:inScheme tax:AssetTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-capability> {
    tax:CapabilityTaxonomy a skos:ConceptScheme ;
        dcterms:title "Capability taxonomy"@en ;
        skos:prefLabel "Capability taxonomy"@en ;
        dcterms:description "Classification of business capabilities, the abilities an organization has or needs to achieve outcomes, independent of how they are organized or implemented."@en ;
        dcterms:subject core:Capability ;
        skos:scopeNote "Capabilities are stable and implementation-neutral; processes realize them and services expose them. Maturity and strategic importance values are in the capability vocabulary."@en ;
        dcterms:source "BFO disposition and function (ISO/IEC 21838-2); The Open Group TOGAF and Business Architecture Guild capability mapping."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:StrategicCapability ,
            tax:CustomerFacingCapability ,
            tax:SupportingCapability ,
            tax:InformationAndKnowledgeCapability .

    tax:StrategicCapability a skos:Concept ;
        skos:prefLabel "Strategic capability"@en ;
        skos:altLabel "Direction-setting capability"@en ;
        skos:definition "A capability for setting direction and shaping the organization."@en ;
        skos:topConceptOf tax:CapabilityTaxonomy ;
        skos:narrower tax:StrategyManagement , tax:PortfolioManagement , tax:EnterpriseArchitectureManagement , tax:InnovationManagement , tax:PerformanceManagement ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:StrategyManagement a skos:Concept ;
        skos:prefLabel "Strategy management"@en ;
        skos:altLabel "Strategic planning capability"@en ;
        skos:definition "A strategic capability to define, communicate, and adjust strategy and objectives."@en ;
        skos:broader tax:StrategicCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:PortfolioManagement a skos:Concept ;
        skos:prefLabel "Portfolio management"@en ;
        skos:altLabel "Investment management"@en ;
        skos:definition "A strategic capability to select and balance investments in initiatives and offerings."@en ;
        skos:broader tax:StrategicCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:EnterpriseArchitectureManagement a skos:Concept ;
        skos:prefLabel "Enterprise architecture management"@en ;
        skos:altLabel "Architecture management"@en ;
        skos:definition "A strategic capability to design and govern the structure of business, information, and technology."@en ;
        skos:broader tax:StrategicCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:InnovationManagement a skos:Concept ;
        skos:prefLabel "Innovation management"@en ;
        skos:definition "A strategic capability to generate, test, and scale new ideas."@en ;
        skos:broader tax:StrategicCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:PerformanceManagement a skos:Concept ;
        skos:prefLabel "Performance management"@en ;
        skos:altLabel "Enterprise performance management"@en ;
        skos:definition "A strategic capability to set targets, measure results, and drive improvement."@en ;
        skos:broader tax:StrategicCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:CustomerFacingCapability a skos:Concept ;
        skos:prefLabel "Customer-facing capability"@en ;
        skos:altLabel "Core capability"@en , "Value delivery capability"@en ;
        skos:definition "A capability for creating and delivering value to clients and their workers."@en ;
        skos:topConceptOf tax:CapabilityTaxonomy ;
        skos:narrower tax:ClientRelationshipManagement , tax:MarketingManagement , tax:SalesManagement , tax:OfferingManagement , tax:ServiceDeliveryManagement , tax:ClientSupportManagement ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ClientRelationshipManagement a skos:Concept ;
        skos:prefLabel "Client relationship management"@en ;
        skos:altLabel "Customer management"@en , "Account management"@en ;
        skos:definition "A customer-facing capability to acquire, understand, serve, and retain clients."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:MarketingManagement a skos:Concept ;
        skos:prefLabel "Marketing management"@en ;
        skos:definition "A customer-facing capability to generate awareness and demand."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:SalesManagement a skos:Concept ;
        skos:prefLabel "Sales management"@en ;
        skos:altLabel "Selling"@en ;
        skos:definition "A customer-facing capability to pursue and win new and renewed business."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:OfferingManagement a skos:Concept ;
        skos:prefLabel "Offering management"@en ;
        skos:altLabel "Product management"@en ;
        skos:definition "A customer-facing capability to define, price, and evolve products and services."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ServiceDeliveryManagement a skos:Concept ;
        skos:prefLabel "Service delivery management"@en ;
        skos:altLabel "Service management"@en ;
        skos:definition "A customer-facing capability to fulfil services to agreed levels."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ClientSupportManagement a skos:Concept ;
        skos:prefLabel "Client support management"@en ;
        skos:altLabel "Customer service management"@en ;
        skos:definition "A customer-facing capability to answer inquiries and resolve requests."@en ;
        skos:broader tax:CustomerFacingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:SupportingCapability a skos:Concept ;
        skos:prefLabel "Supporting capability"@en ;
        skos:altLabel "Enabling capability"@en ;
        skos:definition "A capability that enables strategic and customer-facing capabilities."@en ;
        skos:topConceptOf tax:CapabilityTaxonomy ;
        skos:narrower tax:WorkforceManagement , tax:FinancialManagement , tax:ProcurementManagement , tax:LegalManagement , tax:RiskAndComplianceManagement , tax:TechnologyManagement , tax:FacilitiesManagement ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:WorkforceManagement a skos:Concept ;
        skos:prefLabel "Workforce management"@en ;
        skos:altLabel "Human capital management"@en ;
        skos:definition "A supporting capability to attract, pay, develop, and retain people."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:FinancialManagement a skos:Concept ;
        skos:prefLabel "Financial management"@en ;
        skos:altLabel "Finance management"@en ;
        skos:definition "A supporting capability to plan, record, report, and control money."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ProcurementManagement a skos:Concept ;
        skos:prefLabel "Procurement management"@en ;
        skos:altLabel "Supplier management"@en ;
        skos:definition "A supporting capability to source and manage suppliers."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:LegalManagement a skos:Concept ;
        skos:prefLabel "Legal management"@en ;
        skos:altLabel "Legal affairs management"@en ;
        skos:definition "A supporting capability to manage agreements, legal advice, and disputes."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:RiskAndComplianceManagement a skos:Concept ;
        skos:prefLabel "Risk and compliance management"@en ;
        skos:altLabel "Governance, risk, and compliance"@en , "GRC"@en ;
        skos:definition "A supporting capability to identify and treat risks and meet obligations."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:TechnologyManagement a skos:Concept ;
        skos:prefLabel "Technology management"@en ;
        skos:altLabel "Information technology management"@en ;
        skos:definition "A supporting capability to plan, build, run, and secure technology."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:FacilitiesManagement a skos:Concept ;
        skos:prefLabel "Facilities management"@en ;
        skos:definition "A supporting capability to provide and maintain workplaces."@en ;
        skos:broader tax:SupportingCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:InformationAndKnowledgeCapability a skos:Concept ;
        skos:prefLabel "Information and knowledge capability"@en ;
        skos:altLabel "Data and artificial intelligence capability"@en ;
        skos:definition "A capability for managing and using data, knowledge, and artificial intelligence."@en ;
        skos:topConceptOf tax:CapabilityTaxonomy ;
        skos:narrower tax:DataManagement , tax:KnowledgeManagement , tax:SemanticManagement , tax:AnalyticsManagement , tax:ArtificialIntelligenceManagement , tax:ContentManagement ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:DataManagement a skos:Concept ;
        skos:prefLabel "Data management"@en ;
        skos:altLabel "Data governance capability"@en ;
        skos:definition "An information and knowledge capability to acquire, define, store, and govern data."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:KnowledgeManagement a skos:Concept ;
        skos:prefLabel "Knowledge management"@en ;
        skos:altLabel "Knowledge engineering capability"@en ;
        skos:definition "An information and knowledge capability to capture, organize, and share knowledge."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:SemanticManagement a skos:Concept ;
        skos:prefLabel "Semantic management"@en ;
        skos:altLabel "Semantic governance capability"@en , "Ontology management"@en ;
        skos:definition "An information and knowledge capability to define and govern shared meaning through vocabularies, taxonomies, and ontologies."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:AnalyticsManagement a skos:Concept ;
        skos:prefLabel "Analytics management"@en ;
        skos:altLabel "Analytics"@en , "Business intelligence"@en , "BI"@en ;
        skos:definition "An information and knowledge capability to analyze data and report insights."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ArtificialIntelligenceManagement a skos:Concept ;
        skos:prefLabel "Artificial intelligence management"@en ;
        skos:altLabel "AI management"@en , "AI governance capability"@en ;
        skos:definition "An information and knowledge capability to develop, deploy, monitor, and govern artificial intelligence systems responsibly."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .

    tax:ContentManagement a skos:Concept ;
        skos:prefLabel "Content management"@en ;
        skos:altLabel "Document management"@en , "Records management"@en ;
        skos:definition "An information and knowledge capability to create, publish, and retain documents and content."@en ;
        skos:broader tax:InformationAndKnowledgeCapability ;
        skos:inScheme tax:CapabilityTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-decision> {
    tax:DecisionTaxonomy a skos:ConceptScheme ;
        dcterms:title "Decision taxonomy"@en ;
        skos:prefLabel "Decision taxonomy"@en ;
        dcterms:description "Classification of decisions, the determinations of an outcome or course of action made by a party or automated agent, and of the models used to make them."@en ;
        dcterms:subject core:Decision ;
        skos:scopeNote "Decisions are made in decision steps and are governed by rules and policies. Automation level, outcome, confidence, and hit policy values are in the decision vocabulary."@en ;
        dcterms:source "Object Management Group Decision Model and Notation; ISO/IEC 42001 human oversight; Semantic Governance v1.8 Decision API."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:StrategicDecision ,
            tax:TacticalDecision ,
            tax:OperationalDecision ,
            tax:DecisionModel .

    tax:StrategicDecision a skos:Concept ;
        skos:prefLabel "Strategic decision"@en ;
        skos:altLabel "Executive decision"@en ;
        skos:definition "A decision that sets long-term direction, scope, or major resource commitments."@en ;
        skos:topConceptOf tax:DecisionTaxonomy ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:TacticalDecision a skos:Concept ;
        skos:prefLabel "Tactical decision"@en ;
        skos:altLabel "Management decision"@en ;
        skos:definition "A decision that translates strategy into plans, budgets, and allocations for a medium term."@en ;
        skos:topConceptOf tax:DecisionTaxonomy ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:OperationalDecision a skos:Concept ;
        skos:prefLabel "Operational decision"@en ;
        skos:altLabel "Transactional decision"@en , "Day-to-day decision"@en ;
        skos:definition "A decision made repeatedly in the course of day-to-day work, often by rules or agents."@en ;
        skos:topConceptOf tax:DecisionTaxonomy ;
        skos:narrower tax:EligibilityDetermination , tax:ApprovalDecision , tax:ClassificationDecision , tax:RoutingDecision , tax:PricingDecision , tax:AllocationDecision , tax:PrioritizationDecision , tax:ExceptionDecision , tax:ComplianceDetermination , tax:AnswerDecision ;
        skos:relatedMatch tax:DecisionStep ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:EligibilityDetermination a skos:Concept ;
        skos:prefLabel "Eligibility determination"@en ;
        skos:altLabel "Eligibility decision"@en , "Qualification decision"@en ;
        skos:definition "An operational decision that establishes whether a party qualifies for something."@en ;
        skos:broader tax:OperationalDecision ;
        skos:relatedMatch tax:EligibilityRule ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:ApprovalDecision a skos:Concept ;
        skos:prefLabel "Approval decision"@en ;
        skos:altLabel "Authorization decision"@en ;
        skos:definition "An operational decision that accepts or rejects a request or item."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:ClassificationDecision a skos:Concept ;
        skos:prefLabel "Classification decision"@en ;
        skos:altLabel "Categorization"@en , "Triage decision"@en ;
        skos:definition "An operational decision that assigns an item to a category."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:RoutingDecision a skos:Concept ;
        skos:prefLabel "Routing decision"@en ;
        skos:altLabel "Assignment decision"@en ;
        skos:definition "An operational decision that selects where work or a request goes next."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:PricingDecision a skos:Concept ;
        skos:prefLabel "Pricing decision"@en ;
        skos:altLabel "Quote decision"@en , "Rating decision"@en ;
        skos:definition "An operational decision that sets a price, rate, or fee."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:AllocationDecision a skos:Concept ;
        skos:prefLabel "Allocation decision"@en ;
        skos:definition "An operational decision that distributes resources or amounts among recipients."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:PrioritizationDecision a skos:Concept ;
        skos:prefLabel "Prioritization decision"@en ;
        skos:altLabel "Ranking decision"@en ;
        skos:definition "An operational decision that orders work by importance or urgency."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:ExceptionDecision a skos:Concept ;
        skos:prefLabel "Exception decision"@en ;
        skos:altLabel "Override decision"@en ;
        skos:definition "An operational decision on whether and how to handle a departure from a rule or path."@en ;
        skos:broader tax:OperationalDecision ;
        skos:relatedMatch tax:PolicyException ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:ComplianceDetermination a skos:Concept ;
        skos:prefLabel "Compliance determination"@en ;
        skos:altLabel "Compliance decision"@en ;
        skos:definition "An operational decision that establishes whether an obligation applies and is met."@en ;
        skos:broader tax:OperationalDecision ;
        skos:relatedMatch tax:Obligation ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:AnswerDecision a skos:Concept ;
        skos:prefLabel "Answer decision"@en ;
        skos:altLabel "Respond or escalate decision"@en ;
        skos:definition "An operational decision by an artificial intelligence agent on whether to answer, ask, escalate, or decline."@en ;
        skos:broader tax:OperationalDecision ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:DecisionModel a skos:Concept ;
        skos:prefLabel "Decision model"@en ;
        skos:altLabel "Decision logic specification"@en ;
        skos:definition "A decision-related information artifact that specifies how a decision is made from its inputs."@en ;
        skos:topConceptOf tax:DecisionTaxonomy ;
        skos:narrower tax:DecisionTable , tax:DecisionTree , tax:DecisionRequirementsGraph , tax:ScoringModel , tax:PredictiveDecisionModel ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:DecisionTable a skos:Concept ;
        skos:prefLabel "Decision table"@en ;
        skos:altLabel "DMN decision table"@en , "Rule table"@en ;
        skos:definition "A decision model that maps combinations of input conditions to outputs in rows governed by a hit policy."@en ;
        skos:broader tax:DecisionModel ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:DecisionTree a skos:Concept ;
        skos:prefLabel "Decision tree"@en ;
        skos:altLabel "Decision flow"@en ;
        skos:definition "A decision model that reaches an outcome through a sequence of branching tests."@en ;
        skos:broader tax:DecisionModel ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:DecisionRequirementsGraph a skos:Concept ;
        skos:prefLabel "Decision requirements graph"@en ;
        skos:altLabel "Decision requirements diagram"@en , "DRD"@en ;
        skos:definition "A decision model that shows decisions, their input data, knowledge sources, and dependencies."@en ;
        skos:broader tax:DecisionModel ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:ScoringModel a skos:Concept ;
        skos:prefLabel "Scoring model"@en ;
        skos:altLabel "Scorecard"@en ;
        skos:definition "A decision model that combines weighted factors into a score compared to cut-offs."@en ;
        skos:broader tax:DecisionModel ;
        skos:relatedMatch tax:ScoringCalculation ;
        skos:inScheme tax:DecisionTaxonomy .

    tax:PredictiveDecisionModel a skos:Concept ;
        skos:prefLabel "Predictive decision model"@en ;
        skos:altLabel "Machine learning decision model"@en ;
        skos:definition "A decision model whose output is produced by a trained machine learning model."@en ;
        skos:broader tax:DecisionModel ;
        skos:relatedMatch tax:MachineLearningModel ;
        skos:inScheme tax:DecisionTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-event> {
    tax:EventTaxonomy a skos:ConceptScheme ;
        dcterms:title "Event taxonomy"@en ;
        skos:prefLabel "Event taxonomy"@en ;
        dcterms:description "Classification of occurrences that happen at a point or short span in time and can start, end, or result from a process step."@en ;
        dcterms:subject core:Event ;
        skos:scopeNote "Events trigger or are produced by process steps through triggers and triggeredBy. Long-running activities are processes, not events. Unwanted outcomes that need resolution are issues."@en ;
        dcterms:source "BFO process boundary and instantaneous occurrent (ISO/IEC 21838-2); CloudEvents envelope for event messages."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:BusinessEvent ,
            tax:ProcessEvent ,
            tax:TimeEvent ,
            tax:ChangeEvent ,
            tax:SystemEvent ,
            tax:InteractionEvent ,
            tax:GovernanceEvent .

    tax:BusinessEvent a skos:Concept ;
        skos:prefLabel "Business event"@en ;
        skos:definition "An event that changes the state of a business relationship, agreement, or transaction."@en ;
        skos:example "Employee termination; client contract signed."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:PartyEvent , tax:AgreementEvent , tax:TransactionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:PartyEvent a skos:Concept ;
        skos:prefLabel "Party event"@en ;
        skos:definition "A business event that changes the status or attributes of a party."@en ;
        skos:broader tax:BusinessEvent ;
        skos:narrower tax:PartyOnboarding , tax:PartyChange , tax:PartyOffboarding , tax:LifeEvent ;
        skos:relatedMatch tax:PartyLifecycle ;
        skos:inScheme tax:EventTaxonomy .

    tax:PartyOnboarding a skos:Concept ;
        skos:prefLabel "Party onboarding"@en ;
        skos:altLabel "Party registration"@en , "Hire"@en , "Client onboarding"@en ;
        skos:definition "A party event in which a party is registered and begins an active relationship with the organization."@en ;
        skos:broader tax:PartyEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:PartyChange a skos:Concept ;
        skos:prefLabel "Party change"@en ;
        skos:altLabel "Status change"@en , "Job change"@en ;
        skos:definition "A party event in which identifying, contact, or status attributes of a party change."@en ;
        skos:broader tax:PartyEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:PartyOffboarding a skos:Concept ;
        skos:prefLabel "Party offboarding"@en ;
        skos:altLabel "Party exit"@en , "Termination"@en , "Client exit"@en ;
        skos:definition "A party event in which an active relationship with a party ends."@en ;
        skos:broader tax:PartyEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:LifeEvent a skos:Concept ;
        skos:prefLabel "Life event"@en ;
        skos:altLabel "Qualifying life event"@en ;
        skos:definition "A party event in which a change in a person's personal circumstances occurs."@en ;
        skos:scopeNote "Personal circumstances such as marriage, birth, or loss of other coverage; domain ontologies specialize this."@en ;
        skos:example "Marriage; birth of a child."@en ;
        skos:broader tax:PartyEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AgreementEvent a skos:Concept ;
        skos:prefLabel "Agreement event"@en ;
        skos:definition "A business event that creates, changes, or ends an agreement between parties."@en ;
        skos:broader tax:BusinessEvent ;
        skos:narrower tax:AgreementExecution , tax:AgreementAmendment , tax:AgreementRenewal , tax:AgreementTermination ;
        skos:relatedMatch tax:AgreementLifecycle ;
        skos:inScheme tax:EventTaxonomy .

    tax:AgreementExecution a skos:Concept ;
        skos:prefLabel "Agreement execution"@en ;
        skos:altLabel "Contract signing"@en ;
        skos:definition "An agreement event in which parties sign or accept an agreement and it becomes binding."@en ;
        skos:broader tax:AgreementEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AgreementAmendment a skos:Concept ;
        skos:prefLabel "Agreement amendment"@en ;
        skos:altLabel "Contract amendment"@en ;
        skos:definition "An agreement event in which the terms of an existing agreement are changed."@en ;
        skos:broader tax:AgreementEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AgreementRenewal a skos:Concept ;
        skos:prefLabel "Agreement renewal"@en ;
        skos:altLabel "Contract renewal"@en ;
        skos:definition "An agreement event in which an agreement is extended for a further term."@en ;
        skos:broader tax:AgreementEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AgreementTermination a skos:Concept ;
        skos:prefLabel "Agreement termination"@en ;
        skos:altLabel "Contract termination"@en , "Cancellation"@en ;
        skos:definition "An agreement event in which an agreement ends before or at its expiry."@en ;
        skos:broader tax:AgreementEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:TransactionEvent a skos:Concept ;
        skos:prefLabel "Transaction event"@en ;
        skos:definition "A business event in which value is exchanged or committed between parties."@en ;
        skos:example "Payment issued; order placed."@en ;
        skos:broader tax:BusinessEvent ;
        skos:narrower tax:OrderPlacement , tax:Payment , tax:Refund , tax:Enrollment ;
        skos:inScheme tax:EventTaxonomy .

    tax:OrderPlacement a skos:Concept ;
        skos:prefLabel "Order placement"@en ;
        skos:altLabel "Order"@en ;
        skos:definition "A transaction event in which a party requests goods or services under stated terms."@en ;
        skos:broader tax:TransactionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:Payment a skos:Concept ;
        skos:prefLabel "Payment"@en ;
        skos:altLabel "Payment issued"@en , "Disbursement"@en ;
        skos:definition "A transaction event in which money is transferred from one party to another."@en ;
        skos:broader tax:TransactionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:Refund a skos:Concept ;
        skos:prefLabel "Refund"@en ;
        skos:altLabel "Reversal"@en ;
        skos:definition "A transaction event in which money is returned to a party."@en ;
        skos:broader tax:TransactionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:Enrollment a skos:Concept ;
        skos:prefLabel "Enrollment"@en ;
        skos:altLabel "Election"@en , "Sign-up"@en ;
        skos:definition "A transaction event in which a party elects to participate in an offering or plan."@en ;
        skos:broader tax:TransactionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ProcessEvent a skos:Concept ;
        skos:prefLabel "Process event"@en ;
        skos:definition "An event that marks a change in the execution state of a process or process step."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:ProcessStart , tax:ProcessCompletion , tax:ProcessException , tax:Handoff , tax:EscalationRaised ;
        skos:relatedMatch tax:ProcessStep ;
        skos:inScheme tax:EventTaxonomy .

    tax:ProcessStart a skos:Concept ;
        skos:prefLabel "Process start"@en ;
        skos:altLabel "Step started"@en ;
        skos:definition "A process event that marks the beginning of a process or process step instance."@en ;
        skos:broader tax:ProcessEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ProcessCompletion a skos:Concept ;
        skos:prefLabel "Process completion"@en ;
        skos:altLabel "Step completed"@en ;
        skos:definition "A process event that marks the successful end of a process or process step instance."@en ;
        skos:broader tax:ProcessEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ProcessException a skos:Concept ;
        skos:prefLabel "Process exception"@en ;
        skos:altLabel "Exception raised"@en ;
        skos:definition "A process event that marks a deviation from the expected path of a process step."@en ;
        skos:broader tax:ProcessEvent ;
        skos:relatedMatch tax:ProcessExceptionIssue ;
        skos:inScheme tax:EventTaxonomy .

    tax:Handoff a skos:Concept ;
        skos:prefLabel "Handoff"@en ;
        skos:altLabel "Transfer of work"@en ;
        skos:definition "A process event in which responsibility for work passes from one party or role to another."@en ;
        skos:broader tax:ProcessEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:EscalationRaised a skos:Concept ;
        skos:prefLabel "Escalation raised"@en ;
        skos:altLabel "Escalation"@en ;
        skos:definition "A process event in which work is referred to a higher authority or specialist."@en ;
        skos:broader tax:ProcessEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:TimeEvent a skos:Concept ;
        skos:prefLabel "Time event"@en ;
        skos:altLabel "Temporal event"@en , "Scheduled event"@en ;
        skos:definition "An event that occurs because a point in time is reached."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:PeriodStart , tax:PeriodEnd , tax:DeadlineReached , tax:EffectiveDateReached , tax:ExpirationReached ;
        skos:relatedMatch tax:Instant ;
        skos:inScheme tax:EventTaxonomy .

    tax:PeriodStart a skos:Concept ;
        skos:prefLabel "Period start"@en ;
        skos:definition "A time event that marks the beginning of a defined period."@en ;
        skos:example "Start of a pay period; start of a plan year."@en ;
        skos:broader tax:TimeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:PeriodEnd a skos:Concept ;
        skos:prefLabel "Period end"@en ;
        skos:altLabel "Period close"@en ;
        skos:definition "A time event that marks the end of a defined period."@en ;
        skos:broader tax:TimeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:DeadlineReached a skos:Concept ;
        skos:prefLabel "Deadline reached"@en ;
        skos:altLabel "Due date reached"@en ;
        skos:definition "A time event that marks the latest time by which an action must be completed."@en ;
        skos:broader tax:TimeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:EffectiveDateReached a skos:Concept ;
        skos:prefLabel "Effective date reached"@en ;
        skos:altLabel "Effective date"@en ;
        skos:definition "A time event that marks when a rule, policy, agreement, or change takes effect."@en ;
        skos:broader tax:TimeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ExpirationReached a skos:Concept ;
        skos:prefLabel "Expiration reached"@en ;
        skos:altLabel "Expiration"@en , "Expiry"@en ;
        skos:definition "A time event that marks when a right, agreement, or document ceases to be valid."@en ;
        skos:broader tax:TimeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ChangeEvent a skos:Concept ;
        skos:prefLabel "Change event"@en ;
        skos:definition "An event that records a change in data, configuration, or governed knowledge."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:DataChange , tax:ConfigurationChange , tax:KnowledgeChange , tax:RegulatoryChange ;
        skos:relatedMatch tax:ChangeControl ;
        skos:inScheme tax:EventTaxonomy .

    tax:DataChange a skos:Concept ;
        skos:prefLabel "Data change"@en ;
        skos:altLabel "Change data capture event"@en , "Record change"@en ;
        skos:definition "A change event in which a stored record is created, updated, or deleted."@en ;
        skos:broader tax:ChangeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ConfigurationChange a skos:Concept ;
        skos:prefLabel "Configuration change"@en ;
        skos:definition "A change event in which settings of a system or service are altered."@en ;
        skos:broader tax:ChangeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:KnowledgeChange a skos:Concept ;
        skos:prefLabel "Knowledge change"@en ;
        skos:altLabel "Ontology change"@en , "Taxonomy change"@en ;
        skos:definition "A change event in which a governed term, rule, mapping, or shape is created, changed, or deprecated."@en ;
        skos:broader tax:ChangeEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:RegulatoryChange a skos:Concept ;
        skos:prefLabel "Regulatory change"@en ;
        skos:altLabel "Legislative change"@en , "Norm amendment"@en ;
        skos:definition "A change event in which a law, regulation, or official guidance is enacted, amended, or repealed."@en ;
        skos:broader tax:ChangeEvent ;
        skos:relatedMatch tax:LegalNormSource ;
        skos:inScheme tax:EventTaxonomy .

    tax:SystemEvent a skos:Concept ;
        skos:prefLabel "System event"@en ;
        skos:altLabel "Technical event"@en ;
        skos:definition "An event that is generated by a software system about its own operation."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:MessageReceipt , tax:SystemAlert , tax:JobCompletion , tax:AvailabilityChange ;
        skos:inScheme tax:EventTaxonomy .

    tax:MessageReceipt a skos:Concept ;
        skos:prefLabel "Message receipt"@en ;
        skos:altLabel "Inbound message"@en , "File received"@en ;
        skos:definition "A system event in which a system receives a message or file from another system."@en ;
        skos:broader tax:SystemEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:SystemAlert a skos:Concept ;
        skos:prefLabel "System alert"@en ;
        skos:altLabel "Alert"@en , "Alarm"@en ;
        skos:definition "A system event that signals a condition requiring attention."@en ;
        skos:broader tax:SystemEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:JobCompletion a skos:Concept ;
        skos:prefLabel "Job completion"@en ;
        skos:altLabel "Batch completion"@en ;
        skos:definition "A system event that marks the end of a scheduled or batch job."@en ;
        skos:broader tax:SystemEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AvailabilityChange a skos:Concept ;
        skos:prefLabel "Availability change"@en ;
        skos:altLabel "Outage start"@en , "Outage end"@en ;
        skos:definition "A system event in which a system becomes available or unavailable."@en ;
        skos:broader tax:SystemEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:InteractionEvent a skos:Concept ;
        skos:prefLabel "Interaction event"@en ;
        skos:altLabel "Engagement event"@en ;
        skos:definition "An event in which a party communicates with the organization or one of its systems."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:Inquiry , tax:RequestSubmission , tax:FeedbackSubmission , tax:NotificationDelivery , tax:AnswerDelivery ;
        skos:inScheme tax:EventTaxonomy .

    tax:Inquiry a skos:Concept ;
        skos:prefLabel "Inquiry"@en ;
        skos:altLabel "Question asked"@en , "Query"@en ;
        skos:definition "An interaction event in which a party asks a question or requests information."@en ;
        skos:broader tax:InteractionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:RequestSubmission a skos:Concept ;
        skos:prefLabel "Request submission"@en ;
        skos:altLabel "Service request submitted"@en ;
        skos:definition "An interaction event in which a party submits a request for action."@en ;
        skos:broader tax:InteractionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:FeedbackSubmission a skos:Concept ;
        skos:prefLabel "Feedback submission"@en ;
        skos:altLabel "Feedback"@en , "Answer rating"@en ;
        skos:definition "An interaction event in which a party rates or comments on a service or answer."@en ;
        skos:broader tax:InteractionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:NotificationDelivery a skos:Concept ;
        skos:prefLabel "Notification delivery"@en ;
        skos:altLabel "Notification sent"@en ;
        skos:definition "An interaction event in which the organization sends information to a party."@en ;
        skos:broader tax:InteractionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AnswerDelivery a skos:Concept ;
        skos:prefLabel "Answer delivery"@en ;
        skos:altLabel "Response"@en , "Assistant answer"@en ;
        skos:definition "An interaction event in which an artificial intelligence agent or person returns an answer to a question."@en ;
        skos:broader tax:InteractionEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:GovernanceEvent a skos:Concept ;
        skos:prefLabel "Governance event"@en ;
        skos:definition "An event in which a governance decision or control outcome is recorded."@en ;
        skos:topConceptOf tax:EventTaxonomy ;
        skos:narrower tax:ApprovalGranted , tax:ApprovalDenied , tax:ReleasePublished , tax:ControlFailureDetected , tax:AuditCompleted ;
        skos:relatedMatch tax:GovernanceActivity ;
        skos:inScheme tax:EventTaxonomy .

    tax:ApprovalGranted a skos:Concept ;
        skos:prefLabel "Approval granted"@en ;
        skos:altLabel "Approval"@en , "Sign-off"@en ;
        skos:definition "A governance event in which an authorized party approves an item."@en ;
        skos:broader tax:GovernanceEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ApprovalDenied a skos:Concept ;
        skos:prefLabel "Approval denied"@en ;
        skos:altLabel "Rejection"@en ;
        skos:definition "A governance event in which an authorized party rejects an item."@en ;
        skos:broader tax:GovernanceEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ReleasePublished a skos:Concept ;
        skos:prefLabel "Release published"@en ;
        skos:altLabel "Release"@en , "Deployment"@en ;
        skos:definition "A governance event in which a versioned artifact is promoted to an environment."@en ;
        skos:broader tax:GovernanceEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:ControlFailureDetected a skos:Concept ;
        skos:prefLabel "Control failure detected"@en ;
        skos:altLabel "Gate failure"@en , "Circuit breaker trip"@en ;
        skos:definition "A governance event in which a control or quality gate does not pass."@en ;
        skos:broader tax:GovernanceEvent ;
        skos:inScheme tax:EventTaxonomy .

    tax:AuditCompleted a skos:Concept ;
        skos:prefLabel "Audit completed"@en ;
        skos:definition "A governance event in which an audit concludes with recorded findings."@en ;
        skos:broader tax:GovernanceEvent ;
        skos:inScheme tax:EventTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-governance> {
    tax:GovernanceTaxonomy a skos:ConceptScheme ;
        dcterms:title "Governance taxonomy"@en ;
        skos:prefLabel "Governance taxonomy"@en ;
        dcterms:description "Classification of governance concepts, the disciplines, bodies, controls, activities, and records through which the organization directs, oversees, and assures its work, data, knowledge, and artificial intelligence."@en ;
        dcterms:subject core:Governance ;
        skos:scopeNote "Data classification, verification, approval, change, validation, and environment values are in the governance vocabulary. Governance roles are in the role taxonomy."@en ;
        dcterms:source "ISO/IEC 38500 governance of information technology; ISO/IEC 42001 artificial intelligence management system; ISO 30401; ISO/IEC 11179 metadata registries; Semantic Governance v1.8 Sections 3.3 and 3.4."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:GovernanceDiscipline ,
            tax:GovernanceBody ,
            tax:Control ,
            tax:GovernanceActivity ,
            tax:GovernanceRecord .

    tax:GovernanceDiscipline a skos:Concept ;
        skos:prefLabel "Governance discipline"@en ;
        skos:altLabel "Governance domain"@en ;
        skos:definition "A governance area of practice that directs and oversees a defined subject."@en ;
        skos:topConceptOf tax:GovernanceTaxonomy ;
        skos:narrower tax:CorporateGovernance , tax:DataGovernance , tax:SemanticGovernance , tax:ArtificialIntelligenceGovernance , tax:TechnologyGovernance , tax:RiskGovernance ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:CorporateGovernance a skos:Concept ;
        skos:prefLabel "Corporate governance"@en ;
        skos:definition "A governance discipline concerned with direction and control of the organization by its board and executives."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:DataGovernance a skos:Concept ;
        skos:prefLabel "Data governance"@en ;
        skos:altLabel "Information governance"@en ;
        skos:definition "A governance discipline concerned with the quality, security, and proper use of data."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:SemanticGovernance a skos:Concept ;
        skos:prefLabel "Semantic governance"@en ;
        skos:altLabel "Knowledge governance"@en , "SG"@en ;
        skos:definition "A governance discipline concerned with shared, governed meaning in vocabularies, taxonomies, ontologies, rules, and mappings."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ArtificialIntelligenceGovernance a skos:Concept ;
        skos:prefLabel "Artificial intelligence governance"@en ;
        skos:altLabel "AI governance"@en , "Model governance"@en ;
        skos:definition "A governance discipline concerned with responsible design, deployment, and oversight of artificial intelligence."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:TechnologyGovernance a skos:Concept ;
        skos:prefLabel "Technology governance"@en ;
        skos:altLabel "Information technology governance"@en , "IT governance"@en ;
        skos:definition "A governance discipline concerned with the value, risk, and performance of technology."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:RiskGovernance a skos:Concept ;
        skos:prefLabel "Risk governance"@en ;
        skos:definition "A governance discipline concerned with risk appetite, oversight, and accountability."@en ;
        skos:broader tax:GovernanceDiscipline ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:GovernanceBody a skos:Concept ;
        skos:prefLabel "Governance body"@en ;
        skos:altLabel "Governing body"@en ;
        skos:definition "A governance structure that is a group with authority to make or review governance decisions."@en ;
        skos:topConceptOf tax:GovernanceTaxonomy ;
        skos:narrower tax:BoardOfDirectors , tax:ArchitectureReviewBoard , tax:DataGovernanceCouncil , tax:ChangeAdvisoryBoard , tax:ArtificialIntelligenceOversightCommittee ;
        skos:relatedMatch tax:Committee ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:BoardOfDirectors a skos:Concept ;
        skos:prefLabel "Board of directors"@en ;
        skos:altLabel "Board"@en ;
        skos:definition "A governance body elected to oversee the organization on behalf of owners."@en ;
        skos:broader tax:GovernanceBody ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ArchitectureReviewBoard a skos:Concept ;
        skos:prefLabel "Architecture review board"@en ;
        skos:altLabel "Architecture board"@en , "Architecture"@en ;
        skos:definition "A governance body that reviews and approves architecture and core and mapping changes."@en ;
        skos:broader tax:GovernanceBody ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:DataGovernanceCouncil a skos:Concept ;
        skos:prefLabel "Data governance council"@en ;
        skos:altLabel "Data council"@en ;
        skos:definition "A governance body that sets data policies and resolves data issues across domains."@en ;
        skos:broader tax:GovernanceBody ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ChangeAdvisoryBoard a skos:Concept ;
        skos:prefLabel "Change advisory board"@en ;
        skos:altLabel "CAB"@en ;
        skos:definition "A governance body that assesses and approves changes to production."@en ;
        skos:broader tax:GovernanceBody ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ArtificialIntelligenceOversightCommittee a skos:Concept ;
        skos:prefLabel "Artificial intelligence oversight committee"@en ;
        skos:altLabel "AI oversight committee"@en , "Responsible AI committee"@en ;
        skos:definition "A governance body that reviews artificial intelligence use, impact assessments, and incidents."@en ;
        skos:broader tax:GovernanceBody ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Control a skos:Concept ;
        skos:prefLabel "Control"@en ;
        skos:altLabel "Internal control"@en , "Safeguard"@en ;
        skos:definition "A governance measure that modifies risk by preventing, detecting, or correcting unwanted outcomes."@en ;
        skos:topConceptOf tax:GovernanceTaxonomy ;
        skos:narrower tax:PreventiveControl , tax:DetectiveControl , tax:CorrectiveControl , tax:QualityGate , tax:SegregationOfDuties , tax:AccessControl , tax:HumanOversight ;
        skos:relatedMatch tax:ControlDeficiency ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:PreventiveControl a skos:Concept ;
        skos:prefLabel "Preventive control"@en ;
        skos:altLabel "Preventative control"@en ;
        skos:definition "A control that stops an unwanted outcome before it occurs."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:DetectiveControl a skos:Concept ;
        skos:prefLabel "Detective control"@en ;
        skos:altLabel "Monitoring control"@en ;
        skos:definition "A control that identifies an unwanted outcome after it occurs."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:CorrectiveControl a skos:Concept ;
        skos:prefLabel "Corrective control"@en ;
        skos:definition "A control that limits damage and restores the expected state after an unwanted outcome."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:QualityGate a skos:Concept ;
        skos:prefLabel "Quality gate"@en ;
        skos:altLabel "Release gate"@en , "Validation gate"@en ;
        skos:definition "A control that blocks release of an artifact that fails defined checks."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:SegregationOfDuties a skos:Concept ;
        skos:prefLabel "Segregation of duties"@en ;
        skos:altLabel "Separation of duties"@en ;
        skos:definition "A control that divides conflicting responsibilities among different parties."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:AccessControl a skos:Concept ;
        skos:prefLabel "Access control"@en ;
        skos:altLabel "Entitlement control"@en ;
        skos:definition "A control that restricts who can read or change information."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:HumanOversight a skos:Concept ;
        skos:prefLabel "Human oversight"@en ;
        skos:altLabel "Human in the loop"@en , "Human review"@en ;
        skos:definition "A control in which a person reviews, approves, or can override an automated decision or output."@en ;
        skos:broader tax:Control ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:GovernanceActivity a skos:Concept ;
        skos:prefLabel "Governance activity"@en ;
        skos:altLabel "Assurance activity"@en ;
        skos:definition "A governance process step undertaken to direct, assure, or improve governed work."@en ;
        skos:topConceptOf tax:GovernanceTaxonomy ;
        skos:narrower tax:Review , tax:Audit , tax:ImpactAssessment , tax:RiskAssessment , tax:ChangeControl , tax:Attestation , tax:Monitoring ;
        skos:relatedMatch tax:ProcessStep ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Review a skos:Concept ;
        skos:prefLabel "Review"@en ;
        skos:altLabel "Peer review"@en , "Expert review"@en ;
        skos:definition "A governance activity in which a qualified party examines work for correctness and conformance."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Audit a skos:Concept ;
        skos:prefLabel "Audit"@en ;
        skos:altLabel "Internal audit"@en , "Compliance audit"@en ;
        skos:definition "A governance activity that independently examines records and controls against criteria."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ImpactAssessment a skos:Concept ;
        skos:prefLabel "Impact assessment"@en ;
        skos:altLabel "Change impact assessment"@en ;
        skos:definition "A governance activity that evaluates the effects of a proposed change or system before it proceeds."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:narrower tax:ArtificialIntelligenceImpactAssessment , tax:PrivacyImpactAssessment ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ArtificialIntelligenceImpactAssessment a skos:Concept ;
        skos:prefLabel "Artificial intelligence impact assessment"@en ;
        skos:altLabel "AI impact assessment"@en ;
        skos:definition "An impact assessment of the effects of an artificial intelligence system on people and the organization."@en ;
        skos:broader tax:ImpactAssessment ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:PrivacyImpactAssessment a skos:Concept ;
        skos:prefLabel "Privacy impact assessment"@en ;
        skos:altLabel "Data protection impact assessment"@en ;
        skos:definition "An impact assessment of the effects of processing on personal information."@en ;
        skos:broader tax:ImpactAssessment ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:RiskAssessment a skos:Concept ;
        skos:prefLabel "Risk assessment"@en ;
        skos:altLabel "Risk analysis"@en ;
        skos:definition "A governance activity that identifies, analyzes, and evaluates risks."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ChangeControl a skos:Concept ;
        skos:prefLabel "Change control"@en ;
        skos:altLabel "Change management"@en , "Change governance"@en ;
        skos:definition "A governance activity that ensures every change is traceable to an approved requirement, tested, and versioned."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Attestation a skos:Concept ;
        skos:prefLabel "Attestation"@en ;
        skos:altLabel "Certification"@en , "Acknowledgment"@en ;
        skos:definition "A governance activity in which a party formally confirms compliance or acknowledgment."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Monitoring a skos:Concept ;
        skos:prefLabel "Monitoring"@en ;
        skos:altLabel "Oversight monitoring"@en , "Continuous monitoring"@en ;
        skos:definition "A governance activity that continuously observes artifacts, services, and answers against targets."@en ;
        skos:broader tax:GovernanceActivity ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:GovernanceRecord a skos:Concept ;
        skos:prefLabel "Governance record"@en ;
        skos:altLabel "Governance artifact"@en , "Register"@en ;
        skos:definition "A governance information artifact that documents governance decisions, obligations, or evidence."@en ;
        skos:topConceptOf tax:GovernanceTaxonomy ;
        skos:narrower tax:Charter , tax:DecisionLog , tax:ObligationsRegister , tax:RiskRegister , tax:MetadataRegistry , tax:AuditTrail , tax:ReleaseManifest ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:Charter a skos:Concept ;
        skos:prefLabel "Charter"@en ;
        skos:definition "A governance record that establishes the purpose, authority, and membership of a governance body or program."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:DecisionLog a skos:Concept ;
        skos:prefLabel "Decision log"@en ;
        skos:altLabel "Architecture decision record"@en , "Decision register"@en ;
        skos:definition "A governance record that lists governance decisions, their rationale, and approvers."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ObligationsRegister a skos:Concept ;
        skos:prefLabel "Obligations register"@en ;
        skos:altLabel "Compliance register"@en ;
        skos:definition "A governance record that lists obligations, their sources, owners, and controls."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:RiskRegister a skos:Concept ;
        skos:prefLabel "Risk register"@en ;
        skos:definition "A governance record that lists risks, their ratings, owners, and treatments."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:MetadataRegistry a skos:Concept ;
        skos:prefLabel "Metadata registry"@en ;
        skos:altLabel "Artifact registry"@en , "Model registry"@en ;
        skos:definition "A governance record that registers each artifact, version, and status."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:AuditTrail a skos:Concept ;
        skos:prefLabel "Audit trail"@en ;
        skos:altLabel "Audit log"@en ;
        skos:definition "A governance record of the sequence of actions on an item, who took them, and when."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .

    tax:ReleaseManifest a skos:Concept ;
        skos:prefLabel "Release manifest"@en ;
        skos:altLabel "Component manifest"@en ;
        skos:definition "A governance record that lists the artifacts, versions, and checksums in a release."@en ;
        skos:broader tax:GovernanceRecord ;
        skos:inScheme tax:GovernanceTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-issue> {
    tax:IssueTaxonomy a skos:ConceptScheme ;
        dcterms:title "Issue taxonomy"@en ;
        skos:prefLabel "Issue taxonomy"@en ;
        dcterms:description "Classification of conditions that deviate from what is expected or required and need to be assessed, tracked, or resolved."@en ;
        dcterms:subject core:Issue ;
        skos:scopeNote "Covers kinds of issue. Severity, priority, status, resolution, and root-cause values are in the issue vocabulary."@en ;
        dcterms:source "ISO 31000 for risk; ISO/IEC 5259 for data quality; ITIL practice for incident and problem."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:Defect ,
            tax:Incident ,
            tax:Problem ,
            tax:Risk ,
            tax:Nonconformance ,
            tax:Exception ,
            tax:Complaint ,
            tax:QuestionGap .

    tax:Defect a skos:Concept ;
        skos:prefLabel "Defect"@en ;
        skos:altLabel "Bug"@en , "Fault"@en ;
        skos:definition "An issue that is a fault in an artifact causing it to differ from its specification or intended meaning."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:narrower tax:DataDefect , tax:KnowledgeDefect , tax:SoftwareDefect , tax:ArtificialIntelligenceOutputDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:DataDefect a skos:Concept ;
        skos:prefLabel "Data defect"@en ;
        skos:altLabel "Data quality issue"@en ;
        skos:definition "A defect in data values or records."@en ;
        skos:broader tax:Defect ;
        skos:narrower tax:MissingValue , tax:InvalidValue , tax:DuplicateRecord , tax:InconsistentValue , tax:StaleValue ;
        skos:relatedMatch tax:DataQualityDimension ;
        skos:inScheme tax:IssueTaxonomy .

    tax:MissingValue a skos:Concept ;
        skos:prefLabel "Missing value"@en ;
        skos:altLabel "Null value"@en , "Incomplete record"@en ;
        skos:definition "A data defect in which a required value is absent."@en ;
        skos:broader tax:DataDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:InvalidValue a skos:Concept ;
        skos:prefLabel "Invalid value"@en ;
        skos:altLabel "Malformed value"@en ;
        skos:definition "A data defect in which a value does not conform to its allowed type, format, or range."@en ;
        skos:broader tax:DataDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:DuplicateRecord a skos:Concept ;
        skos:prefLabel "Duplicate record"@en ;
        skos:altLabel "Duplicate"@en ;
        skos:definition "A data defect in which the same entity is recorded more than once."@en ;
        skos:broader tax:DataDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:InconsistentValue a skos:Concept ;
        skos:prefLabel "Inconsistent value"@en ;
        skos:altLabel "Conflicting value"@en ;
        skos:definition "A data defect in which values about the same fact disagree across records or systems."@en ;
        skos:broader tax:DataDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:StaleValue a skos:Concept ;
        skos:prefLabel "Stale value"@en ;
        skos:altLabel "Outdated value"@en ;
        skos:definition "A data defect in which a value is older than its required freshness."@en ;
        skos:broader tax:DataDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:KnowledgeDefect a skos:Concept ;
        skos:prefLabel "Knowledge defect"@en ;
        skos:altLabel "Semantic defect"@en , "Design-time defect"@en ;
        skos:definition "A defect in a governed vocabulary, taxonomy, ontology, mapping, or rule."@en ;
        skos:broader tax:Defect ;
        skos:narrower tax:DefinitionDefect , tax:LabelDefect , tax:ClassificationDefect , tax:MappingDefect , tax:RuleDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:DefinitionDefect a skos:Concept ;
        skos:prefLabel "Definition defect"@en ;
        skos:definition "A knowledge defect in which a term's definition is missing, circular, ambiguous, or wrong."@en ;
        skos:broader tax:KnowledgeDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:LabelDefect a skos:Concept ;
        skos:prefLabel "Label defect"@en ;
        skos:definition "A knowledge defect in which a label is missing, duplicated, colliding, or uses an unapproved acronym."@en ;
        skos:broader tax:KnowledgeDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ClassificationDefect a skos:Concept ;
        skos:prefLabel "Classification defect"@en ;
        skos:altLabel "Orphan term"@en , "Misclassification"@en ;
        skos:definition "A knowledge defect in which a term is placed under the wrong parent or has no path to the core."@en ;
        skos:broader tax:KnowledgeDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:MappingDefect a skos:Concept ;
        skos:prefLabel "Mapping defect"@en ;
        skos:altLabel "Unmapped element"@en ;
        skos:definition "A knowledge defect in which a source element is mapped to the wrong term or not mapped."@en ;
        skos:broader tax:KnowledgeDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:RuleDefect a skos:Concept ;
        skos:prefLabel "Rule defect"@en ;
        skos:altLabel "Decision table gap"@en , "Decision table overlap"@en ;
        skos:definition "A knowledge defect in which a rule has a gap, overlap, or incorrect outcome."@en ;
        skos:broader tax:KnowledgeDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:SoftwareDefect a skos:Concept ;
        skos:prefLabel "Software defect"@en ;
        skos:altLabel "Code defect"@en ;
        skos:definition "A defect in software code or configuration."@en ;
        skos:broader tax:Defect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ArtificialIntelligenceOutputDefect a skos:Concept ;
        skos:prefLabel "Artificial intelligence output defect"@en ;
        skos:altLabel "AI output defect"@en ;
        skos:definition "A defect in content generated by an artificial intelligence agent."@en ;
        skos:broader tax:Defect ;
        skos:narrower tax:Hallucination , tax:UngroundedAnswer , tax:IncorrectCitation , tax:PolicyViolatingOutput ;
        skos:relatedMatch tax:ArtificialIntelligenceRisk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Hallucination a skos:Concept ;
        skos:prefLabel "Hallucination"@en ;
        skos:altLabel "Confabulation"@en , "Fabricated answer"@en ;
        skos:definition "An artificial intelligence output defect in which the output states something that is not supported by governed facts or sources."@en ;
        skos:broader tax:ArtificialIntelligenceOutputDefect ;
        skos:relatedMatch tax:MeanTimeBetweenHallucinations ;
        skos:inScheme tax:IssueTaxonomy .

    tax:UngroundedAnswer a skos:Concept ;
        skos:prefLabel "Ungrounded answer"@en ;
        skos:altLabel "Missing citation"@en , "Untraceable answer"@en ;
        skos:definition "An artificial intelligence output defect in which an answer does not cite the governed terms and sources it relied on."@en ;
        skos:broader tax:ArtificialIntelligenceOutputDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:IncorrectCitation a skos:Concept ;
        skos:prefLabel "Incorrect citation"@en ;
        skos:definition "An artificial intelligence output defect in which an answer cites a source that does not support it."@en ;
        skos:broader tax:ArtificialIntelligenceOutputDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:PolicyViolatingOutput a skos:Concept ;
        skos:prefLabel "Policy violating output"@en ;
        skos:altLabel "Guardrail breach"@en ;
        skos:definition "An artificial intelligence output defect in which the output breaches a guardrail or policy."@en ;
        skos:broader tax:ArtificialIntelligenceOutputDefect ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Incident a skos:Concept ;
        skos:prefLabel "Incident"@en ;
        skos:altLabel "Service incident"@en ;
        skos:definition "An issue that is an unplanned interruption or reduction in the quality of a service."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:narrower tax:ServiceOutage , tax:PerformanceDegradation , tax:SecurityIncident , tax:PrivacyIncident ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ServiceOutage a skos:Concept ;
        skos:prefLabel "Service outage"@en ;
        skos:altLabel "Outage"@en , "Downtime"@en ;
        skos:definition "An incident in which a service is unavailable to its users."@en ;
        skos:broader tax:Incident ;
        skos:inScheme tax:IssueTaxonomy .

    tax:PerformanceDegradation a skos:Concept ;
        skos:prefLabel "Performance degradation"@en ;
        skos:altLabel "Slowdown"@en ;
        skos:definition "An incident in which a service is available but slower or less reliable than its service level."@en ;
        skos:broader tax:Incident ;
        skos:inScheme tax:IssueTaxonomy .

    tax:SecurityIncident a skos:Concept ;
        skos:prefLabel "Security incident"@en ;
        skos:altLabel "Cybersecurity incident"@en ;
        skos:definition "An incident that compromises the confidentiality, integrity, or availability of information or systems."@en ;
        skos:broader tax:Incident ;
        skos:inScheme tax:IssueTaxonomy .

    tax:PrivacyIncident a skos:Concept ;
        skos:prefLabel "Privacy incident"@en ;
        skos:altLabel "Data breach"@en , "Privacy breach"@en ;
        skos:definition "An incident in which personal information is accessed, used, or disclosed without authorization."@en ;
        skos:broader tax:Incident ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Problem a skos:Concept ;
        skos:prefLabel "Problem"@en ;
        skos:altLabel "Root cause problem"@en ;
        skos:definition "An issue that is the underlying cause of one or more incidents or defects."@en ;
        skos:scopeNote "Problems are resolved by removing the cause, incidents by restoring service."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Risk a skos:Concept ;
        skos:prefLabel "Risk"@en ;
        skos:altLabel "Risk item"@en ;
        skos:definition "An issue that is the effect of uncertainty on objectives, expressed as a possible event and its consequence."@en ;
        skos:scopeNote "A risk has not yet occurred; once it occurs it is recorded as an incident or nonconformance."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:narrower tax:ComplianceRisk , tax:OperationalRisk , tax:FinancialRisk , tax:StrategicRisk , tax:ArtificialIntelligenceRisk , tax:InformationSecurityRisk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ComplianceRisk a skos:Concept ;
        skos:prefLabel "Compliance risk"@en ;
        skos:altLabel "Regulatory risk"@en ;
        skos:definition "A risk of failing to meet a legal, regulatory, or contractual obligation."@en ;
        skos:broader tax:Risk ;
        skos:relatedMatch tax:Obligation ;
        skos:inScheme tax:IssueTaxonomy .

    tax:OperationalRisk a skos:Concept ;
        skos:prefLabel "Operational risk"@en ;
        skos:definition "A risk of loss from failed processes, people, systems, or external events."@en ;
        skos:broader tax:Risk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:FinancialRisk a skos:Concept ;
        skos:prefLabel "Financial risk"@en ;
        skos:altLabel "Credit risk"@en , "Market risk"@en ;
        skos:definition "A risk of monetary loss or adverse financial outcome."@en ;
        skos:broader tax:Risk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:StrategicRisk a skos:Concept ;
        skos:prefLabel "Strategic risk"@en ;
        skos:definition "A risk that threatens the organization's direction or competitive position."@en ;
        skos:broader tax:Risk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ArtificialIntelligenceRisk a skos:Concept ;
        skos:prefLabel "Artificial intelligence risk"@en ;
        skos:altLabel "AI risk"@en , "Model risk"@en ;
        skos:definition "A risk arising from the design, data, or use of an artificial intelligence system."@en ;
        skos:broader tax:Risk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:InformationSecurityRisk a skos:Concept ;
        skos:prefLabel "Information security risk"@en ;
        skos:altLabel "Cybersecurity risk"@en ;
        skos:definition "A risk to the confidentiality, integrity, or availability of information."@en ;
        skos:broader tax:Risk ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Nonconformance a skos:Concept ;
        skos:prefLabel "Nonconformance"@en ;
        skos:altLabel "Nonconformity"@en , "Noncompliance"@en ;
        skos:definition "An issue in which a requirement, norm, or control is not met."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:narrower tax:NormViolation , tax:ControlDeficiency , tax:AuditFinding , tax:ServiceLevelBreach ;
        skos:inScheme tax:IssueTaxonomy .

    tax:NormViolation a skos:Concept ;
        skos:prefLabel "Norm violation"@en ;
        skos:altLabel "Compliance violation"@en , "Regulatory violation"@en ;
        skos:definition "A nonconformance in which an obligation or prohibition in a law, regulation, or policy is breached."@en ;
        skos:broader tax:Nonconformance ;
        skos:relatedMatch tax:Norm ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ControlDeficiency a skos:Concept ;
        skos:prefLabel "Control deficiency"@en ;
        skos:altLabel "Control gap"@en ;
        skos:definition "A nonconformance in which a control is missing, poorly designed, or not operating as intended."@en ;
        skos:broader tax:Nonconformance ;
        skos:relatedMatch tax:Control ;
        skos:inScheme tax:IssueTaxonomy .

    tax:AuditFinding a skos:Concept ;
        skos:prefLabel "Audit finding"@en ;
        skos:altLabel "Finding"@en ;
        skos:definition "A nonconformance identified and recorded during an audit."@en ;
        skos:broader tax:Nonconformance ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ServiceLevelBreach a skos:Concept ;
        skos:prefLabel "Service level breach"@en ;
        skos:altLabel "Service level agreement breach"@en , "SLA breach"@en ;
        skos:definition "A nonconformance in which a committed service level is not met."@en ;
        skos:broader tax:Nonconformance ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Exception a skos:Concept ;
        skos:prefLabel "Exception"@en ;
        skos:altLabel "Deviation"@en ;
        skos:definition "An issue that is an approved or detected departure from the normal rule or path."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:narrower tax:ProcessExceptionIssue , tax:PolicyException ;
        skos:inScheme tax:IssueTaxonomy .

    tax:ProcessExceptionIssue a skos:Concept ;
        skos:prefLabel "Process exception issue"@en ;
        skos:altLabel "Process exception case"@en , "Work exception"@en ;
        skos:definition "An exception in which a process step cannot complete along its expected path and needs handling."@en ;
        skos:broader tax:Exception ;
        skos:inScheme tax:IssueTaxonomy .

    tax:PolicyException a skos:Concept ;
        skos:prefLabel "Policy exception"@en ;
        skos:altLabel "Waiver"@en , "Exemption"@en ;
        skos:definition "An exception in which a party is permitted to depart from a policy for a stated reason and period."@en ;
        skos:broader tax:Exception ;
        skos:inScheme tax:IssueTaxonomy .

    tax:Complaint a skos:Concept ;
        skos:prefLabel "Complaint"@en ;
        skos:altLabel "Grievance"@en , "Customer complaint"@en ;
        skos:definition "An issue that is an expression of dissatisfaction by a party about a product, service, or interaction."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:inScheme tax:IssueTaxonomy .

    tax:QuestionGap a skos:Concept ;
        skos:prefLabel "Question gap"@en ;
        skos:altLabel "Knowledge gap"@en , "Zero-result search"@en , "Unanswered question"@en ;
        skos:definition "An issue in which a question cannot be answered from governed knowledge."@en ;
        skos:topConceptOf tax:IssueTaxonomy ;
        skos:relatedMatch tax:Inquiry ;
        skos:inScheme tax:IssueTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-lifecycle> {
    tax:LifecycleTaxonomy a skos:ConceptScheme ;
        dcterms:title "Lifecycle taxonomy"@en ;
        skos:prefLabel "Lifecycle taxonomy"@en ;
        dcterms:description "Classification of the kinds of lifecycle, the ordered sets of stages through which a thing passes from creation to retirement."@en ;
        dcterms:subject core:Lifecycle ;
        skos:scopeNote "Covers kinds of lifecycle. The stages and status values of specific lifecycles, including the knowledge artifact status and the six-stage and ten-stage governance lifecycles, are in the lifecycle vocabulary."@en ;
        dcterms:source "Semantic Governance v1.8 Sections 2.4, 3.3, and 3.4; ISO/IEC/IEEE 15288 for system life cycle stages."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:ArtifactLifecycle ,
            tax:PartyLifecycle ,
            tax:OfferingLifecycle ,
            tax:AssetLifecycle ,
            tax:AgreementLifecycle ,
            tax:WorkItemLifecycle ,
            tax:GovernanceLifecycle .

    tax:ArtifactLifecycle a skos:Concept ;
        skos:prefLabel "Artifact lifecycle"@en ;
        skos:definition "A lifecycle of an information or software asset from creation to retirement."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:narrower tax:KnowledgeArtifactLifecycle , tax:DocumentLifecycle , tax:RecordLifecycle , tax:DataLifecycle , tax:SoftwareReleaseLifecycle , tax:ModelLifecycle ;
        skos:relatedMatch tax:InformationAsset ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:KnowledgeArtifactLifecycle a skos:Concept ;
        skos:prefLabel "Knowledge artifact lifecycle"@en ;
        skos:altLabel "Semantic knowledge lifecycle"@en , "SKL"@en ;
        skos:definition "An artifact lifecycle of a vocabulary, taxonomy, ontology, mapping, shape, or rule from ideation to retirement."@en ;
        skos:scopeNote "Stages are in the lifecycle vocabulary; statuses run Draft, Candidate, Released, Deprecated, Retired."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:relatedMatch tax:KnowledgeArtifact ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:DocumentLifecycle a skos:Concept ;
        skos:prefLabel "Document lifecycle"@en ;
        skos:altLabel "Content lifecycle"@en ;
        skos:definition "An artifact lifecycle of a document from drafting through review, publication, revision, and disposal."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:RecordLifecycle a skos:Concept ;
        skos:prefLabel "Record lifecycle"@en ;
        skos:altLabel "Records retention lifecycle"@en ;
        skos:definition "An artifact lifecycle of a record from capture through retention to disposition."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:DataLifecycle a skos:Concept ;
        skos:prefLabel "Data lifecycle"@en ;
        skos:altLabel "Information lifecycle"@en ;
        skos:definition "An artifact lifecycle of data from creation or acquisition through use, archiving, and deletion."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:SoftwareReleaseLifecycle a skos:Concept ;
        skos:prefLabel "Software release lifecycle"@en ;
        skos:altLabel "Release lifecycle"@en ;
        skos:definition "An artifact lifecycle of a software or knowledge release from build through test, stage, and production promotion to retirement."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ModelLifecycle a skos:Concept ;
        skos:prefLabel "Model lifecycle"@en ;
        skos:altLabel "Artificial intelligence system lifecycle"@en , "AI lifecycle"@en ;
        skos:definition "An artifact lifecycle of a machine learning model from design and training through validation, deployment, monitoring, and retirement."@en ;
        skos:broader tax:ArtifactLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:PartyLifecycle a skos:Concept ;
        skos:prefLabel "Party lifecycle"@en ;
        skos:altLabel "Relationship lifecycle"@en ;
        skos:definition "A lifecycle of a party's relationship with the organization."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:narrower tax:EmploymentLifecycle , tax:ClientLifecycle , tax:SupplierLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:EmploymentLifecycle a skos:Concept ;
        skos:prefLabel "Employment lifecycle"@en ;
        skos:altLabel "Hire to retire"@en , "Employee lifecycle"@en , "Worker lifecycle"@en ;
        skos:definition "A party lifecycle of a worker from recruitment and hire through employment changes to separation."@en ;
        skos:broader tax:PartyLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ClientLifecycle a skos:Concept ;
        skos:prefLabel "Client lifecycle"@en ;
        skos:altLabel "Customer lifecycle"@en , "Prospect to client"@en ;
        skos:definition "A party lifecycle of a client from prospect through onboarding, service, renewal, and exit."@en ;
        skos:broader tax:PartyLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:SupplierLifecycle a skos:Concept ;
        skos:prefLabel "Supplier lifecycle"@en ;
        skos:altLabel "Vendor lifecycle"@en ;
        skos:definition "A party lifecycle of a supplier from qualification and contracting through performance management to exit."@en ;
        skos:broader tax:PartyLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:OfferingLifecycle a skos:Concept ;
        skos:prefLabel "Offering lifecycle"@en ;
        skos:definition "A lifecycle of something offered to clients from concept to withdrawal."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:narrower tax:ProductLifecycle , tax:ServiceLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ProductLifecycle a skos:Concept ;
        skos:prefLabel "Product lifecycle"@en ;
        skos:altLabel "Product life cycle"@en ;
        skos:definition "An offering lifecycle of a product from concept, design, and launch through growth, maturity, and discontinuation."@en ;
        skos:broader tax:OfferingLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ServiceLifecycle a skos:Concept ;
        skos:prefLabel "Service lifecycle"@en ;
        skos:altLabel "Service life cycle"@en ;
        skos:definition "An offering lifecycle of a service from strategy and design through transition, operation, and retirement."@en ;
        skos:broader tax:OfferingLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:AssetLifecycle a skos:Concept ;
        skos:prefLabel "Asset lifecycle"@en ;
        skos:altLabel "Asset life cycle"@en , "Plan to dispose"@en ;
        skos:definition "A lifecycle of a physical or financial asset from planning and acquisition through operation and maintenance to disposal."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:AgreementLifecycle a skos:Concept ;
        skos:prefLabel "Agreement lifecycle"@en ;
        skos:altLabel "Contract lifecycle"@en ;
        skos:definition "A lifecycle of an agreement from drafting and negotiation through execution, performance, renewal, and termination."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:WorkItemLifecycle a skos:Concept ;
        skos:prefLabel "Work item lifecycle"@en ;
        skos:altLabel "Ticket lifecycle"@en ;
        skos:definition "A lifecycle of a unit of tracked work from creation to closure."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:narrower tax:RequirementLifecycle , tax:IssueLifecycle , tax:ChangeLifecycle , tax:DecisionLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:RequirementLifecycle a skos:Concept ;
        skos:prefLabel "Requirement lifecycle"@en ;
        skos:definition "A work item lifecycle of a requirement from elicitation through approval, implementation, and verification."@en ;
        skos:broader tax:WorkItemLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:IssueLifecycle a skos:Concept ;
        skos:prefLabel "Issue lifecycle"@en ;
        skos:altLabel "Incident lifecycle"@en , "Defect lifecycle"@en ;
        skos:definition "A work item lifecycle of an issue from detection through triage and resolution to closure."@en ;
        skos:broader tax:WorkItemLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ChangeLifecycle a skos:Concept ;
        skos:prefLabel "Change lifecycle"@en ;
        skos:altLabel "Change request lifecycle"@en ;
        skos:definition "A work item lifecycle of a change from request through assessment, approval, implementation, and review."@en ;
        skos:broader tax:WorkItemLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:DecisionLifecycle a skos:Concept ;
        skos:prefLabel "Decision lifecycle"@en ;
        skos:definition "A work item lifecycle of a decision from framing through analysis and choice to communication and review."@en ;
        skos:broader tax:WorkItemLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:GovernanceLifecycle a skos:Concept ;
        skos:prefLabel "Governance lifecycle"@en ;
        skos:altLabel "Oversight lifecycle"@en ;
        skos:definition "A lifecycle of governed oversight that a policy, control, or governed artifact passes through from definition to retirement."@en ;
        skos:scopeNote "The ten-stage knowledge governance lifecycle in Section 3.4 is in the lifecycle vocabulary."@en ;
        skos:topConceptOf tax:LifecycleTaxonomy ;
        skos:narrower tax:PolicyLifecycle , tax:ControlLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:PolicyLifecycle a skos:Concept ;
        skos:prefLabel "Policy lifecycle"@en ;
        skos:altLabel "Policy management lifecycle"@en ;
        skos:definition "A governance lifecycle of a policy from drafting and approval through publication, attestation, review, and retirement."@en ;
        skos:broader tax:GovernanceLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .

    tax:ControlLifecycle a skos:Concept ;
        skos:prefLabel "Control lifecycle"@en ;
        skos:definition "A governance lifecycle of a control from design through implementation, testing, operation, and remediation."@en ;
        skos:broader tax:GovernanceLifecycle ;
        skos:inScheme tax:LifecycleTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-location> {
    tax:LocationTaxonomy a skos:ConceptScheme ;
        dcterms:title "Location taxonomy"@en ;
        skos:prefLabel "Location taxonomy"@en ;
        dcterms:description "Classification of locations, the places, jurisdictions, sites, and references where parties, assets, and process steps are located or where norms apply."@en ;
        dcterms:subject core:Location ;
        skos:scopeNote "Jurisdiction values with ISO 3166-2 codes, work arrangement, and address type values are in the location vocabulary."@en ;
        dcterms:source "BFO site and spatial region (ISO/IEC 21838-2); ISO 3166 country and subdivision codes; LKIF-Core jurisdiction."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:GeographicArea ,
            tax:Jurisdiction ,
            tax:Site ,
            tax:LocationReference ,
            tax:VirtualLocation .

    tax:GeographicArea a skos:Concept ;
        skos:prefLabel "Geographic area"@en ;
        skos:altLabel "Geographic location"@en , "Place"@en ;
        skos:definition "A location that is a region of the earth's surface identified by name or boundary."@en ;
        skos:topConceptOf tax:LocationTaxonomy ;
        skos:narrower tax:Country , tax:StateOrProvince , tax:County , tax:City , tax:PostalArea , tax:Region ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Country a skos:Concept ;
        skos:prefLabel "Country"@en ;
        skos:altLabel "Nation"@en ;
        skos:definition "A geographic area that is a sovereign nation."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:StateOrProvince a skos:Concept ;
        skos:prefLabel "State or province"@en ;
        skos:altLabel "State"@en , "Province"@en , "Subnational division"@en ;
        skos:definition "A geographic area that is a first-level subdivision of a country."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:County a skos:Concept ;
        skos:prefLabel "County"@en ;
        skos:altLabel "Parish"@en , "Borough"@en ;
        skos:definition "A geographic area that is a subdivision of a state used for local government."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:City a skos:Concept ;
        skos:prefLabel "City"@en ;
        skos:altLabel "Municipality"@en , "Town"@en ;
        skos:definition "A geographic area that is a municipality or populated place."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:PostalArea a skos:Concept ;
        skos:prefLabel "Postal area"@en ;
        skos:altLabel "Zip code area"@en , "Postal code area"@en ;
        skos:definition "A geographic area identified by a postal code."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Region a skos:Concept ;
        skos:prefLabel "Region"@en ;
        skos:altLabel "Sales region"@en , "Service region"@en , "Territory"@en ;
        skos:definition "A geographic area grouping countries, states, or cities for business purposes."@en ;
        skos:broader tax:GeographicArea ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Jurisdiction a skos:Concept ;
        skos:prefLabel "Jurisdiction"@en ;
        skos:altLabel "Legal jurisdiction"@en ;
        skos:definition "A location that is the territory within which a governing authority's laws and regulations apply."@en ;
        skos:topConceptOf tax:LocationTaxonomy ;
        skos:narrower tax:NationalJurisdiction , tax:StateJurisdiction , tax:LocalJurisdiction , tax:TaxJurisdiction ;
        skos:relatedMatch tax:GovernmentBody ;
        skos:inScheme tax:LocationTaxonomy .

    tax:NationalJurisdiction a skos:Concept ;
        skos:prefLabel "National jurisdiction"@en ;
        skos:altLabel "Federal jurisdiction"@en ;
        skos:definition "A jurisdiction of a national government."@en ;
        skos:broader tax:Jurisdiction ;
        skos:inScheme tax:LocationTaxonomy .

    tax:StateJurisdiction a skos:Concept ;
        skos:prefLabel "State jurisdiction"@en ;
        skos:altLabel "Provincial jurisdiction"@en ;
        skos:definition "A jurisdiction of a state or provincial government."@en ;
        skos:broader tax:Jurisdiction ;
        skos:inScheme tax:LocationTaxonomy .

    tax:LocalJurisdiction a skos:Concept ;
        skos:prefLabel "Local jurisdiction"@en ;
        skos:altLabel "Municipal jurisdiction"@en ;
        skos:definition "A jurisdiction of a county, city, or other local government."@en ;
        skos:broader tax:Jurisdiction ;
        skos:inScheme tax:LocationTaxonomy .

    tax:TaxJurisdiction a skos:Concept ;
        skos:prefLabel "Tax jurisdiction"@en ;
        skos:altLabel "Taxing jurisdiction"@en ;
        skos:definition "A jurisdiction defined by a taxing authority, which may cross other boundaries."@en ;
        skos:broader tax:Jurisdiction ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Site a skos:Concept ;
        skos:prefLabel "Site"@en ;
        skos:altLabel "Business location"@en , "Physical site"@en ;
        skos:definition "A location where an organization carries out activities or keeps assets."@en ;
        skos:topConceptOf tax:LocationTaxonomy ;
        skos:narrower tax:Worksite , tax:Office , tax:RemoteWorkLocation , tax:DataCenter , tax:DistributionSite ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Worksite a skos:Concept ;
        skos:prefLabel "Worksite"@en ;
        skos:altLabel "Client worksite"@en , "Work location"@en ;
        skos:definition "A site where workers perform work for a client employer."@en ;
        skos:broader tax:Site ;
        skos:inScheme tax:LocationTaxonomy .

    tax:Office a skos:Concept ;
        skos:prefLabel "Office"@en ;
        skos:altLabel "Branch office"@en , "Headquarters"@en ;
        skos:definition "A site used mainly for administrative and professional work."@en ;
        skos:broader tax:Site ;
        skos:inScheme tax:LocationTaxonomy .

    tax:RemoteWorkLocation a skos:Concept ;
        skos:prefLabel "Remote work location"@en ;
        skos:altLabel "Home office"@en , "Telework location"@en ;
        skos:definition "A site outside the employer's premises where a worker regularly works."@en ;
        skos:broader tax:Site ;
        skos:inScheme tax:LocationTaxonomy .

    tax:DataCenter a skos:Concept ;
        skos:prefLabel "Data center"@en ;
        skos:altLabel "Hosting facility"@en ;
        skos:definition "A site that houses computing and storage infrastructure."@en ;
        skos:broader tax:Site ;
        skos:inScheme tax:LocationTaxonomy .

    tax:DistributionSite a skos:Concept ;
        skos:prefLabel "Distribution site"@en ;
        skos:altLabel "Warehouse"@en , "Fulfilment center"@en ;
        skos:definition "A site where goods are stored and shipped."@en ;
        skos:broader tax:Site ;
        skos:inScheme tax:LocationTaxonomy .

    tax:LocationReference a skos:Concept ;
        skos:prefLabel "Location reference"@en ;
        skos:altLabel "Location identifier"@en ;
        skos:definition "A location-related information artifact that identifies a place."@en ;
        skos:topConceptOf tax:LocationTaxonomy ;
        skos:narrower tax:PostalAddress , tax:GeographicCoordinate , tax:LocationCode ;
        skos:inScheme tax:LocationTaxonomy .

    tax:PostalAddress a skos:Concept ;
        skos:prefLabel "Postal address"@en ;
        skos:altLabel "Address"@en , "Mailing address"@en ;
        skos:definition "A location reference that identifies a delivery point by street, city, state, and postal code."@en ;
        skos:broader tax:LocationReference ;
        skos:inScheme tax:LocationTaxonomy .

    tax:GeographicCoordinate a skos:Concept ;
        skos:prefLabel "Geographic coordinate"@en ;
        skos:altLabel "Coordinates"@en , "Geolocation"@en ;
        skos:definition "A location reference given as latitude and longitude."@en ;
        skos:broader tax:LocationReference ;
        skos:inScheme tax:LocationTaxonomy .

    tax:LocationCode a skos:Concept ;
        skos:prefLabel "Location code"@en ;
        skos:altLabel "Site code"@en , "Jurisdiction code"@en ;
        skos:definition "A location reference given as a code from a standard or system."@en ;
        skos:broader tax:LocationReference ;
        skos:inScheme tax:LocationTaxonomy .

    tax:VirtualLocation a skos:Concept ;
        skos:prefLabel "Virtual location"@en ;
        skos:altLabel "Digital location"@en ;
        skos:definition "A location in a network or digital space rather than physical space."@en ;
        skos:topConceptOf tax:LocationTaxonomy ;
        skos:narrower tax:WebAddress , tax:CloudRegion , tax:CollaborationSpace ;
        skos:inScheme tax:LocationTaxonomy .

    tax:WebAddress a skos:Concept ;
        skos:prefLabel "Web address"@en ;
        skos:altLabel "URL"@en , "Web page"@en ;
        skos:definition "A virtual location identified by a uniform resource locator."@en ;
        skos:broader tax:VirtualLocation ;
        skos:inScheme tax:LocationTaxonomy .

    tax:CloudRegion a skos:Concept ;
        skos:prefLabel "Cloud region"@en ;
        skos:altLabel "Hosting region"@en , "Availability zone"@en ;
        skos:definition "A virtual location that is a provider-defined geographic grouping of data centers."@en ;
        skos:broader tax:VirtualLocation ;
        skos:inScheme tax:LocationTaxonomy .

    tax:CollaborationSpace a skos:Concept ;
        skos:prefLabel "Collaboration space"@en ;
        skos:altLabel "Workspace"@en , "Channel"@en , "Team site"@en ;
        skos:definition "A virtual location where people share content and communicate."@en ;
        skos:broader tax:VirtualLocation ;
        skos:inScheme tax:LocationTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-logic> {
    tax:LogicTaxonomy a skos:ConceptScheme ;
        dcterms:title "Logic taxonomy"@en ;
        skos:prefLabel "Logic taxonomy"@en ;
        dcterms:description "Classification of logic components, the governed specifications of how a multi-step process, data flow, or reasoning task is carried out by services and agents."@en ;
        dcterms:subject core:Logic ;
        skos:scopeNote "Logic is authored as code that references single source of truth terms and versions. Business rules and decisions are in their own taxonomies. Operator and truth values are in the logic vocabulary."@en ;
        dcterms:source "Semantic Governance v1.8 Section 3.5; BPMN gateways and flows; W3C OWL 2 RL and SPARQL for reasoning and retrieval."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:ControlFlowLogic ,
            tax:OrchestrationLogic ,
            tax:DataFlowLogic ,
            tax:ReasoningLogic ,
            tax:RetrievalLogic .

    tax:ControlFlowLogic a skos:Concept ;
        skos:prefLabel "Control flow logic"@en ;
        skos:altLabel "Flow logic"@en , "Orchestration flow"@en ;
        skos:definition "A logic component that determines the order and conditions under which process steps are carried out."@en ;
        skos:topConceptOf tax:LogicTaxonomy ;
        skos:narrower tax:Sequence , tax:ConditionalBranching , tax:ParallelExecution , tax:Iteration , tax:EventBasedBranching , tax:ErrorHandlingLogic ;
        skos:relatedMatch tax:ProcessStep ;
        skos:inScheme tax:LogicTaxonomy .

    tax:Sequence a skos:Concept ;
        skos:prefLabel "Sequence"@en ;
        skos:altLabel "Sequential flow"@en ;
        skos:definition "A control flow logic in which steps run one after another."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ConditionalBranching a skos:Concept ;
        skos:prefLabel "Conditional branching"@en ;
        skos:altLabel "Exclusive gateway"@en , "If then else"@en , "Branch"@en ;
        skos:definition "A control flow logic in which one path is chosen from several by evaluating conditions."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ParallelExecution a skos:Concept ;
        skos:prefLabel "Parallel execution"@en ;
        skos:altLabel "Parallel gateway"@en , "Fork and join"@en ;
        skos:definition "A control flow logic in which several paths run at the same time and later join."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:Iteration a skos:Concept ;
        skos:prefLabel "Iteration"@en ;
        skos:altLabel "Loop"@en , "Repeat"@en ;
        skos:definition "A control flow logic in which steps repeat until a condition is met or a collection is exhausted."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:EventBasedBranching a skos:Concept ;
        skos:prefLabel "Event-based branching"@en ;
        skos:altLabel "Event gateway"@en ;
        skos:definition "A control flow logic in which the path taken depends on which event occurs first."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ErrorHandlingLogic a skos:Concept ;
        skos:prefLabel "Error handling logic"@en ;
        skos:altLabel "Exception handling"@en ;
        skos:definition "A control flow logic that detects failures and decides how to recover."@en ;
        skos:broader tax:ControlFlowLogic ;
        skos:narrower tax:RetryLogic , tax:FallbackLogic , tax:CompensationLogic , tax:DeadLetterRouting ;
        skos:inScheme tax:LogicTaxonomy .

    tax:RetryLogic a skos:Concept ;
        skos:prefLabel "Retry logic"@en ;
        skos:altLabel "Retry with backoff"@en ;
        skos:definition "An error handling logic that repeats a failed step after a delay."@en ;
        skos:broader tax:ErrorHandlingLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:FallbackLogic a skos:Concept ;
        skos:prefLabel "Fallback logic"@en ;
        skos:altLabel "Graceful degradation"@en ;
        skos:definition "An error handling logic that switches to an alternate path or degraded answer when a step fails."@en ;
        skos:broader tax:ErrorHandlingLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:CompensationLogic a skos:Concept ;
        skos:prefLabel "Compensation logic"@en ;
        skos:altLabel "Rollback"@en , "Saga compensation"@en ;
        skos:definition "An error handling logic that undoes the effects of completed steps when a later step fails."@en ;
        skos:broader tax:ErrorHandlingLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:DeadLetterRouting a skos:Concept ;
        skos:prefLabel "Dead-letter routing"@en ;
        skos:altLabel "Dead letter queue handling"@en ;
        skos:definition "An error handling logic that sets aside messages that cannot be processed after allowed recovery actions."@en ;
        skos:broader tax:ErrorHandlingLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:OrchestrationLogic a skos:Concept ;
        skos:prefLabel "Orchestration logic"@en ;
        skos:altLabel "Coordination logic"@en ;
        skos:definition "A logic component that coordinates several services or agents to complete a request."@en ;
        skos:topConceptOf tax:LogicTaxonomy ;
        skos:narrower tax:ServiceOrchestration , tax:ServiceChoreography , tax:AgentOrchestration ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ServiceOrchestration a skos:Concept ;
        skos:prefLabel "Service orchestration"@en ;
        skos:altLabel "Workflow orchestration"@en ;
        skos:definition "An orchestration logic in which a central controller calls services in a defined order."@en ;
        skos:broader tax:OrchestrationLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ServiceChoreography a skos:Concept ;
        skos:prefLabel "Service choreography"@en ;
        skos:altLabel "Event choreography"@en ;
        skos:definition "An orchestration logic in which services react to each other's events without a central controller."@en ;
        skos:broader tax:OrchestrationLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:AgentOrchestration a skos:Concept ;
        skos:prefLabel "Agent orchestration"@en ;
        skos:altLabel "Multi-agent orchestration"@en , "Agent-to-agent delegation"@en ;
        skos:definition "An orchestration logic in which a coordinating agent delegates tasks to other agents and tools."@en ;
        skos:broader tax:OrchestrationLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:DataFlowLogic a skos:Concept ;
        skos:prefLabel "Data flow logic"@en ;
        skos:altLabel "Data pipeline logic"@en ;
        skos:definition "A logic component that moves, transforms, or combines data."@en ;
        skos:topConceptOf tax:LogicTaxonomy ;
        skos:narrower tax:TransformationLogic , tax:EnrichmentLogic , tax:FilteringLogic , tax:MatchingLogic , tax:RoutingLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:TransformationLogic a skos:Concept ;
        skos:prefLabel "Transformation logic"@en ;
        skos:altLabel "Data transformation"@en ;
        skos:definition "A data flow logic that changes the structure, format, or values of data."@en ;
        skos:broader tax:DataFlowLogic ;
        skos:relatedMatch tax:TransformationRule ;
        skos:inScheme tax:LogicTaxonomy .

    tax:EnrichmentLogic a skos:Concept ;
        skos:prefLabel "Enrichment logic"@en ;
        skos:altLabel "Data enrichment"@en ;
        skos:definition "A data flow logic that adds attributes or links from other sources."@en ;
        skos:broader tax:DataFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:FilteringLogic a skos:Concept ;
        skos:prefLabel "Filtering logic"@en ;
        skos:altLabel "Filter"@en ;
        skos:definition "A data flow logic that keeps or removes records by conditions."@en ;
        skos:broader tax:DataFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:MatchingLogic a skos:Concept ;
        skos:prefLabel "Matching logic"@en ;
        skos:altLabel "Entity resolution"@en , "Record linkage"@en ;
        skos:definition "A data flow logic that determines whether records refer to the same entity."@en ;
        skos:broader tax:DataFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:RoutingLogic a skos:Concept ;
        skos:prefLabel "Routing logic"@en ;
        skos:altLabel "Content-based routing"@en ;
        skos:definition "A data flow logic that directs messages or records to destinations by content or type."@en ;
        skos:broader tax:DataFlowLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ReasoningLogic a skos:Concept ;
        skos:prefLabel "Reasoning logic"@en ;
        skos:altLabel "Inference logic"@en ;
        skos:definition "A logic component that draws conclusions from facts and knowledge."@en ;
        skos:topConceptOf tax:LogicTaxonomy ;
        skos:narrower tax:DeductiveReasoning , tax:InductiveReasoning , tax:AbductiveReasoning , tax:CausalReasoning , tax:ProbabilisticReasoning , tax:TemporalReasoning ;
        skos:inScheme tax:LogicTaxonomy .

    tax:DeductiveReasoning a skos:Concept ;
        skos:prefLabel "Deductive reasoning"@en ;
        skos:altLabel "Deduction"@en , "Entailment"@en ;
        skos:definition "A reasoning logic that derives conclusions that necessarily follow from premises and axioms."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:InductiveReasoning a skos:Concept ;
        skos:prefLabel "Inductive reasoning"@en ;
        skos:altLabel "Induction"@en ;
        skos:definition "A reasoning logic that generalizes from observed cases to probable rules."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:AbductiveReasoning a skos:Concept ;
        skos:prefLabel "Abductive reasoning"@en ;
        skos:altLabel "Abduction"@en , "Diagnostic reasoning"@en ;
        skos:definition "A reasoning logic that infers the most likely explanation for observations."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:CausalReasoning a skos:Concept ;
        skos:prefLabel "Causal reasoning"@en ;
        skos:altLabel "Causal inference"@en ;
        skos:definition "A reasoning logic that determines how changes in one factor produce changes in another."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ProbabilisticReasoning a skos:Concept ;
        skos:prefLabel "Probabilistic reasoning"@en ;
        skos:altLabel "Bayesian reasoning"@en ;
        skos:definition "A reasoning logic that computes likelihoods of conclusions under uncertainty."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:TemporalReasoning a skos:Concept ;
        skos:prefLabel "Temporal reasoning"@en ;
        skos:definition "A reasoning logic that draws conclusions about the order, overlap, and validity of facts over time."@en ;
        skos:broader tax:ReasoningLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:RetrievalLogic a skos:Concept ;
        skos:prefLabel "Retrieval logic"@en ;
        skos:altLabel "Retrieval-augmented generation logic"@en , "RAG logic"@en ;
        skos:definition "A logic component that selects the governed facts and content used to answer a question."@en ;
        skos:topConceptOf tax:LogicTaxonomy ;
        skos:narrower tax:SemanticSearch , tax:GraphTraversal , tax:HybridRetrieval , tax:ContextAssembly ;
        skos:inScheme tax:LogicTaxonomy .

    tax:SemanticSearch a skos:Concept ;
        skos:prefLabel "Semantic search"@en ;
        skos:altLabel "Vector search"@en , "Similarity search"@en ;
        skos:definition "A retrieval logic that finds content by meaning using labels, synonyms, and embeddings."@en ;
        skos:broader tax:RetrievalLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:GraphTraversal a skos:Concept ;
        skos:prefLabel "Graph traversal"@en ;
        skos:altLabel "Graph query"@en ;
        skos:definition "A retrieval logic that follows relationships in the knowledge graph from a starting entity."@en ;
        skos:broader tax:RetrievalLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:HybridRetrieval a skos:Concept ;
        skos:prefLabel "Hybrid retrieval"@en ;
        skos:altLabel "Federated retrieval"@en ;
        skos:definition "A retrieval logic that combines keyword, vector, and graph results and ranks them together."@en ;
        skos:broader tax:RetrievalLogic ;
        skos:inScheme tax:LogicTaxonomy .

    tax:ContextAssembly a skos:Concept ;
        skos:prefLabel "Context assembly"@en ;
        skos:altLabel "Context engineering"@en ;
        skos:definition "A retrieval logic that composes retrieved facts, definitions, and sources into model context within a token budget."@en ;
        skos:broader tax:RetrievalLogic ;
        skos:inScheme tax:LogicTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-measure> {
    tax:MeasureTaxonomy a skos:ConceptScheme ;
        dcterms:title "Measure taxonomy"@en ;
        skos:prefLabel "Measure taxonomy"@en ;
        dcterms:description "Classification of measures and calculations, the quantified evaluations of processes, assets, and qualities and the governed formulas that compute them."@en ;
        dcterms:subject core:Measure ;
        skos:scopeNote "Includes calculations, which are authored as declarative formula specifications with test vectors. Units, aggregation functions, and polarity values are in the measure vocabulary."@en ;
        dcterms:source "ISO/IEC/IEEE 15939 measurement process; W3C Data Cube Vocabulary for observations; ISO/IEC 5259 and ISO 8000 for data quality; ISO 30414 human capital reporting."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:BaseMeasure ,
            tax:DerivedMeasure ,
            tax:Indicator ,
            tax:Target ,
            tax:ForecastValue ,
            tax:Threshold ,
            tax:Observation ,
            tax:Calculation ,
            tax:MeasurementDimension .

    tax:BaseMeasure a skos:Concept ;
        skos:prefLabel "Base measure"@en ;
        skos:altLabel "Raw measure"@en , "Count"@en ;
        skos:definition "A measure that quantifies a single attribute by a direct method."@en ;
        skos:example "Number of answers served; hours worked."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:DerivedMeasure a skos:Concept ;
        skos:prefLabel "Derived measure"@en ;
        skos:altLabel "Calculated measure"@en , "Computed measure"@en ;
        skos:definition "A measure computed from two or more base or derived measures."@en ;
        skos:example "Average handling time."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Indicator a skos:Concept ;
        skos:prefLabel "Indicator"@en ;
        skos:altLabel "Metric"@en ;
        skos:definition "A measure that estimates or evaluates an attribute against an information need, often compared to a target."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:KeyPerformanceIndicator , tax:KeyRiskIndicator , tax:ServiceLevelIndicator , tax:ReliabilityIndicator , tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:KeyPerformanceIndicator a skos:Concept ;
        skos:prefLabel "Key performance indicator"@en ;
        skos:altLabel "KPI"@en , "Performance indicator"@en ;
        skos:definition "An indicator that tracks performance against a strategic or operational objective."@en ;
        skos:broader tax:Indicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:KeyRiskIndicator a skos:Concept ;
        skos:prefLabel "Key risk indicator"@en ;
        skos:altLabel "KRI"@en , "Risk indicator"@en ;
        skos:definition "An indicator that signals a change in risk exposure."@en ;
        skos:broader tax:Indicator ;
        skos:relatedMatch tax:Risk ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ServiceLevelIndicator a skos:Concept ;
        skos:prefLabel "Service level indicator"@en ;
        skos:altLabel "SLI"@en ;
        skos:definition "An indicator that measures an aspect of service performance experienced by users."@en ;
        skos:broader tax:Indicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ReliabilityIndicator a skos:Concept ;
        skos:prefLabel "Reliability indicator"@en ;
        skos:altLabel "Reliability metric"@en ;
        skos:definition "An indicator of how long or how often a system works without failure."@en ;
        skos:broader tax:Indicator ;
        skos:narrower tax:MeanTimeBetweenFailures , tax:MeanTimeToRecover , tax:MeanTimeBetweenHallucinations ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MeanTimeBetweenFailures a skos:Concept ;
        skos:prefLabel "Mean time between failures"@en ;
        skos:altLabel "MTBF"@en ;
        skos:definition "A reliability indicator equal to operating time divided by the number of failures."@en ;
        skos:broader tax:ReliabilityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MeanTimeToRecover a skos:Concept ;
        skos:prefLabel "Mean time to recover"@en ;
        skos:altLabel "MTTR"@en , "Mean time to restore"@en ;
        skos:definition "A reliability indicator equal to the average time to restore service after a failure."@en ;
        skos:broader tax:ReliabilityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MeanTimeBetweenHallucinations a skos:Concept ;
        skos:prefLabel "Mean time between hallucinations"@en ;
        skos:altLabel "MTBH"@en ;
        skos:definition "A reliability indicator equal to answers served or hours in service divided by confirmed hallucinations."@en ;
        skos:broader tax:ReliabilityIndicator ;
        skos:relatedMatch tax:Hallucination ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:KnowledgeQualityIndicator a skos:Concept ;
        skos:prefLabel "Knowledge quality indicator"@en ;
        skos:altLabel "Semantic quality metric"@en ;
        skos:definition "An indicator of the coverage, accuracy, or traceability of governed knowledge and the answers that use it."@en ;
        skos:broader tax:Indicator ;
        skos:narrower tax:MappingCoverage , tax:MappingAccuracy , tax:CompetencyQuestionPassRate , tax:AnswerTraceabilityRate , tax:SearchSuccessRate ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MappingCoverage a skos:Concept ;
        skos:prefLabel "Mapping coverage"@en ;
        skos:definition "A knowledge quality indicator equal to the share of inbound schema elements mapped to ontology terms."@en ;
        skos:broader tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MappingAccuracy a skos:Concept ;
        skos:prefLabel "Mapping accuracy"@en ;
        skos:definition "A knowledge quality indicator equal to the share of agent-proposed mappings accepted on review."@en ;
        skos:broader tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:CompetencyQuestionPassRate a skos:Concept ;
        skos:prefLabel "Competency question pass rate"@en ;
        skos:definition "A knowledge quality indicator equal to the share of competency questions passing in a release."@en ;
        skos:broader tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:AnswerTraceabilityRate a skos:Concept ;
        skos:prefLabel "Answer traceability rate"@en ;
        skos:definition "A knowledge quality indicator equal to the share of artificial intelligence answers that cite governed terms and mappings."@en ;
        skos:broader tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:SearchSuccessRate a skos:Concept ;
        skos:prefLabel "Search success rate"@en ;
        skos:definition "A knowledge quality indicator equal to the share of searches returning a result the user accepts."@en ;
        skos:broader tax:KnowledgeQualityIndicator ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Target a skos:Concept ;
        skos:prefLabel "Target"@en ;
        skos:altLabel "Goal"@en , "Objective value"@en ;
        skos:definition "A measure value that a party commits to achieve within a period."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:ServiceLevelObjective , tax:BudgetTarget ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ServiceLevelObjective a skos:Concept ;
        skos:prefLabel "Service level objective"@en ;
        skos:altLabel "SLO"@en ;
        skos:definition "A target for a service level indicator agreed internally."@en ;
        skos:broader tax:Target ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:BudgetTarget a skos:Concept ;
        skos:prefLabel "Budget target"@en ;
        skos:altLabel "Budget"@en ;
        skos:definition "A target expressed as a planned amount of money."@en ;
        skos:broader tax:Target ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ForecastValue a skos:Concept ;
        skos:prefLabel "Forecast value"@en ;
        skos:altLabel "Forecast"@en , "Projection"@en ;
        skos:definition "A measure value that estimates a future value of a measure from assumptions and history."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Threshold a skos:Concept ;
        skos:prefLabel "Threshold"@en ;
        skos:altLabel "Limit"@en , "Tolerance"@en ;
        skos:definition "A measure value that, when crossed, triggers an alert, decision, or action."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:AlertThreshold , tax:ToleranceThreshold , tax:TripThreshold ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:AlertThreshold a skos:Concept ;
        skos:prefLabel "Alert threshold"@en ;
        skos:altLabel "Warning threshold"@en ;
        skos:definition "A threshold that triggers a notification for attention."@en ;
        skos:broader tax:Threshold ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ToleranceThreshold a skos:Concept ;
        skos:prefLabel "Tolerance threshold"@en ;
        skos:altLabel "Tolerance band"@en ;
        skos:definition "A threshold that defines the acceptable band around a target."@en ;
        skos:broader tax:Threshold ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:TripThreshold a skos:Concept ;
        skos:prefLabel "Trip threshold"@en ;
        skos:altLabel "Circuit breaker threshold"@en ;
        skos:definition "A threshold that triggers automatic suspension or fallback."@en ;
        skos:broader tax:Threshold ;
        skos:relatedMatch tax:CircuitBreakerRule ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Observation a skos:Concept ;
        skos:prefLabel "Observation"@en ;
        skos:altLabel "Measurement"@en , "Data point"@en , "Fact"@en ;
        skos:definition "A measure value recorded for a specific subject, period, and set of dimensions."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:ActualValue , tax:BenchmarkValue ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ActualValue a skos:Concept ;
        skos:prefLabel "Actual value"@en ;
        skos:altLabel "Actual"@en ;
        skos:definition "An observation that records what occurred."@en ;
        skos:broader tax:Observation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:BenchmarkValue a skos:Concept ;
        skos:prefLabel "Benchmark value"@en ;
        skos:altLabel "Benchmark"@en ;
        skos:definition "An observation from a comparable population used as a reference."@en ;
        skos:broader tax:Observation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Calculation a skos:Concept ;
        skos:prefLabel "Calculation"@en ;
        skos:altLabel "Computation"@en , "Formula"@en , "Calc"@en ;
        skos:definition "A governed formula specification that computes a value from inputs and is verified against test vectors."@en ;
        skos:scopeNote "Authored once in the single source of truth and generated into services."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:ArithmeticCalculation , tax:AggregationCalculation , tax:RatioCalculation , tax:AllocationCalculation , tax:ConversionCalculation , tax:DateCalculation , tax:StatisticalCalculation , tax:ScoringCalculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ArithmeticCalculation a skos:Concept ;
        skos:prefLabel "Arithmetic calculation"@en ;
        skos:definition "A calculation that combines inputs using addition, subtraction, multiplication, or division."@en ;
        skos:example "Gross pay equals hours times rate plus overtime premium."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:AggregationCalculation a skos:Concept ;
        skos:prefLabel "Aggregation calculation"@en ;
        skos:altLabel "Rollup"@en , "Aggregate"@en ;
        skos:definition "A calculation that summarizes many values into one, such as a sum, count, or average."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:RatioCalculation a skos:Concept ;
        skos:prefLabel "Ratio calculation"@en ;
        skos:altLabel "Percentage calculation"@en , "Rate calculation"@en ;
        skos:definition "A calculation that divides one quantity by another to express a proportion or rate."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:AllocationCalculation a skos:Concept ;
        skos:prefLabel "Allocation calculation"@en ;
        skos:altLabel "Proration"@en , "Apportionment"@en ;
        skos:definition "A calculation that distributes an amount across recipients by a defined basis."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ConversionCalculation a skos:Concept ;
        skos:prefLabel "Conversion calculation"@en ;
        skos:altLabel "Unit conversion"@en , "Annualization"@en ;
        skos:definition "A calculation that converts a value between units, currencies, or periods."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:DateCalculation a skos:Concept ;
        skos:prefLabel "Date calculation"@en ;
        skos:altLabel "Date arithmetic"@en ;
        skos:definition "A calculation that derives a date or duration from other dates and rules."@en ;
        skos:broader tax:Calculation ;
        skos:relatedMatch tax:TimingRule ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:StatisticalCalculation a skos:Concept ;
        skos:prefLabel "Statistical calculation"@en ;
        skos:altLabel "Statistical model"@en , "Regression"@en ;
        skos:definition "A calculation that estimates a distribution, trend, or relationship from data."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:ScoringCalculation a skos:Concept ;
        skos:prefLabel "Scoring calculation"@en ;
        skos:altLabel "Score"@en , "Weighted score"@en ;
        skos:definition "A calculation that combines weighted factors into a single score."@en ;
        skos:broader tax:Calculation ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:MeasurementDimension a skos:Concept ;
        skos:prefLabel "Measurement dimension"@en ;
        skos:altLabel "Dimension"@en , "Quality dimension group"@en ;
        skos:definition "A characteristic along which measures are evaluated or broken down."@en ;
        skos:topConceptOf tax:MeasureTaxonomy ;
        skos:narrower tax:DataQualityDimension , tax:TrustDimension , tax:PerformanceDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:DataQualityDimension a skos:Concept ;
        skos:prefLabel "Data quality dimension"@en ;
        skos:altLabel "Data quality characteristic"@en ;
        skos:definition "A measurement dimension of how fit data is for its intended use."@en ;
        skos:broader tax:MeasurementDimension ;
        skos:narrower tax:Accuracy , tax:Completeness , tax:Consistency , tax:Timeliness , tax:Validity , tax:Uniqueness ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Accuracy a skos:Concept ;
        skos:prefLabel "Accuracy"@en ;
        skos:definition "A data quality dimension of how closely values agree with reality or an authoritative source."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Completeness a skos:Concept ;
        skos:prefLabel "Completeness"@en ;
        skos:definition "A data quality dimension of whether all required values are present."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Consistency a skos:Concept ;
        skos:prefLabel "Consistency"@en ;
        skos:definition "A data quality dimension of whether values agree across records and systems."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Timeliness a skos:Concept ;
        skos:prefLabel "Timeliness"@en ;
        skos:altLabel "Freshness"@en , "Currency"@en ;
        skos:definition "A data quality dimension of whether values are current enough for use."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Validity a skos:Concept ;
        skos:prefLabel "Validity"@en ;
        skos:definition "A data quality dimension of whether values conform to defined formats and domains."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Uniqueness a skos:Concept ;
        skos:prefLabel "Uniqueness"@en ;
        skos:definition "A data quality dimension of whether each entity is recorded once."@en ;
        skos:broader tax:DataQualityDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:TrustDimension a skos:Concept ;
        skos:prefLabel "Trust dimension"@en ;
        skos:altLabel "Trustworthiness dimension"@en ;
        skos:definition "A measurement dimension of how much confidence users can place in information or answers."@en ;
        skos:broader tax:MeasurementDimension ;
        skos:narrower tax:Provenance , tax:Verification , tax:Explainability ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Provenance a skos:Concept ;
        skos:prefLabel "Provenance"@en ;
        skos:altLabel "Lineage"@en ;
        skos:definition "A trust dimension of whether the origin and lineage of information are recorded."@en ;
        skos:broader tax:TrustDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Verification a skos:Concept ;
        skos:prefLabel "Verification"@en ;
        skos:altLabel "Verification status"@en ;
        skos:definition "A trust dimension of whether facts have been checked against published sources."@en ;
        skos:broader tax:TrustDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Explainability a skos:Concept ;
        skos:prefLabel "Explainability"@en ;
        skos:altLabel "Traceability"@en ;
        skos:definition "A trust dimension of whether outputs can be traced to inputs, rules, and sources."@en ;
        skos:broader tax:TrustDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:PerformanceDimension a skos:Concept ;
        skos:prefLabel "Performance dimension"@en ;
        skos:altLabel "Operational dimension"@en ;
        skos:definition "A measurement dimension of how well a process or service achieves results with resources."@en ;
        skos:broader tax:MeasurementDimension ;
        skos:narrower tax:Efficiency , tax:Effectiveness , tax:Cost , tax:Speed ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Efficiency a skos:Concept ;
        skos:prefLabel "Efficiency"@en ;
        skos:definition "A performance dimension of output relative to resources used."@en ;
        skos:broader tax:PerformanceDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Effectiveness a skos:Concept ;
        skos:prefLabel "Effectiveness"@en ;
        skos:definition "A performance dimension of the degree to which intended results are achieved."@en ;
        skos:broader tax:PerformanceDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Cost a skos:Concept ;
        skos:prefLabel "Cost"@en ;
        skos:altLabel "Expense"@en ;
        skos:definition "A performance dimension of the money spent to produce an output."@en ;
        skos:broader tax:PerformanceDimension ;
        skos:inScheme tax:MeasureTaxonomy .

    tax:Speed a skos:Concept ;
        skos:prefLabel "Speed"@en ;
        skos:altLabel "Cycle time"@en , "Lead time"@en , "Latency"@en ;
        skos:definition "A performance dimension of the time taken to produce an output."@en ;
        skos:broader tax:PerformanceDimension ;
        skos:inScheme tax:MeasureTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-party> {
    tax:PartyTaxonomy a skos:ConceptScheme ;
        dcterms:title "Party taxonomy"@en ;
        skos:prefLabel "Party taxonomy"@en ;
        dcterms:description "Classification of the persons, organizations, groups, and automated agents that can take part in process steps, hold roles, and enter agreements."@en ;
        dcterms:subject core:Party ;
        skos:scopeNote "Classifies what a party is, not the roles it plays. Employee, client, and co-employer are roles in the role taxonomy; persona categories are in the persona taxonomy."@en ;
        dcterms:source "BFO object and object aggregate (ISO/IEC 21838-2); W3C Organization Ontology; PROV-O agent."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:Person ,
            tax:Organization ,
            tax:Group ,
            tax:AutomatedAgent .

    tax:Person a skos:Concept ;
        skos:prefLabel "Person"@en ;
        skos:altLabel "Individual"@en , "Natural person"@en ;
        skos:definition "A party that is an individual human being."@en ;
        skos:scopeNote "A person bears roles such as employee or client administrator; those are in the role taxonomy. Personal attributes are confidential and governed by named-graph access."@en ;
        skos:topConceptOf tax:PartyTaxonomy ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Organization a skos:Concept ;
        skos:prefLabel "Organization"@en ;
        skos:altLabel "Entity"@en ;
        skos:hiddenLabel "Organisation"@en ;
        skos:definition "A party that is a group of people organized for a purpose and able to act as a unit."@en ;
        skos:topConceptOf tax:PartyTaxonomy ;
        skos:narrower tax:LegalEntity , tax:GovernmentBody , tax:OrganizationalUnit ;
        skos:inScheme tax:PartyTaxonomy .

    tax:LegalEntity a skos:Concept ;
        skos:prefLabel "Legal entity"@en ;
        skos:altLabel "Company"@en , "Business entity"@en ;
        skos:definition "An organization that has legal capacity to enter contracts, own assets, and bear obligations."@en ;
        skos:broader tax:Organization ;
        skos:narrower tax:Corporation , tax:LimitedLiabilityCompany , tax:Partnership , tax:SoleProprietorship , tax:NonprofitOrganization ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Corporation a skos:Concept ;
        skos:prefLabel "Corporation"@en ;
        skos:altLabel "Incorporated company"@en ;
        skos:definition "A legal entity that is incorporated under law with separate legal existence from its owners."@en ;
        skos:broader tax:LegalEntity ;
        skos:inScheme tax:PartyTaxonomy .

    tax:LimitedLiabilityCompany a skos:Concept ;
        skos:prefLabel "Limited liability company"@en ;
        skos:altLabel "LLC"@en ;
        skos:definition "A legal entity whose owners' liability is limited to their investment and that may be taxed as a partnership or corporation."@en ;
        skos:broader tax:LegalEntity ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Partnership a skos:Concept ;
        skos:prefLabel "Partnership"@en ;
        skos:altLabel "Limited partnership"@en , "General partnership"@en ;
        skos:definition "A legal entity formed by two or more owners who share profits and liabilities under a partnership agreement."@en ;
        skos:broader tax:LegalEntity ;
        skos:inScheme tax:PartyTaxonomy .

    tax:SoleProprietorship a skos:Concept ;
        skos:prefLabel "Sole proprietorship"@en ;
        skos:altLabel "Sole trader"@en ;
        skos:definition "A legal entity owned and run by one person with no legal distinction between owner and business."@en ;
        skos:broader tax:LegalEntity ;
        skos:inScheme tax:PartyTaxonomy .

    tax:NonprofitOrganization a skos:Concept ;
        skos:prefLabel "Nonprofit organization"@en ;
        skos:altLabel "Not-for-profit organization"@en , "Charity"@en ;
        skos:definition "A legal entity organized for a purpose other than generating profit for owners."@en ;
        skos:broader tax:LegalEntity ;
        skos:inScheme tax:PartyTaxonomy .

    tax:GovernmentBody a skos:Concept ;
        skos:prefLabel "Government body"@en ;
        skos:altLabel "Government organization"@en , "Public authority"@en ;
        skos:definition "An organization that exercises public authority under law."@en ;
        skos:broader tax:Organization ;
        skos:narrower tax:LegislativeBody , tax:RegulatoryAgency , tax:Court ;
        skos:inScheme tax:PartyTaxonomy .

    tax:LegislativeBody a skos:Concept ;
        skos:prefLabel "Legislative body"@en ;
        skos:altLabel "Legislature"@en , "Congress"@en ;
        skos:definition "A government body that enacts laws."@en ;
        skos:broader tax:GovernmentBody ;
        skos:inScheme tax:PartyTaxonomy .

    tax:RegulatoryAgency a skos:Concept ;
        skos:prefLabel "Regulatory agency"@en ;
        skos:altLabel "Regulator"@en , "Agency"@en ;
        skos:definition "A government body that issues and enforces regulations and guidance."@en ;
        skos:example "Department of Labor; Internal Revenue Service."@en ;
        skos:broader tax:GovernmentBody ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Court a skos:Concept ;
        skos:prefLabel "Court"@en ;
        skos:altLabel "Tribunal"@en ;
        skos:definition "A government body that adjudicates disputes and interprets law."@en ;
        skos:broader tax:GovernmentBody ;
        skos:inScheme tax:PartyTaxonomy .

    tax:OrganizationalUnit a skos:Concept ;
        skos:prefLabel "Organizational unit"@en ;
        skos:altLabel "Org unit"@en , "Business unit"@en ;
        skos:definition "An organization that is a subdivision of a larger organization with its own responsibilities."@en ;
        skos:broader tax:Organization ;
        skos:narrower tax:Division , tax:Department , tax:Team , tax:Committee ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Division a skos:Concept ;
        skos:prefLabel "Division"@en ;
        skos:altLabel "Line of business"@en ;
        skos:definition "An organizational unit that groups related departments under shared leadership."@en ;
        skos:broader tax:OrganizationalUnit ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Department a skos:Concept ;
        skos:prefLabel "Department"@en ;
        skos:altLabel "Function"@en ;
        skos:definition "An organizational unit responsible for a defined function."@en ;
        skos:example "Enterprise Analytics; Benefits Operations."@en ;
        skos:broader tax:OrganizationalUnit ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Team a skos:Concept ;
        skos:prefLabel "Team"@en ;
        skos:altLabel "Squad"@en , "Working group"@en ;
        skos:definition "An organizational unit of people who work together toward shared objectives."@en ;
        skos:broader tax:OrganizationalUnit ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Committee a skos:Concept ;
        skos:prefLabel "Committee"@en ;
        skos:altLabel "Board"@en , "Council"@en , "Steering committee"@en ;
        skos:definition "An organizational unit of members appointed to deliberate or decide on a defined matter."@en ;
        skos:broader tax:OrganizationalUnit ;
        skos:relatedMatch tax:GovernanceBody ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Group a skos:Concept ;
        skos:prefLabel "Group"@en ;
        skos:altLabel "Collection of parties"@en ;
        skos:definition "A party that is a collection of persons or organizations treated together without forming a single organization."@en ;
        skos:topConceptOf tax:PartyTaxonomy ;
        skos:narrower tax:Household , tax:Cohort , tax:MembershipGroup ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Household a skos:Concept ;
        skos:prefLabel "Household"@en ;
        skos:altLabel "Family unit"@en ;
        skos:definition "A group of persons who share a residence or are linked as a family unit for benefits or tax purposes."@en ;
        skos:broader tax:Group ;
        skos:inScheme tax:PartyTaxonomy .

    tax:Cohort a skos:Concept ;
        skos:prefLabel "Cohort"@en ;
        skos:altLabel "Segment"@en ;
        skos:definition "A group of persons sharing a characteristic or event within a period, used for analysis or communication."@en ;
        skos:broader tax:Group ;
        skos:inScheme tax:PartyTaxonomy .

    tax:MembershipGroup a skos:Concept ;
        skos:prefLabel "Membership group"@en ;
        skos:altLabel "Association membership"@en ;
        skos:definition "A group of parties that have joined an association or program."@en ;
        skos:broader tax:Group ;
        skos:inScheme tax:PartyTaxonomy .

    tax:AutomatedAgent a skos:Concept ;
        skos:prefLabel "Automated agent"@en ;
        skos:altLabel "Software agent"@en , "Digital agent"@en ;
        skos:definition "A party that is a software system acting with delegated authority to perform or support process steps."@en ;
        skos:scopeNote "Covers acting agents. The deployed code is also a software asset."@en ;
        skos:topConceptOf tax:PartyTaxonomy ;
        skos:narrower tax:ArtificialIntelligenceAgent , tax:SystemAccount , tax:RoboticProcessAutomationAgent ;
        skos:inScheme tax:PartyTaxonomy .

    tax:ArtificialIntelligenceAgent a skos:Concept ;
        skos:prefLabel "Artificial intelligence agent"@en ;
        skos:altLabel "AI agent"@en , "Assistant"@en , "Conversational agent"@en ;
        skos:definition "An automated agent that uses a language or machine learning model to interpret requests and take actions or produce answers."@en ;
        skos:example "HR 360 agent."@en ;
        skos:broader tax:AutomatedAgent ;
        skos:inScheme tax:PartyTaxonomy .

    tax:SystemAccount a skos:Concept ;
        skos:prefLabel "System account"@en ;
        skos:altLabel "Service account"@en , "Bot account"@en ;
        skos:definition "An automated agent that is a non-human identity under which a service or integration runs."@en ;
        skos:broader tax:AutomatedAgent ;
        skos:inScheme tax:PartyTaxonomy .

    tax:RoboticProcessAutomationAgent a skos:Concept ;
        skos:prefLabel "Robotic process automation agent"@en ;
        skos:altLabel "RPA bot"@en , "Bot"@en ;
        skos:definition "An automated agent that executes scripted interactions with user interfaces or systems."@en ;
        skos:broader tax:AutomatedAgent ;
        skos:inScheme tax:PartyTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-persona> {
    tax:PersonaTaxonomy a skos:ConceptScheme ;
        dcterms:title "Persona taxonomy"@en ;
        skos:prefLabel "Persona taxonomy"@en ;
        dcterms:description "Classification of personas, the governed descriptions of user groups who share goals, vocabulary, and information needs, used to tailor labels, retrieval, tone, and prompts."@en ;
        dcterms:subject core:Persona ;
        skos:scopeNote "A persona describes a typical user; it is not a person and not a security role and never grants access. Persona individuals are in the persona vocabulary and link here with skos:broadMatch. Personas never encode protected characteristics."@en ;
        dcterms:source "Semantic Governance v1.8 Section 3.8."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:WorkforcePersona ,
            tax:ClientPersona ,
            tax:ProspectPersona ,
            tax:ServiceDeliveryPersona ,
            tax:OversightPersona ,
            tax:AnalyticsPersona ,
            tax:TechnologyPersona .

    tax:WorkforcePersona a skos:Concept ;
        skos:prefLabel "Workforce persona"@en ;
        skos:altLabel "Employee persona"@en , "Worker persona"@en ;
        skos:definition "A persona representing workers who use services for their own employment, pay, and benefits."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:narrower tax:ActiveWorkerPersona , tax:JoiningWorkerPersona , tax:LifeChangeWorkerPersona , tax:DepartingWorkerPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ActiveWorkerPersona a skos:Concept ;
        skos:prefLabel "Active worker persona"@en ;
        skos:altLabel "Current employee persona"@en ;
        skos:definition "A workforce persona representing workers in ongoing employment."@en ;
        skos:broader tax:WorkforcePersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:JoiningWorkerPersona a skos:Concept ;
        skos:prefLabel "Joining worker persona"@en ;
        skos:altLabel "New hire persona"@en ;
        skos:definition "A workforce persona representing workers who are newly hired or in their first enrollment window."@en ;
        skos:broader tax:WorkforcePersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:LifeChangeWorkerPersona a skos:Concept ;
        skos:prefLabel "Life change worker persona"@en ;
        skos:altLabel "Life event persona"@en ;
        skos:definition "A workforce persona representing workers whose personal circumstances have changed and who need to adjust elections."@en ;
        skos:broader tax:WorkforcePersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:DepartingWorkerPersona a skos:Concept ;
        skos:prefLabel "Departing worker persona"@en ;
        skos:altLabel "Separating employee persona"@en ;
        skos:definition "A workforce persona representing workers leaving employment or reducing hours."@en ;
        skos:broader tax:WorkforcePersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ClientPersona a skos:Concept ;
        skos:prefLabel "Client persona"@en ;
        skos:altLabel "Customer persona"@en , "Employer persona"@en ;
        skos:definition "A persona representing people at a client organization who administer or sponsor services for their workforce."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:narrower tax:ClientAdministratorPersona , tax:ClientExecutivePersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ClientAdministratorPersona a skos:Concept ;
        skos:prefLabel "Client administrator persona"@en ;
        skos:altLabel "Client HR administrator persona"@en ;
        skos:definition "A client persona representing staff who administer human resources, payroll, or benefits at a client."@en ;
        skos:broader tax:ClientPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ClientExecutivePersona a skos:Concept ;
        skos:prefLabel "Client executive persona"@en ;
        skos:altLabel "Business owner persona"@en ;
        skos:definition "A client persona representing owners and executives who make sponsorship and spending decisions at a client."@en ;
        skos:broader tax:ClientPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ProspectPersona a skos:Concept ;
        skos:prefLabel "Prospect persona"@en ;
        skos:altLabel "Buyer persona"@en ;
        skos:definition "A persona representing people at organizations evaluating whether to become clients."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:ServiceDeliveryPersona a skos:Concept ;
        skos:prefLabel "Service delivery persona"@en ;
        skos:altLabel "Internal specialist persona"@en , "Advisor persona"@en ;
        skos:definition "A persona representing internal staff who answer questions and deliver services to clients and workers."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:narrower tax:HumanResourcesAdvisoryPersona , tax:BenefitsServicePersona , tax:PayrollServicePersona , tax:SalesAndServiceManagementPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:HumanResourcesAdvisoryPersona a skos:Concept ;
        skos:prefLabel "Human resources advisory persona"@en ;
        skos:altLabel "HR specialist persona"@en ;
        skos:definition "A service delivery persona representing internal advisors and specialists answering human resources questions."@en ;
        skos:broader tax:ServiceDeliveryPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:BenefitsServicePersona a skos:Concept ;
        skos:prefLabel "Benefits service persona"@en ;
        skos:altLabel "Benefits specialist persona"@en , "Retirement specialist persona"@en ;
        skos:definition "A service delivery persona representing internal staff who operate benefits and retirement plans."@en ;
        skos:broader tax:ServiceDeliveryPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:PayrollServicePersona a skos:Concept ;
        skos:prefLabel "Payroll service persona"@en ;
        skos:definition "A service delivery persona representing internal staff who operate payroll and deductions."@en ;
        skos:broader tax:ServiceDeliveryPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:SalesAndServiceManagementPersona a skos:Concept ;
        skos:prefLabel "Sales and service management persona"@en ;
        skos:altLabel "Account manager persona"@en , "Sales advisor persona"@en ;
        skos:definition "A service delivery persona representing internal staff who manage client relationships and renewals."@en ;
        skos:broader tax:ServiceDeliveryPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:OversightPersona a skos:Concept ;
        skos:prefLabel "Oversight persona"@en ;
        skos:altLabel "Assurance persona"@en ;
        skos:definition "A persona representing internal staff who check that work and answers comply with law, policy, and controls."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:narrower tax:CompliancePersona , tax:AuditPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:CompliancePersona a skos:Concept ;
        skos:prefLabel "Compliance persona"@en ;
        skos:altLabel "Compliance analyst persona"@en , "Compliance auditor persona"@en ;
        skos:definition "An oversight persona representing staff who determine which norms govern a step and gather evidence."@en ;
        skos:broader tax:OversightPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:AuditPersona a skos:Concept ;
        skos:prefLabel "Audit persona"@en ;
        skos:altLabel "Auditor persona"@en ;
        skos:definition "An oversight persona representing internal or external auditors who examine records and controls."@en ;
        skos:broader tax:OversightPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:AnalyticsPersona a skos:Concept ;
        skos:prefLabel "Analytics persona"@en ;
        skos:altLabel "Insights persona"@en , "Data analyst persona"@en ;
        skos:definition "A persona representing staff who analyze measures, trends, and quality of services and answers."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:TechnologyPersona a skos:Concept ;
        skos:prefLabel "Technology persona"@en ;
        skos:altLabel "Technical persona"@en ;
        skos:definition "A persona representing staff who build, integrate, or operate systems that use governed knowledge."@en ;
        skos:topConceptOf tax:PersonaTaxonomy ;
        skos:narrower tax:SoftwareDeveloperPersona , tax:KnowledgePractitionerPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:SoftwareDeveloperPersona a skos:Concept ;
        skos:prefLabel "Software developer persona"@en ;
        skos:altLabel "Developer persona"@en ;
        skos:definition "A technology persona representing engineers who build applications and services that consume knowledge services."@en ;
        skos:broader tax:TechnologyPersona ;
        skos:inScheme tax:PersonaTaxonomy .

    tax:KnowledgePractitionerPersona a skos:Concept ;
        skos:prefLabel "Knowledge practitioner persona"@en ;
        skos:altLabel "Knowledge engineer persona"@en , "Data steward persona"@en ;
        skos:definition "A technology persona representing knowledge engineers and data stewards who search and maintain governed knowledge."@en ;
        skos:scopeNote "Design-time responsibilities are roles; this persona only tailors presentation for these users."@en ;
        skos:broader tax:TechnologyPersona ;
        skos:inScheme tax:PersonaTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-policy> {
    tax:PolicyTaxonomy a skos:ConceptScheme ;
        dcterms:title "Policy taxonomy"@en ;
        skos:prefLabel "Policy taxonomy"@en ;
        dcterms:description "Classification of policies and other normative sources, the governing statements that impose obligations, permissions, and prohibitions on parties and process steps."@en ;
        dcterms:subject core:Policy ;
        skos:scopeNote "Policies govern process steps through governedBy. Individual norms are classified under Norm and linked to their source. Scope, enforcement, and compliance status values are in the policy vocabulary."@en ;
        dcterms:source "LKIF-Core norm and legal source; OASIS LegalRuleML; Akoma Ntoso for legislative documents; ISO 37301 compliance management."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:LegalNormSource ,
            tax:OrganizationalPolicy ,
            tax:ContractualInstrument ,
            tax:Standard ,
            tax:Procedure ,
            tax:Guideline ,
            tax:Norm .

    tax:LegalNormSource a skos:Concept ;
        skos:prefLabel "Legal norm source"@en ;
        skos:altLabel "Legal source"@en , "Regulatory source"@en ;
        skos:definition "A policy issued by a public authority with the force of law."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:narrower tax:Statute , tax:Regulation , tax:AgencyGuidance , tax:CourtDecision , tax:ExecutiveOrder ;
        skos:relatedMatch tax:GovernmentBody ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Statute a skos:Concept ;
        skos:prefLabel "Statute"@en ;
        skos:altLabel "Act"@en , "Law"@en , "Federal statute"@en , "State law"@en ;
        skos:definition "A legal norm source enacted by a legislative body."@en ;
        skos:example "Fair Labor Standards Act."@en ;
        skos:broader tax:LegalNormSource ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Regulation a skos:Concept ;
        skos:prefLabel "Regulation"@en ;
        skos:altLabel "Rule"@en , "Administrative rule"@en , "Code of Federal Regulations section"@en ;
        skos:definition "A legal norm source issued by a regulatory agency under statutory authority."@en ;
        skos:broader tax:LegalNormSource ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:AgencyGuidance a skos:Concept ;
        skos:prefLabel "Agency guidance"@en ;
        skos:altLabel "Guidance"@en , "Interpretive letter"@en , "Notice"@en ;
        skos:definition "A legal norm source issued by an agency to interpret or apply law without the force of regulation."@en ;
        skos:broader tax:LegalNormSource ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:CourtDecision a skos:Concept ;
        skos:prefLabel "Court decision"@en ;
        skos:altLabel "Case law"@en , "Judicial decision"@en , "Precedent"@en ;
        skos:definition "A legal norm source that is a ruling by a court establishing or interpreting law."@en ;
        skos:broader tax:LegalNormSource ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:ExecutiveOrder a skos:Concept ;
        skos:prefLabel "Executive order"@en ;
        skos:definition "A legal norm source issued by a head of government directing government operations."@en ;
        skos:broader tax:LegalNormSource ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:OrganizationalPolicy a skos:Concept ;
        skos:prefLabel "Organizational policy"@en ;
        skos:altLabel "Company policy"@en , "Internal policy"@en ;
        skos:definition "A policy issued by an organization to govern its own conduct and that of its workers and agents."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:narrower tax:CodeOfConduct , tax:WorkforcePolicy , tax:InformationSecurityPolicy , tax:PrivacyPolicy , tax:DataClassificationPolicy , tax:RecordsRetentionPolicy , tax:ResponsibleArtificialIntelligencePolicy , tax:AcceptableUsePolicy , tax:FinancialControlPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:CodeOfConduct a skos:Concept ;
        skos:prefLabel "Code of conduct"@en ;
        skos:altLabel "Code of ethics"@en ;
        skos:definition "An organizational policy that states expected ethical behavior."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:WorkforcePolicy a skos:Concept ;
        skos:prefLabel "Workforce policy"@en ;
        skos:altLabel "Human resources policy"@en , "Employee handbook policy"@en ;
        skos:definition "An organizational policy that governs employment practices, leave, conduct, and pay."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:InformationSecurityPolicy a skos:Concept ;
        skos:prefLabel "Information security policy"@en ;
        skos:altLabel "Security policy"@en ;
        skos:definition "An organizational policy that protects information and systems."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:PrivacyPolicy a skos:Concept ;
        skos:prefLabel "Privacy policy"@en ;
        skos:altLabel "Data privacy policy"@en ;
        skos:definition "An organizational policy that governs collection, use, and disclosure of personal information."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:DataClassificationPolicy a skos:Concept ;
        skos:prefLabel "Data classification policy"@en ;
        skos:altLabel "Information classification policy"@en ;
        skos:definition "An organizational policy that defines classification levels and the handling each requires."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:RecordsRetentionPolicy a skos:Concept ;
        skos:prefLabel "Records retention policy"@en ;
        skos:altLabel "Retention schedule"@en ;
        skos:definition "An organizational policy that defines how long records are kept and how they are disposed of."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:ResponsibleArtificialIntelligencePolicy a skos:Concept ;
        skos:prefLabel "Responsible artificial intelligence policy"@en ;
        skos:altLabel "Responsible AI policy"@en , "AI use policy"@en ;
        skos:definition "An organizational policy that governs the design, use, and oversight of artificial intelligence."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:AcceptableUsePolicy a skos:Concept ;
        skos:prefLabel "Acceptable use policy"@en ;
        skos:definition "An organizational policy that governs permitted use of systems and data."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:FinancialControlPolicy a skos:Concept ;
        skos:prefLabel "Financial control policy"@en ;
        skos:altLabel "Expense policy"@en , "Delegation of authority policy"@en ;
        skos:definition "An organizational policy that governs spending, approval authority, and financial reporting."@en ;
        skos:broader tax:OrganizationalPolicy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:ContractualInstrument a skos:Concept ;
        skos:prefLabel "Contractual instrument"@en ;
        skos:altLabel "Agreement"@en , "Contract"@en ;
        skos:definition "A policy that arises from an agreement between parties and binds them to its terms."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:narrower tax:ClientServiceAgreement , tax:ServiceLevelAgreement , tax:PlanDocument , tax:DataProcessingAgreement , tax:TermsOfService ;
        skos:relatedMatch tax:AgreementDocument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:ClientServiceAgreement a skos:Concept ;
        skos:prefLabel "Client service agreement"@en ;
        skos:altLabel "Client agreement"@en , "Co-employment agreement"@en ;
        skos:definition "A contractual instrument that sets the services, fees, and responsibilities between the organization and a client."@en ;
        skos:broader tax:ContractualInstrument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:ServiceLevelAgreement a skos:Concept ;
        skos:prefLabel "Service level agreement"@en ;
        skos:altLabel "SLA"@en ;
        skos:definition "A contractual instrument that commits measurable service levels and remedies."@en ;
        skos:broader tax:ContractualInstrument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:PlanDocument a skos:Concept ;
        skos:prefLabel "Plan document"@en ;
        skos:altLabel "Plan terms"@en , "Summary plan description"@en , "SPD"@en ;
        skos:definition "A contractual instrument that sets the legally binding terms of a benefit or retirement plan."@en ;
        skos:broader tax:ContractualInstrument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:DataProcessingAgreement a skos:Concept ;
        skos:prefLabel "Data processing agreement"@en ;
        skos:altLabel "Data protection agreement"@en ;
        skos:definition "A contractual instrument that governs how one party processes personal data for another."@en ;
        skos:broader tax:ContractualInstrument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:TermsOfService a skos:Concept ;
        skos:prefLabel "Terms of service"@en ;
        skos:altLabel "Terms of use"@en ;
        skos:definition "A contractual instrument that sets the conditions for using a service or application."@en ;
        skos:broader tax:ContractualInstrument ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Standard a skos:Concept ;
        skos:prefLabel "Standard"@en ;
        skos:altLabel "Specification"@en ;
        skos:definition "A policy that is a documented agreement on specifications or practices adopted voluntarily or by reference."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:narrower tax:InternationalStandard , tax:IndustryStandard , tax:InternalStandard ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:InternationalStandard a skos:Concept ;
        skos:prefLabel "International standard"@en ;
        skos:altLabel "ISO standard"@en , "Consensus standard"@en ;
        skos:definition "A standard published by an international standards body."@en ;
        skos:broader tax:Standard ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:IndustryStandard a skos:Concept ;
        skos:prefLabel "Industry standard"@en ;
        skos:altLabel "Industry specification"@en ;
        skos:definition "A standard published by an industry or professional body."@en ;
        skos:broader tax:Standard ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:InternalStandard a skos:Concept ;
        skos:prefLabel "Internal standard"@en ;
        skos:altLabel "Company standard"@en ;
        skos:definition "A standard adopted by the organization for its own work."@en ;
        skos:example "Naming conventions; documentation standards."@en ;
        skos:broader tax:Standard ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Procedure a skos:Concept ;
        skos:prefLabel "Procedure"@en ;
        skos:altLabel "Standard operating procedure"@en , "SOP"@en , "Work instruction"@en ;
        skos:definition "A policy that specifies the steps to carry out an activity in a consistent way."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:relatedMatch tax:ProcessStep ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Guideline a skos:Concept ;
        skos:prefLabel "Guideline"@en ;
        skos:altLabel "Guidance note"@en , "Best practice"@en ;
        skos:definition "A policy that recommends good practice without mandating it."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Norm a skos:Concept ;
        skos:prefLabel "Norm"@en ;
        skos:altLabel "Deontic statement"@en , "Legal norm"@en ;
        skos:definition "A policy statement that qualifies an action or state as obligatory, permitted, or prohibited for a party in a jurisdiction and period."@en ;
        skos:scopeNote "Norms link to steps with governedBy and to their source with a source relation; each has a jurisdiction and effective period."@en ;
        skos:topConceptOf tax:PolicyTaxonomy ;
        skos:narrower tax:Obligation , tax:Permission , tax:Prohibition , tax:Right ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Obligation a skos:Concept ;
        skos:prefLabel "Obligation"@en ;
        skos:altLabel "Duty"@en , "Requirement to act"@en ;
        skos:definition "A norm that requires a party to perform an action or achieve a state."@en ;
        skos:broader tax:Norm ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Permission a skos:Concept ;
        skos:prefLabel "Permission"@en ;
        skos:altLabel "Allowance"@en , "Authorization"@en ;
        skos:definition "A norm that allows a party to perform an action without requiring it."@en ;
        skos:broader tax:Norm ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Prohibition a skos:Concept ;
        skos:prefLabel "Prohibition"@en ;
        skos:altLabel "Restriction"@en , "Ban"@en ;
        skos:definition "A norm that forbids a party from performing an action."@en ;
        skos:broader tax:Norm ;
        skos:inScheme tax:PolicyTaxonomy .

    tax:Right a skos:Concept ;
        skos:prefLabel "Right"@en ;
        skos:altLabel "Entitlement"@en , "Claim right"@en ;
        skos:definition "A norm that entitles a party to an action, benefit, or protection from another party."@en ;
        skos:broader tax:Norm ;
        skos:inScheme tax:PolicyTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-process> {
    tax:ProcessTaxonomy a skos:ConceptScheme ;
        dcterms:title "Process taxonomy"@en ;
        skos:prefLabel "Process taxonomy"@en ;
        dcterms:description "Classification of processes and process steps, the occurrents that unfold over time and to which every other fact is anchored in the unifying ontology."@en ;
        dcterms:subject core:Process ;
        skos:scopeNote "The process step is the first-class anchor of the unifying ontology; performedBy, consumes, produces, triggers, governedBy, measuredBy, and precedes attach to it. Process status and automation values are in the process vocabulary."@en ;
        dcterms:source "BFO process (ISO/IEC 21838-2); OBO Relations Ontology has input, has output, has active participant; APQC Process Classification Framework categories; BPMN for step notation."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:ManagementProcess ,
            tax:OperationalProcess ,
            tax:SupportProcess ,
            tax:ProcessStep .

    tax:ManagementProcess a skos:Concept ;
        skos:prefLabel "Management process"@en ;
        skos:altLabel "Governing process"@en ;
        skos:definition "A process that sets direction, allocates resources, and oversees performance of the organization."@en ;
        skos:topConceptOf tax:ProcessTaxonomy ;
        skos:narrower tax:StrategyAndPlanningProcess , tax:PerformanceManagementProcess , tax:RiskAndComplianceManagementProcess , tax:EnterpriseArchitectureProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:StrategyAndPlanningProcess a skos:Concept ;
        skos:prefLabel "Strategy and planning process"@en ;
        skos:altLabel "Strategic planning"@en , "Planning process"@en ;
        skos:definition "A management process that defines objectives, plans, and budgets."@en ;
        skos:broader tax:ManagementProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:PerformanceManagementProcess a skos:Concept ;
        skos:prefLabel "Performance management process"@en ;
        skos:altLabel "Performance review process"@en ;
        skos:definition "A management process that sets targets, measures results, and drives improvement."@en ;
        skos:broader tax:ManagementProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:RiskAndComplianceManagementProcess a skos:Concept ;
        skos:prefLabel "Risk and compliance management process"@en ;
        skos:altLabel "Governance, risk, and compliance process"@en , "GRC process"@en ;
        skos:definition "A management process that identifies, assesses, treats, and monitors risks and obligations."@en ;
        skos:broader tax:ManagementProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:EnterpriseArchitectureProcess a skos:Concept ;
        skos:prefLabel "Enterprise architecture process"@en ;
        skos:altLabel "Architecture governance process"@en ;
        skos:definition "A management process that defines and governs the structure of business, information, and technology."@en ;
        skos:broader tax:ManagementProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:OperationalProcess a skos:Concept ;
        skos:prefLabel "Operational process"@en ;
        skos:altLabel "Core process"@en , "Value chain process"@en , "Primary process"@en ;
        skos:definition "A process that directly creates or delivers value to clients."@en ;
        skos:topConceptOf tax:ProcessTaxonomy ;
        skos:narrower tax:OfferingDevelopmentProcess , tax:MarketingAndSalesProcess , tax:ClientOnboardingProcess , tax:ServiceDeliveryProcess , tax:ClientSupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:OfferingDevelopmentProcess a skos:Concept ;
        skos:prefLabel "Offering development process"@en ;
        skos:altLabel "Product development process"@en ;
        skos:definition "An operational process that designs, builds, and launches products and services."@en ;
        skos:broader tax:OperationalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:MarketingAndSalesProcess a skos:Concept ;
        skos:prefLabel "Marketing and sales process"@en ;
        skos:altLabel "Lead to client"@en , "Selling process"@en ;
        skos:definition "An operational process that generates demand and wins clients."@en ;
        skos:broader tax:OperationalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ClientOnboardingProcess a skos:Concept ;
        skos:prefLabel "Client onboarding process"@en ;
        skos:altLabel "Implementation process"@en ;
        skos:definition "An operational process that sets up a new client and its workforce for service."@en ;
        skos:broader tax:OperationalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ServiceDeliveryProcess a skos:Concept ;
        skos:prefLabel "Service delivery process"@en ;
        skos:altLabel "Fulfilment process"@en , "Order to cash"@en ;
        skos:definition "An operational process that fulfils services for clients and their workers."@en ;
        skos:broader tax:OperationalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ClientSupportProcess a skos:Concept ;
        skos:prefLabel "Client support process"@en ;
        skos:altLabel "Customer service process"@en , "Case management process"@en ;
        skos:definition "An operational process that answers inquiries and resolves requests from clients and workers."@en ;
        skos:broader tax:OperationalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:SupportProcess a skos:Concept ;
        skos:prefLabel "Support process"@en ;
        skos:altLabel "Enabling process"@en , "Supporting process"@en ;
        skos:definition "A process that enables management and operational processes."@en ;
        skos:topConceptOf tax:ProcessTaxonomy ;
        skos:narrower tax:HumanCapitalManagementProcess , tax:FinancialManagementProcess , tax:ProcurementProcess , tax:InformationTechnologyManagementProcess , tax:DataAndKnowledgeManagementProcess , tax:LegalProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:HumanCapitalManagementProcess a skos:Concept ;
        skos:prefLabel "Human capital management process"@en ;
        skos:altLabel "Human resources process"@en , "Hire to retire"@en ;
        skos:definition "A support process that recruits, pays, develops, and retains the workforce."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:FinancialManagementProcess a skos:Concept ;
        skos:prefLabel "Financial management process"@en ;
        skos:altLabel "Record to report"@en , "Finance process"@en ;
        skos:definition "A support process that records, reports, plans, and controls money."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ProcurementProcess a skos:Concept ;
        skos:prefLabel "Procurement process"@en ;
        skos:altLabel "Procure to pay"@en , "Purchasing process"@en ;
        skos:definition "A support process that sources and buys goods and services."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:InformationTechnologyManagementProcess a skos:Concept ;
        skos:prefLabel "Information technology management process"@en ;
        skos:altLabel "IT management process"@en ;
        skos:definition "A support process that plans, builds, and runs technology services."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:DataAndKnowledgeManagementProcess a skos:Concept ;
        skos:prefLabel "Data and knowledge management process"@en ;
        skos:altLabel "Knowledge engineering process"@en , "Data management process"@en ;
        skos:definition "A support process that acquires, defines, governs, and publishes data and knowledge."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:LegalProcess a skos:Concept ;
        skos:prefLabel "Legal process"@en ;
        skos:altLabel "Legal affairs process"@en ;
        skos:definition "A support process that drafts agreements, advises on law, and manages disputes."@en ;
        skos:broader tax:SupportProcess ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ProcessStep a skos:Concept ;
        skos:prefLabel "Process step"@en ;
        skos:altLabel "Activity"@en , "Task"@en , "Step"@en ;
        skos:definition "A process that is a bounded part of a larger process, performed by a party or role, consuming and producing assets."@en ;
        skos:scopeNote "In the unifying ontology every fact is attached to the step in which it is created, used, or governed. Kinds below follow BPMN task types."@en ;
        skos:example "Validate timesheet; calculate gross pay; approve payroll run."@en ;
        skos:topConceptOf tax:ProcessTaxonomy ;
        skos:narrower tax:ManualStep , tax:UserStep , tax:AutomatedStep , tax:DecisionStep , tax:ApprovalStep , tax:ValidationStep , tax:CalculationStep , tax:CommunicationStep , tax:WaitStep , tax:SubprocessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ManualStep a skos:Concept ;
        skos:prefLabel "Manual step"@en ;
        skos:altLabel "Manual task"@en ;
        skos:definition "A process step performed by a person without system automation."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:UserStep a skos:Concept ;
        skos:prefLabel "User step"@en ;
        skos:altLabel "User task"@en ;
        skos:definition "A process step performed by a person with the help of a software application."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:AutomatedStep a skos:Concept ;
        skos:prefLabel "Automated step"@en ;
        skos:altLabel "Service task"@en , "System task"@en ;
        skos:definition "A process step performed entirely by software without human intervention."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:DecisionStep a skos:Concept ;
        skos:prefLabel "Decision step"@en ;
        skos:altLabel "Business rule task"@en , "Gateway decision"@en ;
        skos:definition "A process step that selects an outcome or path by applying a decision model or judgement."@en ;
        skos:broader tax:ProcessStep ;
        skos:relatedMatch tax:OperationalDecision ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ApprovalStep a skos:Concept ;
        skos:prefLabel "Approval step"@en ;
        skos:altLabel "Approval task"@en , "Sign-off step"@en ;
        skos:definition "A process step in which an authorized party accepts or rejects an item."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:ValidationStep a skos:Concept ;
        skos:prefLabel "Validation step"@en ;
        skos:altLabel "Verification step"@en , "Check"@en ;
        skos:definition "A process step that checks data or work against constraints and rules."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:CalculationStep a skos:Concept ;
        skos:prefLabel "Calculation step"@en ;
        skos:altLabel "Computation step"@en ;
        skos:definition "A process step that computes a value from inputs using a governed calculation."@en ;
        skos:broader tax:ProcessStep ;
        skos:relatedMatch tax:Calculation ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:CommunicationStep a skos:Concept ;
        skos:prefLabel "Communication step"@en ;
        skos:altLabel "Send task"@en , "Receive task"@en , "Notification step"@en ;
        skos:definition "A process step that sends or receives information to or from a party."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:WaitStep a skos:Concept ;
        skos:prefLabel "Wait step"@en ;
        skos:altLabel "Timer step"@en , "Hold"@en ;
        skos:definition "A process step that pauses until a time, event, or condition occurs."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .

    tax:SubprocessStep a skos:Concept ;
        skos:prefLabel "Subprocess step"@en ;
        skos:altLabel "Call activity"@en , "Subprocess"@en ;
        skos:definition "A process step that invokes another process as a unit."@en ;
        skos:broader tax:ProcessStep ;
        skos:inScheme tax:ProcessTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-product> {
    tax:ProductTaxonomy a skos:ConceptScheme ;
        dcterms:title "Product taxonomy"@en ;
        skos:prefLabel "Product taxonomy"@en ;
        dcterms:description "Classification of offerings that the organization or its partners make available to clients and their workers."@en ;
        dcterms:subject core:Product ;
        skos:scopeNote "Covers kinds of offering. Product status and offering model values are in the product vocabulary. Packages are related to their components with hasComponent, not skos:narrower."@en ;
        dcterms:source "GS1 Global Product Classification and United Nations Standard Products and Services Code concepts, generalized."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:Good ,
            tax:ServiceOffering ,
            tax:BundledOffering ,
            tax:FinancialProduct ,
            tax:InformationProduct .

    tax:Good a skos:Concept ;
        skos:prefLabel "Good"@en ;
        skos:altLabel "Goods"@en , "Merchandise"@en ;
        skos:definition "A product that is a tangible or digital item whose ownership or use transfers to the buyer."@en ;
        skos:topConceptOf tax:ProductTaxonomy ;
        skos:narrower tax:PhysicalGood , tax:DigitalGood ;
        skos:inScheme tax:ProductTaxonomy .

    tax:PhysicalGood a skos:Concept ;
        skos:prefLabel "Physical good"@en ;
        skos:altLabel "Hardware product"@en ;
        skos:definition "A good that has material form and is shipped or delivered."@en ;
        skos:broader tax:Good ;
        skos:inScheme tax:ProductTaxonomy .

    tax:DigitalGood a skos:Concept ;
        skos:prefLabel "Digital good"@en ;
        skos:altLabel "Digital product"@en ;
        skos:definition "A good delivered and used in electronic form."@en ;
        skos:broader tax:Good ;
        skos:narrower tax:SoftwareProduct , tax:DigitalContent ;
        skos:inScheme tax:ProductTaxonomy .

    tax:SoftwareProduct a skos:Concept ;
        skos:prefLabel "Software product"@en ;
        skos:altLabel "Software as a service"@en , "SaaS"@en , "Application product"@en ;
        skos:definition "A digital good that is software licensed or subscribed to by clients."@en ;
        skos:broader tax:DigitalGood ;
        skos:inScheme tax:ProductTaxonomy .

    tax:DigitalContent a skos:Concept ;
        skos:prefLabel "Digital content"@en ;
        skos:altLabel "Content product"@en , "E-learning course"@en ;
        skos:definition "A digital good that is media or information content."@en ;
        skos:broader tax:DigitalGood ;
        skos:inScheme tax:ProductTaxonomy .

    tax:ServiceOffering a skos:Concept ;
        skos:prefLabel "Service offering"@en ;
        skos:altLabel "Service product"@en , "Packaged service"@en ;
        skos:definition "A product that is the commitment to perform activities or provide outcomes for a client."@en ;
        skos:topConceptOf tax:ProductTaxonomy ;
        skos:narrower tax:OutsourcedServiceOffering , tax:AdvisoryServiceOffering , tax:TechnologyServiceOffering , tax:AdministrationServiceOffering ;
        skos:relatedMatch tax:BusinessService ;
        skos:inScheme tax:ProductTaxonomy .

    tax:OutsourcedServiceOffering a skos:Concept ;
        skos:prefLabel "Outsourced service offering"@en ;
        skos:altLabel "Managed service offering"@en , "Co-employment offering"@en , "Professional employer organization offering"@en , "PEO offering"@en ;
        skos:definition "A service offering in which the provider takes over a business function for the client."@en ;
        skos:broader tax:ServiceOffering ;
        skos:inScheme tax:ProductTaxonomy .

    tax:AdvisoryServiceOffering a skos:Concept ;
        skos:prefLabel "Advisory service offering"@en ;
        skos:altLabel "Consulting offering"@en ;
        skos:definition "A service offering that provides expert guidance and recommendations."@en ;
        skos:broader tax:ServiceOffering ;
        skos:inScheme tax:ProductTaxonomy .

    tax:TechnologyServiceOffering a skos:Concept ;
        skos:prefLabel "Technology service offering"@en ;
        skos:altLabel "Platform offering"@en ;
        skos:definition "A service offering that provides access to software, platforms, or infrastructure operated by the provider."@en ;
        skos:broader tax:ServiceOffering ;
        skos:inScheme tax:ProductTaxonomy .

    tax:AdministrationServiceOffering a skos:Concept ;
        skos:prefLabel "Administration service offering"@en ;
        skos:altLabel "Administrative services offering"@en ;
        skos:definition "A service offering that performs recurring administrative transactions for the client."@en ;
        skos:broader tax:ServiceOffering ;
        skos:inScheme tax:ProductTaxonomy .

    tax:BundledOffering a skos:Concept ;
        skos:prefLabel "Bundled offering"@en ;
        skos:altLabel "Bundle"@en , "Package"@en , "Service bundle"@en , "Suite"@en ;
        skos:definition "A product that combines several products or services sold as one package."@en ;
        skos:topConceptOf tax:ProductTaxonomy ;
        skos:inScheme tax:ProductTaxonomy .

    tax:FinancialProduct a skos:Concept ;
        skos:prefLabel "Financial product"@en ;
        skos:altLabel "Financial services product"@en ;
        skos:definition "A product that is a contract providing financial protection, savings, credit, or investment."@en ;
        skos:topConceptOf tax:ProductTaxonomy ;
        skos:narrower tax:InsuranceProduct , tax:RetirementSavingsProduct , tax:SpendingAccountProduct , tax:CreditProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:InsuranceProduct a skos:Concept ;
        skos:prefLabel "Insurance product"@en ;
        skos:altLabel "Insurance plan"@en , "Coverage"@en ;
        skos:definition "A financial product that pays benefits when a covered loss or event occurs, in exchange for premiums."@en ;
        skos:broader tax:FinancialProduct ;
        skos:narrower tax:HealthInsuranceProduct , tax:LifeInsuranceProduct , tax:DisabilityInsuranceProduct , tax:PropertyAndCasualtyInsuranceProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:HealthInsuranceProduct a skos:Concept ;
        skos:prefLabel "Health insurance product"@en ;
        skos:altLabel "Health plan"@en , "Medical plan"@en ;
        skos:definition "An insurance product that covers medical, dental, vision, or prescription costs."@en ;
        skos:broader tax:InsuranceProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:LifeInsuranceProduct a skos:Concept ;
        skos:prefLabel "Life insurance product"@en ;
        skos:altLabel "Life plan"@en ;
        skos:definition "An insurance product that pays a benefit on the death of the insured."@en ;
        skos:broader tax:InsuranceProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:DisabilityInsuranceProduct a skos:Concept ;
        skos:prefLabel "Disability insurance product"@en ;
        skos:altLabel "Disability plan"@en ;
        skos:definition "An insurance product that replaces income when the insured cannot work due to disability."@en ;
        skos:broader tax:InsuranceProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:PropertyAndCasualtyInsuranceProduct a skos:Concept ;
        skos:prefLabel "Property and casualty insurance product"@en ;
        skos:altLabel "Workers compensation insurance"@en , "Liability insurance"@en ;
        skos:definition "An insurance product that covers damage to property or liability to others."@en ;
        skos:broader tax:InsuranceProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:RetirementSavingsProduct a skos:Concept ;
        skos:prefLabel "Retirement savings product"@en ;
        skos:altLabel "Retirement plan"@en , "Defined contribution plan"@en ;
        skos:definition "A financial product that accumulates savings for retirement with tax advantages."@en ;
        skos:broader tax:FinancialProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:SpendingAccountProduct a skos:Concept ;
        skos:prefLabel "Spending account product"@en ;
        skos:altLabel "Flexible spending account"@en , "Health savings account"@en ;
        skos:definition "A financial product that sets aside funds for qualified expenses."@en ;
        skos:broader tax:FinancialProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:CreditProduct a skos:Concept ;
        skos:prefLabel "Credit product"@en ;
        skos:altLabel "Loan"@en ;
        skos:definition "A financial product that lends money or extends credit."@en ;
        skos:broader tax:FinancialProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:InformationProduct a skos:Concept ;
        skos:prefLabel "Information product"@en ;
        skos:altLabel "Data and insight product"@en ;
        skos:definition "A product whose value lies in information delivered to the buyer."@en ;
        skos:topConceptOf tax:ProductTaxonomy ;
        skos:narrower tax:DataProduct , tax:ReportProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:DataProduct a skos:Concept ;
        skos:prefLabel "Data product"@en ;
        skos:altLabel "Data as a product"@en ;
        skos:definition "An information product that is a curated, documented, and governed dataset offered for reuse by consumers."@en ;
        skos:scopeNote "Described with the Object Management Group Data Product Ontology and Data Catalog Vocabulary."@en ;
        skos:broader tax:InformationProduct ;
        skos:inScheme tax:ProductTaxonomy .

    tax:ReportProduct a skos:Concept ;
        skos:prefLabel "Report product"@en ;
        skos:altLabel "Analytics product"@en , "Benchmark report"@en ;
        skos:definition "An information product delivered as a recurring report or dashboard."@en ;
        skos:broader tax:InformationProduct ;
        skos:inScheme tax:ProductTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-requirement> {
    tax:RequirementTaxonomy a skos:ConceptScheme ;
        dcterms:title "Requirement taxonomy"@en ;
        skos:prefLabel "Requirement taxonomy"@en ;
        dcterms:description "Classification of statements of need, capability, condition, or constraint that a solution, service, process, or knowledge artifact must satisfy."@en ;
        dcterms:subject core:Requirement ;
        skos:scopeNote "Covers kinds of requirement. Priority, status, and verification method values are in the requirement vocabulary. Requirements trace to features, change records, releases, and deployments."@en ;
        dcterms:source "ISO/IEC/IEEE 29148 requirements engineering; NeOn Ontology Requirements Specification Document; INCOSE Guide to Writing Requirements."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:StakeholderRequirement ,
            tax:SolutionRequirement ,
            tax:Constraint ,
            tax:KnowledgeRequirement ,
            tax:TransitionRequirement .

    tax:StakeholderRequirement a skos:Concept ;
        skos:prefLabel "Stakeholder requirement"@en ;
        skos:altLabel "Stakeholder need"@en ;
        skos:definition "A requirement that states what a stakeholder needs, independent of any solution."@en ;
        skos:topConceptOf tax:RequirementTaxonomy ;
        skos:narrower tax:BusinessRequirement , tax:UserRequirement , tax:RegulatoryRequirement , tax:ContractualRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:BusinessRequirement a skos:Concept ;
        skos:prefLabel "Business requirement"@en ;
        skos:altLabel "Business need"@en , "Business objective requirement"@en ;
        skos:definition "A stakeholder requirement that states an organizational goal, objective, or outcome."@en ;
        skos:broader tax:StakeholderRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:UserRequirement a skos:Concept ;
        skos:prefLabel "User requirement"@en ;
        skos:altLabel "User story"@en , "User need"@en ;
        skos:definition "A stakeholder requirement that states what a user must be able to do or experience."@en ;
        skos:broader tax:StakeholderRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:RegulatoryRequirement a skos:Concept ;
        skos:prefLabel "Regulatory requirement"@en ;
        skos:altLabel "Compliance requirement"@en , "Legal requirement"@en ;
        skos:definition "A stakeholder requirement that arises from a law, regulation, or binding guidance."@en ;
        skos:broader tax:StakeholderRequirement ;
        skos:relatedMatch tax:LegalNormSource ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:ContractualRequirement a skos:Concept ;
        skos:prefLabel "Contractual requirement"@en ;
        skos:altLabel "Contract requirement"@en ;
        skos:definition "A stakeholder requirement that arises from the terms of an agreement."@en ;
        skos:broader tax:StakeholderRequirement ;
        skos:relatedMatch tax:ContractualInstrument ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:SolutionRequirement a skos:Concept ;
        skos:prefLabel "Solution requirement"@en ;
        skos:altLabel "System requirement"@en , "Product requirement"@en ;
        skos:definition "A requirement that states a characteristic a solution must have to meet stakeholder requirements."@en ;
        skos:topConceptOf tax:RequirementTaxonomy ;
        skos:narrower tax:FunctionalRequirement , tax:QualityRequirement , tax:InterfaceRequirement , tax:DataRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:FunctionalRequirement a skos:Concept ;
        skos:prefLabel "Functional requirement"@en ;
        skos:altLabel "Capability requirement"@en ;
        skos:definition "A solution requirement that states a behavior or function the solution must perform."@en ;
        skos:broader tax:SolutionRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:QualityRequirement a skos:Concept ;
        skos:prefLabel "Quality requirement"@en ;
        skos:altLabel "Non-functional requirement"@en , "Quality attribute requirement"@en ;
        skos:definition "A solution requirement that states how well the solution must perform a function or a characteristic it must exhibit."@en ;
        skos:broader tax:SolutionRequirement ;
        skos:narrower tax:PerformanceRequirement , tax:AvailabilityRequirement , tax:ReliabilityRequirement , tax:SecurityRequirement , tax:PrivacyRequirement , tax:UsabilityRequirement , tax:AccessibilityRequirement , tax:MaintainabilityRequirement , tax:ScalabilityRequirement , tax:InteroperabilityRequirement , tax:ExplainabilityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:PerformanceRequirement a skos:Concept ;
        skos:prefLabel "Performance requirement"@en ;
        skos:altLabel "Latency requirement"@en ;
        skos:definition "A quality requirement on response time, throughput, or resource use."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:AvailabilityRequirement a skos:Concept ;
        skos:prefLabel "Availability requirement"@en ;
        skos:altLabel "Uptime requirement"@en ;
        skos:definition "A quality requirement on the proportion of time a solution is operational."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:ReliabilityRequirement a skos:Concept ;
        skos:prefLabel "Reliability requirement"@en ;
        skos:altLabel "Mean time between failures requirement"@en ;
        skos:definition "A quality requirement on the ability to perform without failure over a period."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:SecurityRequirement a skos:Concept ;
        skos:prefLabel "Security requirement"@en ;
        skos:altLabel "Information security requirement"@en ;
        skos:definition "A quality requirement on protecting confidentiality, integrity, and availability."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:PrivacyRequirement a skos:Concept ;
        skos:prefLabel "Privacy requirement"@en ;
        skos:definition "A quality requirement on the lawful and limited collection and use of personal information."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:UsabilityRequirement a skos:Concept ;
        skos:prefLabel "Usability requirement"@en ;
        skos:altLabel "User experience requirement"@en ;
        skos:definition "A quality requirement on ease of learning and efficient use."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:AccessibilityRequirement a skos:Concept ;
        skos:prefLabel "Accessibility requirement"@en ;
        skos:altLabel "Web Content Accessibility Guidelines requirement"@en , "WCAG requirement"@en ;
        skos:definition "A quality requirement on use by people with the widest range of abilities."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:MaintainabilityRequirement a skos:Concept ;
        skos:prefLabel "Maintainability requirement"@en ;
        skos:definition "A quality requirement on the ease of changing and correcting the solution."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:ScalabilityRequirement a skos:Concept ;
        skos:prefLabel "Scalability requirement"@en ;
        skos:definition "A quality requirement on handling growth in load or data."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:InteroperabilityRequirement a skos:Concept ;
        skos:prefLabel "Interoperability requirement"@en ;
        skos:altLabel "Integration requirement"@en ;
        skos:definition "A quality requirement on exchanging and using information with other systems."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:ExplainabilityRequirement a skos:Concept ;
        skos:prefLabel "Explainability requirement"@en ;
        skos:altLabel "Traceability requirement"@en , "Answer traceability requirement"@en ;
        skos:definition "A quality requirement on the ability to trace and explain outputs to their inputs and rules."@en ;
        skos:broader tax:QualityRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:InterfaceRequirement a skos:Concept ;
        skos:prefLabel "Interface requirement"@en ;
        skos:altLabel "Integration interface requirement"@en ;
        skos:definition "A solution requirement that states how the solution interacts with users, systems, or devices."@en ;
        skos:broader tax:SolutionRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:DataRequirement a skos:Concept ;
        skos:prefLabel "Data requirement"@en ;
        skos:altLabel "Information requirement"@en ;
        skos:definition "A solution requirement that states what data must be captured, defined, stored, or retained."@en ;
        skos:broader tax:SolutionRequirement ;
        skos:narrower tax:DataDefinitionRequirement , tax:DataQualityRequirement , tax:DataRetentionRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:DataDefinitionRequirement a skos:Concept ;
        skos:prefLabel "Data definition requirement"@en ;
        skos:definition "A data requirement on the meaning, format, and allowed values of a data element."@en ;
        skos:broader tax:DataRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:DataQualityRequirement a skos:Concept ;
        skos:prefLabel "Data quality requirement"@en ;
        skos:definition "A data requirement on the accuracy, completeness, consistency, timeliness, or validity of data."@en ;
        skos:broader tax:DataRequirement ;
        skos:relatedMatch tax:DataQualityDimension ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:DataRetentionRequirement a skos:Concept ;
        skos:prefLabel "Data retention requirement"@en ;
        skos:altLabel "Records retention requirement"@en ;
        skos:definition "A data requirement on how long data is kept and how it is disposed of."@en ;
        skos:broader tax:DataRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:Constraint a skos:Concept ;
        skos:prefLabel "Constraint"@en ;
        skos:altLabel "Design constraint"@en ;
        skos:definition "A requirement that limits the design or implementation options available."@en ;
        skos:scopeNote "Distinct from data constraints in the rule taxonomy, which state what must be true about data."@en ;
        skos:topConceptOf tax:RequirementTaxonomy ;
        skos:narrower tax:TechnicalConstraint , tax:BusinessConstraint ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:TechnicalConstraint a skos:Concept ;
        skos:prefLabel "Technical constraint"@en ;
        skos:altLabel "Technology constraint"@en ;
        skos:definition "A constraint imposed by technology standards, platforms, or existing systems."@en ;
        skos:broader tax:Constraint ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:BusinessConstraint a skos:Concept ;
        skos:prefLabel "Business constraint"@en ;
        skos:altLabel "Project constraint"@en ;
        skos:definition "A constraint imposed by budget, schedule, staffing, or policy."@en ;
        skos:broader tax:Constraint ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:KnowledgeRequirement a skos:Concept ;
        skos:prefLabel "Knowledge requirement"@en ;
        skos:altLabel "Ontology requirement"@en ;
        skos:definition "A requirement that states what governed knowledge must define or be able to answer."@en ;
        skos:topConceptOf tax:RequirementTaxonomy ;
        skos:narrower tax:CompetencyQuestion , tax:CoverageRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:CompetencyQuestion a skos:Concept ;
        skos:prefLabel "Competency question"@en ;
        skos:altLabel "CQ"@en , "Competency test"@en ;
        skos:definition "A knowledge requirement written as a question the knowledge must be able to answer, run as a test in each release."@en ;
        skos:broader tax:KnowledgeRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:CoverageRequirement a skos:Concept ;
        skos:prefLabel "Coverage requirement"@en ;
        skos:altLabel "Mapping coverage requirement"@en ;
        skos:definition "A knowledge requirement on the terms, mappings, or sources that must be included."@en ;
        skos:broader tax:KnowledgeRequirement ;
        skos:inScheme tax:RequirementTaxonomy .

    tax:TransitionRequirement a skos:Concept ;
        skos:prefLabel "Transition requirement"@en ;
        skos:altLabel "Migration requirement"@en , "Cutover requirement"@en ;
        skos:definition "A requirement that states a capability needed only to move from the current to the future state."@en ;
        skos:topConceptOf tax:RequirementTaxonomy ;
        skos:inScheme tax:RequirementTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-role> {
    tax:RoleTaxonomy a skos:ConceptScheme ;
        dcterms:title "Role taxonomy"@en ;
        skos:prefLabel "Role taxonomy"@en ;
        dcterms:description "Classification of roles, the positions or functions a party bears because of its situation and that are realized when it takes part in process steps."@en ;
        dcterms:subject core:Role ;
        skos:scopeNote "A role is borne by a party (hasRole) and realized in process steps (performedBy). Personas are not roles and never grant access. Security entitlements are managed separately."@en ;
        dcterms:source "BFO role (ISO/IEC 21838-2); W3C Organization Ontology; RACI responsibility assignment."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:EmploymentRole ,
            tax:CommercialRole ,
            tax:PlanRole ,
            tax:ResponsibilityRole ,
            tax:GovernanceRole ,
            tax:KnowledgeEngineeringRole ,
            tax:AgreementPartyRole .

    tax:EmploymentRole a skos:Concept ;
        skos:prefLabel "Employment role"@en ;
        skos:definition "A role that arises from an employment relationship between a worker and an employer."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:Worker , tax:Employer , tax:Manager , tax:Executive ;
        skos:relatedMatch tax:EmploymentLifecycle ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Worker a skos:Concept ;
        skos:prefLabel "Worker"@en ;
        skos:altLabel "Worker role"@en ;
        skos:definition "An employment role borne by a person who performs work for an organization."@en ;
        skos:broader tax:EmploymentRole ;
        skos:narrower tax:Employee , tax:ContingentWorker ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Employee a skos:Concept ;
        skos:prefLabel "Employee"@en ;
        skos:altLabel "Employee role"@en , "Staff member"@en ;
        skos:definition "A worker who is employed under an employment relationship and paid through payroll."@en ;
        skos:broader tax:Worker ;
        skos:narrower tax:WorksiteEmployee ;
        skos:inScheme tax:RoleTaxonomy .

    tax:WorksiteEmployee a skos:Concept ;
        skos:prefLabel "Worksite employee"@en ;
        skos:altLabel "Co-employed employee"@en , "WSE"@en ;
        skos:definition "An employee who performs work at a client worksite under a co-employment relationship."@en ;
        skos:broader tax:Employee ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ContingentWorker a skos:Concept ;
        skos:prefLabel "Contingent worker"@en ;
        skos:altLabel "Temporary worker"@en , "Contractor"@en , "Consultant"@en ;
        skos:definition "A worker engaged for a limited period or task without standard employment."@en ;
        skos:broader tax:Worker ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Employer a skos:Concept ;
        skos:prefLabel "Employer"@en ;
        skos:altLabel "Employer role"@en ;
        skos:definition "An employment role borne by an organization that hires and directs workers."@en ;
        skos:broader tax:EmploymentRole ;
        skos:narrower tax:CoEmployer , tax:ClientEmployer ;
        skos:inScheme tax:RoleTaxonomy .

    tax:CoEmployer a skos:Concept ;
        skos:prefLabel "Co-employer"@en ;
        skos:altLabel "Professional employer organization"@en , "PEO"@en ;
        skos:definition "An employer that shares employer responsibilities for the same workers with another employer under a co-employment agreement."@en ;
        skos:broader tax:Employer ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ClientEmployer a skos:Concept ;
        skos:prefLabel "Client employer"@en ;
        skos:altLabel "Worksite client employer"@en ;
        skos:definition "An employer that is a client of a co-employer and directs the day-to-day work of worksite employees."@en ;
        skos:broader tax:Employer ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Manager a skos:Concept ;
        skos:prefLabel "Manager"@en ;
        skos:altLabel "Supervisor"@en , "People manager"@en ;
        skos:definition "An employment role borne by a person who directs the work of other workers."@en ;
        skos:broader tax:EmploymentRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Executive a skos:Concept ;
        skos:prefLabel "Executive"@en ;
        skos:altLabel "Officer"@en , "Senior leader"@en ;
        skos:definition "An employment role borne by a person accountable for the direction of an organization or major unit."@en ;
        skos:broader tax:EmploymentRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:CommercialRole a skos:Concept ;
        skos:prefLabel "Commercial role"@en ;
        skos:altLabel "Business relationship role"@en ;
        skos:definition "A role that arises from a commercial relationship or agreement."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:Client , tax:Prospect , tax:Supplier , tax:Partner , tax:Broker ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Client a skos:Concept ;
        skos:prefLabel "Client"@en ;
        skos:altLabel "Customer"@en , "Client company"@en ;
        skos:definition "A commercial role borne by a party that purchases services from the organization under an agreement."@en ;
        skos:broader tax:CommercialRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Prospect a skos:Concept ;
        skos:prefLabel "Prospect"@en ;
        skos:altLabel "Prospective client"@en , "Lead"@en ;
        skos:definition "A commercial role borne by a party being evaluated or pursued as a future client."@en ;
        skos:broader tax:CommercialRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Supplier a skos:Concept ;
        skos:prefLabel "Supplier"@en ;
        skos:altLabel "Vendor"@en , "Provider"@en ;
        skos:definition "A commercial role borne by a party that provides goods or services to the organization."@en ;
        skos:broader tax:CommercialRole ;
        skos:narrower tax:Carrier ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Carrier a skos:Concept ;
        skos:prefLabel "Carrier"@en ;
        skos:altLabel "Insurance carrier"@en , "Insurer"@en ;
        skos:definition "A supplier that underwrites and pays insurance benefits."@en ;
        skos:broader tax:Supplier ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Partner a skos:Concept ;
        skos:prefLabel "Partner"@en ;
        skos:altLabel "Alliance partner"@en , "Channel partner"@en ;
        skos:definition "A commercial role borne by a party that collaborates with the organization to deliver or sell offerings."@en ;
        skos:broader tax:CommercialRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Broker a skos:Concept ;
        skos:prefLabel "Broker"@en ;
        skos:altLabel "Agent of record"@en , "Intermediary"@en ;
        skos:definition "A commercial role borne by a party that arranges agreements between other parties for a commission or fee."@en ;
        skos:broader tax:CommercialRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:PlanRole a skos:Concept ;
        skos:prefLabel "Plan role"@en ;
        skos:altLabel "Benefit plan role"@en ;
        skos:definition "A role that arises from participation in a benefit, retirement, or insurance plan."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:PlanSponsor , tax:PlanAdministrator , tax:PlanParticipant , tax:Dependent , tax:Beneficiary ;
        skos:inScheme tax:RoleTaxonomy .

    tax:PlanSponsor a skos:Concept ;
        skos:prefLabel "Plan sponsor"@en ;
        skos:altLabel "Sponsor"@en ;
        skos:definition "A plan role borne by an organization that establishes and maintains a plan."@en ;
        skos:broader tax:PlanRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:PlanAdministrator a skos:Concept ;
        skos:prefLabel "Plan administrator"@en ;
        skos:altLabel "Administrator"@en ;
        skos:definition "A plan role borne by a party responsible for operating a plan under its terms."@en ;
        skos:broader tax:PlanRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:PlanParticipant a skos:Concept ;
        skos:prefLabel "Plan participant"@en ;
        skos:altLabel "Participant"@en , "Member"@en , "Enrollee"@en ;
        skos:definition "A plan role borne by a person who is enrolled in a plan."@en ;
        skos:broader tax:PlanRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Dependent a skos:Concept ;
        skos:prefLabel "Dependent"@en ;
        skos:altLabel "Covered dependent"@en ;
        skos:definition "A plan role borne by a person who receives coverage through a plan participant."@en ;
        skos:broader tax:PlanRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Beneficiary a skos:Concept ;
        skos:prefLabel "Beneficiary"@en ;
        skos:altLabel "Designated beneficiary"@en ;
        skos:definition "A plan role borne by a party designated to receive a benefit on a participant's death."@en ;
        skos:broader tax:PlanRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ResponsibilityRole a skos:Concept ;
        skos:prefLabel "Responsibility role"@en ;
        skos:altLabel "Responsibility assignment"@en , "RACI role"@en ;
        skos:definition "A role that defines the kind of responsibility a party has for a process step or decision."@en ;
        skos:scopeNote "Used to qualify performedBy and approvedBy."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:ResponsibleRole , tax:AccountableRole , tax:ConsultedRole , tax:InformedRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ResponsibleRole a skos:Concept ;
        skos:prefLabel "Responsible role"@en ;
        skos:altLabel "Responsible"@en , "Doer"@en ;
        skos:definition "A responsibility role borne by the party that does the work."@en ;
        skos:broader tax:ResponsibilityRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:AccountableRole a skos:Concept ;
        skos:prefLabel "Accountable role"@en ;
        skos:altLabel "Accountable"@en , "Approver"@en ;
        skos:definition "A responsibility role borne by the party that answers for the outcome and approves the work."@en ;
        skos:broader tax:ResponsibilityRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ConsultedRole a skos:Concept ;
        skos:prefLabel "Consulted role"@en ;
        skos:altLabel "Consulted"@en , "Advisor"@en ;
        skos:definition "A responsibility role borne by a party whose input is sought before work or decisions."@en ;
        skos:broader tax:ResponsibilityRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:InformedRole a skos:Concept ;
        skos:prefLabel "Informed role"@en ;
        skos:altLabel "Informed"@en ;
        skos:definition "A responsibility role borne by a party kept up to date on progress or outcome."@en ;
        skos:broader tax:ResponsibilityRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:GovernanceRole a skos:Concept ;
        skos:prefLabel "Governance role"@en ;
        skos:definition "A role that carries authority or duty for the oversight of policies, data, knowledge, or controls."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:Owner , tax:Steward , tax:Custodian , tax:ChangeReviewer , tax:Auditor , tax:Regulator ;
        skos:relatedMatch tax:GovernanceDiscipline ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Owner a skos:Concept ;
        skos:prefLabel "Owner"@en ;
        skos:altLabel "Domain owner"@en , "Data owner"@en , "Business owner"@en ;
        skos:definition "A governance role borne by the party accountable for an asset, domain, or artifact and for approving changes to it."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Steward a skos:Concept ;
        skos:prefLabel "Steward"@en ;
        skos:altLabel "Data steward"@en , "Vocabulary steward"@en ;
        skos:definition "A governance role borne by the party who maintains the quality, labels, and definitions of data or vocabularies day to day."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Custodian a skos:Concept ;
        skos:prefLabel "Custodian"@en ;
        skos:altLabel "Data custodian"@en , "System owner"@en ;
        skos:definition "A governance role borne by the party who operates the systems that store and protect an asset."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:ChangeReviewer a skos:Concept ;
        skos:prefLabel "Change reviewer"@en ;
        skos:altLabel "Approver of record"@en ;
        skos:definition "A governance role borne by the party who approves changes before they enter source control and release."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Auditor a skos:Concept ;
        skos:prefLabel "Auditor"@en ;
        skos:altLabel "Internal auditor"@en , "External auditor"@en ;
        skos:definition "A governance role borne by a party who independently examines records and controls."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Regulator a skos:Concept ;
        skos:prefLabel "Regulator"@en ;
        skos:altLabel "Supervisory authority"@en ;
        skos:definition "A governance role borne by a government body that oversees compliance with law in a domain."@en ;
        skos:broader tax:GovernanceRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:KnowledgeEngineeringRole a skos:Concept ;
        skos:prefLabel "Knowledge engineering role"@en ;
        skos:altLabel "Design-time role"@en ;
        skos:definition "A role that builds, reviews, or maintains governed knowledge artifacts."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:KnowledgeEngineer , tax:SubjectMatterExpert , tax:DraftingAssistant ;
        skos:inScheme tax:RoleTaxonomy .

    tax:KnowledgeEngineer a skos:Concept ;
        skos:prefLabel "Knowledge engineer"@en ;
        skos:definition "A knowledge engineering role borne by the person who builds and extends ontologies under the naming, URI, and definition standards."@en ;
        skos:broader tax:KnowledgeEngineeringRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:SubjectMatterExpert a skos:Concept ;
        skos:prefLabel "Subject matter expert"@en ;
        skos:altLabel "SME"@en , "Domain expert"@en ;
        skos:definition "A knowledge engineering role borne by the person who confirms definitions, rules, and relationships for a domain."@en ;
        skos:broader tax:KnowledgeEngineeringRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:DraftingAssistant a skos:Concept ;
        skos:prefLabel "Drafting assistant"@en ;
        skos:altLabel "AI drafting assistant"@en ;
        skos:definition "A knowledge engineering role borne by an artificial intelligence agent that drafts definitions, labels, mappings, and shapes for human review and never commits on its own."@en ;
        skos:broader tax:KnowledgeEngineeringRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:AgreementPartyRole a skos:Concept ;
        skos:prefLabel "Agreement party role"@en ;
        skos:altLabel "Contracting party"@en ;
        skos:definition "A role borne by a party because it is a signatory to or named in an agreement."@en ;
        skos:topConceptOf tax:RoleTaxonomy ;
        skos:narrower tax:Principal , tax:Representative , tax:Guarantor ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Principal a skos:Concept ;
        skos:prefLabel "Principal"@en ;
        skos:definition "An agreement party role borne by the party on whose behalf an agreement is made or an action taken."@en ;
        skos:broader tax:AgreementPartyRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Representative a skos:Concept ;
        skos:prefLabel "Representative"@en ;
        skos:altLabel "Authorized representative"@en , "Agent"@en , "Legal representative"@en ;
        skos:definition "An agreement party role borne by a party authorized to act for another."@en ;
        skos:broader tax:AgreementPartyRole ;
        skos:inScheme tax:RoleTaxonomy .

    tax:Guarantor a skos:Concept ;
        skos:prefLabel "Guarantor"@en ;
        skos:definition "An agreement party role borne by a party that promises to meet another party's obligation if it defaults."@en ;
        skos:broader tax:AgreementPartyRole ;
        skos:inScheme tax:RoleTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-rule> {
    tax:RuleTaxonomy a skos:ConceptScheme ;
        dcterms:title "Rule taxonomy"@en ;
        skos:prefLabel "Rule taxonomy"@en ;
        dcterms:description "Classification of rules, the declarative statements authored once in the single source of truth that constrain data, derive decisions, or guard the behavior of services and agents."@en ;
        dcterms:subject core:Rule ;
        skos:scopeNote "Constraints run as SHACL shapes or JSON Schema; decision rules run as DMN tables behind the Decision API. Multi-step logic is in the logic taxonomy and calculations are in the measure taxonomy. Strength, authoring format, and runtime values are in the rule vocabulary."@en ;
        dcterms:source "Semantic Governance v1.8 Section 3.5; Object Management Group Semantics of Business Vocabulary and Business Rules; Decision Model and Notation; W3C SHACL."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:BusinessRule ,
            tax:DataConstraint ,
            tax:DataQualityRule ,
            tax:TransformationRule ,
            tax:AccessControlRule ,
            tax:GuardrailRule .

    tax:BusinessRule a skos:Concept ;
        skos:prefLabel "Business rule"@en ;
        skos:altLabel "Business logic rule"@en ;
        skos:definition "A rule that states a business policy or decision logic in terms the business understands."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:narrower tax:DecisionRule , tax:AuthorizationRule , tax:DerivationRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:DecisionRule a skos:Concept ;
        skos:prefLabel "Decision rule"@en ;
        skos:altLabel "Decision table rule"@en , "DMN rule"@en ;
        skos:definition "A business rule that determines an outcome from input conditions, typically one row of a decision table."@en ;
        skos:broader tax:BusinessRule ;
        skos:narrower tax:EligibilityRule , tax:PricingRule , tax:RoutingRule , tax:TimingRule , tax:ThresholdRule ;
        skos:relatedMatch tax:DecisionTable ;
        skos:inScheme tax:RuleTaxonomy .

    tax:EligibilityRule a skos:Concept ;
        skos:prefLabel "Eligibility rule"@en ;
        skos:altLabel "Qualification rule"@en ;
        skos:definition "A decision rule that determines whether a party qualifies for a benefit, service, or action."@en ;
        skos:broader tax:DecisionRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:PricingRule a skos:Concept ;
        skos:prefLabel "Pricing rule"@en ;
        skos:altLabel "Rating rule"@en ;
        skos:definition "A decision rule that determines a price, fee, or rate."@en ;
        skos:broader tax:DecisionRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:RoutingRule a skos:Concept ;
        skos:prefLabel "Routing rule"@en ;
        skos:altLabel "Assignment rule"@en ;
        skos:definition "A decision rule that determines where work or a request is sent."@en ;
        skos:broader tax:DecisionRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:TimingRule a skos:Concept ;
        skos:prefLabel "Timing rule"@en ;
        skos:altLabel "Deadline rule"@en , "Effective date rule"@en ;
        skos:definition "A decision rule that determines a due date, waiting period, or effective date."@en ;
        skos:broader tax:DecisionRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ThresholdRule a skos:Concept ;
        skos:prefLabel "Threshold rule"@en ;
        skos:altLabel "Limit rule"@en , "Tolerance rule"@en ;
        skos:definition "A decision rule that triggers an outcome when a measure crosses a defined limit."@en ;
        skos:broader tax:DecisionRule ;
        skos:relatedMatch tax:Threshold ;
        skos:inScheme tax:RuleTaxonomy .

    tax:AuthorizationRule a skos:Concept ;
        skos:prefLabel "Authorization rule"@en ;
        skos:altLabel "Approval authority rule"@en , "Delegation of authority rule"@en ;
        skos:definition "A business rule that states who may perform or approve an action."@en ;
        skos:broader tax:BusinessRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:DerivationRule a skos:Concept ;
        skos:prefLabel "Derivation rule"@en ;
        skos:altLabel "Inference rule"@en , "Derived fact rule"@en ;
        skos:definition "A business rule that states how a fact is concluded from other facts."@en ;
        skos:broader tax:BusinessRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:DataConstraint a skos:Concept ;
        skos:prefLabel "Data constraint"@en ;
        skos:altLabel "Constraint rule"@en , "Integrity constraint"@en ;
        skos:definition "A rule that states what must always be true about data."@en ;
        skos:scopeNote "Authored as ontology terms and SHACL shapes or JSON Schema."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:narrower tax:CardinalityConstraint , tax:ValueConstraint , tax:UniquenessConstraint , tax:ReferentialConstraint , tax:TemporalConstraint , tax:ConditionalConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:CardinalityConstraint a skos:Concept ;
        skos:prefLabel "Cardinality constraint"@en ;
        skos:altLabel "Multiplicity constraint"@en ;
        skos:definition "A data constraint on how many values a property may or must have."@en ;
        skos:example "A payroll run has exactly one pay period."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ValueConstraint a skos:Concept ;
        skos:prefLabel "Value constraint"@en ;
        skos:altLabel "Domain constraint"@en , "Allowed values"@en ;
        skos:definition "A data constraint on the type, format, range, or allowed list of a value."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:UniquenessConstraint a skos:Concept ;
        skos:prefLabel "Uniqueness constraint"@en ;
        skos:altLabel "Key constraint"@en ;
        skos:definition "A data constraint that a value or combination of values identifies at most one entity."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ReferentialConstraint a skos:Concept ;
        skos:prefLabel "Referential constraint"@en ;
        skos:altLabel "Referential integrity rule"@en ;
        skos:definition "A data constraint that a referenced entity must exist."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:TemporalConstraint a skos:Concept ;
        skos:prefLabel "Temporal constraint"@en ;
        skos:altLabel "Date order constraint"@en ;
        skos:definition "A data constraint on the order or overlap of dates and periods."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ConditionalConstraint a skos:Concept ;
        skos:prefLabel "Conditional constraint"@en ;
        skos:altLabel "Dependency constraint"@en ;
        skos:definition "A data constraint that applies only when a stated condition holds."@en ;
        skos:broader tax:DataConstraint ;
        skos:inScheme tax:RuleTaxonomy .

    tax:DataQualityRule a skos:Concept ;
        skos:prefLabel "Data quality rule"@en ;
        skos:definition "A rule that measures or enforces a dimension of data quality."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:narrower tax:CompletenessRule , tax:AccuracyRule , tax:ConsistencyRule , tax:TimelinessRule , tax:ValidityRule ;
        skos:relatedMatch tax:DataQualityDimension ;
        skos:inScheme tax:RuleTaxonomy .

    tax:CompletenessRule a skos:Concept ;
        skos:prefLabel "Completeness rule"@en ;
        skos:definition "A data quality rule that checks required values are present."@en ;
        skos:broader tax:DataQualityRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:AccuracyRule a skos:Concept ;
        skos:prefLabel "Accuracy rule"@en ;
        skos:definition "A data quality rule that checks values agree with an authoritative source."@en ;
        skos:broader tax:DataQualityRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ConsistencyRule a skos:Concept ;
        skos:prefLabel "Consistency rule"@en ;
        skos:definition "A data quality rule that checks values agree across records and systems."@en ;
        skos:broader tax:DataQualityRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:TimelinessRule a skos:Concept ;
        skos:prefLabel "Timeliness rule"@en ;
        skos:altLabel "Freshness rule"@en ;
        skos:definition "A data quality rule that checks values are current within an agreed period."@en ;
        skos:broader tax:DataQualityRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ValidityRule a skos:Concept ;
        skos:prefLabel "Validity rule"@en ;
        skos:definition "A data quality rule that checks values conform to defined formats and domains."@en ;
        skos:broader tax:DataQualityRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:TransformationRule a skos:Concept ;
        skos:prefLabel "Transformation rule"@en ;
        skos:altLabel "Mapping rule"@en , "Conversion rule"@en ;
        skos:definition "A rule that states how data in one form is converted into another form."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:relatedMatch tax:MappingSpecification ;
        skos:inScheme tax:RuleTaxonomy .

    tax:AccessControlRule a skos:Concept ;
        skos:prefLabel "Access control rule"@en ;
        skos:altLabel "Entitlement rule"@en , "Access rule"@en ;
        skos:definition "A rule that states which parties may read or change which information under which conditions."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:relatedMatch tax:AccessControl ;
        skos:inScheme tax:RuleTaxonomy .

    tax:GuardrailRule a skos:Concept ;
        skos:prefLabel "Guardrail rule"@en ;
        skos:altLabel "Artificial intelligence guardrail"@en , "AI guardrail"@en , "Agent guardrail"@en ;
        skos:definition "A rule that limits the inputs, actions, or outputs of an automated agent."@en ;
        skos:topConceptOf tax:RuleTaxonomy ;
        skos:narrower tax:InputGuardrail , tax:ActionGuardrail , tax:OutputGuardrail , tax:CircuitBreakerRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:InputGuardrail a skos:Concept ;
        skos:prefLabel "Input guardrail"@en ;
        skos:altLabel "Prompt guardrail"@en ;
        skos:definition "A guardrail rule that screens requests before an agent acts on them."@en ;
        skos:broader tax:GuardrailRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:ActionGuardrail a skos:Concept ;
        skos:prefLabel "Action guardrail"@en ;
        skos:altLabel "Tool use limit"@en ;
        skos:definition "A guardrail rule that restricts which tools or actions an agent may take."@en ;
        skos:broader tax:GuardrailRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:OutputGuardrail a skos:Concept ;
        skos:prefLabel "Output guardrail"@en ;
        skos:altLabel "Answer guardrail"@en , "Grounding check"@en ;
        skos:definition "A guardrail rule that checks an agent's output before it is released."@en ;
        skos:broader tax:GuardrailRule ;
        skos:inScheme tax:RuleTaxonomy .

    tax:CircuitBreakerRule a skos:Concept ;
        skos:prefLabel "Circuit breaker rule"@en ;
        skos:altLabel "Artificial intelligence circuit breaker"@en , "AI circuit breaker"@en ;
        skos:definition "A guardrail rule that suspends or degrades an agent when reliability falls below a threshold."@en ;
        skos:broader tax:GuardrailRule ;
        skos:relatedMatch tax:MeanTimeBetweenHallucinations ;
        skos:inScheme tax:RuleTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-service> {
    tax:ServiceTaxonomy a skos:ConceptScheme ;
        dcterms:title "Service taxonomy"@en ;
        skos:prefLabel "Service taxonomy"@en ;
        dcterms:description "Classification of services, the capabilities offered and realized through process steps to deliver outcomes for clients, workers, and internal consumers."@en ;
        dcterms:subject core:Service ;
        skos:scopeNote "Covers kinds of service. Packaged commercial offerings are in the product taxonomy. Service status, channel, and delivery model values are in the service vocabulary."@en ;
        dcterms:source "BFO disposition realized in processes (ISO/IEC 21838-2); ISO/IEC 20000 service management; Semantic Governance v1.8 Appendix D semantic services."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:BusinessService ,
            tax:TechnologyService ,
            tax:SemanticService .

    tax:BusinessService a skos:Concept ;
        skos:prefLabel "Business service"@en ;
        skos:altLabel "Business function service"@en ;
        skos:definition "A service that delivers a business outcome to clients, workers, or internal units."@en ;
        skos:topConceptOf tax:ServiceTaxonomy ;
        skos:narrower tax:HumanResourcesService , tax:AdvisoryService , tax:AdministrativeService , tax:ClientSupportService , tax:FinancialService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:HumanResourcesService a skos:Concept ;
        skos:prefLabel "Human resources service"@en ;
        skos:altLabel "HR service"@en , "Workforce service"@en ;
        skos:definition "A business service that administers or advises on employment and workforce matters."@en ;
        skos:broader tax:BusinessService ;
        skos:narrower tax:PayrollService , tax:BenefitsAdministrationService , tax:EmploymentComplianceService , tax:TalentService , tax:WorkersCompensationService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:PayrollService a skos:Concept ;
        skos:prefLabel "Payroll service"@en ;
        skos:altLabel "Payroll processing"@en ;
        skos:definition "A human resources service that calculates, pays, and reports compensation and withholding."@en ;
        skos:broader tax:HumanResourcesService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:BenefitsAdministrationService a skos:Concept ;
        skos:prefLabel "Benefits administration service"@en ;
        skos:altLabel "Benefits service"@en ;
        skos:definition "A human resources service that offers and administers benefit and retirement plans."@en ;
        skos:broader tax:HumanResourcesService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:EmploymentComplianceService a skos:Concept ;
        skos:prefLabel "Employment compliance service"@en ;
        skos:altLabel "Human resources compliance service"@en ;
        skos:definition "A human resources service that helps employers meet employment laws and obligations."@en ;
        skos:broader tax:HumanResourcesService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:TalentService a skos:Concept ;
        skos:prefLabel "Talent service"@en ;
        skos:altLabel "Talent management service"@en ;
        skos:definition "A human resources service that supports recruiting, learning, and performance."@en ;
        skos:broader tax:HumanResourcesService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:WorkersCompensationService a skos:Concept ;
        skos:prefLabel "Workers compensation service"@en ;
        skos:altLabel "Workplace safety service"@en ;
        skos:definition "A human resources service that administers workplace injury coverage and claims."@en ;
        skos:broader tax:HumanResourcesService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:AdvisoryService a skos:Concept ;
        skos:prefLabel "Advisory service"@en ;
        skos:altLabel "Consulting service"@en ;
        skos:definition "A business service that provides expert guidance on a question or decision."@en ;
        skos:broader tax:BusinessService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:AdministrativeService a skos:Concept ;
        skos:prefLabel "Administrative service"@en ;
        skos:altLabel "Back-office service"@en ;
        skos:definition "A business service that performs recurring administrative transactions."@en ;
        skos:broader tax:BusinessService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:ClientSupportService a skos:Concept ;
        skos:prefLabel "Client support service"@en ;
        skos:altLabel "Customer support"@en , "Help desk"@en , "Service center"@en ;
        skos:definition "A business service that answers inquiries and resolves requests."@en ;
        skos:broader tax:BusinessService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:FinancialService a skos:Concept ;
        skos:prefLabel "Financial service"@en ;
        skos:altLabel "Payment service"@en , "Treasury service"@en ;
        skos:definition "A business service that moves, holds, or manages money."@en ;
        skos:broader tax:BusinessService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:TechnologyService a skos:Concept ;
        skos:prefLabel "Technology service"@en ;
        skos:altLabel "Information technology service"@en , "IT service"@en ;
        skos:definition "A service that provides computing, data, or integration functions."@en ;
        skos:topConceptOf tax:ServiceTaxonomy ;
        skos:narrower tax:ApplicationService , tax:DataService , tax:IntegrationService , tax:PlatformService , tax:InfrastructureService , tax:SecurityService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:ApplicationService a skos:Concept ;
        skos:prefLabel "Application service"@en ;
        skos:altLabel "Software service"@en ;
        skos:definition "A technology service that exposes application functions to users or systems."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:DataService a skos:Concept ;
        skos:prefLabel "Data service"@en ;
        skos:altLabel "Data access service"@en ;
        skos:definition "A technology service that provides access to or movement of data."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:IntegrationService a skos:Concept ;
        skos:prefLabel "Integration service"@en ;
        skos:altLabel "Integration platform service"@en , "Event streaming service"@en ;
        skos:definition "A technology service that connects systems by exchanging messages or files."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:PlatformService a skos:Concept ;
        skos:prefLabel "Platform service"@en ;
        skos:altLabel "Platform as a service"@en ;
        skos:definition "A technology service that provides a runtime environment for building and running applications."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:InfrastructureService a skos:Concept ;
        skos:prefLabel "Infrastructure service"@en ;
        skos:altLabel "Infrastructure as a service"@en ;
        skos:definition "A technology service that provides compute, storage, or network capacity."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:SecurityService a skos:Concept ;
        skos:prefLabel "Security service"@en ;
        skos:altLabel "Identity and access management service"@en ;
        skos:definition "A technology service that provides identity, access control, or threat protection."@en ;
        skos:broader tax:TechnologyService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:SemanticService a skos:Concept ;
        skos:prefLabel "Semantic service"@en ;
        skos:altLabel "Knowledge service"@en , "Semantic knowledge layer service"@en ;
        skos:definition "A service that publishes or uses governed knowledge to give meaning, context, or answers."@en ;
        skos:scopeNote "The semantic services of the Semantic Knowledge Layer consumed by the HR 360 agent."@en ;
        skos:topConceptOf tax:ServiceTaxonomy ;
        skos:narrower tax:VocabularyService , tax:SearchService , tax:RetrievalService , tax:MappingService , tax:ValidationService , tax:DecisionService , tax:LineageService , tax:AnswerService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:VocabularyService a skos:Concept ;
        skos:prefLabel "Vocabulary service"@en ;
        skos:altLabel "Terminology service"@en , "Label service"@en ;
        skos:definition "A semantic service that serves terms, labels, and definitions, including persona labels."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:SearchService a skos:Concept ;
        skos:prefLabel "Search service"@en ;
        skos:altLabel "Semantic search service"@en ;
        skos:definition "A semantic service that finds governed content and terms by keyword and meaning."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:RetrievalService a skos:Concept ;
        skos:prefLabel "Retrieval service"@en ;
        skos:altLabel "Context service"@en , "Retrieval-augmented generation service"@en ;
        skos:definition "A semantic service that assembles governed facts and sources into context for an agent."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:MappingService a skos:Concept ;
        skos:prefLabel "Mapping service"@en ;
        skos:altLabel "Semantic mapping service"@en ;
        skos:definition "A semantic service that maps inbound schema elements and values to ontology terms."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:ValidationService a skos:Concept ;
        skos:prefLabel "Validation service"@en ;
        skos:altLabel "Shape validation service"@en , "Grounding service"@en ;
        skos:definition "A semantic service that checks data and answers against shapes, rules, and sources."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:DecisionService a skos:Concept ;
        skos:prefLabel "Decision service"@en ;
        skos:altLabel "Decision API"@en , "Rules service"@en ;
        skos:definition "A semantic service that evaluates governed decision models and returns an outcome and trace."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:LineageService a skos:Concept ;
        skos:prefLabel "Lineage service"@en ;
        skos:altLabel "Provenance service"@en , "Traceability service"@en ;
        skos:definition "A semantic service that reports the provenance and traceability of facts, answers, and changes."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .

    tax:AnswerService a skos:Concept ;
        skos:prefLabel "Answer service"@en ;
        skos:altLabel "Conversational answer service"@en , "Question answering service"@en ;
        skos:definition "A semantic service that returns natural language answers grounded in governed knowledge."@en ;
        skos:broader tax:SemanticService ;
        skos:inScheme tax:ServiceTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-time> {
    tax:TimeTaxonomy a skos:ConceptScheme ;
        dcterms:title "Time taxonomy"@en ;
        skos:prefLabel "Time taxonomy"@en ;
        dcterms:description "Classification of temporal entities, the instants, intervals, durations, and schedules used to date, sequence, and bound facts, rules, and process steps."@en ;
        dcterms:subject core:TemporalEntity ;
        skos:scopeNote "Time units, frequencies, day types, and time zones are in the time vocabulary. Domain periods such as pay period or plan year specialize the concepts here."@en ;
        dcterms:source "BFO temporal region (ISO/IEC 21838-2); W3C OWL-Time; ISO 8601 date and time representation."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:Instant ,
            tax:Interval ,
            tax:Duration ,
            tax:Schedule .

    tax:Instant a skos:Concept ;
        skos:prefLabel "Instant"@en ;
        skos:altLabel "Point in time"@en , "Time instant"@en ;
        skos:definition "A temporal entity that is a single point on a time line with no duration."@en ;
        skos:topConceptOf tax:TimeTaxonomy ;
        skos:narrower tax:CalendarDate , tax:DateAndTime , tax:Deadline , tax:EffectiveDate , tax:EndDate ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarDate a skos:Concept ;
        skos:prefLabel "Calendar date"@en ;
        skos:altLabel "Date"@en ;
        skos:definition "An instant identified at the precision of a day."@en ;
        skos:broader tax:Instant ;
        skos:inScheme tax:TimeTaxonomy .

    tax:DateAndTime a skos:Concept ;
        skos:prefLabel "Date and time"@en ;
        skos:altLabel "Timestamp"@en , "Date time"@en ;
        skos:definition "An instant identified to the second or finer, with a time zone."@en ;
        skos:broader tax:Instant ;
        skos:inScheme tax:TimeTaxonomy .

    tax:Deadline a skos:Concept ;
        skos:prefLabel "Deadline"@en ;
        skos:altLabel "Due date"@en , "Cut-off"@en ;
        skos:definition "An instant by which an action must be completed."@en ;
        skos:broader tax:Instant ;
        skos:inScheme tax:TimeTaxonomy .

    tax:EffectiveDate a skos:Concept ;
        skos:prefLabel "Effective date"@en ;
        skos:altLabel "Start date"@en , "Effective from"@en ;
        skos:definition "An instant from which a rule, agreement, election, or value applies."@en ;
        skos:broader tax:Instant ;
        skos:inScheme tax:TimeTaxonomy .

    tax:EndDate a skos:Concept ;
        skos:prefLabel "End date"@en ;
        skos:altLabel "Expiration date"@en , "Effective to"@en , "Termination date"@en ;
        skos:definition "An instant after which a rule, agreement, election, or value no longer applies."@en ;
        skos:broader tax:Instant ;
        skos:inScheme tax:TimeTaxonomy .

    tax:Interval a skos:Concept ;
        skos:prefLabel "Interval"@en ;
        skos:altLabel "Time interval"@en , "Period"@en ;
        skos:definition "A temporal entity that is a stretch of time with a beginning and an end."@en ;
        skos:topConceptOf tax:TimeTaxonomy ;
        skos:narrower tax:CalendarPeriod , tax:FiscalPeriod , tax:BusinessPeriod , tax:ValidityPeriod , tax:TimeWindow , tax:ReportingPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarPeriod a skos:Concept ;
        skos:prefLabel "Calendar period"@en ;
        skos:altLabel "Calendar interval"@en ;
        skos:definition "An interval aligned to the civil calendar."@en ;
        skos:broader tax:Interval ;
        skos:narrower tax:CalendarDay , tax:CalendarWeek , tax:CalendarMonth , tax:CalendarQuarter , tax:CalendarYear ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarDay a skos:Concept ;
        skos:prefLabel "Calendar day"@en ;
        skos:altLabel "Day"@en ;
        skos:definition "A calendar period of one day from midnight to midnight in a time zone."@en ;
        skos:broader tax:CalendarPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarWeek a skos:Concept ;
        skos:prefLabel "Calendar week"@en ;
        skos:altLabel "Week"@en ;
        skos:definition "A calendar period of seven consecutive days."@en ;
        skos:broader tax:CalendarPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarMonth a skos:Concept ;
        skos:prefLabel "Calendar month"@en ;
        skos:altLabel "Month"@en ;
        skos:definition "A calendar period corresponding to one month of the civil calendar."@en ;
        skos:broader tax:CalendarPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarQuarter a skos:Concept ;
        skos:prefLabel "Calendar quarter"@en ;
        skos:altLabel "Quarter"@en ;
        skos:definition "A calendar period of three consecutive months beginning in January, April, July, or October."@en ;
        skos:broader tax:CalendarPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:CalendarYear a skos:Concept ;
        skos:prefLabel "Calendar year"@en ;
        skos:altLabel "Year"@en ;
        skos:definition "A calendar period from the first of January to the thirty-first of December."@en ;
        skos:broader tax:CalendarPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:FiscalPeriod a skos:Concept ;
        skos:prefLabel "Fiscal period"@en ;
        skos:altLabel "Accounting period"@en ;
        skos:definition "An interval used for financial reporting that may differ from the calendar."@en ;
        skos:broader tax:Interval ;
        skos:narrower tax:FiscalMonth , tax:FiscalQuarter , tax:FiscalYear ;
        skos:inScheme tax:TimeTaxonomy .

    tax:FiscalMonth a skos:Concept ;
        skos:prefLabel "Fiscal month"@en ;
        skos:altLabel "Accounting month"@en ;
        skos:definition "A fiscal period that is one month of the fiscal calendar."@en ;
        skos:broader tax:FiscalPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:FiscalQuarter a skos:Concept ;
        skos:prefLabel "Fiscal quarter"@en ;
        skos:altLabel "Financial quarter"@en ;
        skos:definition "A fiscal period that is one quarter of the fiscal year."@en ;
        skos:broader tax:FiscalPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:FiscalYear a skos:Concept ;
        skos:prefLabel "Fiscal year"@en ;
        skos:altLabel "Financial year"@en ;
        skos:definition "A fiscal period of twelve months used for financial reporting and budgeting."@en ;
        skos:broader tax:FiscalPeriod ;
        skos:inScheme tax:TimeTaxonomy .

    tax:BusinessPeriod a skos:Concept ;
        skos:prefLabel "Business period"@en ;
        skos:altLabel "Cycle period"@en ;
        skos:definition "An interval defined by a business cycle such as a pay, plan, coverage, or reporting cycle."@en ;
        skos:scopeNote "Specialized in domain ontologies as pay period, plan year, coverage period, and so on."@en ;
        skos:broader tax:Interval ;
        skos:inScheme tax:TimeTaxonomy .

    tax:ValidityPeriod a skos:Concept ;
        skos:prefLabel "Validity period"@en ;
        skos:altLabel "Effective period"@en , "Period of applicability"@en ;
        skos:definition "An interval during which a rule, agreement, value, or version is in force."@en ;
        skos:scopeNote "Bounded by an effective date and an end date."@en ;
        skos:broader tax:Interval ;
        skos:inScheme tax:TimeTaxonomy .

    tax:TimeWindow a skos:Concept ;
        skos:prefLabel "Time window"@en ;
        skos:altLabel "Window"@en , "Election window"@en , "Open period"@en ;
        skos:definition "An interval during which an action is permitted or must occur."@en ;
        skos:broader tax:Interval ;
        skos:inScheme tax:TimeTaxonomy .

    tax:ReportingPeriod a skos:Concept ;
        skos:prefLabel "Reporting period"@en ;
        skos:altLabel "Measurement period"@en ;
        skos:definition "An interval that measures and observations are reported for."@en ;
        skos:broader tax:Interval ;
        skos:inScheme tax:TimeTaxonomy .

    tax:Duration a skos:Concept ;
        skos:prefLabel "Duration"@en ;
        skos:altLabel "Length of time"@en , "Time span"@en ;
        skos:definition "A temporal entity that is an amount of time without a fixed position on the time line."@en ;
        skos:example "Ninety days; forty hours."@en ;
        skos:topConceptOf tax:TimeTaxonomy ;
        skos:narrower tax:WaitingPeriod , tax:NoticePeriod , tax:RetentionPeriod , tax:ServiceLevelDuration ;
        skos:inScheme tax:TimeTaxonomy .

    tax:WaitingPeriod a skos:Concept ;
        skos:prefLabel "Waiting period"@en ;
        skos:altLabel "Probationary period"@en ;
        skos:definition "A duration that must elapse before an entitlement begins."@en ;
        skos:broader tax:Duration ;
        skos:inScheme tax:TimeTaxonomy .

    tax:NoticePeriod a skos:Concept ;
        skos:prefLabel "Notice period"@en ;
        skos:definition "A duration of advance notice required before an action takes effect."@en ;
        skos:broader tax:Duration ;
        skos:inScheme tax:TimeTaxonomy .

    tax:RetentionPeriod a skos:Concept ;
        skos:prefLabel "Retention period"@en ;
        skos:altLabel "Records retention period"@en ;
        skos:definition "A duration for which a record must be kept."@en ;
        skos:broader tax:Duration ;
        skos:inScheme tax:TimeTaxonomy .

    tax:ServiceLevelDuration a skos:Concept ;
        skos:prefLabel "Service level duration"@en ;
        skos:altLabel "Response time target"@en , "Resolution time target"@en ;
        skos:definition "A duration committed for responding to or resolving a request."@en ;
        skos:broader tax:Duration ;
        skos:inScheme tax:TimeTaxonomy .

    tax:Schedule a skos:Concept ;
        skos:prefLabel "Schedule"@en ;
        skos:altLabel "Timetable"@en ;
        skos:definition "A temporal entity that specifies when recurring or planned occurrences happen."@en ;
        skos:topConceptOf tax:TimeTaxonomy ;
        skos:narrower tax:RecurringSchedule , tax:OneTimeSchedule , tax:BusinessCalendar ;
        skos:inScheme tax:TimeTaxonomy .

    tax:RecurringSchedule a skos:Concept ;
        skos:prefLabel "Recurring schedule"@en ;
        skos:altLabel "Recurrence"@en , "Recurring pattern"@en ;
        skos:definition "A schedule that repeats at a defined frequency."@en ;
        skos:broader tax:Schedule ;
        skos:inScheme tax:TimeTaxonomy .

    tax:OneTimeSchedule a skos:Concept ;
        skos:prefLabel "One-time schedule"@en ;
        skos:altLabel "Single occurrence"@en ;
        skos:definition "A schedule for a single planned occurrence."@en ;
        skos:broader tax:Schedule ;
        skos:inScheme tax:TimeTaxonomy .

    tax:BusinessCalendar a skos:Concept ;
        skos:prefLabel "Business calendar"@en ;
        skos:altLabel "Working calendar"@en , "Holiday calendar"@en ;
        skos:definition "A schedule that defines working days, holidays, and cut-off times."@en ;
        skos:broader tax:Schedule ;
        skos:inScheme tax:TimeTaxonomy .
}

<https://www.insperity.com/graph/taxonomy-core-value> {
    tax:ValueTaxonomy a skos:ConceptScheme ;
        dcterms:title "Value taxonomy"@en ;
        skos:prefLabel "Value taxonomy"@en ;
        dcterms:description "Classification of value, the benefit or worth that stakeholders receive from offerings, capabilities, and process outcomes, and of the structures used to describe how it is delivered."@en ;
        dcterms:subject core:Value ;
        skos:scopeNote "Value is evaluated with measures. Realization status, horizon, and certainty values are in the value vocabulary."@en ;
        dcterms:source "Business Architecture Guild value stream mapping; ISO 30414 human capital reporting; ISO 26000 social responsibility."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept tax:EconomicValue ,
            tax:RiskReductionValue ,
            tax:StakeholderValue ,
            tax:SocietalValue ,
            tax:InformationValue ,
            tax:ValueStream ,
            tax:ValueProposition .

    tax:EconomicValue a skos:Concept ;
        skos:prefLabel "Economic value"@en ;
        skos:altLabel "Financial value"@en , "Monetary value"@en ;
        skos:definition "A value expressed as a financial gain, saving, or avoided cost."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:RevenueGrowth , tax:CostReduction , tax:CostAvoidance , tax:ProductivityGain , tax:CapitalEfficiency ;
        skos:inScheme tax:ValueTaxonomy .

    tax:RevenueGrowth a skos:Concept ;
        skos:prefLabel "Revenue growth"@en ;
        skos:altLabel "Revenue increase"@en ;
        skos:definition "An economic value from increased sales, retention, or pricing."@en ;
        skos:broader tax:EconomicValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:CostReduction a skos:Concept ;
        skos:prefLabel "Cost reduction"@en ;
        skos:altLabel "Cost savings"@en ;
        skos:definition "An economic value from lowering current spending."@en ;
        skos:broader tax:EconomicValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:CostAvoidance a skos:Concept ;
        skos:prefLabel "Cost avoidance"@en ;
        skos:altLabel "Avoided cost"@en ;
        skos:definition "An economic value from preventing spending that would otherwise occur."@en ;
        skos:broader tax:EconomicValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ProductivityGain a skos:Concept ;
        skos:prefLabel "Productivity gain"@en ;
        skos:altLabel "Efficiency gain"@en , "Time savings"@en ;
        skos:definition "An economic value from producing more output with the same resources."@en ;
        skos:broader tax:EconomicValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:CapitalEfficiency a skos:Concept ;
        skos:prefLabel "Capital efficiency"@en ;
        skos:definition "An economic value from using less capital or working capital for the same outcome."@en ;
        skos:broader tax:EconomicValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:RiskReductionValue a skos:Concept ;
        skos:prefLabel "Risk reduction value"@en ;
        skos:altLabel "Protection value"@en , "Risk mitigation value"@en ;
        skos:definition "A value from lowering the likelihood or impact of adverse events."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:ComplianceAssurance , tax:LossAvoidance , tax:Resilience ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ComplianceAssurance a skos:Concept ;
        skos:prefLabel "Compliance assurance"@en ;
        skos:altLabel "Regulatory assurance"@en ;
        skos:definition "A risk reduction value from meeting legal, regulatory, and contractual obligations."@en ;
        skos:broader tax:RiskReductionValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:LossAvoidance a skos:Concept ;
        skos:prefLabel "Loss avoidance"@en ;
        skos:altLabel "Penalty avoidance"@en ;
        skos:definition "A risk reduction value from preventing fraud, errors, penalties, or incidents."@en ;
        skos:broader tax:RiskReductionValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:Resilience a skos:Concept ;
        skos:prefLabel "Resilience"@en ;
        skos:altLabel "Business continuity"@en ;
        skos:definition "A risk reduction value from the ability to continue and recover when disruption occurs."@en ;
        skos:broader tax:RiskReductionValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:StakeholderValue a skos:Concept ;
        skos:prefLabel "Stakeholder value"@en ;
        skos:altLabel "Experience value"@en ;
        skos:definition "A value experienced by a particular group of stakeholders."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:ClientValue , tax:EmployeeValue , tax:PartnerValue , tax:ShareholderValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ClientValue a skos:Concept ;
        skos:prefLabel "Client value"@en ;
        skos:altLabel "Customer value"@en ;
        skos:definition "A stakeholder value experienced by client organizations."@en ;
        skos:broader tax:StakeholderValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:EmployeeValue a skos:Concept ;
        skos:prefLabel "Employee value"@en ;
        skos:altLabel "Worker value"@en , "Employee experience"@en ;
        skos:definition "A stakeholder value experienced by workers, such as security, wellbeing, and growth."@en ;
        skos:broader tax:StakeholderValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:PartnerValue a skos:Concept ;
        skos:prefLabel "Partner value"@en ;
        skos:definition "A stakeholder value experienced by suppliers, carriers, and partners."@en ;
        skos:broader tax:StakeholderValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ShareholderValue a skos:Concept ;
        skos:prefLabel "Shareholder value"@en ;
        skos:altLabel "Owner value"@en ;
        skos:definition "A stakeholder value experienced by owners and investors."@en ;
        skos:broader tax:StakeholderValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:SocietalValue a skos:Concept ;
        skos:prefLabel "Societal value"@en ;
        skos:altLabel "Social value"@en , "Public value"@en ;
        skos:definition "A value that benefits communities or the wider public beyond direct stakeholders."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:CommunityValue , tax:EnvironmentalValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:CommunityValue a skos:Concept ;
        skos:prefLabel "Community value"@en ;
        skos:altLabel "Community benefit"@en ;
        skos:definition "A societal value that benefits the communities where the organization and its clients operate."@en ;
        skos:broader tax:SocietalValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:EnvironmentalValue a skos:Concept ;
        skos:prefLabel "Environmental value"@en ;
        skos:altLabel "Sustainability value"@en , "Planet value"@en ;
        skos:definition "A societal value from reducing harm to or improving the natural environment."@en ;
        skos:broader tax:SocietalValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:InformationValue a skos:Concept ;
        skos:prefLabel "Information value"@en ;
        skos:altLabel "Decision value"@en , "Knowledge value"@en ;
        skos:definition "A value from better knowledge, decisions, and trust."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:DecisionQuality , tax:TrustAndTransparency , tax:ReuseValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:DecisionQuality a skos:Concept ;
        skos:prefLabel "Decision quality"@en ;
        skos:altLabel "Better decisions"@en ;
        skos:definition "An information value from making decisions that are faster, more consistent, and better informed."@en ;
        skos:broader tax:InformationValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:TrustAndTransparency a skos:Concept ;
        skos:prefLabel "Trust and transparency"@en ;
        skos:altLabel "Trust"@en , "Transparency"@en ;
        skos:definition "An information value from answers and records that can be traced, explained, and verified."@en ;
        skos:broader tax:InformationValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ReuseValue a skos:Concept ;
        skos:prefLabel "Reuse value"@en ;
        skos:altLabel "Single source of truth value"@en ;
        skos:definition "An information value from defining knowledge once and reusing it across services and domains."@en ;
        skos:broader tax:InformationValue ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ValueStream a skos:Concept ;
        skos:prefLabel "Value stream"@en ;
        skos:altLabel "Value chain"@en ;
        skos:definition "A value-related structure that is an end-to-end sequence of stages delivering an outcome to a stakeholder."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:CustomerValueStream , tax:InternalValueStream ;
        skos:relatedMatch tax:OperationalProcess ;
        skos:inScheme tax:ValueTaxonomy .

    tax:CustomerValueStream a skos:Concept ;
        skos:prefLabel "Customer value stream"@en ;
        skos:altLabel "Operational value stream"@en , "Prospect to client value stream"@en ;
        skos:definition "A value stream that delivers an outcome to an external client or worker."@en ;
        skos:broader tax:ValueStream ;
        skos:inScheme tax:ValueTaxonomy .

    tax:InternalValueStream a skos:Concept ;
        skos:prefLabel "Internal value stream"@en ;
        skos:altLabel "Development value stream"@en , "Enabling value stream"@en ;
        skos:definition "A value stream that delivers an outcome to an internal stakeholder."@en ;
        skos:broader tax:ValueStream ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ValueProposition a skos:Concept ;
        skos:prefLabel "Value proposition"@en ;
        skos:altLabel "Offer value statement"@en ;
        skos:definition "A value-related statement of the benefits an offering or capability delivers to a stakeholder and why it is preferable to alternatives."@en ;
        skos:topConceptOf tax:ValueTaxonomy ;
        skos:narrower tax:ClientValueProposition , tax:EmployeeValueProposition ;
        skos:inScheme tax:ValueTaxonomy .

    tax:ClientValueProposition a skos:Concept ;
        skos:prefLabel "Client value proposition"@en ;
        skos:altLabel "Customer value proposition"@en ;
        skos:definition "A value proposition addressed to clients."@en ;
        skos:broader tax:ValueProposition ;
        skos:inScheme tax:ValueTaxonomy .

    tax:EmployeeValueProposition a skos:Concept ;
        skos:prefLabel "Employee value proposition"@en ;
        skos:altLabel "Employer brand promise"@en ;
        skos:definition "A value proposition addressed to current and prospective workers."@en ;
        skos:broader tax:ValueProposition ;
        skos:inScheme tax:ValueTaxonomy .
}

<https://www.insperity.com/graph/vocabulary-core-asset> {
    voc:asset-vocabulary a skos:ConceptScheme ;
        dcterms:title "Asset vocabulary"@en ;
        skos:prefLabel "Asset vocabulary"@en ;
        dcterms:description "Controlled values that describe the status, ownership, and criticality of assets."@en ;
        dcterms:subject core:Asset ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:asset-status ,
            voc:asset-ownership-type ,
            voc:asset-criticality .

    voc:asset-status a skos:Concept ;
        skos:prefLabel "Asset status"@en ;
        skos:definition "A controlled value set for the operational state of an asset."@en ;
        skos:topConceptOf voc:asset-vocabulary ;
        skos:narrower voc:asset-status-planned , voc:asset-status-active , voc:asset-status-under-maintenance , voc:asset-status-inactive , voc:asset-status-disposed ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-status-planned a skos:Concept ;
        skos:prefLabel "Planned"@en ;
        skos:definition "An asset status in which the asset is approved but not yet acquired or built."@en ;
        skos:broader voc:asset-status ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-status-active a skos:Concept ;
        skos:prefLabel "Active"@en ;
        skos:altLabel "In service"@en , "In use"@en ;
        skos:definition "An asset status in which the asset is in service and available for use."@en ;
        skos:broader voc:asset-status ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-status-under-maintenance a skos:Concept ;
        skos:prefLabel "Under maintenance"@en ;
        skos:definition "An asset status in which the asset is temporarily out of service for repair or upgrade."@en ;
        skos:broader voc:asset-status ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-status-inactive a skos:Concept ;
        skos:prefLabel "Inactive"@en ;
        skos:altLabel "Idle"@en , "Standby"@en ;
        skos:definition "An asset status in which the asset is held but not in use."@en ;
        skos:broader voc:asset-status ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-status-disposed a skos:Concept ;
        skos:prefLabel "Disposed"@en ;
        skos:altLabel "Decommissioned"@en ;
        skos:definition "An asset status in which the asset has been sold, scrapped, deleted, or otherwise removed."@en ;
        skos:broader voc:asset-status ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-ownership-type a skos:Concept ;
        skos:prefLabel "Asset ownership type"@en ;
        skos:definition "A controlled value set for the basis on which the organization holds an asset."@en ;
        skos:topConceptOf voc:asset-vocabulary ;
        skos:narrower voc:asset-ownership-owned , voc:asset-ownership-leased , voc:asset-ownership-licensed , voc:asset-ownership-subscribed ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-ownership-owned a skos:Concept ;
        skos:prefLabel "Owned"@en ;
        skos:definition "An asset ownership type in which the organization holds legal title."@en ;
        skos:broader voc:asset-ownership-type ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-ownership-leased a skos:Concept ;
        skos:prefLabel "Leased"@en ;
        skos:definition "An asset ownership type in which the organization uses the asset under a lease for a term."@en ;
        skos:broader voc:asset-ownership-type ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-ownership-licensed a skos:Concept ;
        skos:prefLabel "Licensed"@en ;
        skos:definition "An asset ownership type in which the organization holds a license to use the asset."@en ;
        skos:broader voc:asset-ownership-type ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-ownership-subscribed a skos:Concept ;
        skos:prefLabel "Subscribed"@en ;
        skos:altLabel "Subscription"@en ;
        skos:definition "An asset ownership type in which the organization accesses the asset as a service for recurring fees."@en ;
        skos:broader voc:asset-ownership-type ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-criticality a skos:Concept ;
        skos:prefLabel "Asset criticality"@en ;
        skos:definition "A controlled value set for how essential an asset is to operations."@en ;
        skos:topConceptOf voc:asset-vocabulary ;
        skos:narrower voc:asset-criticality-mission-critical , voc:asset-criticality-business-critical , voc:asset-criticality-business-supporting , voc:asset-criticality-non-critical ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-criticality-mission-critical a skos:Concept ;
        skos:prefLabel "Mission critical"@en ;
        skos:altLabel "Tier 1"@en ;
        skos:definition "An asset criticality for assets whose loss stops essential services."@en ;
        skos:broader voc:asset-criticality ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-criticality-business-critical a skos:Concept ;
        skos:prefLabel "Business critical"@en ;
        skos:altLabel "Tier 2"@en ;
        skos:definition "An asset criticality for assets whose loss seriously degrades important services."@en ;
        skos:broader voc:asset-criticality ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-criticality-business-supporting a skos:Concept ;
        skos:prefLabel "Business supporting"@en ;
        skos:altLabel "Tier 3"@en ;
        skos:definition "An asset criticality for assets whose loss causes limited disruption."@en ;
        skos:broader voc:asset-criticality ;
        skos:inScheme voc:asset-vocabulary .

    voc:asset-criticality-non-critical a skos:Concept ;
        skos:prefLabel "Non-critical"@en ;
        skos:altLabel "Tier 4"@en ;
        skos:definition "An asset criticality for assets whose loss has negligible operational effect."@en ;
        skos:broader voc:asset-criticality ;
        skos:inScheme voc:asset-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-capability> {
    voc:capability-vocabulary a skos:ConceptScheme ;
        dcterms:title "Capability vocabulary"@en ;
        skos:prefLabel "Capability vocabulary"@en ;
        dcterms:description "Controlled values for capability maturity and strategic importance."@en ;
        dcterms:subject core:Capability ;
        dcterms:source "Capability Maturity Model Integration maturity levels; Business Architecture Guild capability assessment."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:capability-maturity-level ,
            voc:strategic-importance .

    voc:capability-maturity-level a skos:Concept ;
        skos:prefLabel "Capability maturity level"@en ;
        skos:definition "A controlled value set for how well defined and controlled a capability is."@en ;
        skos:topConceptOf voc:capability-vocabulary ;
        skos:narrower voc:maturity-initial , voc:maturity-managed , voc:maturity-defined , voc:maturity-quantitatively-managed , voc:maturity-optimizing ;
        skos:inScheme voc:capability-vocabulary .

    voc:maturity-initial a skos:Concept ;
        skos:prefLabel "Initial"@en ;
        skos:altLabel "Level 1"@en ;
        skos:notation "1" ;
        skos:definition "A capability maturity level in which work is ad hoc and depends on individuals."@en ;
        skos:broader voc:capability-maturity-level ;
        skos:inScheme voc:capability-vocabulary .

    voc:maturity-managed a skos:Concept ;
        skos:prefLabel "Managed"@en ;
        skos:altLabel "Level 2"@en , "Repeatable"@en ;
        skos:notation "2" ;
        skos:definition "A capability maturity level in which work is planned and tracked at the project level."@en ;
        skos:broader voc:capability-maturity-level ;
        skos:inScheme voc:capability-vocabulary .

    voc:maturity-defined a skos:Concept ;
        skos:prefLabel "Defined"@en ;
        skos:altLabel "Level 3"@en ;
        skos:notation "3" ;
        skos:definition "A capability maturity level in which work follows organization-wide standards."@en ;
        skos:broader voc:capability-maturity-level ;
        skos:inScheme voc:capability-vocabulary .

    voc:maturity-quantitatively-managed a skos:Concept ;
        skos:prefLabel "Quantitatively managed"@en ;
        skos:altLabel "Level 4"@en ;
        skos:notation "4" ;
        skos:definition "A capability maturity level in which work is controlled with measures."@en ;
        skos:broader voc:capability-maturity-level ;
        skos:inScheme voc:capability-vocabulary .

    voc:maturity-optimizing a skos:Concept ;
        skos:prefLabel "Optimizing"@en ;
        skos:altLabel "Level 5"@en ;
        skos:notation "5" ;
        skos:definition "A capability maturity level in which work is continuously improved from measures."@en ;
        skos:broader voc:capability-maturity-level ;
        skos:inScheme voc:capability-vocabulary .

    voc:strategic-importance a skos:Concept ;
        skos:prefLabel "Strategic importance"@en ;
        skos:definition "A controlled value set for how much a capability distinguishes the organization."@en ;
        skos:topConceptOf voc:capability-vocabulary ;
        skos:narrower voc:importance-differentiating , voc:importance-essential , voc:importance-commodity ;
        skos:inScheme voc:capability-vocabulary .

    voc:importance-differentiating a skos:Concept ;
        skos:prefLabel "Differentiating"@en ;
        skos:altLabel "Competitive advantage"@en ;
        skos:definition "A strategic importance for capabilities that set the organization apart from competitors."@en ;
        skos:broader voc:strategic-importance ;
        skos:inScheme voc:capability-vocabulary .

    voc:importance-essential a skos:Concept ;
        skos:prefLabel "Essential"@en ;
        skos:altLabel "Core"@en , "Parity"@en ;
        skos:definition "A strategic importance for capabilities that must be done well but do not differentiate."@en ;
        skos:broader voc:strategic-importance ;
        skos:inScheme voc:capability-vocabulary .

    voc:importance-commodity a skos:Concept ;
        skos:prefLabel "Commodity"@en ;
        skos:altLabel "Utility"@en ;
        skos:definition "A strategic importance for capabilities that can be standardized or outsourced."@en ;
        skos:broader voc:strategic-importance ;
        skos:inScheme voc:capability-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-decision> {
    voc:decision-vocabulary a skos:ConceptScheme ;
        dcterms:title "Decision vocabulary"@en ;
        skos:prefLabel "Decision vocabulary"@en ;
        dcterms:description "Controlled values for decision automation level, outcome, confidence, and decision table hit policy."@en ;
        dcterms:subject core:Decision ;
        dcterms:source "Object Management Group Decision Model and Notation; ISO/IEC 42001 human oversight."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:decision-automation-level ,
            voc:decision-outcome ,
            voc:decision-confidence ,
            voc:hit-policy .

    voc:hit-policy-code a rdfs:Datatype ;
        rdfs:label "Hit policy code"@en ;
        skos:definition "A datatype for the single-letter hit policy codes defined by Decision Model and Notation."@en ;
        rdfs:isDefinedBy voc:decision-vocabulary .

    voc:decision-automation-level a skos:Concept ;
        skos:prefLabel "Decision automation level"@en ;
        skos:definition "A controlled value set for the extent of human involvement in a decision."@en ;
        skos:topConceptOf voc:decision-vocabulary ;
        skos:narrower voc:decision-automation-human-decided , voc:decision-automation-human-in-the-loop , voc:decision-automation-human-on-the-loop , voc:decision-automation-fully-automated-decision ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-automation-human-decided a skos:Concept ;
        skos:prefLabel "Human decided"@en ;
        skos:altLabel "Manual decision"@en ;
        skos:definition "A decision automation level in which a person makes the decision with or without information from systems."@en ;
        skos:broader voc:decision-automation-level ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-automation-human-in-the-loop a skos:Concept ;
        skos:prefLabel "Human in the loop"@en ;
        skos:altLabel "Human approval required"@en ;
        skos:definition "A decision automation level in which software recommends and a person must approve before the decision takes effect."@en ;
        skos:broader voc:decision-automation-level ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-automation-human-on-the-loop a skos:Concept ;
        skos:prefLabel "Human on the loop"@en ;
        skos:altLabel "Human oversight"@en ;
        skos:definition "A decision automation level in which software decides and a person monitors and can override."@en ;
        skos:broader voc:decision-automation-level ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-automation-fully-automated-decision a skos:Concept ;
        skos:prefLabel "Fully automated decision"@en ;
        skos:altLabel "Straight-through decision"@en ;
        skos:definition "A decision automation level in which software decides without human review."@en ;
        skos:broader voc:decision-automation-level ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome a skos:Concept ;
        skos:prefLabel "Decision outcome"@en ;
        skos:definition "A controlled value set for the result of an approval or eligibility decision."@en ;
        skos:topConceptOf voc:decision-vocabulary ;
        skos:narrower voc:decision-outcome-approved , voc:decision-outcome-partially-approved , voc:decision-outcome-denied , voc:decision-outcome-deferred , voc:decision-outcome-referred ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome-approved a skos:Concept ;
        skos:prefLabel "Approved"@en ;
        skos:altLabel "Eligible"@en , "Granted"@en ;
        skos:definition "A decision outcome accepting the request in full."@en ;
        skos:broader voc:decision-outcome ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome-partially-approved a skos:Concept ;
        skos:prefLabel "Partially approved"@en ;
        skos:definition "A decision outcome accepting part of the request."@en ;
        skos:broader voc:decision-outcome ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome-denied a skos:Concept ;
        skos:prefLabel "Denied"@en ;
        skos:altLabel "Ineligible"@en , "Rejected"@en ;
        skos:definition "A decision outcome rejecting the request."@en ;
        skos:broader voc:decision-outcome ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome-deferred a skos:Concept ;
        skos:prefLabel "Deferred"@en ;
        skos:altLabel "Pending information"@en ;
        skos:definition "A decision outcome postponing the decision pending information or time."@en ;
        skos:broader voc:decision-outcome ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-outcome-referred a skos:Concept ;
        skos:prefLabel "Referred"@en ;
        skos:altLabel "Escalated"@en ;
        skos:definition "A decision outcome passing the decision to another party or level."@en ;
        skos:broader voc:decision-outcome ;
        skos:inScheme voc:decision-vocabulary .

    voc:decision-confidence a skos:Concept ;
        skos:prefLabel "Decision confidence"@en ;
        skos:definition "A controlled value set for how confident the decision maker or model is in the outcome."@en ;
        skos:topConceptOf voc:decision-vocabulary ;
        skos:narrower voc:confidence-high-confidence , voc:confidence-medium-confidence , voc:confidence-low-confidence ;
        skos:inScheme voc:decision-vocabulary .

    voc:confidence-high-confidence a skos:Concept ;
        skos:prefLabel "High confidence"@en ;
        skos:definition "A decision confidence in which the outcome is well supported by governed facts."@en ;
        skos:broader voc:decision-confidence ;
        skos:inScheme voc:decision-vocabulary .

    voc:confidence-medium-confidence a skos:Concept ;
        skos:prefLabel "Medium confidence"@en ;
        skos:definition "A decision confidence in which the outcome is supported with some gaps."@en ;
        skos:broader voc:decision-confidence ;
        skos:inScheme voc:decision-vocabulary .

    voc:confidence-low-confidence a skos:Concept ;
        skos:prefLabel "Low confidence"@en ;
        skos:definition "A decision confidence in which the outcome is weakly supported and should be reviewed."@en ;
        skos:scopeNote "Low-confidence answers and mappings are routed to human review."@en ;
        skos:broader voc:decision-confidence ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy a skos:Concept ;
        skos:prefLabel "Hit policy"@en ;
        skos:definition "A controlled value set for how a decision table resolves multiple matching rules."@en ;
        skos:topConceptOf voc:decision-vocabulary ;
        skos:narrower voc:hit-policy-unique , voc:hit-policy-first , voc:hit-policy-priority , voc:hit-policy-any , voc:hit-policy-collect , voc:hit-policy-rule-order , voc:hit-policy-output-order ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-unique a skos:Concept ;
        skos:prefLabel "Unique"@en ;
        skos:notation "U"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which at most one rule may match."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-first a skos:Concept ;
        skos:prefLabel "First"@en ;
        skos:notation "F"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which the first matching rule in order is used."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-priority a skos:Concept ;
        skos:prefLabel "Priority"@en ;
        skos:notation "P"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which the matching rule with the highest output priority is used."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-any a skos:Concept ;
        skos:prefLabel "Any"@en ;
        skos:notation "A"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which several rules may match if they give the same output."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-collect a skos:Concept ;
        skos:prefLabel "Collect"@en ;
        skos:notation "C"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which all matching outputs are returned or aggregated."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-rule-order a skos:Concept ;
        skos:prefLabel "Rule order"@en ;
        skos:notation "R"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which all matching outputs are returned in rule order."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .

    voc:hit-policy-output-order a skos:Concept ;
        skos:prefLabel "Output order"@en ;
        skos:notation "O"^^voc:hit-policy-code ;
        skos:definition "A hit policy in which all matching outputs are returned in output priority order."@en ;
        skos:broader voc:hit-policy ;
        skos:inScheme voc:decision-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-event> {
    voc:event-vocabulary a skos:ConceptScheme ;
        dcterms:title "Event vocabulary"@en ;
        skos:prefLabel "Event vocabulary"@en ;
        dcterms:description "Controlled values that describe how events are sourced and processed."@en ;
        dcterms:subject core:Event ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:event-source-type ,
            voc:event-processing-status .

    voc:event-source-type a skos:Concept ;
        skos:prefLabel "Event source type"@en ;
        skos:definition "A controlled value set for what originates an event."@en ;
        skos:topConceptOf voc:event-vocabulary ;
        skos:narrower voc:event-source-system-generated , voc:event-source-user-generated , voc:event-source-scheduled , voc:event-source-external-notification ;
        skos:inScheme voc:event-vocabulary .

    voc:event-source-system-generated a skos:Concept ;
        skos:prefLabel "System generated"@en ;
        skos:altLabel "Machine generated"@en ;
        skos:definition "An event source type for events raised by software."@en ;
        skos:broader voc:event-source-type ;
        skos:inScheme voc:event-vocabulary .

    voc:event-source-user-generated a skos:Concept ;
        skos:prefLabel "User generated"@en ;
        skos:definition "An event source type for events caused by a person's action."@en ;
        skos:broader voc:event-source-type ;
        skos:inScheme voc:event-vocabulary .

    voc:event-source-scheduled a skos:Concept ;
        skos:prefLabel "Scheduled"@en ;
        skos:definition "An event source type for events raised by a schedule or timer."@en ;
        skos:broader voc:event-source-type ;
        skos:inScheme voc:event-vocabulary .

    voc:event-source-external-notification a skos:Concept ;
        skos:prefLabel "External notification"@en ;
        skos:altLabel "Third-party notification"@en ;
        skos:definition "An event source type for events received from an outside party or feed."@en ;
        skos:broader voc:event-source-type ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-status a skos:Concept ;
        skos:prefLabel "Event processing status"@en ;
        skos:definition "A controlled value set for the state of an event in the processing pipeline."@en ;
        skos:topConceptOf voc:event-vocabulary ;
        skos:narrower voc:event-processing-received , voc:event-processing-processed , voc:event-processing-retrying , voc:event-processing-dead-lettered , voc:event-processing-discarded ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-received a skos:Concept ;
        skos:prefLabel "Received"@en ;
        skos:definition "An event processing status in which the event has been accepted but not yet processed."@en ;
        skos:broader voc:event-processing-status ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-processed a skos:Concept ;
        skos:prefLabel "Processed"@en ;
        skos:altLabel "Consumed"@en ;
        skos:definition "An event processing status in which all subscribers have handled the event."@en ;
        skos:broader voc:event-processing-status ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-retrying a skos:Concept ;
        skos:prefLabel "Retrying"@en ;
        skos:definition "An event processing status in which processing failed and is being retried."@en ;
        skos:broader voc:event-processing-status ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-dead-lettered a skos:Concept ;
        skos:prefLabel "Dead-lettered"@en ;
        skos:altLabel "Dead letter"@en ;
        skos:definition "An event processing status in which the event could not be processed after all allowed recovery actions."@en ;
        skos:broader voc:event-processing-status ;
        skos:inScheme voc:event-vocabulary .

    voc:event-processing-discarded a skos:Concept ;
        skos:prefLabel "Discarded"@en ;
        skos:definition "An event processing status in which the event was deliberately ignored as a duplicate or irrelevant."@en ;
        skos:broader voc:event-processing-status ;
        skos:inScheme voc:event-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-governance> {
    voc:governance-vocabulary a skos:ConceptScheme ;
        dcterms:title "Governance vocabulary"@en ;
        skos:prefLabel "Governance vocabulary"@en ;
        dcterms:description "Controlled values for data classification, verification status, approval status, version change level, knowledge change type, validation result, and deployment environment."@en ;
        dcterms:subject core:Governance ;
        skos:scopeNote "Data classification governs access by named graph. Version change levels follow semantic versioning. Change types follow the Knowledge Graph Change Language."@en ;
        dcterms:source "Semantic Governance v1.8 Sections 3.3, 3.4, and 3.6; Knowledge Graph Change Language; Semantic Versioning 2.0.0."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:data-classification ,
            voc:verification-status ,
            voc:approval-status ,
            voc:version-change-level ,
            voc:knowledge-change-type ,
            voc:validation-result ,
            voc:deployment-environment .

    voc:data-classification a skos:Concept ;
        skos:prefLabel "Data classification"@en ;
        skos:altLabel "Information classification"@en ;
        skos:definition "A controlled value set for the sensitivity of information and the handling it requires."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:classification-public , voc:classification-internal , voc:classification-confidential , voc:classification-restricted ;
        skos:inScheme voc:governance-vocabulary .

    voc:classification-public a skos:Concept ;
        skos:prefLabel "Public"@en ;
        skos:definition "A data classification for information approved for release outside the organization."@en ;
        skos:broader voc:data-classification ;
        skos:inScheme voc:governance-vocabulary .

    voc:classification-internal a skos:Concept ;
        skos:prefLabel "Internal"@en ;
        skos:definition "A data classification for information for use within the organization that would cause limited harm if disclosed."@en ;
        skos:broader voc:data-classification ;
        skos:inScheme voc:governance-vocabulary .

    voc:classification-confidential a skos:Concept ;
        skos:prefLabel "Confidential"@en ;
        skos:definition "A data classification for information whose disclosure would cause serious harm to the organization, clients, or workers."@en ;
        skos:scopeNote "Includes contact details and most worker and client data."@en ;
        skos:broader voc:data-classification ;
        skos:inScheme voc:governance-vocabulary .

    voc:classification-restricted a skos:Concept ;
        skos:prefLabel "Restricted"@en ;
        skos:altLabel "Highly confidential"@en ;
        skos:definition "A data classification for the most sensitive information, available only to named roles with a business need."@en ;
        skos:scopeNote "Includes government identifiers, pay, health, and bank details."@en ;
        skos:broader voc:data-classification ;
        skos:inScheme voc:governance-vocabulary .

    voc:verification-status a skos:Concept ;
        skos:prefLabel "Verification status"@en ;
        skos:definition "A controlled value set for whether a reference fact has been checked against a published source."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:verification-verified , voc:verification-unverified , voc:verification-disputed ;
        skos:inScheme voc:governance-vocabulary .

    voc:verification-verified a skos:Concept ;
        skos:prefLabel "Verified"@en ;
        skos:definition "A verification status for facts confirmed against a cited authoritative source."@en ;
        skos:broader voc:verification-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:verification-unverified a skos:Concept ;
        skos:prefLabel "Unverified"@en ;
        skos:altLabel "Not verified"@en ;
        skos:definition "A verification status for facts not yet confirmed, reported as warnings rather than hidden."@en ;
        skos:broader voc:verification-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:verification-disputed a skos:Concept ;
        skos:prefLabel "Disputed"@en ;
        skos:altLabel "Contested"@en ;
        skos:definition "A verification status for facts that conflict with an authoritative source and are under review."@en ;
        skos:broader voc:verification-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:approval-status a skos:Concept ;
        skos:prefLabel "Approval status"@en ;
        skos:definition "A controlled value set for the state of a request awaiting authorization."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:approval-status-pending-approval , voc:approval-status-approved , voc:approval-status-rejected , voc:approval-status-withdrawn ;
        skos:inScheme voc:governance-vocabulary .

    voc:approval-status-pending-approval a skos:Concept ;
        skos:prefLabel "Pending approval"@en ;
        skos:altLabel "Awaiting approval"@en ;
        skos:definition "An approval status for a request submitted and not yet decided."@en ;
        skos:broader voc:approval-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:approval-status-approved a skos:Concept ;
        skos:prefLabel "Approved"@en ;
        skos:definition "An approval status for a request accepted by an authorized party."@en ;
        skos:broader voc:approval-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:approval-status-rejected a skos:Concept ;
        skos:prefLabel "Rejected"@en ;
        skos:altLabel "Declined"@en ;
        skos:definition "An approval status for a request declined by an authorized party."@en ;
        skos:broader voc:approval-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:approval-status-withdrawn a skos:Concept ;
        skos:prefLabel "Withdrawn"@en ;
        skos:definition "An approval status for a request withdrawn by its submitter."@en ;
        skos:broader voc:approval-status ;
        skos:inScheme voc:governance-vocabulary .

    voc:version-change-level a skos:Concept ;
        skos:prefLabel "Version change level"@en ;
        skos:altLabel "Version bump"@en ;
        skos:definition "A controlled value set for the size of a change under semantic versioning."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:version-change-major-change , voc:version-change-minor-change , voc:version-change-patch-change ;
        skos:inScheme voc:governance-vocabulary .

    voc:version-change-major-change a skos:Concept ;
        skos:prefLabel "Major change"@en ;
        skos:altLabel "MAJOR"@en , "Major"@en ;
        skos:definition "A version change level for changes that break consumers, such as removing or redefining a class or property."@en ;
        skos:broader voc:version-change-level ;
        skos:inScheme voc:governance-vocabulary .

    voc:version-change-minor-change a skos:Concept ;
        skos:prefLabel "Minor change"@en ;
        skos:altLabel "MINOR"@en , "Minor"@en ;
        skos:definition "A version change level for backward-compatible additions."@en ;
        skos:broader voc:version-change-level ;
        skos:inScheme voc:governance-vocabulary .

    voc:version-change-patch-change a skos:Concept ;
        skos:prefLabel "Patch change"@en ;
        skos:altLabel "PATCH"@en , "Patch"@en ;
        skos:definition "A version change level for label and documentation fixes."@en ;
        skos:broader voc:version-change-level ;
        skos:inScheme voc:governance-vocabulary .

    voc:knowledge-change-type a skos:Concept ;
        skos:prefLabel "Knowledge change type"@en ;
        skos:altLabel "KGCL change type"@en ;
        skos:definition "A controlled value set for the kind of change made to a knowledge artifact."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:change-type-node-creation , voc:change-type-node-rename , voc:change-type-node-move , voc:change-type-node-deprecation , voc:change-type-definition-change , voc:change-type-synonym-change , voc:change-type-edge-creation , voc:change-type-edge-deletion , voc:change-type-mapping-change ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-node-creation a skos:Concept ;
        skos:prefLabel "Node creation"@en ;
        skos:altLabel "Create node"@en ;
        skos:definition "A knowledge change type that adds a class, concept, or property."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-node-rename a skos:Concept ;
        skos:prefLabel "Node rename"@en ;
        skos:altLabel "Rename"@en ;
        skos:definition "A knowledge change type that changes a preferred label."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-node-move a skos:Concept ;
        skos:prefLabel "Node move"@en ;
        skos:altLabel "Reparent"@en ;
        skos:definition "A knowledge change type that changes the parent of a class or concept."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-node-deprecation a skos:Concept ;
        skos:prefLabel "Node deprecation"@en ;
        skos:altLabel "Obsoletion"@en ;
        skos:definition "A knowledge change type that marks a term deprecated and names its replacement."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-definition-change a skos:Concept ;
        skos:prefLabel "Definition change"@en ;
        skos:altLabel "New text definition"@en ;
        skos:definition "A knowledge change type that changes a definition."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-synonym-change a skos:Concept ;
        skos:prefLabel "Synonym change"@en ;
        skos:altLabel "Synonym addition"@en ;
        skos:definition "A knowledge change type that adds or removes an alternate label."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-edge-creation a skos:Concept ;
        skos:prefLabel "Edge creation"@en ;
        skos:altLabel "Add edge"@en ;
        skos:definition "A knowledge change type that adds a relationship between terms."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-edge-deletion a skos:Concept ;
        skos:prefLabel "Edge deletion"@en ;
        skos:altLabel "Remove edge"@en ;
        skos:definition "A knowledge change type that removes a relationship between terms."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:change-type-mapping-change a skos:Concept ;
        skos:prefLabel "Mapping change"@en ;
        skos:definition "A knowledge change type that adds, changes, or removes a mapping."@en ;
        skos:broader voc:knowledge-change-type ;
        skos:inScheme voc:governance-vocabulary .

    voc:validation-result a skos:Concept ;
        skos:prefLabel "Validation result"@en ;
        skos:definition "A controlled value set for the outcome of a quality gate or check."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:validation-result-passed , voc:validation-result-passed-with-warnings , voc:validation-result-failed ;
        skos:inScheme voc:governance-vocabulary .

    voc:validation-result-passed a skos:Concept ;
        skos:prefLabel "Passed"@en ;
        skos:definition "A validation result in which all checks succeeded."@en ;
        skos:broader voc:validation-result ;
        skos:inScheme voc:governance-vocabulary .

    voc:validation-result-passed-with-warnings a skos:Concept ;
        skos:prefLabel "Passed with warnings"@en ;
        skos:definition "A validation result in which checks succeeded but warnings were raised."@en ;
        skos:broader voc:validation-result ;
        skos:inScheme voc:governance-vocabulary .

    voc:validation-result-failed a skos:Concept ;
        skos:prefLabel "Failed"@en ;
        skos:definition "A validation result in which at least one blocking check did not succeed."@en ;
        skos:broader voc:validation-result ;
        skos:inScheme voc:governance-vocabulary .

    voc:deployment-environment a skos:Concept ;
        skos:prefLabel "Deployment environment"@en ;
        skos:definition "A controlled value set for the environments a release is promoted through."@en ;
        skos:topConceptOf voc:governance-vocabulary ;
        skos:narrower voc:environment-development , voc:environment-test , voc:environment-stage , voc:environment-production ;
        skos:inScheme voc:governance-vocabulary .

    voc:environment-development a skos:Concept ;
        skos:prefLabel "Development"@en ;
        skos:altLabel "Dev"@en ;
        skos:definition "A deployment environment for building and unit testing."@en ;
        skos:broader voc:deployment-environment ;
        skos:inScheme voc:governance-vocabulary .

    voc:environment-test a skos:Concept ;
        skos:prefLabel "Test"@en ;
        skos:altLabel "Quality assurance environment"@en ;
        skos:definition "A deployment environment for integration and competency question testing."@en ;
        skos:broader voc:deployment-environment ;
        skos:inScheme voc:governance-vocabulary .

    voc:environment-stage a skos:Concept ;
        skos:prefLabel "Stage"@en ;
        skos:altLabel "Staging"@en , "Pre-production"@en ;
        skos:definition "A deployment environment that mirrors production for final validation."@en ;
        skos:broader voc:deployment-environment ;
        skos:inScheme voc:governance-vocabulary .

    voc:environment-production a skos:Concept ;
        skos:prefLabel "Production"@en ;
        skos:altLabel "Prod"@en , "Live"@en ;
        skos:definition "A deployment environment that serves real users."@en ;
        skos:broader voc:deployment-environment ;
        skos:inScheme voc:governance-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-issue> {
    voc:issue-vocabulary a skos:ConceptScheme ;
        dcterms:title "Issue vocabulary"@en ;
        skos:prefLabel "Issue vocabulary"@en ;
        dcterms:description "Controlled values that describe the severity, priority, status, resolution, and root cause of issues."@en ;
        dcterms:subject core:Issue ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:issue-severity ,
            voc:issue-priority ,
            voc:issue-status ,
            voc:resolution-type ,
            voc:root-cause-category .

    voc:issue-severity a skos:Concept ;
        skos:prefLabel "Issue severity"@en ;
        skos:definition "A controlled value set for the magnitude of an issue's impact."@en ;
        skos:topConceptOf voc:issue-vocabulary ;
        skos:narrower voc:severity-critical , voc:severity-high , voc:severity-medium , voc:severity-low ;
        skos:inScheme voc:issue-vocabulary .

    voc:severity-critical a skos:Concept ;
        skos:prefLabel "Critical severity"@en ;
        skos:altLabel "Severity 1"@en , "Sev 1"@en ;
        skos:definition "An issue severity for issues that stop an essential service or cause serious harm or legal exposure."@en ;
        skos:broader voc:issue-severity ;
        skos:inScheme voc:issue-vocabulary .

    voc:severity-high a skos:Concept ;
        skos:prefLabel "High severity"@en ;
        skos:altLabel "Severity 2"@en , "Major"@en ;
        skos:definition "An issue severity for issues that seriously degrade a service or affect many users."@en ;
        skos:broader voc:issue-severity ;
        skos:inScheme voc:issue-vocabulary .

    voc:severity-medium a skos:Concept ;
        skos:prefLabel "Medium severity"@en ;
        skos:altLabel "Severity 3"@en , "Moderate"@en ;
        skos:definition "An issue severity for issues with limited impact and an available workaround."@en ;
        skos:broader voc:issue-severity ;
        skos:inScheme voc:issue-vocabulary .

    voc:severity-low a skos:Concept ;
        skos:prefLabel "Low severity"@en ;
        skos:altLabel "Severity 4"@en , "Minor"@en ;
        skos:definition "An issue severity for issues with minor or cosmetic impact."@en ;
        skos:broader voc:issue-severity ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-priority a skos:Concept ;
        skos:prefLabel "Issue priority"@en ;
        skos:definition "A controlled value set for the order in which issues are worked."@en ;
        skos:topConceptOf voc:issue-vocabulary ;
        skos:narrower voc:priority-urgent , voc:priority-high , voc:priority-normal , voc:priority-low ;
        skos:inScheme voc:issue-vocabulary .

    voc:priority-urgent a skos:Concept ;
        skos:prefLabel "Urgent priority"@en ;
        skos:altLabel "Priority 1"@en , "P1"@en ;
        skos:definition "An issue priority for issues to be worked immediately."@en ;
        skos:broader voc:issue-priority ;
        skos:inScheme voc:issue-vocabulary .

    voc:priority-high a skos:Concept ;
        skos:prefLabel "High priority"@en ;
        skos:altLabel "Priority 2"@en , "P2"@en ;
        skos:definition "An issue priority for issues to be worked before normal work."@en ;
        skos:broader voc:issue-priority ;
        skos:inScheme voc:issue-vocabulary .

    voc:priority-normal a skos:Concept ;
        skos:prefLabel "Normal priority"@en ;
        skos:altLabel "Priority 3"@en , "P3"@en , "Medium"@en ;
        skos:definition "An issue priority for issues worked in standard order."@en ;
        skos:broader voc:issue-priority ;
        skos:inScheme voc:issue-vocabulary .

    voc:priority-low a skos:Concept ;
        skos:prefLabel "Low priority"@en ;
        skos:altLabel "Priority 4"@en , "P4"@en ;
        skos:definition "An issue priority for issues worked when capacity allows."@en ;
        skos:broader voc:issue-priority ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status a skos:Concept ;
        skos:prefLabel "Issue status"@en ;
        skos:definition "A controlled value set for where an issue stands in its lifecycle."@en ;
        skos:topConceptOf voc:issue-vocabulary ;
        skos:narrower voc:issue-status-open , voc:issue-status-triaged , voc:issue-status-in-progress , voc:issue-status-on-hold , voc:issue-status-resolved , voc:issue-status-closed , voc:issue-status-reopened ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-open a skos:Concept ;
        skos:prefLabel "Open"@en ;
        skos:altLabel "New"@en ;
        skos:definition "An issue status for a reported issue not yet assessed."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-triaged a skos:Concept ;
        skos:prefLabel "Triaged"@en ;
        skos:altLabel "Assigned"@en , "Acknowledged"@en ;
        skos:definition "An issue status for an issue assessed and assigned."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-in-progress a skos:Concept ;
        skos:prefLabel "In progress"@en ;
        skos:altLabel "Active"@en ;
        skos:definition "An issue status for an issue being worked on."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-on-hold a skos:Concept ;
        skos:prefLabel "On hold"@en ;
        skos:altLabel "Pending"@en , "Waiting"@en ;
        skos:definition "An issue status for an issue paused while waiting on a party or event."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-resolved a skos:Concept ;
        skos:prefLabel "Resolved"@en ;
        skos:definition "An issue status for an issue whose fix or workaround is in place pending confirmation."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-closed a skos:Concept ;
        skos:prefLabel "Closed"@en ;
        skos:definition "An issue status for an issue confirmed resolved or otherwise ended."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:issue-status-reopened a skos:Concept ;
        skos:prefLabel "Reopened"@en ;
        skos:definition "An issue status for a closed issue that has recurred or was not fixed."@en ;
        skos:broader voc:issue-status ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-type a skos:Concept ;
        skos:prefLabel "Resolution type"@en ;
        skos:definition "A controlled value set for how an issue ended."@en ;
        skos:topConceptOf voc:issue-vocabulary ;
        skos:narrower voc:resolution-fixed , voc:resolution-workaround-provided , voc:resolution-duplicate , voc:resolution-not-reproducible , voc:resolution-working-as-designed , voc:resolution-will-not-fix ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-fixed a skos:Concept ;
        skos:prefLabel "Fixed"@en ;
        skos:altLabel "Corrected"@en ;
        skos:definition "A resolution type in which the cause was corrected."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-workaround-provided a skos:Concept ;
        skos:prefLabel "Workaround provided"@en ;
        skos:altLabel "Workaround"@en ;
        skos:definition "A resolution type in which the effect was avoided without removing the cause."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-duplicate a skos:Concept ;
        skos:prefLabel "Duplicate"@en ;
        skos:definition "A resolution type in which the issue was already reported."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-not-reproducible a skos:Concept ;
        skos:prefLabel "Not reproducible"@en ;
        skos:altLabel "Cannot reproduce"@en ;
        skos:definition "A resolution type in which the issue could not be observed again."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-working-as-designed a skos:Concept ;
        skos:prefLabel "Working as designed"@en ;
        skos:altLabel "By design"@en ;
        skos:definition "A resolution type in which the behavior was found to be intended."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:resolution-will-not-fix a skos:Concept ;
        skos:prefLabel "Will not fix"@en ;
        skos:altLabel "Won't fix"@en , "Accepted risk"@en ;
        skos:definition "A resolution type in which a decision was made not to correct the issue."@en ;
        skos:broader voc:resolution-type ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-category a skos:Concept ;
        skos:prefLabel "Root cause category"@en ;
        skos:definition "A controlled value set for the kind of underlying cause of an issue."@en ;
        skos:topConceptOf voc:issue-vocabulary ;
        skos:narrower voc:root-cause-people , voc:root-cause-process , voc:root-cause-technology , voc:root-cause-data , voc:root-cause-knowledge , voc:root-cause-external ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-people a skos:Concept ;
        skos:prefLabel "People"@en ;
        skos:altLabel "Human error"@en ;
        skos:definition "A root cause category for causes in skills, staffing, or human error."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-process a skos:Concept ;
        skos:prefLabel "Process"@en ;
        skos:definition "A root cause category for causes in process design or execution."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-technology a skos:Concept ;
        skos:prefLabel "Technology"@en ;
        skos:altLabel "System"@en ;
        skos:definition "A root cause category for causes in software, hardware, or infrastructure."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-data a skos:Concept ;
        skos:prefLabel "Data"@en ;
        skos:definition "A root cause category for causes in data quality or availability."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-knowledge a skos:Concept ;
        skos:prefLabel "Knowledge"@en ;
        skos:altLabel "Semantic"@en ;
        skos:definition "A root cause category for causes in definitions, mappings, rules, or other governed knowledge."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .

    voc:root-cause-external a skos:Concept ;
        skos:prefLabel "External"@en ;
        skos:altLabel "Third party"@en ;
        skos:definition "A root cause category for causes outside the organization's control."@en ;
        skos:broader voc:root-cause-category ;
        skos:inScheme voc:issue-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-lifecycle> {
    voc:lifecycle-vocabulary a skos:ConceptScheme ;
        dcterms:title "Lifecycle vocabulary"@en ;
        skos:prefLabel "Lifecycle vocabulary"@en ;
        dcterms:description "Controlled values for the status of governed artifacts and the stages of the Semantic Knowledge Lifecycle and the ten-stage knowledge governance lifecycle."@en ;
        dcterms:subject core:Lifecycle ;
        skos:scopeNote "Lifecycle status is the value of core:hasLifecycleStatus on every governed artifact. Released versions are immutable; terms are deprecated rather than deleted."@en ;
        dcterms:source "Semantic Governance v1.8 Sections 2.4, 3.3, and 3.4."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:lifecycle-status ,
            voc:semantic-knowledge-lifecycle-stage ,
            voc:knowledge-governance-stage ,
            voc:generic-lifecycle-phase .

    voc:lifecycle-status a skos:Concept ;
        skos:prefLabel "Lifecycle status"@en ;
        skos:definition "A controlled value set for the governance state of a knowledge artifact or term."@en ;
        skos:topConceptOf voc:lifecycle-vocabulary ;
        skos:narrower voc:lifecycle-status-draft , voc:lifecycle-status-candidate , voc:lifecycle-status-released , voc:lifecycle-status-deprecated , voc:lifecycle-status-retired ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-status-draft a skos:Concept ;
        skos:prefLabel "Draft"@en ;
        skos:definition "A lifecycle status in which an artifact is being authored and required fields may be incomplete."@en ;
        skos:broader voc:lifecycle-status ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-status-candidate a skos:Concept ;
        skos:prefLabel "Candidate"@en ;
        skos:definition "A lifecycle status in which an artifact has complete required fields and is under review for release."@en ;
        skos:broader voc:lifecycle-status ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-status-released a skos:Concept ;
        skos:prefLabel "Released"@en ;
        skos:altLabel "Published"@en ;
        skos:definition "A lifecycle status in which an artifact is approved, versioned, published, and immutable."@en ;
        skos:broader voc:lifecycle-status ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-status-deprecated a skos:Concept ;
        skos:prefLabel "Deprecated"@en ;
        skos:definition "A lifecycle status in which an artifact remains available but is replaced and carries a sunset date."@en ;
        skos:broader voc:lifecycle-status ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-status-retired a skos:Concept ;
        skos:prefLabel "Retired"@en ;
        skos:altLabel "Archived"@en ;
        skos:definition "A lifecycle status in which an artifact is withdrawn from use and kept only for history."@en ;
        skos:broader voc:lifecycle-status ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-lifecycle-stage a skos:Concept ;
        skos:prefLabel "Semantic knowledge lifecycle stage"@en ;
        skos:altLabel "SKL stage"@en ;
        skos:definition "A controlled value set for the six stages of the Semantic Knowledge Lifecycle."@en ;
        skos:topConceptOf voc:lifecycle-vocabulary ;
        skos:narrower voc:semantic-knowledge-stage-ideation , voc:semantic-knowledge-stage-development , voc:semantic-knowledge-stage-testing , voc:semantic-knowledge-stage-deployment , voc:semantic-knowledge-stage-maintenance , voc:semantic-knowledge-stage-retirement ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-ideation a skos:Concept ;
        skos:prefLabel "Ideation"@en ;
        skos:notation "1" ;
        skos:definition "A semantic knowledge lifecycle stage in which scope, competency questions, and sources are agreed; covers governance stages one and two."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-development a skos:Concept ;
        skos:prefLabel "Development"@en ;
        skos:notation "2" ;
        skos:definition "A semantic knowledge lifecycle stage in which terms are defined, concepts organized, and the ontology formalized; covers governance stages three to five."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-testing a skos:Concept ;
        skos:prefLabel "Testing"@en ;
        skos:notation "3" ;
        skos:definition "A semantic knowledge lifecycle stage in which artifacts are validated; covers governance stage six."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-deployment a skos:Concept ;
        skos:prefLabel "Deployment"@en ;
        skos:notation "4" ;
        skos:definition "A semantic knowledge lifecycle stage in which artifacts are registered, published, and deployed; covers governance stages seven and eight."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-maintenance a skos:Concept ;
        skos:prefLabel "Maintenance"@en ;
        skos:notation "5" ;
        skos:definition "A semantic knowledge lifecycle stage in which artifacts are operated, protected, and measured; covers governance stage nine."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:semantic-knowledge-stage-retirement a skos:Concept ;
        skos:prefLabel "Retirement"@en ;
        skos:notation "6" ;
        skos:definition "A semantic knowledge lifecycle stage in which artifacts are changed, versioned, and retired; covers governance stage ten."@en ;
        skos:broader voc:semantic-knowledge-lifecycle-stage ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:knowledge-governance-stage a skos:Concept ;
        skos:prefLabel "Knowledge governance stage"@en ;
        skos:definition "A controlled value set for the ten stages of the knowledge governance lifecycle."@en ;
        skos:topConceptOf voc:lifecycle-vocabulary ;
        skos:narrower voc:governance-stage-scope-and-competency-questions , voc:governance-stage-acquire-knowledge-and-provenance , voc:governance-stage-define-terms , voc:governance-stage-organize-concepts , voc:governance-stage-formalize-the-ontology , voc:governance-stage-validate , voc:governance-stage-register-and-publish , voc:governance-stage-deploy-as-persistent-or-virtual-graphs , voc:governance-stage-operate-protect-and-measure , voc:governance-stage-change-version-and-retire ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-scope-and-competency-questions a skos:Concept ;
        skos:prefLabel "Scope and competency questions"@en ;
        skos:notation "1" ;
        skos:definition "A knowledge governance stage that agrees what the knowledge must answer, for whom, and who owns it."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-ideation ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-acquire-knowledge-and-provenance a skos:Concept ;
        skos:prefLabel "Acquire knowledge and provenance"@en ;
        skos:notation "2" ;
        skos:definition "A knowledge governance stage that collects authoritative sources and records where each fact came from."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-ideation ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-define-terms a skos:Concept ;
        skos:prefLabel "Define terms"@en ;
        skos:notation "3" ;
        skos:definition "A knowledge governance stage that sets preferred terms, intensional definitions, and term metadata."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-development ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-organize-concepts a skos:Concept ;
        skos:prefLabel "Organize concepts"@en ;
        skos:notation "4" ;
        skos:definition "A knowledge governance stage that builds hierarchies, associative relations, and mappings to external vocabularies."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-development ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-formalize-the-ontology a skos:Concept ;
        skos:prefLabel "Formalize the ontology"@en ;
        skos:notation "5" ;
        skos:definition "A knowledge governance stage that defines classes, relations, and axioms aligned to a top-level ontology."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-development ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-validate a skos:Concept ;
        skos:prefLabel "Validate"@en ;
        skos:notation "6" ;
        skos:definition "A knowledge governance stage that checks reasoner consistency, data quality, and expert and legal review."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-testing ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-register-and-publish a skos:Concept ;
        skos:prefLabel "Register and publish"@en ;
        skos:notation "7" ;
        skos:definition "A knowledge governance stage that records each artifact, version, and status in a metadata registry."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-deployment ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-deploy-as-persistent-or-virtual-graphs a skos:Concept ;
        skos:prefLabel "Deploy as persistent or virtual graphs"@en ;
        skos:notation "8" ;
        skos:definition "A knowledge governance stage that loads artifacts into a store or exposes databases as a graph."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-deployment ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-operate-protect-and-measure a skos:Concept ;
        skos:prefLabel "Operate, protect and measure"@en ;
        skos:notation "9" ;
        skos:definition "A knowledge governance stage that applies access control, impact assessment, quality monitoring, and reporting."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-maintenance ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:governance-stage-change-version-and-retire a skos:Concept ;
        skos:prefLabel "Change, version and retire"@en ;
        skos:notation "10" ;
        skos:definition "A knowledge governance stage that tracks changes, issues versions, deprecates rather than deletes, and retains history."@en ;
        skos:broader voc:knowledge-governance-stage ;
        skos:broadMatch voc:semantic-knowledge-stage-retirement ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:generic-lifecycle-phase a skos:Concept ;
        skos:prefLabel "Generic lifecycle phase"@en ;
        skos:definition "A controlled value set for stages shared by most asset, product, and service lifecycles."@en ;
        skos:topConceptOf voc:lifecycle-vocabulary ;
        skos:narrower voc:lifecycle-phase-plan , voc:lifecycle-phase-acquire-or-build , voc:lifecycle-phase-introduce , voc:lifecycle-phase-operate , voc:lifecycle-phase-improve , voc:lifecycle-phase-retire ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-plan a skos:Concept ;
        skos:prefLabel "Plan"@en ;
        skos:altLabel "Concept"@en , "Strategy"@en ;
        skos:definition "A generic lifecycle phase in which need, scope, and resources are defined."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-acquire-or-build a skos:Concept ;
        skos:prefLabel "Acquire or build"@en ;
        skos:altLabel "Design and build"@en , "Acquire"@en ;
        skos:definition "A generic lifecycle phase in which the thing is designed, built, or obtained."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-introduce a skos:Concept ;
        skos:prefLabel "Introduce"@en ;
        skos:altLabel "Launch"@en , "Transition"@en ;
        skos:definition "A generic lifecycle phase in which the thing is deployed or launched."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-operate a skos:Concept ;
        skos:prefLabel "Operate"@en ;
        skos:altLabel "Run"@en , "Use"@en ;
        skos:definition "A generic lifecycle phase in which the thing is used and supported."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-improve a skos:Concept ;
        skos:prefLabel "Improve"@en ;
        skos:altLabel "Enhance"@en , "Change"@en ;
        skos:definition "A generic lifecycle phase in which the thing is changed or enhanced."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .

    voc:lifecycle-phase-retire a skos:Concept ;
        skos:prefLabel "Retire"@en ;
        skos:altLabel "Dispose"@en , "Sunset"@en ;
        skos:definition "A generic lifecycle phase in which the thing is withdrawn and disposed of."@en ;
        skos:broader voc:generic-lifecycle-phase ;
        skos:inScheme voc:lifecycle-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-location> {
    voc:location-vocabulary a skos:ConceptScheme ;
        dcterms:title "Location vocabulary"@en ;
        skos:prefLabel "Location vocabulary"@en ;
        dcterms:description "Controlled values for the United States jurisdictions where worksite clients operate, work arrangements, and address types."@en ;
        dcterms:subject core:Location ;
        skos:scopeNote "Jurisdictions carry ISO 3166 codes in skos:notation. The federal and state jurisdictions are siblings under one value set, because skos:broader is used only for classification; the legal containment of a state within the United States is modeled in the ontology with located in."@en ;
        dcterms:source "ISO 3166-1 and ISO 3166-2 codes; LKIF-Core jurisdiction."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:jurisdiction ,
            voc:work-arrangement ,
            voc:address-type .

    voc:country-code a rdfs:Datatype ;
        rdfs:label "Country code"@en ;
        skos:definition "A datatype for two-letter country codes defined by ISO 3166-1."@en ;
        rdfs:isDefinedBy voc:location-vocabulary .

    voc:country-subdivision-code a rdfs:Datatype ;
        rdfs:label "Country subdivision code"@en ;
        skos:definition "A datatype for country subdivision codes defined by ISO 3166-2."@en ;
        rdfs:isDefinedBy voc:location-vocabulary .

    voc:jurisdiction a skos:Concept ;
        skos:prefLabel "United States jurisdiction"@en ;
        skos:definition "A controlled value set for the federal, state, and District of Columbia jurisdictions whose laws apply to worksite clients."@en ;
        skos:topConceptOf voc:location-vocabulary ;
        skos:narrower voc:jurisdiction-united-states-federal , voc:jurisdiction-alabama , voc:jurisdiction-alaska , voc:jurisdiction-arizona , voc:jurisdiction-arkansas , voc:jurisdiction-california , voc:jurisdiction-colorado , voc:jurisdiction-connecticut , voc:jurisdiction-delaware , voc:jurisdiction-district-of-columbia , voc:jurisdiction-florida , voc:jurisdiction-georgia , voc:jurisdiction-hawaii , voc:jurisdiction-idaho , voc:jurisdiction-illinois , voc:jurisdiction-indiana , voc:jurisdiction-iowa , voc:jurisdiction-kansas , voc:jurisdiction-kentucky , voc:jurisdiction-louisiana , voc:jurisdiction-maine , voc:jurisdiction-maryland , voc:jurisdiction-massachusetts , voc:jurisdiction-michigan , voc:jurisdiction-minnesota , voc:jurisdiction-mississippi , voc:jurisdiction-missouri , voc:jurisdiction-montana , voc:jurisdiction-nebraska , voc:jurisdiction-nevada , voc:jurisdiction-new-hampshire , voc:jurisdiction-new-jersey , voc:jurisdiction-new-mexico , voc:jurisdiction-new-york , voc:jurisdiction-north-carolina , voc:jurisdiction-north-dakota , voc:jurisdiction-ohio , voc:jurisdiction-oklahoma , voc:jurisdiction-oregon , voc:jurisdiction-pennsylvania , voc:jurisdiction-rhode-island , voc:jurisdiction-south-carolina , voc:jurisdiction-south-dakota , voc:jurisdiction-tennessee , voc:jurisdiction-texas , voc:jurisdiction-utah , voc:jurisdiction-vermont , voc:jurisdiction-virginia , voc:jurisdiction-washington , voc:jurisdiction-west-virginia , voc:jurisdiction-wisconsin , voc:jurisdiction-wyoming ;
        skos:inScheme voc:location-vocabulary .

    voc:jurisdiction-united-states-federal a skos:Concept ;
        skos:prefLabel "United States federal jurisdiction"@en ;
        skos:altLabel "Federal"@en , "United States"@en , "US"@en ;
        skos:notation "US"^^voc:country-code ;
        skos:definition "A national jurisdiction in which United States federal law and federal agencies apply."@en ;
        skos:broader voc:jurisdiction ;
        skos:broadMatch tax:NationalJurisdiction ;
        skos:inScheme voc:location-vocabulary .

    voc:jurisdiction-alabama a skos:Concept ;
        skos:prefLabel "Alabama"@en ;
