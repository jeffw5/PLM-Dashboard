        skos:broader voc:jurisdiction ;
        skos:broadMatch tax:StateJurisdiction ;
        skos:inScheme voc:location-vocabulary .

    voc:jurisdiction-wisconsin a skos:Concept ;
        skos:prefLabel "Wisconsin"@en ;
        skos:altLabel "WI"@en ;
        skos:notation "US-WI"^^voc:country-subdivision-code ;
        skos:definition "A state jurisdiction comprising the state of Wisconsin and the state and local laws, regulations, and agencies that apply there."@en ;
        skos:broader voc:jurisdiction ;
        skos:broadMatch tax:StateJurisdiction ;
        skos:inScheme voc:location-vocabulary .

    voc:jurisdiction-wyoming a skos:Concept ;
        skos:prefLabel "Wyoming"@en ;
        skos:altLabel "WY"@en ;
        skos:notation "US-WY"^^voc:country-subdivision-code ;
        skos:definition "A state jurisdiction comprising the state of Wyoming and the state and local laws, regulations, and agencies that apply there."@en ;
        skos:broader voc:jurisdiction ;
        skos:broadMatch tax:StateJurisdiction ;
        skos:inScheme voc:location-vocabulary .

    voc:work-arrangement a skos:Concept ;
        skos:prefLabel "Work arrangement"@en ;
        skos:definition "A controlled value set for where a worker regularly performs work."@en ;
        skos:topConceptOf voc:location-vocabulary ;
        skos:narrower voc:work-arrangement-onsite , voc:work-arrangement-remote , voc:work-arrangement-hybrid ;
        skos:inScheme voc:location-vocabulary .

    voc:work-arrangement-onsite a skos:Concept ;
        skos:prefLabel "Onsite"@en ;
        skos:altLabel "In office"@en , "On premises"@en ;
        skos:definition "A work arrangement in which the worker works at an employer or client site."@en ;
        skos:broader voc:work-arrangement ;
        skos:inScheme voc:location-vocabulary .

    voc:work-arrangement-remote a skos:Concept ;
        skos:prefLabel "Remote"@en ;
        skos:altLabel "Telework"@en , "Work from home"@en ;
        skos:definition "A work arrangement in which the worker works away from employer and client sites."@en ;
        skos:broader voc:work-arrangement ;
        skos:inScheme voc:location-vocabulary .

    voc:work-arrangement-hybrid a skos:Concept ;
        skos:prefLabel "Hybrid"@en ;
        skos:definition "A work arrangement in which the worker splits time between onsite and remote work."@en ;
        skos:broader voc:work-arrangement ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type a skos:Concept ;
        skos:prefLabel "Address type"@en ;
        skos:definition "A controlled value set for the purpose of a postal address."@en ;
        skos:topConceptOf voc:location-vocabulary ;
        skos:narrower voc:address-type-physical-address , voc:address-type-mailing-address , voc:address-type-worksite-address , voc:address-type-billing-address , voc:address-type-registered-address ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type-physical-address a skos:Concept ;
        skos:prefLabel "Physical address"@en ;
        skos:altLabel "Street address"@en , "Residence address"@en ;
        skos:definition "An address type for where a party or site is located."@en ;
        skos:broader voc:address-type ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type-mailing-address a skos:Concept ;
        skos:prefLabel "Mailing address"@en ;
        skos:definition "An address type for where correspondence is delivered."@en ;
        skos:broader voc:address-type ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type-worksite-address a skos:Concept ;
        skos:prefLabel "Worksite address"@en ;
        skos:altLabel "Work location address"@en ;
        skos:definition "An address type for where workers perform work for a client."@en ;
        skos:broader voc:address-type ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type-billing-address a skos:Concept ;
        skos:prefLabel "Billing address"@en ;
        skos:definition "An address type for where invoices are sent."@en ;
        skos:broader voc:address-type ;
        skos:inScheme voc:location-vocabulary .

    voc:address-type-registered-address a skos:Concept ;
        skos:prefLabel "Registered address"@en ;
        skos:altLabel "Registered office"@en ;
        skos:definition "An address type for a legal entity's official registered office."@en ;
        skos:broader voc:address-type ;
        skos:inScheme voc:location-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-logic> {
    voc:logic-vocabulary a skos:ConceptScheme ;
        dcterms:title "Logic vocabulary"@en ;
        skos:prefLabel "Logic vocabulary"@en ;
        dcterms:description "Controlled values for logical operators, comparison operators, and truth values used in rules, conditions, and queries."@en ;
        dcterms:subject core:Logic ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:logical-operator ,
            voc:comparison-operator ,
            voc:truth-value .

    voc:logical-operator a skos:Concept ;
        skos:prefLabel "Logical operator"@en ;
        skos:definition "A controlled value set for operators that combine conditions."@en ;
        skos:topConceptOf voc:logic-vocabulary ;
        skos:narrower voc:logical-operator-conjunction , voc:logical-operator-disjunction , voc:logical-operator-negation , voc:logical-operator-exclusive-disjunction , voc:logical-operator-implication ;
        skos:inScheme voc:logic-vocabulary .

    voc:logical-operator-conjunction a skos:Concept ;
        skos:prefLabel "Conjunction"@en ;
        skos:altLabel "AND"@en , "And"@en ;
        skos:definition "A logical operator that is true when all operands are true."@en ;
        skos:broader voc:logical-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:logical-operator-disjunction a skos:Concept ;
        skos:prefLabel "Disjunction"@en ;
        skos:altLabel "OR"@en , "Or"@en ;
        skos:definition "A logical operator that is true when at least one operand is true."@en ;
        skos:broader voc:logical-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:logical-operator-negation a skos:Concept ;
        skos:prefLabel "Negation"@en ;
        skos:altLabel "NOT"@en , "Not"@en ;
        skos:definition "A logical operator that reverses the truth of its operand."@en ;
        skos:broader voc:logical-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:logical-operator-exclusive-disjunction a skos:Concept ;
        skos:prefLabel "Exclusive disjunction"@en ;
        skos:altLabel "XOR"@en , "Exclusive or"@en ;
        skos:definition "A logical operator that is true when exactly one of two operands is true."@en ;
        skos:broader voc:logical-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:logical-operator-implication a skos:Concept ;
        skos:prefLabel "Implication"@en ;
        skos:altLabel "If then"@en , "Implies"@en ;
        skos:definition "A logical operator that is false only when its antecedent is true and its consequent false."@en ;
        skos:broader voc:logical-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-operator a skos:Concept ;
        skos:prefLabel "Comparison operator"@en ;
        skos:definition "A controlled value set for operators that compare two values."@en ;
        skos:topConceptOf voc:logic-vocabulary ;
        skos:narrower voc:comparison-equal-to , voc:comparison-not-equal-to , voc:comparison-greater-than , voc:comparison-greater-than-or-equal-to , voc:comparison-less-than , voc:comparison-less-than-or-equal-to , voc:comparison-between , voc:comparison-in-set ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-equal-to a skos:Concept ;
        skos:prefLabel "Equal to"@en ;
        skos:altLabel "Equals"@en ;
        skos:definition "A comparison operator that is true when values are the same."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-not-equal-to a skos:Concept ;
        skos:prefLabel "Not equal to"@en ;
        skos:definition "A comparison operator that is true when values differ."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-greater-than a skos:Concept ;
        skos:prefLabel "Greater than"@en ;
        skos:definition "A comparison operator that is true when the first value exceeds the second."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-greater-than-or-equal-to a skos:Concept ;
        skos:prefLabel "Greater than or equal to"@en ;
        skos:altLabel "At least"@en ;
        skos:definition "A comparison operator that is true when the first value is not less than the second."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-less-than a skos:Concept ;
        skos:prefLabel "Less than"@en ;
        skos:definition "A comparison operator that is true when the first value is below the second."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-less-than-or-equal-to a skos:Concept ;
        skos:prefLabel "Less than or equal to"@en ;
        skos:altLabel "At most"@en ;
        skos:definition "A comparison operator that is true when the first value does not exceed the second."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-between a skos:Concept ;
        skos:prefLabel "Between"@en ;
        skos:altLabel "In range"@en ;
        skos:definition "A comparison operator that is true when a value lies within an inclusive range."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:comparison-in-set a skos:Concept ;
        skos:prefLabel "In set"@en ;
        skos:altLabel "One of"@en , "In list"@en ;
        skos:definition "A comparison operator that is true when a value is a member of a list."@en ;
        skos:broader voc:comparison-operator ;
        skos:inScheme voc:logic-vocabulary .

    voc:truth-value a skos:Concept ;
        skos:prefLabel "Truth value"@en ;
        skos:definition "A controlled value set for the result of evaluating a condition."@en ;
        skos:topConceptOf voc:logic-vocabulary ;
        skos:narrower voc:truth-value-true , voc:truth-value-false , voc:truth-value-unknown ;
        skos:inScheme voc:logic-vocabulary .

    voc:truth-value-true a skos:Concept ;
        skos:prefLabel "True"@en ;
        skos:definition "A truth value for a condition that holds."@en ;
        skos:broader voc:truth-value ;
        skos:inScheme voc:logic-vocabulary .

    voc:truth-value-false a skos:Concept ;
        skos:prefLabel "False"@en ;
        skos:definition "A truth value for a condition that does not hold."@en ;
        skos:broader voc:truth-value ;
        skos:inScheme voc:logic-vocabulary .

    voc:truth-value-unknown a skos:Concept ;
        skos:prefLabel "Unknown"@en ;
        skos:altLabel "Undetermined"@en ;
        skos:definition "A truth value for a condition that cannot be evaluated from the available facts."@en ;
        skos:scopeNote "Needed because the graph follows open-world semantics."@en ;
        skos:broader voc:truth-value ;
        skos:inScheme voc:logic-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-measure> {
    voc:measure-vocabulary a skos:ConceptScheme ;
        dcterms:title "Measure vocabulary"@en ;
        skos:prefLabel "Measure vocabulary"@en ;
        dcterms:description "Controlled values for units of measure, aggregation functions, and polarity of measures."@en ;
        dcterms:subject core:Measure ;
        dcterms:source "W3C Data Cube Vocabulary; ISO 4217 currency codes; Unified Code for Units of Measure concepts."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:unit-of-measure ,
            voc:aggregation-function ,
            voc:measure-polarity .

    voc:currency-code a rdfs:Datatype ;
        rdfs:label "Currency code"@en ;
        skos:definition "A datatype for three-letter currency codes defined by ISO 4217."@en ;
        rdfs:isDefinedBy voc:measure-vocabulary .

    voc:unit-of-measure a skos:Concept ;
        skos:prefLabel "Unit of measure"@en ;
        skos:definition "A controlled value set for the units in which measure values are expressed."@en ;
        skos:topConceptOf voc:measure-vocabulary ;
        skos:narrower voc:unit-count , voc:unit-percentage , voc:unit-ratio , voc:unit-united-states-dollar , voc:unit-hour , voc:unit-day , voc:unit-score , voc:unit-full-time-equivalent ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-count a skos:Concept ;
        skos:prefLabel "Count"@en ;
        skos:altLabel "Number"@en , "Each"@en ;
        skos:definition "A unit of measure for a number of discrete items."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-percentage a skos:Concept ;
        skos:prefLabel "Percentage"@en ;
        skos:altLabel "Percent"@en ;
        skos:definition "A unit of measure for a proportion expressed per hundred."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-ratio a skos:Concept ;
        skos:prefLabel "Ratio"@en ;
        skos:altLabel "Proportion"@en ;
        skos:definition "A unit of measure for a proportion expressed as a decimal fraction."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-united-states-dollar a skos:Concept ;
        skos:prefLabel "United States dollar"@en ;
        skos:altLabel "USD"@en , "Dollar"@en ;
        skos:notation "USD"^^voc:currency-code ;
        skos:definition "A unit of measure for amounts of money in United States currency."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-hour a skos:Concept ;
        skos:prefLabel "Hour"@en ;
        skos:altLabel "Hours"@en ;
        skos:definition "A unit of measure for time equal to sixty minutes."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-day a skos:Concept ;
        skos:prefLabel "Day"@en ;
        skos:altLabel "Days"@en ;
        skos:definition "A unit of measure for time equal to twenty-four hours."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-score a skos:Concept ;
        skos:prefLabel "Score"@en ;
        skos:altLabel "Points"@en , "Index"@en ;
        skos:definition "A unit of measure for a value on a defined scale with no physical unit."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:unit-full-time-equivalent a skos:Concept ;
        skos:prefLabel "Full-time equivalent"@en ;
        skos:altLabel "FTE"@en ;
        skos:definition "A unit of measure for workforce capacity equal to one full-time worker."@en ;
        skos:broader voc:unit-of-measure ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-function a skos:Concept ;
        skos:prefLabel "Aggregation function"@en ;
        skos:definition "A controlled value set for how many values are combined into one."@en ;
        skos:topConceptOf voc:measure-vocabulary ;
        skos:narrower voc:aggregation-sum , voc:aggregation-count-of-values , voc:aggregation-distinct-count , voc:aggregation-average , voc:aggregation-median , voc:aggregation-minimum , voc:aggregation-maximum , voc:aggregation-latest-value ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-sum a skos:Concept ;
        skos:prefLabel "Sum"@en ;
        skos:altLabel "Total"@en ;
        skos:definition "An aggregation function that adds values."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-count-of-values a skos:Concept ;
        skos:prefLabel "Count of values"@en ;
        skos:altLabel "Count function"@en ;
        skos:definition "An aggregation function that counts values."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-distinct-count a skos:Concept ;
        skos:prefLabel "Distinct count"@en ;
        skos:altLabel "Count distinct"@en ;
        skos:definition "An aggregation function that counts unique values."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-average a skos:Concept ;
        skos:prefLabel "Average"@en ;
        skos:altLabel "Mean"@en ;
        skos:definition "An aggregation function that divides the sum by the count."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-median a skos:Concept ;
        skos:prefLabel "Median"@en ;
        skos:definition "An aggregation function that returns the middle value."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-minimum a skos:Concept ;
        skos:prefLabel "Minimum"@en ;
        skos:altLabel "Min"@en ;
        skos:definition "An aggregation function that returns the smallest value."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-maximum a skos:Concept ;
        skos:prefLabel "Maximum"@en ;
        skos:altLabel "Max"@en ;
        skos:definition "An aggregation function that returns the largest value."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:aggregation-latest-value a skos:Concept ;
        skos:prefLabel "Latest value"@en ;
        skos:altLabel "Last value"@en , "Point in time value"@en ;
        skos:definition "An aggregation function that returns the most recent value."@en ;
        skos:broader voc:aggregation-function ;
        skos:inScheme voc:measure-vocabulary .

    voc:measure-polarity a skos:Concept ;
        skos:prefLabel "Measure polarity"@en ;
        skos:definition "A controlled value set for which direction of change is favorable."@en ;
        skos:topConceptOf voc:measure-vocabulary ;
        skos:narrower voc:polarity-higher-is-better , voc:polarity-lower-is-better , voc:polarity-closer-to-target-is-better ;
        skos:inScheme voc:measure-vocabulary .

    voc:polarity-higher-is-better a skos:Concept ;
        skos:prefLabel "Higher is better"@en ;
        skos:altLabel "Positive polarity"@en ;
        skos:definition "A measure polarity in which increases are favorable."@en ;
        skos:broader voc:measure-polarity ;
        skos:inScheme voc:measure-vocabulary .

    voc:polarity-lower-is-better a skos:Concept ;
        skos:prefLabel "Lower is better"@en ;
        skos:altLabel "Negative polarity"@en ;
        skos:definition "A measure polarity in which decreases are favorable."@en ;
        skos:broader voc:measure-polarity ;
        skos:inScheme voc:measure-vocabulary .

    voc:polarity-closer-to-target-is-better a skos:Concept ;
        skos:prefLabel "Closer to target is better"@en ;
        skos:altLabel "On target"@en ;
        skos:definition "A measure polarity in which values nearest the target are favorable."@en ;
        skos:broader voc:measure-polarity ;
        skos:inScheme voc:measure-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-party> {
    voc:party-vocabulary a skos:ConceptScheme ;
        dcterms:title "Party vocabulary"@en ;
        skos:prefLabel "Party vocabulary"@en ;
        dcterms:description "Controlled values that describe the relationship status of parties and the kinds of identifiers assigned to them."@en ;
        dcterms:subject core:Party ;
        skos:scopeNote "Identifier values themselves are confidential or restricted data and are never stored in vocabularies."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:party-relationship-status ,
            voc:party-identifier-type ,
            voc:contact-method-type .

    voc:party-relationship-status a skos:Concept ;
        skos:prefLabel "Party relationship status"@en ;
        skos:definition "A controlled value set for the state of a party's relationship with the organization."@en ;
        skos:topConceptOf voc:party-vocabulary ;
        skos:narrower voc:party-status-prospective , voc:party-status-onboarding , voc:party-status-active , voc:party-status-suspended , voc:party-status-terminated ;
        skos:inScheme voc:party-vocabulary .

    voc:party-status-prospective a skos:Concept ;
        skos:prefLabel "Prospective"@en ;
        skos:altLabel "Prospect"@en ;
        skos:definition "A party relationship status for a party being evaluated or pursued."@en ;
        skos:broader voc:party-relationship-status ;
        skos:inScheme voc:party-vocabulary .

    voc:party-status-onboarding a skos:Concept ;
        skos:prefLabel "Onboarding"@en ;
        skos:altLabel "Implementation"@en , "Pending start"@en ;
        skos:definition "A party relationship status for a party whose relationship is being set up."@en ;
        skos:broader voc:party-relationship-status ;
        skos:inScheme voc:party-vocabulary .

    voc:party-status-active a skos:Concept ;
        skos:prefLabel "Active"@en ;
        skos:altLabel "Current"@en ;
        skos:definition "A party relationship status for a party in a current relationship."@en ;
        skos:broader voc:party-relationship-status ;
        skos:inScheme voc:party-vocabulary .

    voc:party-status-suspended a skos:Concept ;
        skos:prefLabel "Suspended"@en ;
        skos:altLabel "On hold"@en , "Leave"@en ;
        skos:definition "A party relationship status for a party whose relationship is temporarily paused."@en ;
        skos:broader voc:party-relationship-status ;
        skos:inScheme voc:party-vocabulary .

    voc:party-status-terminated a skos:Concept ;
        skos:prefLabel "Terminated"@en ;
        skos:altLabel "Inactive"@en , "Former"@en , "Separated"@en ;
        skos:definition "A party relationship status for a party whose relationship has ended."@en ;
        skos:broader voc:party-relationship-status ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-type a skos:Concept ;
        skos:prefLabel "Party identifier type"@en ;
        skos:definition "A controlled value set for the kinds of identifier assigned to parties."@en ;
        skos:topConceptOf voc:party-vocabulary ;
        skos:narrower voc:party-identifier-employer-identification-number , voc:party-identifier-taxpayer-identification-number , voc:party-identifier-legal-entity-identifier , voc:party-identifier-employee-number , voc:party-identifier-client-number , voc:party-identifier-supplier-number ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-employer-identification-number a skos:Concept ;
        skos:prefLabel "Employer identification number"@en ;
        skos:altLabel "EIN"@en , "Federal employer identification number"@en , "FEIN"@en ;
        skos:definition "A party identifier type assigned by the Internal Revenue Service to an employer for tax purposes."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-taxpayer-identification-number a skos:Concept ;
        skos:prefLabel "Taxpayer identification number"@en ;
        skos:altLabel "TIN"@en , "Social security number"@en , "SSN"@en ;
        skos:definition "A party identifier type assigned by a tax authority to a person or entity."@en ;
        skos:scopeNote "Values are restricted data."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-legal-entity-identifier a skos:Concept ;
        skos:prefLabel "Legal entity identifier"@en ;
        skos:altLabel "LEI"@en ;
        skos:definition "A party identifier type that is the ISO 17442 global code for a legal entity."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-employee-number a skos:Concept ;
        skos:prefLabel "Employee number"@en ;
        skos:altLabel "Employee identifier"@en , "Worker number"@en ;
        skos:definition "A party identifier type assigned by the organization to a worker."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-client-number a skos:Concept ;
        skos:prefLabel "Client number"@en ;
        skos:altLabel "Client identifier"@en , "Customer number"@en ;
        skos:definition "A party identifier type assigned by the organization to a client."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:party-identifier-supplier-number a skos:Concept ;
        skos:prefLabel "Supplier number"@en ;
        skos:altLabel "Vendor number"@en ;
        skos:definition "A party identifier type assigned by the organization to a supplier."@en ;
        skos:broader voc:party-identifier-type ;
        skos:inScheme voc:party-vocabulary .

    voc:contact-method-type a skos:Concept ;
        skos:prefLabel "Contact method type"@en ;
        skos:definition "A controlled value set for the means by which a party can be contacted."@en ;
        skos:topConceptOf voc:party-vocabulary ;
        skos:narrower voc:contact-method-email-address , voc:contact-method-telephone-number , voc:contact-method-postal-mail , voc:contact-method-secure-portal-message ;
        skos:inScheme voc:party-vocabulary .

    voc:contact-method-email-address a skos:Concept ;
        skos:prefLabel "Email address"@en ;
        skos:definition "A contact method type using electronic mail."@en ;
        skos:broader voc:contact-method-type ;
        skos:inScheme voc:party-vocabulary .

    voc:contact-method-telephone-number a skos:Concept ;
        skos:prefLabel "Telephone number"@en ;
        skos:altLabel "Phone number"@en , "Mobile number"@en ;
        skos:definition "A contact method type using voice or text messaging."@en ;
        skos:broader voc:contact-method-type ;
        skos:inScheme voc:party-vocabulary .

    voc:contact-method-postal-mail a skos:Concept ;
        skos:prefLabel "Postal mail"@en ;
        skos:definition "A contact method type using a postal address."@en ;
        skos:broader voc:contact-method-type ;
        skos:inScheme voc:party-vocabulary .

    voc:contact-method-secure-portal-message a skos:Concept ;
        skos:prefLabel "Secure portal message"@en ;
        skos:altLabel "Portal message"@en ;
        skos:definition "A contact method type using a message in an authenticated portal."@en ;
        skos:broader voc:contact-method-type ;
        skos:inScheme voc:party-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-persona> {
    voc:persona-vocabulary a skos:ConceptScheme ;
        dcterms:title "Persona vocabulary"@en ;
        skos:prefLabel "Persona vocabulary"@en ;
        dcterms:description "The governed persona individuals for MVP1 and the controlled values for persona expertise level, tone, and reading level."@en ;
        dcterms:subject core:Persona ;
        skos:scopeNote "Each persona is an individual of core:Persona that selects labels, retrieval ranking, tone, and prompt template; it never grants access and is set from the authenticated role, not from the prompt. Personas never encode protected characteristics. Channels are in the service vocabulary."@en ;
        dcterms:source "Semantic Governance v1.8 Section 3.8 and Appendix D Section 4.3."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept persona:WorksiteEmployee ,
            persona:NewHireEmployee ,
            persona:LifeEventEmployee ,
            persona:DepartingEmployee ,
            persona:ClientHumanResourcesAdministrator ,
            persona:ClientOwnerExecutive ,
            persona:HumanResourcesSpecialist ,
            persona:BenefitsSpecialist ,
            persona:RetirementPlanSpecialist ,
            persona:PayrollSpecialist ,
            persona:ComplianceAnalyst ,
            persona:InsightsAnalyst ,
            voc:expertise-level ,
            voc:communication-tone ,
            voc:reading-level .

    persona:WorksiteEmployee a skos:Concept, core:Persona ;
        skos:prefLabel "Worksite employee"@en ;
        skos:definition "A persona representing co-employed worksite employees asking about eligibility, costs, deadlines, enrollment, their own match, and vesting."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:ActiveWorkerPersona ;
        core:hasExpertiseLevel voc:expertise-level-novice ;
        core:usesChannel voc:channel-conversational-agent ;
        core:usesChannel voc:channel-employee-portal ;
        skos:inScheme voc:persona-vocabulary .

    persona:NewHireEmployee a skos:Concept, core:Persona ;
        skos:prefLabel "New hire employee"@en ;
        skos:definition "A persona representing employees in a waiting period or first enrollment window who need to know what to choose, by when, and what happens if nothing is chosen."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:JoiningWorkerPersona ;
        core:hasExpertiseLevel voc:expertise-level-novice ;
        core:usesChannel voc:channel-conversational-agent ;
        core:usesChannel voc:channel-employee-portal ;
        skos:inScheme voc:persona-vocabulary .

    persona:LifeEventEmployee a skos:Concept, core:Persona ;
        skos:prefLabel "Life event employee"@en ;
        skos:definition "A persona representing employees with a qualifying life event who need to know which changes are allowed and the election window."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:LifeChangeWorkerPersona ;
        core:hasExpertiseLevel voc:expertise-level-novice ;
        core:usesChannel voc:channel-conversational-agent ;
        skos:inScheme voc:persona-vocabulary .

    persona:DepartingEmployee a skos:Concept, core:Persona ;
        skos:prefLabel "Departing employee"@en ;
        skos:definition "A persona representing employees leaving or reducing hours who need continuation coverage, final deductions, loans, rollover, and distribution options."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:DepartingWorkerPersona ;
        core:hasExpertiseLevel voc:expertise-level-novice ;
        core:usesChannel voc:channel-conversational-agent ;
        skos:inScheme voc:persona-vocabulary .

    persona:ClientHumanResourcesAdministrator a skos:Concept, core:Persona ;
        skos:prefLabel "Client human resources administrator"@en ;
        skos:altLabel "Client HR administrator"@en ;
        skos:definition "A persona representing the human resources contact at a worksite client who needs plan offerings, eligibility rules, deadlines, and employer obligations."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:ClientAdministratorPersona ;
        core:hasExpertiseLevel voc:expertise-level-practitioner ;
        core:usesChannel voc:channel-conversational-agent ;
        core:usesChannel voc:channel-client-portal ;
        skos:inScheme voc:persona-vocabulary .

    persona:ClientOwnerExecutive a skos:Concept, core:Persona ;
        skos:prefLabel "Client owner or executive"@en ;
        skos:altLabel "Client executive"@en , "Business owner"@en ;
        skos:definition "A persona representing a business owner or executive at a worksite client who needs plan sponsorship, employer cost, and compliance exposure information."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:ClientExecutivePersona ;
        core:hasExpertiseLevel voc:expertise-level-practitioner ;
        core:usesChannel voc:channel-conversational-agent ;
        core:usesChannel voc:channel-in-person-meeting ;
        skos:inScheme voc:persona-vocabulary .

    persona:HumanResourcesSpecialist a skos:Concept, core:Persona ;
        skos:prefLabel "Human resources specialist"@en ;
        skos:altLabel "HR specialist"@en , "HR advisor"@en ;
        skos:definition "A persona representing internal human resources specialists and advisors who need complete, sourced answers to repeat and edge-case client questions."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:HumanResourcesAdvisoryPersona ;
        core:hasExpertiseLevel voc:expertise-level-expert ;
        core:usesChannel voc:channel-conversational-agent ;
        core:usesChannel voc:channel-internal-search ;
        skos:inScheme voc:persona-vocabulary .

    persona:BenefitsSpecialist a skos:Concept, core:Persona ;
        skos:prefLabel "Benefits specialist"@en ;
        skos:definition "A persona representing internal benefits operations staff who need plan rules, carrier terms, and enrollment exceptions."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:BenefitsServicePersona ;
        core:hasExpertiseLevel voc:expertise-level-expert ;
        core:usesChannel voc:channel-internal-search ;
        core:usesChannel voc:channel-conversational-agent ;
        skos:inScheme voc:persona-vocabulary .

    persona:RetirementPlanSpecialist a skos:Concept, core:Persona ;
        skos:prefLabel "Retirement plan specialist"@en ;
        skos:altLabel "401(k) specialist"@en ;
        skos:definition "A persona representing internal retirement plan services staff who need plan document provisions, limits, testing, and distribution rules."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:BenefitsServicePersona ;
        core:hasExpertiseLevel voc:expertise-level-expert ;
        core:usesChannel voc:channel-internal-search ;
        core:usesChannel voc:channel-conversational-agent ;
        skos:inScheme voc:persona-vocabulary .

    persona:PayrollSpecialist a skos:Concept, core:Persona ;
        skos:prefLabel "Payroll specialist"@en ;
        skos:definition "A persona representing internal payroll operations staff who need deduction timing, compensation definitions, and corrections."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:PayrollServicePersona ;
        core:hasExpertiseLevel voc:expertise-level-practitioner ;
        core:usesChannel voc:channel-business-application ;
        core:usesChannel voc:channel-internal-search ;
        skos:inScheme voc:persona-vocabulary .

    persona:ComplianceAnalyst a skos:Concept, core:Persona ;
        skos:prefLabel "Compliance analyst"@en ;
        skos:altLabel "Compliance auditor"@en ;
        skos:definition "A persona representing internal compliance and audit staff who need to know which norm governs a step and evidence of answers given."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:CompliancePersona ;
        core:hasExpertiseLevel voc:expertise-level-expert ;
        core:usesChannel voc:channel-business-application ;
        core:usesChannel voc:channel-internal-search ;
        skos:inScheme voc:persona-vocabulary .

    persona:InsightsAnalyst a skos:Concept, core:Persona ;
        skos:prefLabel "Insights analyst"@en ;
        skos:altLabel "Analytics consumer"@en ;
        skos:definition "A persona representing Enterprise Analytics staff who consume measures of question trends, answer quality, and gaps by persona and domain."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:broadMatch tax:AnalyticsPersona ;
        core:hasExpertiseLevel voc:expertise-level-practitioner ;
        core:usesChannel voc:channel-dashboard ;
        core:usesChannel voc:channel-query-endpoint ;
        skos:inScheme voc:persona-vocabulary .

    voc:expertise-level a skos:Concept ;
        skos:prefLabel "Expertise level"@en ;
        skos:definition "A controlled value set for a persona's familiarity with a domain."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:narrower voc:expertise-level-novice , voc:expertise-level-practitioner , voc:expertise-level-expert ;
        skos:inScheme voc:persona-vocabulary .

    voc:expertise-level-novice a skos:Concept ;
        skos:prefLabel "Novice"@en ;
        skos:definition "An expertise level for users new to the domain who need plain explanations and next steps."@en ;
        skos:broader voc:expertise-level ;
        skos:inScheme voc:persona-vocabulary .

    voc:expertise-level-practitioner a skos:Concept ;
        skos:prefLabel "Practitioner"@en ;
        skos:definition "An expertise level for users who work in the domain regularly and need precise, procedural answers."@en ;
        skos:broader voc:expertise-level ;
        skos:inScheme voc:persona-vocabulary .

    voc:expertise-level-expert a skos:Concept ;
        skos:prefLabel "Expert"@en ;
        skos:definition "An expertise level for specialists who need complete, sourced answers including edge cases."@en ;
        skos:broader voc:expertise-level ;
        skos:inScheme voc:persona-vocabulary .

    voc:communication-tone a skos:Concept ;
        skos:prefLabel "Communication tone"@en ;
        skos:definition "A controlled value set for the tone of answers addressed to a persona."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:narrower voc:tone-reassuring , voc:tone-concise , voc:tone-procedural , voc:tone-formal ;
        skos:inScheme voc:persona-vocabulary .

    voc:tone-reassuring a skos:Concept ;
        skos:prefLabel "Reassuring"@en ;
        skos:altLabel "Empathetic"@en ;
        skos:definition "A communication tone that is warm, plain, and supportive."@en ;
        skos:broader voc:communication-tone ;
        skos:inScheme voc:persona-vocabulary .

    voc:tone-concise a skos:Concept ;
        skos:prefLabel "Concise"@en ;
        skos:definition "A communication tone that is brief and direct."@en ;
        skos:broader voc:communication-tone ;
        skos:inScheme voc:persona-vocabulary .

    voc:tone-procedural a skos:Concept ;
        skos:prefLabel "Procedural"@en ;
        skos:definition "A communication tone that gives ordered steps and deadlines."@en ;
        skos:broader voc:communication-tone ;
        skos:inScheme voc:persona-vocabulary .

    voc:tone-formal a skos:Concept ;
        skos:prefLabel "Formal"@en ;
        skos:definition "A communication tone suited to executives and official correspondence."@en ;
        skos:broader voc:communication-tone ;
        skos:inScheme voc:persona-vocabulary .

    voc:reading-level a skos:Concept ;
        skos:prefLabel "Reading level"@en ;
        skos:definition "A controlled value set for the vocabulary and sentence complexity of answers."@en ;
        skos:topConceptOf voc:persona-vocabulary ;
        skos:narrower voc:reading-level-plain-language , voc:reading-level-general-business , voc:reading-level-technical ;
        skos:inScheme voc:persona-vocabulary .

    voc:reading-level-plain-language a skos:Concept ;
        skos:prefLabel "Plain language"@en ;
        skos:definition "A reading level using everyday words and short sentences."@en ;
        skos:broader voc:reading-level ;
        skos:inScheme voc:persona-vocabulary .

    voc:reading-level-general-business a skos:Concept ;
        skos:prefLabel "General business"@en ;
        skos:definition "A reading level using common business terms."@en ;
        skos:broader voc:reading-level ;
        skos:inScheme voc:persona-vocabulary .

    voc:reading-level-technical a skos:Concept ;
        skos:prefLabel "Technical"@en ;
        skos:altLabel "Specialist"@en ;
        skos:definition "A reading level that allows domain and technical terms."@en ;
        skos:broader voc:reading-level ;
        skos:inScheme voc:persona-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-policy> {
    voc:policy-vocabulary a skos:ConceptScheme ;
        dcterms:title "Policy vocabulary"@en ;
        skos:prefLabel "Policy vocabulary"@en ;
        dcterms:description "Controlled values for policy scope, enforcement mode, and compliance status."@en ;
        dcterms:subject core:Policy ;
        dcterms:source "ISO 37301 compliance management; LKIF-Core."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:policy-scope ,
            voc:enforcement-mode ,
            voc:compliance-status .

    voc:policy-scope a skos:Concept ;
        skos:prefLabel "Policy scope"@en ;
        skos:definition "A controlled value set for the breadth of parties and activities a policy applies to."@en ;
        skos:topConceptOf voc:policy-vocabulary ;
        skos:narrower voc:policy-scope-enterprise , voc:policy-scope-domain , voc:policy-scope-local , voc:policy-scope-client-specific ;
        skos:inScheme voc:policy-vocabulary .

    voc:policy-scope-enterprise a skos:Concept ;
        skos:prefLabel "Enterprise"@en ;
        skos:altLabel "Organization-wide"@en ;
        skos:definition "A policy scope covering the whole organization."@en ;
        skos:broader voc:policy-scope ;
        skos:inScheme voc:policy-vocabulary .

    voc:policy-scope-domain a skos:Concept ;
        skos:prefLabel "Domain"@en ;
        skos:altLabel "Functional"@en ;
        skos:definition "A policy scope covering one business domain or function."@en ;
        skos:broader voc:policy-scope ;
        skos:inScheme voc:policy-vocabulary .

    voc:policy-scope-local a skos:Concept ;
        skos:prefLabel "Local"@en ;
        skos:definition "A policy scope covering one site, team, or system."@en ;
        skos:broader voc:policy-scope ;
        skos:inScheme voc:policy-vocabulary .

    voc:policy-scope-client-specific a skos:Concept ;
        skos:prefLabel "Client-specific"@en ;
        skos:definition "A policy scope covering one client and its workforce under an agreement."@en ;
        skos:broader voc:policy-scope ;
        skos:inScheme voc:policy-vocabulary .

    voc:enforcement-mode a skos:Concept ;
        skos:prefLabel "Enforcement mode"@en ;
        skos:definition "A controlled value set for how a policy or rule is enforced at runtime."@en ;
        skos:topConceptOf voc:policy-vocabulary ;
        skos:narrower voc:enforcement-blocking , voc:enforcement-warning , voc:enforcement-monitoring-only ;
        skos:inScheme voc:policy-vocabulary .

    voc:enforcement-blocking a skos:Concept ;
        skos:prefLabel "Blocking"@en ;
        skos:altLabel "Hard stop"@en ;
        skos:definition "An enforcement mode that prevents a nonconforming action."@en ;
        skos:broader voc:enforcement-mode ;
        skos:inScheme voc:policy-vocabulary .

    voc:enforcement-warning a skos:Concept ;
        skos:prefLabel "Warning"@en ;
        skos:altLabel "Soft stop"@en ;
        skos:definition "An enforcement mode that allows a nonconforming action and records a warning."@en ;
        skos:broader voc:enforcement-mode ;
        skos:inScheme voc:policy-vocabulary .

    voc:enforcement-monitoring-only a skos:Concept ;
        skos:prefLabel "Monitoring only"@en ;
        skos:altLabel "Audit mode"@en , "Shadow mode"@en ;
        skos:definition "An enforcement mode that records conformance without affecting the action."@en ;
        skos:broader voc:enforcement-mode ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status a skos:Concept ;
        skos:prefLabel "Compliance status"@en ;
        skos:definition "A controlled value set for whether an obligation or policy is met."@en ;
        skos:topConceptOf voc:policy-vocabulary ;
        skos:narrower voc:compliance-status-compliant , voc:compliance-status-partially-compliant , voc:compliance-status-noncompliant , voc:compliance-status-not-assessed , voc:compliance-status-not-applicable ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status-compliant a skos:Concept ;
        skos:prefLabel "Compliant"@en ;
        skos:altLabel "Conforming"@en ;
        skos:definition "A compliance status in which the obligation is fully met."@en ;
        skos:broader voc:compliance-status ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status-partially-compliant a skos:Concept ;
        skos:prefLabel "Partially compliant"@en ;
        skos:definition "A compliance status in which some parts of the obligation are met."@en ;
        skos:broader voc:compliance-status ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status-noncompliant a skos:Concept ;
        skos:prefLabel "Noncompliant"@en ;
        skos:altLabel "Nonconforming"@en , "In breach"@en ;
        skos:definition "A compliance status in which the obligation is not met."@en ;
        skos:broader voc:compliance-status ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status-not-assessed a skos:Concept ;
        skos:prefLabel "Not assessed"@en ;
        skos:altLabel "Unknown compliance"@en ;
        skos:definition "A compliance status in which conformance has not yet been evaluated."@en ;
        skos:broader voc:compliance-status ;
        skos:inScheme voc:policy-vocabulary .

    voc:compliance-status-not-applicable a skos:Concept ;
        skos:prefLabel "Not applicable"@en ;
        skos:altLabel "Exempt"@en ;
        skos:definition "A compliance status in which the obligation does not apply."@en ;
        skos:broader voc:compliance-status ;
        skos:inScheme voc:policy-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-process> {
    voc:process-vocabulary a skos:ConceptScheme ;
        dcterms:title "Process vocabulary"@en ;
        skos:prefLabel "Process vocabulary"@en ;
        dcterms:description "Controlled values that describe the execution status and automation level of processes and process steps."@en ;
        dcterms:subject core:Process ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:process-execution-status ,
            voc:automation-level .

    voc:process-execution-status a skos:Concept ;
        skos:prefLabel "Process execution status"@en ;
        skos:definition "A controlled value set for the state of a process or process step instance."@en ;
        skos:topConceptOf voc:process-vocabulary ;
        skos:narrower voc:process-status-not-started , voc:process-status-in-progress , voc:process-status-suspended , voc:process-status-completed , voc:process-status-failed , voc:process-status-cancelled ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-not-started a skos:Concept ;
        skos:prefLabel "Not started"@en ;
        skos:altLabel "Pending"@en , "Queued"@en ;
        skos:definition "A process execution status for an instance created but not begun."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-in-progress a skos:Concept ;
        skos:prefLabel "In progress"@en ;
        skos:altLabel "Running"@en , "Active"@en ;
        skos:definition "A process execution status for an instance being carried out."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-suspended a skos:Concept ;
        skos:prefLabel "Suspended"@en ;
        skos:altLabel "Waiting"@en , "On hold"@en ;
        skos:definition "A process execution status for an instance paused awaiting an event or decision."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-completed a skos:Concept ;
        skos:prefLabel "Completed"@en ;
        skos:altLabel "Done"@en , "Succeeded"@en ;
        skos:definition "A process execution status for an instance that ended along its expected path."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-failed a skos:Concept ;
        skos:prefLabel "Failed"@en ;
        skos:altLabel "Errored"@en ;
        skos:definition "A process execution status for an instance that ended without completing."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:process-status-cancelled a skos:Concept ;
        skos:prefLabel "Cancelled"@en ;
        skos:altLabel "Aborted"@en , "Withdrawn"@en ;
        skos:definition "A process execution status for an instance stopped deliberately before completion."@en ;
        skos:broader voc:process-execution-status ;
        skos:inScheme voc:process-vocabulary .

    voc:automation-level a skos:Concept ;
        skos:prefLabel "Automation level"@en ;
        skos:definition "A controlled value set for how much of a process step is performed by software."@en ;
        skos:topConceptOf voc:process-vocabulary ;
        skos:narrower voc:automation-manual , voc:automation-system-assisted , voc:automation-agent-assisted , voc:automation-fully-automated ;
        skos:inScheme voc:process-vocabulary .

    voc:automation-manual a skos:Concept ;
        skos:prefLabel "Manual"@en ;
        skos:definition "An automation level in which a person performs the step without system support."@en ;
        skos:broader voc:automation-level ;
        skos:inScheme voc:process-vocabulary .

    voc:automation-system-assisted a skos:Concept ;
        skos:prefLabel "System assisted"@en ;
        skos:altLabel "Semi-automated"@en ;
        skos:definition "An automation level in which a person performs the step using an application."@en ;
        skos:broader voc:automation-level ;
        skos:inScheme voc:process-vocabulary .

    voc:automation-agent-assisted a skos:Concept ;
        skos:prefLabel "Agent assisted"@en ;
        skos:altLabel "Copilot"@en ;
        skos:definition "An automation level in which an artificial intelligence agent drafts or recommends and a person confirms."@en ;
        skos:broader voc:automation-level ;
        skos:inScheme voc:process-vocabulary .

    voc:automation-fully-automated a skos:Concept ;
        skos:prefLabel "Fully automated"@en ;
        skos:altLabel "Straight-through processing"@en , "Touchless"@en ;
        skos:definition "An automation level in which software performs the step without human intervention."@en ;
        skos:broader voc:automation-level ;
        skos:inScheme voc:process-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-product> {
    voc:product-vocabulary a skos:ConceptScheme ;
        dcterms:title "Product vocabulary"@en ;
        skos:prefLabel "Product vocabulary"@en ;
        dcterms:description "Controlled values that describe the availability status and commercial model of products."@en ;
        dcterms:subject core:Product ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:product-availability-status ,
            voc:offering-model .

    voc:product-availability-status a skos:Concept ;
        skos:prefLabel "Product availability status"@en ;
        skos:definition "A controlled value set for whether a product can be sold."@en ;
        skos:topConceptOf voc:product-vocabulary ;
        skos:narrower voc:product-status-in-development , voc:product-status-pilot , voc:product-status-generally-available , voc:product-status-closed-to-new-sales , voc:product-status-discontinued ;
        skos:inScheme voc:product-vocabulary .

    voc:product-status-in-development a skos:Concept ;
        skos:prefLabel "In development"@en ;
        skos:altLabel "Pipeline"@en ;
        skos:definition "A product availability status for products being designed and not yet sold."@en ;
        skos:broader voc:product-availability-status ;
        skos:inScheme voc:product-vocabulary .

    voc:product-status-pilot a skos:Concept ;
        skos:prefLabel "Pilot"@en ;
        skos:altLabel "Beta"@en , "Limited availability"@en ;
        skos:definition "A product availability status for products offered to a limited set of clients for evaluation."@en ;
        skos:broader voc:product-availability-status ;
        skos:inScheme voc:product-vocabulary .

    voc:product-status-generally-available a skos:Concept ;
        skos:prefLabel "Generally available"@en ;
        skos:altLabel "Available"@en , "Launched"@en ;
        skos:definition "A product availability status for products sold to all eligible clients."@en ;
        skos:broader voc:product-availability-status ;
        skos:inScheme voc:product-vocabulary .

    voc:product-status-closed-to-new-sales a skos:Concept ;
        skos:prefLabel "Closed to new sales"@en ;
        skos:altLabel "Grandfathered"@en ;
        skos:definition "A product availability status for products still serviced but no longer sold."@en ;
        skos:broader voc:product-availability-status ;
        skos:inScheme voc:product-vocabulary .

    voc:product-status-discontinued a skos:Concept ;
        skos:prefLabel "Discontinued"@en ;
        skos:altLabel "Withdrawn"@en , "End of life"@en ;
        skos:definition "A product availability status for products no longer sold or serviced."@en ;
        skos:broader voc:product-availability-status ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model a skos:Concept ;
        skos:prefLabel "Offering model"@en ;
        skos:definition "A controlled value set for how a product is priced and sold."@en ;
        skos:topConceptOf voc:product-vocabulary ;
        skos:narrower voc:offering-model-one-time-purchase , voc:offering-model-subscription , voc:offering-model-per-employee-per-month , voc:offering-model-percentage-of-payroll , voc:offering-model-usage-based , voc:offering-model-premium-based ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-one-time-purchase a skos:Concept ;
        skos:prefLabel "One-time purchase"@en ;
        skos:altLabel "Perpetual license"@en ;
        skos:definition "An offering model in which the client pays once for ownership or perpetual use."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-subscription a skos:Concept ;
        skos:prefLabel "Subscription"@en ;
        skos:altLabel "Recurring"@en ;
        skos:definition "An offering model in which the client pays a recurring fee for continued access."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-per-employee-per-month a skos:Concept ;
        skos:prefLabel "Per employee per month"@en ;
        skos:altLabel "PEPM"@en , "Per worker per month"@en ;
        skos:definition "An offering model in which the fee is charged for each covered worker each month."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-percentage-of-payroll a skos:Concept ;
        skos:prefLabel "Percentage of payroll"@en ;
        skos:altLabel "Payroll-based fee"@en ;
        skos:definition "An offering model in which the fee is a percentage of the client's gross payroll."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-usage-based a skos:Concept ;
        skos:prefLabel "Usage-based"@en ;
        skos:altLabel "Pay as you go"@en , "Metered"@en ;
        skos:definition "An offering model in which the fee depends on measured consumption."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .

    voc:offering-model-premium-based a skos:Concept ;
        skos:prefLabel "Premium-based"@en ;
        skos:altLabel "Premium"@en ;
        skos:definition "An offering model in which the client pays an insurance premium for coverage."@en ;
        skos:broader voc:offering-model ;
        skos:inScheme voc:product-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-requirement> {
    voc:requirement-vocabulary a skos:ConceptScheme ;
        dcterms:title "Requirement vocabulary"@en ;
        skos:prefLabel "Requirement vocabulary"@en ;
        dcterms:description "Controlled values that describe the priority, status, and verification method of requirements."@en ;
        dcterms:subject core:Requirement ;
        dcterms:source "ISO/IEC/IEEE 29148; INCOSE verification methods; MoSCoW prioritization."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:requirement-priority ,
            voc:requirement-status ,
            voc:verification-method .

    voc:requirement-priority a skos:Concept ;
        skos:prefLabel "Requirement priority"@en ;
        skos:definition "A controlled value set for the relative importance of a requirement in a release."@en ;
        skos:topConceptOf voc:requirement-vocabulary ;
        skos:narrower voc:requirement-priority-must-have , voc:requirement-priority-should-have , voc:requirement-priority-could-have , voc:requirement-priority-will-not-have-this-time ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-priority-must-have a skos:Concept ;
        skos:prefLabel "Must have"@en ;
        skos:altLabel "Must"@en , "Mandatory"@en ;
        skos:definition "A requirement priority for requirements without which the release fails."@en ;
        skos:broader voc:requirement-priority ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-priority-should-have a skos:Concept ;
        skos:prefLabel "Should have"@en ;
        skos:altLabel "Should"@en ;
        skos:definition "A requirement priority for important requirements that can be deferred with a workaround."@en ;
        skos:broader voc:requirement-priority ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-priority-could-have a skos:Concept ;
        skos:prefLabel "Could have"@en ;
        skos:altLabel "Could"@en , "Nice to have"@en ;
        skos:definition "A requirement priority for desirable requirements included if capacity allows."@en ;
        skos:broader voc:requirement-priority ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-priority-will-not-have-this-time a skos:Concept ;
        skos:prefLabel "Will not have this time"@en ;
        skos:altLabel "Won't have"@en , "Out of scope"@en ;
        skos:definition "A requirement priority for requirements explicitly out of scope for the release."@en ;
        skos:broader voc:requirement-priority ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status a skos:Concept ;
        skos:prefLabel "Requirement status"@en ;
        skos:definition "A controlled value set for where a requirement stands in its lifecycle."@en ;
        skos:topConceptOf voc:requirement-vocabulary ;
        skos:narrower voc:requirement-status-proposed , voc:requirement-status-approved , voc:requirement-status-implemented , voc:requirement-status-verified , voc:requirement-status-deferred , voc:requirement-status-rejected ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-proposed a skos:Concept ;
        skos:prefLabel "Proposed"@en ;
        skos:altLabel "Draft requirement"@en ;
        skos:definition "A requirement status for a requirement captured but not yet reviewed."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-approved a skos:Concept ;
        skos:prefLabel "Approved"@en ;
        skos:altLabel "Baselined"@en ;
        skos:definition "A requirement status for a requirement accepted for implementation."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-implemented a skos:Concept ;
        skos:prefLabel "Implemented"@en ;
        skos:definition "A requirement status for a requirement built and awaiting verification."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-verified a skos:Concept ;
        skos:prefLabel "Verified"@en ;
        skos:altLabel "Passed"@en ;
        skos:definition "A requirement status for a requirement shown to be met by its verification method."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-deferred a skos:Concept ;
        skos:prefLabel "Deferred"@en ;
        skos:altLabel "Postponed"@en ;
        skos:definition "A requirement status for an approved requirement moved to a later release."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:requirement-status-rejected a skos:Concept ;
        skos:prefLabel "Rejected"@en ;
        skos:altLabel "Declined"@en ;
        skos:definition "A requirement status for a requirement not accepted."@en ;
        skos:broader voc:requirement-status ;
        skos:inScheme voc:requirement-vocabulary .

    voc:verification-method a skos:Concept ;
        skos:prefLabel "Verification method"@en ;
        skos:definition "A controlled value set for how a requirement is shown to be met."@en ;
        skos:topConceptOf voc:requirement-vocabulary ;
        skos:narrower voc:verification-method-inspection , voc:verification-method-analysis , voc:verification-method-demonstration , voc:verification-method-test ;
        skos:inScheme voc:requirement-vocabulary .

    voc:verification-method-inspection a skos:Concept ;
        skos:prefLabel "Inspection"@en ;
        skos:altLabel "Review"@en ;
        skos:definition "A verification method that examines an artifact against the requirement without executing it."@en ;
        skos:broader voc:verification-method ;
        skos:inScheme voc:requirement-vocabulary .

    voc:verification-method-analysis a skos:Concept ;
        skos:prefLabel "Analysis"@en ;
        skos:definition "A verification method that uses models, calculations, or reasoning to show the requirement is met."@en ;
        skos:broader voc:verification-method ;
        skos:inScheme voc:requirement-vocabulary .

    voc:verification-method-demonstration a skos:Concept ;
        skos:prefLabel "Demonstration"@en ;
        skos:definition "A verification method that shows the function operating without detailed measurement."@en ;
        skos:broader voc:verification-method ;
        skos:inScheme voc:requirement-vocabulary .

    voc:verification-method-test a skos:Concept ;
        skos:prefLabel "Test"@en ;
        skos:altLabel "Competency question test"@en ;
        skos:definition "A verification method that executes the item under controlled conditions and measures results."@en ;
        skos:broader voc:verification-method ;
        skos:inScheme voc:requirement-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-role> {
    voc:role-vocabulary a skos:ConceptScheme ;
        dcterms:title "Role vocabulary"@en ;
        skos:prefLabel "Role vocabulary"@en ;
        dcterms:description "Controlled values that describe how a role is assigned and the decision authority it carries."@en ;
        dcterms:subject core:Role ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:role-assignment-type ,
            voc:decision-authority-level .

    voc:role-assignment-type a skos:Concept ;
        skos:prefLabel "Role assignment type"@en ;
        skos:definition "A controlled value set for the basis on which a party holds a role."@en ;
        skos:topConceptOf voc:role-vocabulary ;
        skos:narrower voc:role-assignment-primary , voc:role-assignment-backup , voc:role-assignment-delegate , voc:role-assignment-acting ;
        skos:inScheme voc:role-vocabulary .

    voc:role-assignment-primary a skos:Concept ;
        skos:prefLabel "Primary"@en ;
        skos:altLabel "Principal holder"@en ;
        skos:definition "A role assignment type for the party normally holding the role."@en ;
        skos:broader voc:role-assignment-type ;
        skos:inScheme voc:role-vocabulary .

    voc:role-assignment-backup a skos:Concept ;
        skos:prefLabel "Backup"@en ;
        skos:altLabel "Alternate"@en , "Secondary"@en ;
        skos:definition "A role assignment type for a party who holds the role when the primary is unavailable."@en ;
        skos:broader voc:role-assignment-type ;
        skos:inScheme voc:role-vocabulary .

    voc:role-assignment-delegate a skos:Concept ;
        skos:prefLabel "Delegate"@en ;
        skos:altLabel "Delegated authority"@en ;
        skos:definition "A role assignment type for a party to whom authority is delegated for a defined scope and period."@en ;
        skos:broader voc:role-assignment-type ;
        skos:inScheme voc:role-vocabulary .

    voc:role-assignment-acting a skos:Concept ;
        skos:prefLabel "Acting"@en ;
        skos:altLabel "Interim"@en ;
        skos:definition "A role assignment type for a party temporarily filling a vacant role."@en ;
        skos:broader voc:role-assignment-type ;
        skos:inScheme voc:role-vocabulary .

    voc:decision-authority-level a skos:Concept ;
        skos:prefLabel "Decision authority level"@en ;
        skos:definition "A controlled value set for the authority a role carries in a decision."@en ;
        skos:topConceptOf voc:role-vocabulary ;
        skos:narrower voc:authority-informs , voc:authority-recommends , voc:authority-approves , voc:authority-decides ;
        skos:inScheme voc:role-vocabulary .

    voc:authority-informs a skos:Concept ;
        skos:prefLabel "Informs"@en ;
        skos:altLabel "Contributes"@en ;
        skos:definition "A decision authority level for roles that provide information to a decision."@en ;
        skos:broader voc:decision-authority-level ;
        skos:inScheme voc:role-vocabulary .

    voc:authority-recommends a skos:Concept ;
        skos:prefLabel "Recommends"@en ;
        skos:definition "A decision authority level for roles that propose an outcome for others to decide."@en ;
        skos:broader voc:decision-authority-level ;
        skos:inScheme voc:role-vocabulary .

    voc:authority-approves a skos:Concept ;
        skos:prefLabel "Approves"@en ;
        skos:altLabel "Approval authority"@en ;
        skos:definition "A decision authority level for roles that accept or reject a proposed outcome."@en ;
        skos:broader voc:decision-authority-level ;
        skos:inScheme voc:role-vocabulary .

    voc:authority-decides a skos:Concept ;
        skos:prefLabel "Decides"@en ;
        skos:altLabel "Final authority"@en ;
        skos:definition "A decision authority level for roles with final authority over the outcome."@en ;
        skos:broader voc:decision-authority-level ;
        skos:inScheme voc:role-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-rule> {
    voc:rule-vocabulary a skos:ConceptScheme ;
        dcterms:title "Rule vocabulary"@en ;
        skos:prefLabel "Rule vocabulary"@en ;
        dcterms:description "Controlled values that describe the strength, authoring format, and runtime of rules in the single source of truth."@en ;
        dcterms:subject core:Rule ;
        dcterms:source "Semantic Governance v1.8 Section 3.5; IETF RFC 2119 requirement keywords."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:rule-strength ,
            voc:rule-authoring-format ,
            voc:rule-runtime .

    voc:rule-strength a skos:Concept ;
        skos:prefLabel "Rule strength"@en ;
        skos:definition "A controlled value set for how binding a rule is."@en ;
        skos:topConceptOf voc:rule-vocabulary ;
        skos:narrower voc:rule-strength-mandatory , voc:rule-strength-recommended , voc:rule-strength-optional ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-strength-mandatory a skos:Concept ;
        skos:prefLabel "Mandatory"@en ;
        skos:altLabel "Must"@en , "Required"@en , "Shall"@en ;
        skos:definition "A rule strength for rules that must always be followed."@en ;
        skos:broader voc:rule-strength ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-strength-recommended a skos:Concept ;
        skos:prefLabel "Recommended"@en ;
        skos:altLabel "Should"@en ;
        skos:definition "A rule strength for rules that should be followed unless there is a documented reason."@en ;
        skos:broader voc:rule-strength ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-strength-optional a skos:Concept ;
        skos:prefLabel "Optional"@en ;
        skos:altLabel "May"@en ;
        skos:definition "A rule strength for rules that may be followed at the party's discretion."@en ;
        skos:broader voc:rule-strength ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-authoring-format a skos:Concept ;
        skos:prefLabel "Rule authoring format"@en ;
        skos:definition "A controlled value set for the declarative form in which a rule is authored once."@en ;
        skos:topConceptOf voc:rule-vocabulary ;
        skos:narrower voc:rule-format-decision-table , voc:rule-format-shapes-constraint-language-shape , voc:rule-format-javascript-object-notation-schema , voc:rule-format-formula-specification , voc:rule-format-governed-code ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-format-decision-table a skos:Concept ;
        skos:prefLabel "Decision table"@en ;
        skos:altLabel "DMN table"@en ;
        skos:definition "A rule authoring format using Decision Model and Notation tables edited as grids."@en ;
        skos:broader voc:rule-authoring-format ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-format-shapes-constraint-language-shape a skos:Concept ;
        skos:prefLabel "Shapes Constraint Language shape"@en ;
        skos:altLabel "SHACL shape"@en ;
        skos:definition "A rule authoring format using W3C shapes for graph data constraints."@en ;
        skos:broader voc:rule-authoring-format ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-format-javascript-object-notation-schema a skos:Concept ;
        skos:prefLabel "JavaScript Object Notation schema"@en ;
        skos:altLabel "JSON Schema"@en ;
        skos:definition "A rule authoring format using JSON Schema for message and API constraints."@en ;
        skos:broader voc:rule-authoring-format ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-format-formula-specification a skos:Concept ;
        skos:prefLabel "Formula specification"@en ;
        skos:altLabel "Calculation specification"@en ;
        skos:definition "A rule authoring format using a declarative formula with test vectors."@en ;
        skos:broader voc:rule-authoring-format ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-format-governed-code a skos:Concept ;
        skos:prefLabel "Governed code"@en ;
        skos:altLabel "Logic code"@en ;
        skos:definition "A rule authoring format using code that references single source of truth terms and versions."@en ;
        skos:broader voc:rule-authoring-format ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-runtime a skos:Concept ;
        skos:prefLabel "Rule runtime"@en ;
        skos:definition "A controlled value set for where a generated rule executes."@en ;
        skos:topConceptOf voc:rule-vocabulary ;
        skos:narrower voc:rule-runtime-graph-store , voc:rule-runtime-rules-engine , voc:rule-runtime-microservice , voc:rule-runtime-interface-validation ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-runtime-graph-store a skos:Concept ;
        skos:prefLabel "Graph store"@en ;
        skos:definition "A rule runtime in which the rule runs as validation in the graph database."@en ;
        skos:broader voc:rule-runtime ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-runtime-rules-engine a skos:Concept ;
        skos:prefLabel "Rules engine"@en ;
        skos:altLabel "Decision engine"@en ;
        skos:definition "A rule runtime in which the rule runs behind the Decision API."@en ;
        skos:broader voc:rule-runtime ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-runtime-microservice a skos:Concept ;
        skos:prefLabel "Microservice"@en ;
        skos:definition "A rule runtime in which the rule runs as generated code in a service."@en ;
        skos:broader voc:rule-runtime ;
        skos:inScheme voc:rule-vocabulary .

    voc:rule-runtime-interface-validation a skos:Concept ;
        skos:prefLabel "Interface validation"@en ;
        skos:altLabel "API validation"@en ;
        skos:definition "A rule runtime in which the rule runs when an application programming interface receives a request."@en ;
        skos:broader voc:rule-runtime ;
        skos:inScheme voc:rule-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-service> {
    voc:service-vocabulary a skos:ConceptScheme ;
        dcterms:title "Service vocabulary"@en ;
        skos:prefLabel "Service vocabulary"@en ;
        dcterms:description "Controlled values for service operating status, delivery channels, and delivery models."@en ;
        dcterms:subject core:Service ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:service-operating-status ,
            voc:service-channel ,
            voc:service-delivery-model .

    voc:service-operating-status a skos:Concept ;
        skos:prefLabel "Service operating status"@en ;
        skos:definition "A controlled value set for the current health of a service."@en ;
        skos:topConceptOf voc:service-vocabulary ;
        skos:narrower voc:service-status-operational , voc:service-status-degraded , voc:service-status-unavailable , voc:service-status-under-maintenance ;
        skos:inScheme voc:service-vocabulary .

    voc:service-status-operational a skos:Concept ;
        skos:prefLabel "Operational"@en ;
        skos:altLabel "Available"@en , "Healthy"@en ;
        skos:definition "A service operating status in which the service meets its service levels."@en ;
        skos:broader voc:service-operating-status ;
        skos:inScheme voc:service-vocabulary .

    voc:service-status-degraded a skos:Concept ;
        skos:prefLabel "Degraded"@en ;
        skos:altLabel "Impaired"@en ;
        skos:definition "A service operating status in which the service is available but below its service levels."@en ;
        skos:broader voc:service-operating-status ;
        skos:inScheme voc:service-vocabulary .

    voc:service-status-unavailable a skos:Concept ;
        skos:prefLabel "Unavailable"@en ;
        skos:altLabel "Down"@en , "Outage"@en ;
        skos:definition "A service operating status in which the service cannot be used."@en ;
        skos:broader voc:service-operating-status ;
        skos:inScheme voc:service-vocabulary .

    voc:service-status-under-maintenance a skos:Concept ;
        skos:prefLabel "Under maintenance"@en ;
        skos:altLabel "Planned maintenance"@en ;
        skos:definition "A service operating status in which the service is intentionally unavailable for planned work."@en ;
        skos:broader voc:service-operating-status ;
        skos:inScheme voc:service-vocabulary .

    voc:service-channel a skos:Concept ;
        skos:prefLabel "Service channel"@en ;
        skos:definition "A controlled value set for the means through which a service is delivered or accessed."@en ;
        skos:topConceptOf voc:service-vocabulary ;
        skos:narrower voc:channel-conversational-agent , voc:channel-employee-portal , voc:channel-client-portal , voc:channel-internal-search , voc:channel-business-application , voc:channel-dashboard , voc:channel-query-endpoint , voc:channel-programmatic-interface , voc:channel-email , voc:channel-telephone , voc:channel-in-person-meeting , voc:channel-mobile-application ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-conversational-agent a skos:Concept ;
        skos:prefLabel "Conversational agent"@en ;
        skos:altLabel "Chat assistant"@en , "HR 360 agent"@en , "Virtual assistant"@en ;
        skos:definition "A service channel in which users ask questions in natural language to an artificial intelligence agent."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-employee-portal a skos:Concept ;
        skos:prefLabel "Employee portal"@en ;
        skos:altLabel "Employee self-service"@en ;
        skos:definition "A service channel that is an authenticated web application for workers."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-client-portal a skos:Concept ;
        skos:prefLabel "Client portal"@en ;
        skos:altLabel "Client self-service"@en ;
        skos:definition "A service channel that is an authenticated web application for client administrators."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-internal-search a skos:Concept ;
        skos:prefLabel "Internal search"@en ;
        skos:altLabel "Enterprise search"@en ;
        skos:definition "A service channel that is the organization's enterprise search for staff."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-business-application a skos:Concept ;
        skos:prefLabel "Business application"@en ;
        skos:altLabel "Line of business application"@en , "Operations Workbench"@en , "Payroll application"@en ;
        skos:definition "A service channel that is an operational system used by staff to do their work."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-dashboard a skos:Concept ;
        skos:prefLabel "Dashboard"@en ;
        skos:altLabel "Report portal"@en ;
        skos:definition "A service channel that presents measures visually for monitoring and analysis."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-query-endpoint a skos:Concept ;
        skos:prefLabel "Query endpoint"@en ;
        skos:altLabel "SPARQL endpoint"@en , "Graph endpoint"@en ;
        skos:definition "A service channel through which systems or analysts query the knowledge graph directly."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-programmatic-interface a skos:Concept ;
        skos:prefLabel "Programmatic interface"@en ;
        skos:altLabel "Application programming interface"@en , "API"@en ;
        skos:definition "A service channel through which software calls the service."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-email a skos:Concept ;
        skos:prefLabel "Email"@en ;
        skos:definition "A service channel using electronic mail."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-telephone a skos:Concept ;
        skos:prefLabel "Telephone"@en ;
        skos:altLabel "Phone"@en , "Call center"@en ;
        skos:definition "A service channel using voice calls."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-in-person-meeting a skos:Concept ;
        skos:prefLabel "In-person meeting"@en ;
        skos:altLabel "Advisor meeting"@en , "Video meeting"@en ;
        skos:definition "A service channel in which staff meet users face to face or by video."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:channel-mobile-application a skos:Concept ;
        skos:prefLabel "Mobile application"@en ;
        skos:altLabel "Mobile app"@en ;
        skos:definition "A service channel that is an application on a phone or tablet."@en ;
        skos:broader voc:service-channel ;
        skos:inScheme voc:service-vocabulary .

    voc:service-delivery-model a skos:Concept ;
        skos:prefLabel "Service delivery model"@en ;
        skos:definition "A controlled value set for how much of a service the user performs."@en ;
        skos:topConceptOf voc:service-vocabulary ;
        skos:narrower voc:delivery-model-self-service , voc:delivery-model-assisted-service , voc:delivery-model-full-service ;
        skos:inScheme voc:service-vocabulary .

    voc:delivery-model-self-service a skos:Concept ;
        skos:prefLabel "Self-service"@en ;
        skos:altLabel "Do it yourself"@en ;
        skos:definition "A service delivery model in which users complete the service themselves with tools provided."@en ;
        skos:broader voc:service-delivery-model ;
        skos:inScheme voc:service-vocabulary .

    voc:delivery-model-assisted-service a skos:Concept ;
        skos:prefLabel "Assisted service"@en ;
        skos:altLabel "Guided service"@en ;
        skos:definition "A service delivery model in which staff or agents help users complete the service."@en ;
        skos:broader voc:service-delivery-model ;
        skos:inScheme voc:service-vocabulary .

    voc:delivery-model-full-service a skos:Concept ;
        skos:prefLabel "Full service"@en ;
        skos:altLabel "Managed service"@en , "Done for you"@en ;
        skos:definition "A service delivery model in which the provider performs the service on the user's behalf."@en ;
        skos:broader voc:service-delivery-model ;
        skos:inScheme voc:service-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-time> {
    voc:time-vocabulary a skos:ConceptScheme ;
        dcterms:title "Time vocabulary"@en ;
        skos:prefLabel "Time vocabulary"@en ;
        dcterms:description "Controlled values for time units, frequencies, day types, and the United States time zones."@en ;
        dcterms:subject core:TemporalEntity ;
        dcterms:source "W3C OWL-Time; ISO 8601; IANA Time Zone Database identifiers."@en ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:time-unit ,
            voc:frequency ,
            voc:day-type ,
            voc:united-states-time-zone .

    voc:time-zone-identifier a rdfs:Datatype ;
        rdfs:label "Time zone identifier"@en ;
        skos:definition "A datatype for time zone identifiers from the Internet Assigned Numbers Authority Time Zone Database."@en ;
        rdfs:isDefinedBy voc:time-vocabulary .

    voc:time-unit a skos:Concept ;
        skos:prefLabel "Time unit"@en ;
        skos:definition "A controlled value set for units in which durations are expressed."@en ;
        skos:topConceptOf voc:time-vocabulary ;
        skos:narrower voc:time-unit-second , voc:time-unit-minute , voc:time-unit-hour , voc:time-unit-day , voc:time-unit-week , voc:time-unit-month , voc:time-unit-quarter , voc:time-unit-year ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-second a skos:Concept ;
        skos:prefLabel "Second"@en ;
        skos:definition "A time unit equal to the base unit of time in the International System of Units."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-minute a skos:Concept ;
        skos:prefLabel "Minute"@en ;
        skos:definition "A time unit equal to sixty seconds."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-hour a skos:Concept ;
        skos:prefLabel "Hour"@en ;
        skos:definition "A time unit equal to sixty minutes."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-day a skos:Concept ;
        skos:prefLabel "Day"@en ;
        skos:definition "A time unit equal to twenty-four hours."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-week a skos:Concept ;
        skos:prefLabel "Week"@en ;
        skos:definition "A time unit equal to seven days."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-month a skos:Concept ;
        skos:prefLabel "Month"@en ;
        skos:definition "A time unit equal to one calendar month."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-quarter a skos:Concept ;
        skos:prefLabel "Quarter"@en ;
        skos:definition "A time unit equal to three calendar months."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:time-unit-year a skos:Concept ;
        skos:prefLabel "Year"@en ;
        skos:definition "A time unit equal to twelve calendar months."@en ;
        skos:broader voc:time-unit ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency a skos:Concept ;
        skos:prefLabel "Frequency"@en ;
        skos:definition "A controlled value set for how often a recurring event or process occurs."@en ;
        skos:topConceptOf voc:time-vocabulary ;
        skos:narrower voc:frequency-daily , voc:frequency-weekly , voc:frequency-biweekly , voc:frequency-semimonthly , voc:frequency-monthly , voc:frequency-quarterly , voc:frequency-semiannually , voc:frequency-annually , voc:frequency-on-demand ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-daily a skos:Concept ;
        skos:prefLabel "Daily"@en ;
        skos:definition "A frequency of once each day."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-weekly a skos:Concept ;
        skos:prefLabel "Weekly"@en ;
        skos:definition "A frequency of once each week."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-biweekly a skos:Concept ;
        skos:prefLabel "Biweekly"@en ;
        skos:altLabel "Every two weeks"@en , "Fortnightly"@en ;
        skos:definition "A frequency of once every two weeks, giving twenty-six occurrences a year."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-semimonthly a skos:Concept ;
        skos:prefLabel "Semimonthly"@en ;
        skos:altLabel "Twice monthly"@en ;
        skos:definition "A frequency of twice each month, giving twenty-four occurrences a year."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-monthly a skos:Concept ;
        skos:prefLabel "Monthly"@en ;
        skos:definition "A frequency of once each month."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-quarterly a skos:Concept ;
        skos:prefLabel "Quarterly"@en ;
        skos:definition "A frequency of once each quarter."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-semiannually a skos:Concept ;
        skos:prefLabel "Semiannually"@en ;
        skos:altLabel "Semiannual"@en , "Twice yearly"@en ;
        skos:definition "A frequency of twice each year."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-annually a skos:Concept ;
        skos:prefLabel "Annually"@en ;
        skos:altLabel "Annual"@en , "Yearly"@en ;
        skos:definition "A frequency of once each year."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:frequency-on-demand a skos:Concept ;
        skos:prefLabel "On demand"@en ;
        skos:altLabel "Ad hoc"@en , "Event driven"@en ;
        skos:definition "A frequency in which occurrences happen when requested rather than on a schedule."@en ;
        skos:broader voc:frequency ;
        skos:inScheme voc:time-vocabulary .

    voc:day-type a skos:Concept ;
        skos:prefLabel "Day type"@en ;
        skos:definition "A controlled value set for how days are counted in deadlines and durations."@en ;
        skos:topConceptOf voc:time-vocabulary ;
        skos:narrower voc:day-type-calendar-day , voc:day-type-business-day , voc:day-type-holiday ;
        skos:inScheme voc:time-vocabulary .

    voc:day-type-calendar-day a skos:Concept ;
        skos:prefLabel "Calendar day"@en ;
        skos:altLabel "Calendar days"@en ;
        skos:definition "A day type that counts every day."@en ;
        skos:broader voc:day-type ;
        skos:inScheme voc:time-vocabulary .

    voc:day-type-business-day a skos:Concept ;
        skos:prefLabel "Business day"@en ;
        skos:altLabel "Working day"@en , "Banking day"@en ;
        skos:definition "A day type that counts weekdays excluding observed holidays."@en ;
        skos:broader voc:day-type ;
        skos:inScheme voc:time-vocabulary .

    voc:day-type-holiday a skos:Concept ;
        skos:prefLabel "Holiday"@en ;
        skos:definition "A day type for days on which the business calendar closes."@en ;
        skos:broader voc:day-type ;
        skos:inScheme voc:time-vocabulary .

    voc:united-states-time-zone a skos:Concept ;
        skos:prefLabel "United States time zone"@en ;
        skos:definition "A controlled value set for the time zones used to resolve local dates and deadlines."@en ;
        skos:topConceptOf voc:time-vocabulary ;
        skos:narrower voc:time-zone-eastern-time , voc:time-zone-central-time , voc:time-zone-mountain-time , voc:time-zone-mountain-standard-time-without-daylight-saving , voc:time-zone-pacific-time , voc:time-zone-alaska-time , voc:time-zone-hawaii-aleutian-time ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-eastern-time a skos:Concept ;
        skos:prefLabel "Eastern time"@en ;
        skos:notation "America/New_York"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in the eastern states."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-central-time a skos:Concept ;
        skos:prefLabel "Central time"@en ;
        skos:notation "America/Chicago"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in the central states."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-mountain-time a skos:Concept ;
        skos:prefLabel "Mountain time"@en ;
        skos:notation "America/Denver"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in the mountain states."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-mountain-standard-time-without-daylight-saving a skos:Concept ;
        skos:prefLabel "Mountain standard time without daylight saving"@en ;
        skos:altLabel "Arizona time"@en ;
        skos:notation "America/Phoenix"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in most of Arizona with no daylight saving time."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-pacific-time a skos:Concept ;
        skos:prefLabel "Pacific time"@en ;
        skos:notation "America/Los_Angeles"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in the Pacific states."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-alaska-time a skos:Concept ;
        skos:prefLabel "Alaska time"@en ;
        skos:notation "America/Anchorage"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in most of Alaska."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .

    voc:time-zone-hawaii-aleutian-time a skos:Concept ;
        skos:prefLabel "Hawaii-Aleutian time"@en ;
        skos:notation "Pacific/Honolulu"^^voc:time-zone-identifier ;
        skos:definition "A United States time zone observed in Hawaii with no daylight saving time."@en ;
        skos:broader voc:united-states-time-zone ;
        skos:inScheme voc:time-vocabulary .
}

<https://www.insperity.com/graph/vocabulary-core-value> {
    voc:value-vocabulary a skos:ConceptScheme ;
        dcterms:title "Value vocabulary"@en ;
        skos:prefLabel "Value vocabulary"@en ;
        dcterms:description "Controlled values for value realization status, time horizon, and certainty."@en ;
        dcterms:subject core:Value ;
        dcterms:publisher "Architecture"@en ;
        dcterms:creator "Knowledge Engineering"@en ;
        dcterms:created "2026-10-14"^^xsd:date ;
        dcterms:modified "2026-10-14"^^xsd:date ;
        owl:versionInfo "0.1.0" ;
        core:hasLifecycleStatus voc:lifecycle-status-draft ;
        skos:hasTopConcept voc:value-realization-status ,
            voc:value-horizon ,
            voc:value-certainty .

    voc:value-realization-status a skos:Concept ;
        skos:prefLabel "Value realization status"@en ;
        skos:definition "A controlled value set for progress in realizing an expected value."@en ;
        skos:topConceptOf voc:value-vocabulary ;
        skos:narrower voc:value-realization-identified , voc:value-realization-committed , voc:value-realization-in-realization , voc:value-realization-realized , voc:value-realization-not-realized ;
        skos:inScheme voc:value-vocabulary .

    voc:value-realization-identified a skos:Concept ;
        skos:prefLabel "Identified"@en ;
        skos:definition "A value realization status for a value described but not yet committed."@en ;
        skos:broader voc:value-realization-status ;
        skos:inScheme voc:value-vocabulary .

    voc:value-realization-committed a skos:Concept ;
        skos:prefLabel "Committed"@en ;
        skos:altLabel "Planned"@en ;
        skos:definition "A value realization status for a value approved with an owner and target."@en ;
        skos:broader voc:value-realization-status ;
        skos:inScheme voc:value-vocabulary .

    voc:value-realization-in-realization a skos:Concept ;
        skos:prefLabel "In realization"@en ;
        skos:altLabel "In progress"@en ;
        skos:definition "A value realization status for a value whose enabling work is under way."@en ;
        skos:broader voc:value-realization-status ;
        skos:inScheme voc:value-vocabulary .

    voc:value-realization-realized a skos:Concept ;
        skos:prefLabel "Realized"@en ;
        skos:altLabel "Achieved"@en ;
        skos:definition "A value realization status for a value confirmed by measurement."@en ;
        skos:broader voc:value-realization-status ;
        skos:inScheme voc:value-vocabulary .

    voc:value-realization-not-realized a skos:Concept ;
        skos:prefLabel "Not realized"@en ;
        skos:altLabel "Missed"@en ;
        skos:definition "A value realization status for a value that was not achieved."@en ;
        skos:broader voc:value-realization-status ;
        skos:inScheme voc:value-vocabulary .

    voc:value-horizon a skos:Concept ;
        skos:prefLabel "Value horizon"@en ;
        skos:definition "A controlled value set for when a value is expected to occur."@en ;
        skos:topConceptOf voc:value-vocabulary ;
        skos:narrower voc:value-horizon-short-term , voc:value-horizon-medium-term , voc:value-horizon-long-term ;
        skos:inScheme voc:value-vocabulary .

    voc:value-horizon-short-term a skos:Concept ;
        skos:prefLabel "Short term"@en ;
        skos:altLabel "Near term"@en ;
        skos:definition "A value horizon of within one year."@en ;
        skos:broader voc:value-horizon ;
        skos:inScheme voc:value-vocabulary .

    voc:value-horizon-medium-term a skos:Concept ;
        skos:prefLabel "Medium term"@en ;
        skos:definition "A value horizon of one to three years."@en ;
        skos:broader voc:value-horizon ;
        skos:inScheme voc:value-vocabulary .

    voc:value-horizon-long-term a skos:Concept ;
        skos:prefLabel "Long term"@en ;
        skos:altLabel "Long range"@en ;
        skos:definition "A value horizon of more than three years, including generational effects."@en ;
        skos:broader voc:value-horizon ;
        skos:inScheme voc:value-vocabulary .

    voc:value-certainty a skos:Concept ;
        skos:prefLabel "Value certainty"@en ;
        skos:definition "A controlled value set for how well a value amount is supported."@en ;
        skos:topConceptOf voc:value-vocabulary ;
        skos:narrower voc:value-certainty-estimated , voc:value-certainty-measured , voc:value-certainty-verified ;
        skos:inScheme voc:value-vocabulary .

    voc:value-certainty-estimated a skos:Concept ;
        skos:prefLabel "Estimated"@en ;
        skos:altLabel "Projected"@en ;
        skos:definition "A value certainty for amounts based on assumptions."@en ;
        skos:broader voc:value-certainty ;
        skos:inScheme voc:value-vocabulary .

    voc:value-certainty-measured a skos:Concept ;
        skos:prefLabel "Measured"@en ;
        skos:definition "A value certainty for amounts based on observed data."@en ;
        skos:broader voc:value-certainty ;
        skos:inScheme voc:value-vocabulary .

    voc:value-certainty-verified a skos:Concept ;
        skos:prefLabel "Verified"@en ;
        skos:altLabel "Audited"@en ;
        skos:definition "A value certainty for measured amounts independently confirmed."@en ;
        skos:broader voc:value-certainty ;
        skos:inScheme voc:value-vocabulary .
}
