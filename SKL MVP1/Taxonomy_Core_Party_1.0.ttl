<https://ontologies.verizon.com/taxonomy-core-party/> a owl:Ontology;
  rdfs:label "Taxonomy | Core | Party"@en;
  dct:description "The party taxonomy categorizes entities such as organizations (companies, agencies), persons (individuals, contacts) and vendors (suppliers of goods or services) which helps to effectively manage relationships and interactions with various internal & external entities."@en;
  dct:title "Taxonomy | Core | Party"@en;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> "https://ontologies.verizon.com/taxonomy-core-party/"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
  <http://open-services.net/ns/core#modifiedBy> "sherri.miller1@one.verizon.com";
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com";
  dct:creator "Jeffrey Wallk", "Sherri Anderson";
  dct:modified "2025-09-30T19:47:17.454Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft>;
  skos:changeNote "This is the initial version of the core taxonomy to be refined over time with input from other stakeholders & resources.";
  dct:created "2024-08-29T17:21:12.502Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
  owl:versionInfo "1.0";
  owl:imports <https://ontologies.verizon.com/upperontology/>;
  <http://verizon.ontologies.com/terms/certified> false .

