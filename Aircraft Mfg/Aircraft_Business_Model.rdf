aero:ProcComponentExchange a ddd:Process ; rdfs:label "Component Exchange Programs (CEP)" .
aero:ProcServiceBulletin a ddd:Process ; rdfs:label "Service Bulletin (SB) Implementations" .
aero:ProcEngineOverhaul a ddd:Process ; rdfs:label "Engine Overhaul Management" .
aero:ProcStructuralRepairs a ddd:Process ; rdfs:label "Structural Repairs" .
aero:ProcAvionicsUpgrades a ddd:Process ; rdfs:label "Avionics Upgrades" .
aero:Proc247Hotline a ddd:Process ; rdfs:label "24/7 Technical Hotline" .
aero:ProcMRTDeployment a ddd:Process ; rdfs:label "Mobile Repair Team (MRT) Deployment" .
aero:ProcUrgentPartsDispatch a ddd:Process ; rdfs:label "Urgent Parts Dispatch" .

aero:ProcRevenueForecasting a ddd:Process ; rdfs:label "Revenue Forecasting" .
aero:ProcCostAccounting a ddd:Process ; rdfs:label "Cost Accounting & Control" .
aero:ProcInvestmentAppraisal a ddd:Process ; rdfs:label "Investment Appraisal" .
