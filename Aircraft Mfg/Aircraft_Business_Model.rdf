aero:ProcSupplierAuditing a ddd:Process ; rdfs:label "Supplier Selection & Auditing" .
aero:ProcContractNegotiation a ddd:Process ; rdfs:label "Contract Negotiation" .
aero:ProcPerfMonitoring a ddd:Process ; rdfs:label "Performance Monitoring" .
