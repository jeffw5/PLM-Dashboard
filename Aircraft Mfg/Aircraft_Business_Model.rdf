aero:ProcLongLeadOrdering a ddd:Process ; rdfs:label "Long-Lead Item Ordering" .
aero:ProcJITPlanning a ddd:Process ; rdfs:label "Just-In-Time (JIT) Delivery Planning" .
aero:ProcPartsTracking a ddd:Process ; rdfs:label "Parts Tracking" .
aero:ProcWarehouseOptimization a ddd:Process ; rdfs:label "Warehousing Optimization" .
aero:ProcAOGLogistics a ddd:Process ; rdfs:label "AOG (Aircraft on Ground) Logistics" .

aero:ProcLeadGeneration a ddd:Process ; rdfs:label "Lead Generation" .
aero:ProcNeedsAssessment a ddd:Process ; rdfs:label "Client Needs Assessment" .
