    rdfs:label "State Insurance Rate & Form Filing Requirement" ;
    hf:guidesProcess hf:ProcCustomSurplusLineRating ,
                     hf:ProcHomeownersUnderwriting ,
                     hf:ProcLitigationStrategyManagement .

