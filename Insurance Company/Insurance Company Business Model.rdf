@prefix hf:       <http://example.org/hartford/ddd#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:      <http://purl.org/dc/terms/> .

# =================================================================
# ONTOLOGY & CLASS DEFINITIONS
# =================================================================

hf:EnterpriseBusinessModel a owl:Ontology ;
    rdfs:label "The Hartford Domain-Driven Business Model Ontology" ;
    rdfs:comment "A DDD ontology mapping insurance domains, services, processes, and operations." ;
    owl:versionInfo "1.1" ;
    dct:description "v1.1 extends v1.0 by aligning the DDD model's relation pattern with the enterprise Core ontology suite (Ontology_Core_Asset, Ontology_Core_Capability, Ontology_Core_Domain, Ontology_Core_Event): every Service/Process now carries the same BFO-style relations (enables, performedBy, creates/modifies, initiates, assignedTo, guides/constrains, controls) used in those Core ontology SHACL shapes, and every bounded context's Service catalog has been filled out to a comparable depth." .

# --- DDD Core Classes (v1.0) ---
hf:Domain a owl:Class ;
    rdfs:label "Business Domain" .

hf:SubDomain a owl:Class ;
    rdfs:subClassOf hf:Domain ;
    rdfs:label "Sub-Domain / Bounded Context" .

hf:DomainService a owl:Class ;
    rdfs:label "Domain Service" .

hf:BusinessProcess a owl:Class ;
    rdfs:label "Underlying Business Process" .

hf:OperationalArea a owl:Class ;
    rdfs:label "Functional Operational Area" .

hf:OntologyConcept a owl:Class ;
    rdfs:label "Domain-Specific Ontology Concept" .

# --- DDD Core Object Properties (v1.0) ---
hf:hasSubDomain a owl:ObjectProperty ;
    rdfs:domain hf:Domain ;
    rdfs:range hf:SubDomain .

hf:providesService a owl:ObjectProperty ;
    rdfs:domain hf:SubDomain ;
    rdfs:range hf:DomainService .

hf:executedByProcess a owl:ObjectProperty ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:BusinessProcess .

hf:supportedByOperation a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:OperationalArea .

hf:mapsToOntologyConcept a owl:ObjectProperty ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:OntologyConcept .

# =================================================================
# 0. EXTENDED CLASSES  (aligned to Ontology_Core_Asset / Capability / Domain / Event)
# =================================================================
# These classes mirror the target classes referenced by the Core ontology's SHACL
# NodeShapes (taxonomy-core-serviceShape, ProcessShape, EventsShape, ValueStreamShape,
# PersonaShape, RoleShape, RulesShape, ComplianceShape, DigitalAssetShape,
# PhysicalAssetShape) so the DDD model can carry the same relation pattern.

hf:Capability a owl:Class ;
    rdfs:label "Business Capability" ;
    rdfs:comment "What the enterprise is able to do, independent of how; mirrors service.model#Capability in the Core Capability ontology." .

hf:Event a owl:Class ;
    rdfs:label "Business Event" ;
    rdfs:comment "A discrete occurrence that a Process initiates or that triggers a Process; mirrors ontology-core-event/Event." .

hf:Asset a owl:Class ;
    rdfs:label "Business Asset" ;
    rdfs:comment "Parent class of Digital and Physical assets created/modified by processes; mirrors ontology-core-asset/Artifact." .

hf:DigitalAsset a owl:Class ;
    rdfs:subClassOf hf:Asset ;
    rdfs:label "Digital Asset" .

hf:PhysicalAsset a owl:Class ;
    rdfs:subClassOf hf:Asset ;
    rdfs:label "Physical Asset" .

hf:ValueStream a owl:Class ;
    rdfs:label "Value Stream" ;
    rdfs:comment "An end-to-end stream of value delivery enabled by one or more Services; mirrors taxonomy-core-valuestream/ValueStream." .

hf:Persona a owl:Class ;
    rdfs:label "Persona" ;
    rdfs:comment "An internal or external actor assigned a Role; mirrors taxonomy-core-persona/Persona." .

hf:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function performed against a Process; mirrors taxonomy-core-role/Role." .

hf:Rules a owl:Class ;
    rdfs:label "Business Rule" ;
    rdfs:comment "Guides or constrains a Process; mirrors taxonomy-core-rules/Rules." .

hf:Compliance a owl:Class ;
    rdfs:label "Compliance Requirement" ;
    rdfs:comment "Controls a Process to ensure regulatory conformance; mirrors taxonomy-core-compliance/Compliance." .

# =================================================================
# 0b. EXTENDED OBJECT PROPERTIES  (relations mirrored from the Core ontology's
#      basic-formal-ontology upper-ontology predicates: enables, performedBy,
#      performs, creates, modifies, generates, initiates, assignedTo, guides,
#      constrains, controls, enabledBy)
# =================================================================

hf:enablesCapability a owl:ObjectProperty ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:Capability ;
    rdfs:comment "Mirrors ServiceShape: Service -enables-> Capability." .

hf:enablesValueStream a owl:ObjectProperty ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:ValueStream ;
    rdfs:comment "Mirrors ServiceShape: Service -enables-> ValueStream." .

hf:enabledByService a owl:ObjectProperty ;
    owl:inverseOf hf:enablesValueStream ;
    rdfs:domain hf:ValueStream ;
    rdfs:range hf:DomainService ;
    rdfs:comment "Mirrors ValueStreamShape: ValueStream -enabledBy-> Service." .

hf:assignedToPersona a owl:ObjectProperty ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:Persona ;
    rdfs:comment "Mirrors ServiceShape: Service -assignedTo-> Persona." .

hf:assignedToRole a owl:ObjectProperty ;
    rdfs:domain hf:Persona ;
    rdfs:range hf:Role ;
    rdfs:comment "Mirrors PersonaShape: Persona -assignedTo-> Role." .

hf:performedByRole a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Role ;
    rdfs:comment "Mirrors ProcessShape: Process -performedBy-> Persona/Role." .

hf:performsProcess a owl:ObjectProperty ;
    owl:inverseOf hf:performedByRole ;
    rdfs:domain hf:Role ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors RoleShape: Role -performs-> Process." .

hf:createsAsset a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Asset ;
    rdfs:comment "Mirrors ProcessShape: Process -creates-> DigitalAsset/PhysicalAsset." .

hf:modifiesAsset a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Asset ;
    rdfs:comment "Mirrors ProcessShape: Process -modifies-> DigitalAsset/PhysicalAsset." .

hf:initiatesEvent a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Event ;
    rdfs:comment "Mirrors ProcessShape: Process -initiates-> Event." .

hf:triggersProcess a owl:ObjectProperty ;
    owl:inverseOf hf:initiatesEvent ;
    rdfs:domain hf:Event ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors EventsShape: Event -initiates-> Process." .

hf:guidesProcess a owl:ObjectProperty ;
    rdfs:domain hf:Rules ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors RulesShape: Rules -guides-> Process." .

hf:constrainsProcess a owl:ObjectProperty ;
    rdfs:domain hf:Rules ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors RulesShape: Rules -constrains-> Process." .

hf:controlsProcess a owl:ObjectProperty ;
    rdfs:domain hf:Compliance ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors ComplianceShape: Compliance -controls-> Process." .

# --- Reverse/inverse declarations for the v1.0/v1.1 core DDD chain (v1.2) ---
# Declared so any reasoner or SPARQL engine can walk "what depends on this"
# upward from a Domain/SubDomain/Service/Process/Asset/Capability/Concept
# without needing every reverse triple physically re-asserted.

hf:subDomainOf a owl:ObjectProperty ;
    owl:inverseOf hf:hasSubDomain ;
    rdfs:domain hf:SubDomain ;
    rdfs:range hf:Domain .

hf:providedBySubDomain a owl:ObjectProperty ;
    owl:inverseOf hf:providesService ;
    rdfs:domain hf:DomainService ;
    rdfs:range hf:SubDomain .

hf:processOfService a owl:ObjectProperty ;
    owl:inverseOf hf:executedByProcess ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:DomainService .

hf:operationSupportsProcess a owl:ObjectProperty ;
    owl:inverseOf hf:supportedByOperation ;
    rdfs:domain hf:OperationalArea ;
    rdfs:range hf:BusinessProcess .

hf:conceptMappedFromService a owl:ObjectProperty ;
    owl:inverseOf hf:mapsToOntologyConcept ;
    rdfs:domain hf:OntologyConcept ;
    rdfs:range hf:DomainService .

hf:assetCreatedByProcess a owl:ObjectProperty ;
    owl:inverseOf hf:createsAsset ;
    rdfs:domain hf:Asset ;
    rdfs:range hf:BusinessProcess .

hf:assetModifiedByProcess a owl:ObjectProperty ;
    owl:inverseOf hf:modifiesAsset ;
    rdfs:domain hf:Asset ;
    rdfs:range hf:BusinessProcess .

hf:capabilityEnabledByService a owl:ObjectProperty ;
    owl:inverseOf hf:enablesCapability ;
    rdfs:domain hf:Capability ;
    rdfs:range hf:DomainService .

# =================================================================
# 0c. SYSTEM / DEPENDENCY / RISK EXTENSION (v1.2)
# =================================================================
# Closes the three gaps found during design-time impact-analysis validation:
#   (1) no first-class System/Application distinct from OperationalArea,
#   (2) no "depends on / consumes" edge (only "creates/modifies", which is
#       output-only and can't answer "what breaks if this asset changes"),
#   (3) no Risk/Issue/Observation instances, even though the Core ontology's
#       own ProcessShape/IssueShape already define generates->Observation and
#       occursIn->Process as the intended risk primitive.

hf:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:comment "A deployable IT system, platform, or application that implements/automates a Process. Distinct from hf:OperationalArea, which is the organizational function that owns the system, not the system itself." .

hf:Issue a owl:Class ;
    rdfs:label "Issue" ;
    rdfs:comment "Mirrors taxonomy-core-issue/Issue: occurs in a Process and generates an Observation." .

hf:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "Mirrors taxonomy-core-process/Observation: a recorded finding generated by a Process or an Issue." .

hf:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "A design-time or operational risk, scored by severity/likelihood, that can be attached to a System, Process, or Service for impact analysis." .

hf:implementedBySystem a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:System ;
    rdfs:comment "The System that automates/implements this Process." .

hf:systemImplementsProcess a owl:ObjectProperty ;
    owl:inverseOf hf:implementedBySystem ;
    rdfs:domain hf:System ;
    rdfs:range hf:BusinessProcess .

hf:dependsOnSystem a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:System ;
    rdfs:comment "A Process's dependency on a System other than the one that directly implements it (cross-system dependency)." .

hf:consumesAsset a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Asset ;
    rdfs:comment "A Process's read/input dependency on an Asset produced or modified elsewhere -- the relation needed to trace 'what breaks if this asset's shape changes', which creates/modifies alone cannot answer." .

hf:assetConsumedBy a owl:ObjectProperty ;
    owl:inverseOf hf:consumesAsset ;
    rdfs:domain hf:Asset ;
    rdfs:range hf:BusinessProcess .

hf:precedesProcess a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Typical lifecycle sequencing between Processes (not necessarily 1:1 per transaction) -- enables end-to-end pipeline impact tracing across service boundaries." .

hf:followsProcess a owl:ObjectProperty ;
    owl:inverseOf hf:precedesProcess ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:BusinessProcess .

hf:generatesObservation a owl:ObjectProperty ;
    rdfs:domain hf:BusinessProcess ;
    rdfs:range hf:Observation ;
    rdfs:comment "Mirrors Core ProcessShape: Process -generates-> Observation." .

hf:occursInProcess a owl:ObjectProperty ;
    rdfs:domain hf:Issue ;
    rdfs:range hf:BusinessProcess ;
    rdfs:comment "Mirrors Core IssueShape: Issue -occursIn-> Process." .

hf:issueGeneratesObservation a owl:ObjectProperty ;
    rdfs:domain hf:Issue ;
    rdfs:range hf:Observation ;
    rdfs:comment "Mirrors Core IssueShape: Issue -generates-> Observation." .

hf:impactsProcess a owl:ObjectProperty ;
    rdfs:domain hf:Risk ;
    rdfs:range hf:BusinessProcess .

hf:impactsSystem a owl:ObjectProperty ;
    rdfs:domain hf:Risk ;
    rdfs:range hf:System .

hf:impactsService a owl:ObjectProperty ;
    rdfs:domain hf:Risk ;
    rdfs:range hf:DomainService .

hf:riskSeverity a owl:DatatypeProperty ;
    rdfs:domain hf:Risk ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled value: High | Medium | Low." .

hf:riskLikelihood a owl:DatatypeProperty ;
    rdfs:domain hf:Risk ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled value: High | Medium | Low." .

# =================================================================
# 1. CORE BUSINESS DOMAINS & BOUNDED CONTEXTS
# =================================================================

# --- Commercial Lines Domain ---
hf:CommercialLinesDomain a hf:Domain ;
    rdfs:label "Commercial Lines Domain" ;
    hf:hasSubDomain hf:SmallBusinessSubDomain ,
                    hf:MiddleLargeCommercialSubDomain ,
                    hf:GlobalSpecialtySubDomain .

hf:SmallBusinessSubDomain a hf:SubDomain ;
    rdfs:label "Small Business Bounded Context" ;
    rdfs:comment "Standardized P&C products for small business enterprise" ;
    hf:providesService hf:BOPIssuanceService ,
                       hf:WorkersCompService ,
                       hf:CommercialAutoService ,
                       hf:CyberLiabilityBOPRiderService .

hf:MiddleLargeCommercialSubDomain a hf:SubDomain ;
    rdfs:label "Middle & Large Commercial Bounded Context" ;
    rdfs:comment "Complex property, liability, and umbrella coverage for mid-to-large enterprises" ;
    hf:providesService hf:ComplexPropertyUnderwritingService ,
                       hf:UmbrellaLiabilityService ,
                       hf:CasualtyClaimsLitigationService .

hf:GlobalSpecialtySubDomain a hf:SubDomain ;
    rdfs:label "Global Specialty (Navigators) Bounded Context" ;
    rdfs:comment "High-hazard, E&S lines, marine, and financial lines" ;
    hf:providesService hf:ExcessAndSurplusService ,
                       hf:OceanMarineRiskService ,
                       hf:FinancialLinesDirectorsService ,
                       hf:CyberSpecialtyRiskService .

# --- Personal Lines Domain ---
hf:PersonalLinesDomain a hf:Domain ;
    rdfs:label "Personal Lines Domain" ;
    hf:hasSubDomain hf:AARPAffinitySubDomain ,
                    hf:StandardPersonalLinesSubDomain .

hf:AARPAffinitySubDomain a hf:SubDomain ;
    rdfs:label "AARP Partnership Bounded Context" ;
    rdfs:comment "Exclusive direct-to-consumer auto and home insurance partnership" ;
    hf:providesService hf:AARPAutoPolicyService ,
                       hf:AARPHomeownersService ,
                       hf:AARPUmbrellaService .

hf:StandardPersonalLinesSubDomain a hf:SubDomain ;
    rdfs:label "Standard Personal Lines Bounded Context" ;
    hf:providesService hf:RentersCoverageService ,
                       hf:PersonalAutoService ,
                       hf:HomeownersInsuranceService .

# --- Group Benefits Domain ---
hf:GroupBenefitsDomain a hf:Domain ;
    rdfs:label "Group Benefits Domain" ;
    hf:hasSubDomain hf:EmployerGroupBenefitsSubDomain .

hf:EmployerGroupBenefitsSubDomain a hf:SubDomain ;
    rdfs:label "Employer Group Benefits Bounded Context" ;
    hf:providesService hf:GroupLifeService ,
                       hf:ShortTermDisabilityService ,
                       hf:LongTermDisabilityService ,
                       hf:VoluntaryAccidentalDeathService ,
                       hf:AbsenceManagementService .

# --- Hartford Funds Domain ---
hf:HartfordFundsDomain a hf:Domain ;
    rdfs:label "Hartford Funds (Investment) Domain" ;
    hf:hasSubDomain hf:AssetManagementSubDomain .

hf:AssetManagementSubDomain a hf:SubDomain ;
    rdfs:label "Asset Management & Investment Bounded Context" ;
    hf:providesService hf:MutualFundManagementService ,
                       hf:ETFStrategyService ,
                       hf:InstitutionalSeparateAccountService .

# =================================================================
# 2. FUNCTIONAL & CORPORATE OPERATIONAL AREAS
# =================================================================

# Technical Operations
hf:OpUnderwriting a hf:OperationalArea ;
    rdfs:label "Underwriting Operations" ;
    rdfs:comment "Risk assessment, pricing, policy structuring" .

hf:OpClaimsManagement a hf:OperationalArea ;
    rdfs:label "Claims Management Operations" ;
    rdfs:comment "Intake, adjudication, negotiation, and ClaimPlus enterprise services" .

hf:OpRiskEngineering a hf:OperationalArea ;
    rdfs:label "Risk Engineering & Loss Control Operations" ;
    rdfs:comment "Safety assessments, hazard mitigation, ergonomic consulting" .

hf:OpDistributionSales a hf:OperationalArea ;
    rdfs:label "Distribution & Sales Operations" ;
    rdfs:comment "Independent agent network, wholesale brokers, direct channels" .

hf:OpActuarialAnalytics a hf:OperationalArea ;
    rdfs:label "Actuarial & Quantitative Analytics" ;
    rdfs:comment "Pricing models, loss reserving, predictive data science" .

# Corporate Support Operations
hf:OpITInnovation a hf:OperationalArea ;
    rdfs:label "IT & Innovation Operations" ;
    rdfs:comment "Cloud infrastructure, cybersecurity, AI platform automation" .

hf:OpFinanceCapital a hf:OperationalArea ;
    rdfs:label "Finance, Accounting & Capital Management" ;
    rdfs:comment "Financial reporting, enterprise investment, capital adequacy" .

hf:OpLegalCompliance a hf:OperationalArea ;
    rdfs:label "Legal, Compliance & Regulatory Affairs" ;
    rdfs:comment "State regulatory filings, contract law, litigation management" .

hf:OpHRMarketingCustomer a hf:OperationalArea ;
    rdfs:label "HR, Marketing & Policyholder Service Operations" ;
    rdfs:comment "Talent acquisition, brand strategy, direct customer service" .

# --- New Operational Areas (v1.1) ---
hf:OpReinsuranceCapitalMarkets a hf:OperationalArea ;
    rdfs:label "Reinsurance & Capital Markets Operations" ;
    rdfs:comment "Treaty/facultative reinsurance placement, cat bonds, capital markets risk transfer" .

hf:OpDataGovernancePlatform a hf:OperationalArea ;
    rdfs:label "Data Governance & Analytics Platform Operations" ;
    rdfs:comment "Enterprise data quality, telematics/IoT ingestion, model governance" .

hf:OpCustomerExperienceDesign a hf:OperationalArea ;
    rdfs:label "Customer Experience & Product Design Operations" ;
    rdfs:comment "Self-service product design, digital journey design, UX research" .

# =================================================================
# 3. SERVICES, PROCESSES & OPERATIONAL MAPPINGS
# =================================================================

# -----------------------------------------------------------------
# 3.1 Small Business Bounded Context
# -----------------------------------------------------------------

# --- Service: BOP Issuance (v1.0, extended with mirrored relations) ---
hf:BOPIssuanceService a hf:DomainService ;
    rdfs:label "Business Owner's Policy (BOP) Automated Service" ;
    hf:executedByProcess hf:ProcStraightThroughUnderwriting ,
                         hf:ProcAutomatedBinding ;
    hf:mapsToOntologyConcept hf:ConceptPolicyContract ,
                             hf:ConceptCommercialRiskProfile ;
    hf:enablesCapability hf:CapUnderwriteRisk , hf:CapPriceRisk ;
    hf:enablesValueStream hf:VSCommercialLinesPolicyToClaim ;
    hf:assignedToPersona hf:PersonaUnderwriter .

hf:ProcStraightThroughUnderwriting a hf:BusinessProcess ;
    rdfs:label "Straight-Through Automated Underwriting Process" ;
    hf:supportedByOperation hf:OpUnderwriting ,
                            hf:OpITInnovation ;
    hf:performedByRole hf:RoleUnderwriter ;
    hf:createsAsset hf:AssetPolicyDocument ;
    hf:initiatesEvent hf:EventPolicyBound ;
    hf:implementedBySystem hf:SysPolicyAdminPlatform ;
    hf:precedesProcess hf:ProcAutomatedBinding .


hf:ProcAutomatedBinding a hf:BusinessProcess ;
    rdfs:label "Real-Time Policy Binding & Rating Process" ;
    hf:supportedByOperation hf:OpActuarialAnalytics ,
                            hf:OpDistributionSales ;
    hf:performedByRole hf:RoleActuary ;
    hf:createsAsset hf:AssetActuarialModel ;
    hf:implementedBySystem hf:SysPolicyAdminPlatform ;
    hf:consumesAsset hf:AssetPolicyDocument .


# --- Service: Workers' Compensation (fleshed out from stub) ---
hf:WorkersCompService a hf:DomainService ;
    rdfs:label "Workers' Compensation Statutory Coverage Service" ;
    rdfs:comment "Statutory wage-replacement and medical benefit coverage for workplace injury, rated on payroll exposure." ;
    hf:executedByProcess hf:ProcPayrollExposureRating ,
                         hf:ProcClaimsIntakeTriage ;
    hf:mapsToOntologyConcept hf:ConceptStatutoryBenefitSchedule ,
                             hf:ConceptExperienceModRating ;
    hf:enablesCapability hf:CapUnderwriteRisk , hf:CapAdjudicateClaims ;
    hf:assignedToPersona hf:PersonaUnderwriter .

hf:ProcPayrollExposureRating a hf:BusinessProcess ;
    rdfs:label "Payroll-Based Exposure Rating Process" ;
    hf:supportedByOperation hf:OpUnderwriting ,
                            hf:OpActuarialAnalytics ;
    hf:performedByRole hf:RoleUnderwriter ;
    hf:createsAsset hf:AssetPolicyDocument ;
    hf:initiatesEvent hf:EventPolicyBound ;
    hf:implementedBySystem hf:SysPolicyAdminPlatform ;
    hf:precedesProcess hf:ProcClaimsIntakeTriage .


hf:ProcClaimsIntakeTriage a hf:BusinessProcess ;
    rdfs:label "Injury Claims Intake & Triage Process" ;
    hf:supportedByOperation hf:OpClaimsManagement ;
    hf:performedByRole hf:RoleClaimsAdjuster ;
    hf:createsAsset hf:AssetClaimsFile ;
    hf:initiatesEvent hf:EventFNOLReceived ;
    hf:implementedBySystem hf:SysClaimsManagementPlatform .


# --- Service: Commercial Auto (fleshed out from stub) ---
hf:CommercialAutoService a hf:DomainService ;
    rdfs:label "Commercial Fleet Auto Liability & Physical Damage Service" ;
    rdfs:comment "Liability and physical damage coverage for commercial vehicle fleets, rated with telematics." ;
    hf:executedByProcess hf:ProcFleetTelematicsRating ,
                         hf:ProcCommercialAutoClaimsHandling ;
    hf:mapsToOntologyConcept hf:ConceptFleetRiskProfile ,
                             hf:ConceptAutoLossEvent ;
    hf:enablesCapability hf:CapUnderwriteRisk , hf:CapAdjudicateClaims ;
    hf:assignedToPersona hf:PersonaUnderwriter .

hf:ProcFleetTelematicsRating a hf:BusinessProcess ;
    rdfs:label "Fleet Telematics-Based Rating Process" ;
    hf:supportedByOperation hf:OpUnderwriting ,
                            hf:OpDataGovernancePlatform ;
    hf:performedByRole hf:RoleUnderwriter ;
    hf:createsAsset hf:AssetPolicyDocument ;
    hf:modifiesAsset hf:AssetInsuredVehiclePhysical ;
    hf:implementedBySystem hf:SysTelematicsIoTPlatform ;
    hf:precedesProcess hf:ProcCommercialAutoClaimsHandling .


hf:ProcCommercialAutoClaimsHandling a hf:BusinessProcess ;
    rdfs:label "Commercial Auto Claims Handling Process" ;
    hf:supportedByOperation hf:OpClaimsManagement ;
    hf:performedByRole hf:RoleClaimsAdjuster ;
    hf:modifiesAsset hf:AssetClaimsFile ;
    hf:initiatesEvent hf:EventClaimSettled ;
    hf:implementedBySystem hf:SysClaimsManagementPlatform ;
    hf:consumesAsset hf:AssetPolicyDocument .


# --- Service: Small Business Cyber Rider (new, v1.1) ---
hf:CyberLiabilityBOPRiderService a hf:DomainService ;
    rdfs:label "Small Business Cyber Liability Endorsement Service" ;
    rdfs:comment "New v1.1 service: cyber liability endorsement attached to the BOP for small business insureds." ;
    hf:executedByProcess hf:ProcCyberRiskScreening ;
    hf:mapsToOntologyConcept hf:ConceptCyberExposureProfile ;
    hf:enablesCapability hf:CapUnderwriteRisk ;
    hf:assignedToPersona hf:PersonaUnderwriter .

hf:ProcCyberRiskScreening a hf:BusinessProcess ;
    rdfs:label "Cyber Risk Screening & Endorsement Process" ;
    hf:supportedByOperation hf:OpUnderwriting ,
                            hf:OpITInnovation ;
    hf:performedByRole hf:RoleUnderwriter ;
    hf:createsAsset hf:AssetPolicyDocument ;
    hf:implementedBySystem hf:SysPolicyAdminPlatform .


# -----------------------------------------------------------------
# 3.2 Middle & Large Commercial Bounded Context
# -----------------------------------------------------------------

# --- Service: Complex Property Underwriting (v1.0, extended) ---
hf:ComplexPropertyUnderwritingService a hf:DomainService ;
    rdfs:label "Middle/Large Commercial Property Underwriting Service" ;
    hf:executedByProcess hf:ProcOnsiteRiskInspection ,
                         hf:ProcCatastropheLossModeling ;
    hf:mapsToOntologyConcept hf:ConceptPropertyLossExposure ,
                             hf:ConceptReinsuranceStructure ;
    hf:enablesCapability hf:CapUnderwriteRisk , hf:CapEngineerRisk ;
    hf:enablesValueStream hf:VSCommercialLinesPolicyToClaim ;
    hf:assignedToPersona hf:PersonaRiskEngineer .

hf:ProcOnsiteRiskInspection a hf:BusinessProcess ;
    rdfs:label "On-Site Physical Safety & Risk Inspection Process" ;
    hf:supportedByOperation hf:OpRiskEngineering ;
    hf:performedByRole hf:RoleRiskEngineer ;
    hf:createsAsset hf:AssetRiskInspectionReport ;
    hf:initiatesEvent hf:EventInspectionCompleted ;
    hf:precedesProcess hf:ProcCatastropheLossModeling .


hf:ProcCatastropheLossModeling a hf:BusinessProcess ;
    rdfs:label "Catastrophe & Exposure Predictive Modeling Process" ;
    hf:supportedByOperation hf:OpActuarialAnalytics ,
                            hf:OpReinsuranceCapitalMarkets ;
    hf:performedByRole hf:RoleActuary ;
    hf:createsAsset hf:AssetActuarialModel ;
    hf:implementedBySystem hf:SysActuarialModelingPlatform ;
    hf:consumesAsset hf:AssetRiskInspectionReport .


# --- Service: Umbrella Liability (fleshed out from stub) ---
hf:UmbrellaLiabilityService a hf:DomainService ;
    rdfs:label "Commercial Umbrella & Excess Liability Service" ;
