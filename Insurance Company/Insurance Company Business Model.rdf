    rdfs:label "Statutory Workers' Comp Benefit Schedule Rule" ;
    hf:constrainsProcess hf:ProcPayrollExposureRating ,
                         hf:ProcClaimsIntakeTriage ,
                         hf:ProcFMLAEligibilityTracking .

