    hf:controlsProcess hf:ProcSECRegulatoryReporting ,
                       hf:ProcExecutiveRiskUnderwriting .

# =================================================================
# 11. SYSTEMS  (v1.2 -- distinct from OperationalArea; the thing a
#      design-time decision usually actually changes)
# =================================================================

hf:SysPolicyAdminPlatform a hf:System ;
    rdfs:label "Policy Administration & Rating Platform" ;
    rdfs:comment "Shared straight-through underwriting/rating/binding engine underlying most commercial and personal lines new-business processes." .

hf:SysClaimsManagementPlatform a hf:System ;
    rdfs:label "Enterprise Claims Management Platform (ClaimPlus)" ;
    rdfs:comment "Shared claims intake, adjudication, and litigation-support system referenced across nearly every claims-handling process in the model." .

hf:SysTelematicsIoTPlatform a hf:System ;
    rdfs:label "Telematics & IoT Ingestion Platform" ;
    rdfs:comment "Usage-based rating data platform for fleet and personal auto." .

hf:SysActuarialModelingPlatform a hf:System ;
    rdfs:label "Actuarial & Catastrophe Modeling Platform" .

hf:SysInvestmentPortfolioPlatform a hf:System ;
    rdfs:label "Investment Portfolio Management Platform" ;
    rdfs:comment "Order management, rebalancing, and creation/redemption system shared by Hartford Funds mutual fund, ETF, and institutional separate account services." .

hf:SysRegulatoryFilingPlatform a hf:System ;
    rdfs:label "Regulatory & Statutory Filing Platform" .

hf:SysAffinityPartnerPortal a hf:System ;
    rdfs:label "Affinity Partner Distribution Portal" .

hf:SysBenefitsAdminPlatform a hf:System ;
    rdfs:label "Group Benefits Administration Platform" .

# =================================================================
# 12. RISK / ISSUE / OBSERVATION  (v1.2 worked examples of the
#      design-time impact-analysis pattern this file was validated against)
# =================================================================

# --- Example 1: shared-system concentration risk, discoverable by fan-in ---
hf:RiskClaimsPlatformConcentration a hf:Risk ;
    rdfs:label "Claims Management Platform Concentration Risk" ;
    rdfs:comment "hf:SysClaimsManagementPlatform implements 15 processes across 6 bounded contexts (query it via hf:systemImplementsProcess); an outage, defect, or replatforming decision has enterprise-wide blast radius." ;
    hf:riskSeverity "High" ;
    hf:riskLikelihood "Medium" ;
    hf:impactsSystem hf:SysClaimsManagementPlatform .

# --- Example 2: cross-process asset-shape-change risk (the gap consumesAsset closes) ---
hf:RiskPolicyDocumentSchemaChange a hf:Risk ;
    rdfs:label "Policy Document Schema Change Risk" ;
    rdfs:comment "hf:AssetPolicyDocument is consumed by claims-handling processes (hf:consumesAsset) that did not create it; a design-time change to its schema in the policy admin platform can silently break downstream claims processes unless traced via hf:assetConsumedBy." ;
    hf:riskSeverity "Medium" ;
    hf:riskLikelihood "Medium" ;
    hf:impactsSystem hf:SysPolicyAdminPlatform ;
    hf:impactsProcess hf:ProcCommercialAutoClaimsHandling , hf:ProcAutoClaimsAdjudication .

# --- Example 3: regulatory process, with the Issue -> Observation causal chain the Core ontology defines ---
hf:IssueSurplusLineFilingDelay a hf:Issue ;
    rdfs:label "Surplus Line Rate Filing Delay Issue" ;
    hf:occursInProcess hf:ProcCustomSurplusLineRating ;
    hf:issueGeneratesObservation hf:ObsFilingTurnaroundBreach .

hf:ObsFilingTurnaroundBreach a hf:Observation ;
    rdfs:label "State Filing Turnaround SLA Breach Observation" .

hf:RiskSurplusLinesComplianceDrift a hf:Risk ;
    rdfs:label "Surplus Lines Compliance Drift Risk" ;
    rdfs:comment "Generated from hf:IssueSurplusLineFilingDelay; governed by hf:RuleStateInsuranceRateFilingRequirement, which already guidesProcess this same process -- the Rule, Issue, Observation, and Risk all resolve onto one Process node, which is exactly the causal join a design-time impact query needs." ;
    hf:riskSeverity "Medium" ;
    hf:riskLikelihood "Low" ;
    hf:impactsProcess hf:ProcCustomSurplusLineRating ;
    hf:impactsService hf:ExcessAndSurplusService .