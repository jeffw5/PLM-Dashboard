# Vocabulary: Capability vocabulary
# File: vocabulary-core-capability.ttl   Version 0.1.0   Status: Draft
# Conforms to Semantic Governance v1.8 (Sections 3.2, 3.7, 3.8, 3.9; Appendix E Step 3).
# One skos:ConceptScheme per file; load through RDF Studio's taxonomy import.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix voc: <https://www.insperity.com/vocabulary/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

voc:capability-vocabulary a skos:ConceptScheme ;
    dcterms:title "Capability vocabulary"@en ;
    skos:prefLabel "Capability vocabulary"@en ;
    dcterms:description "Controlled values for capability maturity and strategic importance."@en ;
    dcterms:subject core:Capability ;
    dcterms:source "Capability Maturity Model Integration maturity levels; Business Architecture Guild capability assessment."@en ;
    dcterms:publisher "Architecture"@en ;
    dcterms:creator "Knowledge Engineering"@en ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus voc:lifecycle-status-draft ;
    skos:hasTopConcept voc:capability-maturity-level ,
        voc:strategic-importance .

voc:capability-maturity-level a skos:Concept ;
    skos:prefLabel "Capability maturity level"@en ;
    skos:definition "A controlled value set for how well defined and controlled a capability is."@en ;
    skos:topConceptOf voc:capability-vocabulary ;
    skos:narrower voc:maturity-initial , voc:maturity-managed , voc:maturity-defined , voc:maturity-quantitatively-managed , voc:maturity-optimizing ;
    skos:inScheme voc:capability-vocabulary .

voc:maturity-initial a skos:Concept ;
    skos:prefLabel "Initial"@en ;
    skos:altLabel "Level 1"@en ;
    skos:notation "1" ;
    skos:definition "A capability maturity level in which work is ad hoc and depends on individuals."@en ;
    skos:broader voc:capability-maturity-level ;
    skos:inScheme voc:capability-vocabulary .

voc:maturity-managed a skos:Concept ;
    skos:prefLabel "Managed"@en ;
    skos:altLabel "Level 2"@en , "Repeatable"@en ;
    skos:notation "2" ;
    skos:definition "A capability maturity level in which work is planned and tracked at the project level."@en ;
    skos:broader voc:capability-maturity-level ;
    skos:inScheme voc:capability-vocabulary .

voc:maturity-defined a skos:Concept ;
    skos:prefLabel "Defined"@en ;
    skos:altLabel "Level 3"@en ;
    skos:notation "3" ;
    skos:definition "A capability maturity level in which work follows organization-wide standards."@en ;
    skos:broader voc:capability-maturity-level ;
    skos:inScheme voc:capability-vocabulary .

voc:maturity-quantitatively-managed a skos:Concept ;
    skos:prefLabel "Quantitatively managed"@en ;
    skos:altLabel "Level 4"@en ;
    skos:notation "4" ;
    skos:definition "A capability maturity level in which work is controlled with measures."@en ;
    skos:broader voc:capability-maturity-level ;
    skos:inScheme voc:capability-vocabulary .

voc:maturity-optimizing a skos:Concept ;
    skos:prefLabel "Optimizing"@en ;
    skos:altLabel "Level 5"@en ;
    skos:notation "5" ;
    skos:definition "A capability maturity level in which work is continuously improved from measures."@en ;
    skos:broader voc:capability-maturity-level ;
    skos:inScheme voc:capability-vocabulary .

voc:strategic-importance a skos:Concept ;
    skos:prefLabel "Strategic importance"@en ;
    skos:definition "A controlled value set for how much a capability distinguishes the organization."@en ;
    skos:topConceptOf voc:capability-vocabulary ;
    skos:narrower voc:importance-differentiating , voc:importance-essential , voc:importance-commodity ;
    skos:inScheme voc:capability-vocabulary .

voc:importance-differentiating a skos:Concept ;
    skos:prefLabel "Differentiating"@en ;
    skos:altLabel "Competitive advantage"@en ;
    skos:definition "A strategic importance for capabilities that set the organization apart from competitors."@en ;
    skos:broader voc:strategic-importance ;
    skos:inScheme voc:capability-vocabulary .

voc:importance-essential a skos:Concept ;
    skos:prefLabel "Essential"@en ;
    skos:altLabel "Core"@en , "Parity"@en ;
    skos:definition "A strategic importance for capabilities that must be done well but do not differentiate."@en ;
    skos:broader voc:strategic-importance ;
    skos:inScheme voc:capability-vocabulary .

voc:importance-commodity a skos:Concept ;
    skos:prefLabel "Commodity"@en ;
    skos:altLabel "Utility"@en ;
    skos:definition "A strategic importance for capabilities that can be standardized or outsourced."@en ;
    skos:broader voc:strategic-importance ;
    skos:inScheme voc:capability-vocabulary .
