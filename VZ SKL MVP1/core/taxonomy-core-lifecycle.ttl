# Taxonomy: Lifecycle taxonomy
# File: taxonomy-core-lifecycle.ttl   Version 0.1.0   Status: Draft
# Conforms to Semantic Governance v1.8 (Sections 3.2, 3.7, 3.8, 3.9; Appendix E Step 3).
# One skos:ConceptScheme per file; load through RDF Studio's taxonomy import.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix tax: <https://www.insperity.com/taxonomy/core/> .
@prefix voc: <https://www.insperity.com/vocabulary/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tax:LifecycleTaxonomy a skos:ConceptScheme ;
    dcterms:title "Lifecycle taxonomy"@en ;
    skos:prefLabel "Lifecycle taxonomy"@en ;
    dcterms:description "Classification of the kinds of lifecycle, the ordered sets of stages through which a thing passes from creation to retirement."@en ;
    dcterms:subject core:Lifecycle ;
    skos:scopeNote "Covers kinds of lifecycle. The stages and status values of specific lifecycles, including the knowledge artifact status and the six-stage and ten-stage governance lifecycles, are in the lifecycle vocabulary."@en ;
    dcterms:source "Semantic Governance v1.8 Sections 2.4, 3.3, and 3.4; ISO/IEC/IEEE 15288 for system life cycle stages."@en ;
    dcterms:publisher "Architecture"@en ;
    dcterms:creator "Knowledge Engineering"@en ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus voc:lifecycle-status-draft ;
    skos:hasTopConcept tax:ArtifactLifecycle ,
        tax:PartyLifecycle ,
        tax:OfferingLifecycle ,
        tax:AssetLifecycle ,
        tax:AgreementLifecycle ,
        tax:WorkItemLifecycle ,
        tax:GovernanceLifecycle .

tax:ArtifactLifecycle a skos:Concept ;
    skos:prefLabel "Artifact lifecycle"@en ;
    skos:definition "A lifecycle of an information or software asset from creation to retirement."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:narrower tax:KnowledgeArtifactLifecycle , tax:DocumentLifecycle , tax:RecordLifecycle , tax:DataLifecycle , tax:SoftwareReleaseLifecycle , tax:ModelLifecycle ;
    skos:relatedMatch tax:InformationAsset ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:KnowledgeArtifactLifecycle a skos:Concept ;
    skos:prefLabel "Knowledge artifact lifecycle"@en ;
    skos:altLabel "Semantic knowledge lifecycle"@en , "SKL"@en ;
    skos:definition "An artifact lifecycle of a vocabulary, taxonomy, ontology, mapping, shape, or rule from ideation to retirement."@en ;
    skos:scopeNote "Stages are in the lifecycle vocabulary; statuses run Draft, Candidate, Released, Deprecated, Retired."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:relatedMatch tax:KnowledgeArtifact ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:DocumentLifecycle a skos:Concept ;
    skos:prefLabel "Document lifecycle"@en ;
    skos:altLabel "Content lifecycle"@en ;
    skos:definition "An artifact lifecycle of a document from drafting through review, publication, revision, and disposal."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:RecordLifecycle a skos:Concept ;
    skos:prefLabel "Record lifecycle"@en ;
    skos:altLabel "Records retention lifecycle"@en ;
    skos:definition "An artifact lifecycle of a record from capture through retention to disposition."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:DataLifecycle a skos:Concept ;
    skos:prefLabel "Data lifecycle"@en ;
    skos:altLabel "Information lifecycle"@en ;
    skos:definition "An artifact lifecycle of data from creation or acquisition through use, archiving, and deletion."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:SoftwareReleaseLifecycle a skos:Concept ;
    skos:prefLabel "Software release lifecycle"@en ;
    skos:altLabel "Release lifecycle"@en ;
    skos:definition "An artifact lifecycle of a software or knowledge release from build through test, stage, and production promotion to retirement."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ModelLifecycle a skos:Concept ;
    skos:prefLabel "Model lifecycle"@en ;
    skos:altLabel "Artificial intelligence system lifecycle"@en , "AI lifecycle"@en ;
    skos:definition "An artifact lifecycle of a machine learning model from design and training through validation, deployment, monitoring, and retirement."@en ;
    skos:broader tax:ArtifactLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:PartyLifecycle a skos:Concept ;
    skos:prefLabel "Party lifecycle"@en ;
    skos:altLabel "Relationship lifecycle"@en ;
    skos:definition "A lifecycle of a party's relationship with the organization."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:narrower tax:EmploymentLifecycle , tax:ClientLifecycle , tax:SupplierLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:EmploymentLifecycle a skos:Concept ;
    skos:prefLabel "Employment lifecycle"@en ;
    skos:altLabel "Hire to retire"@en , "Employee lifecycle"@en , "Worker lifecycle"@en ;
    skos:definition "A party lifecycle of a worker from recruitment and hire through employment changes to separation."@en ;
    skos:broader tax:PartyLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ClientLifecycle a skos:Concept ;
    skos:prefLabel "Client lifecycle"@en ;
    skos:altLabel "Customer lifecycle"@en , "Prospect to client"@en ;
    skos:definition "A party lifecycle of a client from prospect through onboarding, service, renewal, and exit."@en ;
    skos:broader tax:PartyLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:SupplierLifecycle a skos:Concept ;
    skos:prefLabel "Supplier lifecycle"@en ;
    skos:altLabel "Vendor lifecycle"@en ;
    skos:definition "A party lifecycle of a supplier from qualification and contracting through performance management to exit."@en ;
    skos:broader tax:PartyLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:OfferingLifecycle a skos:Concept ;
    skos:prefLabel "Offering lifecycle"@en ;
    skos:definition "A lifecycle of something offered to clients from concept to withdrawal."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:narrower tax:ProductLifecycle , tax:ServiceLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ProductLifecycle a skos:Concept ;
    skos:prefLabel "Product lifecycle"@en ;
    skos:altLabel "Product life cycle"@en ;
    skos:definition "An offering lifecycle of a product from concept, design, and launch through growth, maturity, and discontinuation."@en ;
    skos:broader tax:OfferingLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ServiceLifecycle a skos:Concept ;
    skos:prefLabel "Service lifecycle"@en ;
    skos:altLabel "Service life cycle"@en ;
    skos:definition "An offering lifecycle of a service from strategy and design through transition, operation, and retirement."@en ;
    skos:broader tax:OfferingLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:AssetLifecycle a skos:Concept ;
    skos:prefLabel "Asset lifecycle"@en ;
    skos:altLabel "Asset life cycle"@en , "Plan to dispose"@en ;
    skos:definition "A lifecycle of a physical or financial asset from planning and acquisition through operation and maintenance to disposal."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:AgreementLifecycle a skos:Concept ;
    skos:prefLabel "Agreement lifecycle"@en ;
    skos:altLabel "Contract lifecycle"@en ;
    skos:definition "A lifecycle of an agreement from drafting and negotiation through execution, performance, renewal, and termination."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:WorkItemLifecycle a skos:Concept ;
    skos:prefLabel "Work item lifecycle"@en ;
    skos:altLabel "Ticket lifecycle"@en ;
    skos:definition "A lifecycle of a unit of tracked work from creation to closure."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:narrower tax:RequirementLifecycle , tax:IssueLifecycle , tax:ChangeLifecycle , tax:DecisionLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:RequirementLifecycle a skos:Concept ;
    skos:prefLabel "Requirement lifecycle"@en ;
    skos:definition "A work item lifecycle of a requirement from elicitation through approval, implementation, and verification."@en ;
    skos:broader tax:WorkItemLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:IssueLifecycle a skos:Concept ;
    skos:prefLabel "Issue lifecycle"@en ;
    skos:altLabel "Incident lifecycle"@en , "Defect lifecycle"@en ;
    skos:definition "A work item lifecycle of an issue from detection through triage and resolution to closure."@en ;
    skos:broader tax:WorkItemLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ChangeLifecycle a skos:Concept ;
    skos:prefLabel "Change lifecycle"@en ;
    skos:altLabel "Change request lifecycle"@en ;
    skos:definition "A work item lifecycle of a change from request through assessment, approval, implementation, and review."@en ;
    skos:broader tax:WorkItemLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:DecisionLifecycle a skos:Concept ;
    skos:prefLabel "Decision lifecycle"@en ;
    skos:definition "A work item lifecycle of a decision from framing through analysis and choice to communication and review."@en ;
    skos:broader tax:WorkItemLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:GovernanceLifecycle a skos:Concept ;
    skos:prefLabel "Governance lifecycle"@en ;
    skos:altLabel "Oversight lifecycle"@en ;
    skos:definition "A lifecycle of governed oversight that a policy, control, or governed artifact passes through from definition to retirement."@en ;
    skos:scopeNote "The ten-stage knowledge governance lifecycle in Section 3.4 is in the lifecycle vocabulary."@en ;
    skos:topConceptOf tax:LifecycleTaxonomy ;
    skos:narrower tax:PolicyLifecycle , tax:ControlLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:PolicyLifecycle a skos:Concept ;
    skos:prefLabel "Policy lifecycle"@en ;
    skos:altLabel "Policy management lifecycle"@en ;
    skos:definition "A governance lifecycle of a policy from drafting and approval through publication, attestation, review, and retirement."@en ;
    skos:broader tax:GovernanceLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .

tax:ControlLifecycle a skos:Concept ;
    skos:prefLabel "Control lifecycle"@en ;
    skos:definition "A governance lifecycle of a control from design through implementation, testing, operation, and remediation."@en ;
    skos:broader tax:GovernanceLifecycle ;
    skos:inScheme tax:LifecycleTaxonomy .
